<?xml version="1.0" encoding="utf-8"?>
<LanguageData>
  <!-- 传奇怪物 -->
  <LP_LegendaryBeasts.label>legendary monsters</LP_LegendaryBeasts.label>
  <!-- 贝希尔、眼魔、半巫妖这些独来独往的传说中的怪物。它们不结盟、不谈判，对谁都怀着敌意。 -->
  <LP_LegendaryBeasts.description>Lone legendary monsters such as behirs, beholders and demiliches. They don't ally or negotiate, and are hostile to everyone.</LP_LegendaryBeasts.description>
  <!-- 传奇怪物 -->
  <LP_LegendaryBeasts.fixedName>legendary monsters</LP_LegendaryBeasts.fixedName>
  <!-- 活着就是为了吞下更多。 -->
  <LP_LegendaryBeasts.ideoDescription>Living only to devour more.</LP_LegendaryBeasts.ideoDescription>
  <!-- 无名的饥渴 -->
  <LP_LegendaryBeasts.ideoName>nameless hunger</LP_LegendaryBeasts.ideoName>
  <!-- 怪物 -->
  <LP_LegendaryBeasts.pawnSingular>monster</LP_LegendaryBeasts.pawnSingular>
  <!-- 怪物 -->
  <LP_LegendaryBeasts.pawnsPlural>monster</LP_LegendaryBeasts.pawnsPlural>
</LanguageData>
