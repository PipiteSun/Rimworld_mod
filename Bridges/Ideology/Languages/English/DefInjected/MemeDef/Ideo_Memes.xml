  <!-- 巫妖女王 -->
  <LP_Meme_Vlaakith.label>the lich-queen</LP_Meme_Vlaakith.label>
  <!-- 维拉基斯是吉斯洋基人的巫妖女王，她要求子民永恒的效忠。 -->
  <LP_Meme_Vlaakith.description>Vlaakith is the lich-queen of the githyanki, demanding eternal loyalty from her people.</LP_Meme_Vlaakith.description>
  <!-- memeAdjective->不朽 | memeHyphenPrefix->冠 | memeConcept->效忠 | memeLeaderNoun->女王之剑 | memeLeaderAdjective->不朽 | memeMoralist->女王之声 -->
