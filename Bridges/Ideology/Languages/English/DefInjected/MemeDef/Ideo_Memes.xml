    <li>memeAdjective-&gt;grey-robed</li>
    <li>memeAdjective-&gt;restful</li>
    <li>memeHyphenPrefix-&gt;Necro</li>
    <li>memeConcept-&gt;rest</li>
    <li>memeConcept-&gt;judgment</li>
    <li>memeLeaderNoun-&gt;gravekeeper</li>
    <li>memeLeaderAdjective-&gt;grey-robed</li>
    <li>memeMoralist-&gt;soul guide</li>
  </LP_Meme_Kelemvor.generalRules.rulesStrings>
  <!-- 亡者之主 -->
  <LP_Meme_Kelemvor.modExtensions.0.deityTitle>lord of the dead</LP_Meme_Kelemvor.modExtensions.0.deityTitle>
  <!-- 兽王之猎 -->
  <LP_Meme_Malar.label>the Beastlord's hunt</LP_Meme_Malar.label>
  <!-- 马拉尔是野兽与狩猎之神。强者猎杀，弱者成为猎物。文化的守护神固定为马拉尔。\n\n被动：殖民地每有一只驯服的狼、熊或冬狼，信徒心情+1（最多+3）。 -->
  <LP_Meme_Malar.description>Malar is the god of beasts and the hunt. The strong hunt, and the weak become prey. The culture's patron deity is fixed to Malar.\n\nPassive: believers get mood +1 for each tamed wolf, bear or winter wolf in the colony (up to +3).</LP_Meme_Malar.description>
  <!-- memeAdjective->兽血 | memeAdjective->狩猎 | memeHyphenPrefix->兽 | memeConcept->狩猎 | memeConcept->兽性 | memeLeaderNoun->猎王 | memeLeaderAdjective->嗜血 | memeMoralist->追猎者 -->
  <LP_Meme_Malar.generalRules.rulesStrings>
    <li>memeAdjective-&gt;beast-blooded</li>
    <li>memeAdjective-&gt;hunting</li>
    <li>memeHyphenPrefix-&gt;Thero</li>
    <li>memeConcept-&gt;the hunt</li>
    <li>memeConcept-&gt;bestiality</li>
    <li>memeLeaderNoun-&gt;hunt king</li>
