<?xml version="1.0" encoding="utf-8"?>
<!-- 1.56.0：DND 派系的 DND 模因（规格 8.1）和戒律（8.2，LichPhylactery.LP_FactionIdeoExtension，生成文化时由 IdeoGenerator 后缀替换进对应议题）。
     旧存档：设置「文化」分组里的「重建 DND 派系文化」按钮。黑网、龙教徒留给后续批次。 -->
<Patch>
  <!-- 费伦拓荒同盟 -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/FactionDef[defName="LP_FaerunColony"]/forcedMemes</xpath>
    <match Class="PatchOperationAdd"><xpath>Defs/FactionDef[defName="LP_FaerunColony"]/forcedMemes</xpath><value><li>LP_Meme_Pantheon</li></value></match>
    <nomatch Class="PatchOperationConditional">
      <xpath>Defs/FactionDef[defName="LP_FaerunColony"]</xpath>
      <match Class="PatchOperationAdd"><xpath>Defs/FactionDef[defName="LP_FaerunColony"]</xpath><value><forcedMemes><li>LP_Meme_Pantheon</li></forcedMemes></value></match>
    </nomatch>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/FactionDef[defName="LP_FaerunColony"]</xpath>
    <match Class="PatchOperationAddModExtension"><xpath>Defs/FactionDef[defName="LP_FaerunColony"]</xpath><value><li Class="LichPhylactery.LP_FactionIdeoExtension"><precepts><li>LP_Undead_Abhorrent</li><li>LP_Races_Many</li><li>LP_Arcane_Cautious</li><li>Slavery_Abhorrent</li></precepts></li></value></match>
  </Operation>
  <!-- 塞伊远征军 -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/FactionDef[defName="LP_FaerunHostile"]/forcedMemes</xpath>
    <match Class="PatchOperationAdd"><xpath>Defs/FactionDef[defName="LP_FaerunHostile"]/forcedMemes</xpath><value><li>LP_Meme_Bane</li><li>LP_Meme_Weave</li></value></match>
    <nomatch Class="PatchOperationConditional">
      <xpath>Defs/FactionDef[defName="LP_FaerunHostile"]</xpath>
      <match Class="PatchOperationAdd"><xpath>Defs/FactionDef[defName="LP_FaerunHostile"]</xpath><value><forcedMemes><li>LP_Meme_Bane</li><li>LP_Meme_Weave</li></forcedMemes></value></match>
    </nomatch>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/FactionDef[defName="LP_FaerunHostile"]</xpath>
    <match Class="PatchOperationAddModExtension"><xpath>Defs/FactionDef[defName="LP_FaerunHostile"]</xpath><value><li Class="LichPhylactery.LP_FactionIdeoExtension"><precepts><li>LP_Undead_Acceptable</li><li>LP_Arcane_Supreme</li><li>LP_Races_Own</li></precepts></li></value></match>
  </Operation>
  <!-- 余烬氏族 -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/FactionDef[defName="LP_EmberClan"]/forcedMemes</xpath>
    <match Class="PatchOperationAdd"><xpath>Defs/FactionDef[defName="LP_EmberClan"]/forcedMemes</xpath><value><li>LP_Meme_Surtr</li><li>LP_Meme_Ordning</li></value></match>
    <nomatch Class="PatchOperationConditional">
      <xpath>Defs/FactionDef[defName="LP_EmberClan"]</xpath>
      <match Class="PatchOperationAdd"><xpath>Defs/FactionDef[defName="LP_EmberClan"]</xpath><value><forcedMemes><li>LP_Meme_Surtr</li><li>LP_Meme_Ordning</li></forcedMemes></value></match>
    </nomatch>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/FactionDef[defName="LP_EmberClan"]</xpath>
    <match Class="PatchOperationAddModExtension"><xpath>Defs/FactionDef[defName="LP_EmberClan"]</xpath><value><li Class="LichPhylactery.LP_FactionIdeoExtension"><precepts><li>LP_Giants_Supreme</li><li>LP_Races_Own</li></precepts></li></value></match>
  </Operation>
  <!-- 幽暗殖巢 -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/FactionDef[defName="LP_IllithidColony"]/forcedMemes</xpath>
    <match Class="PatchOperationAdd"><xpath>Defs/FactionDef[defName="LP_IllithidColony"]/forcedMemes</xpath><value><li>LP_Meme_Ilsvi</li></value></match>
    <nomatch Class="PatchOperationConditional">
      <xpath>Defs/FactionDef[defName="LP_IllithidColony"]</xpath>
      <match Class="PatchOperationAdd"><xpath>Defs/FactionDef[defName="LP_IllithidColony"]</xpath><value><forcedMemes><li>LP_Meme_Ilsvi</li></forcedMemes></value></match>
    </nomatch>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/FactionDef[defName="LP_IllithidColony"]</xpath>
    <match Class="PatchOperationAddModExtension"><xpath>Defs/FactionDef[defName="LP_IllithidColony"]</xpath><value><li Class="LichPhylactery.LP_FactionIdeoExtension"><precepts><li>LP_BrainDevouring_Sacred</li><li>LP_Races_Own</li></precepts></li></value></match>
  </Operation>
  <!-- 猎巫狂热分子 -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/FactionDef[defName="LP_Zealots"]/forcedMemes</xpath>
    <match Class="PatchOperationAdd"><xpath>Defs/FactionDef[defName="LP_Zealots"]/forcedMemes</xpath><value><li>LP_Meme_Tyr</li></value></match>
    <nomatch Class="PatchOperationConditional">
      <xpath>Defs/FactionDef[defName="LP_Zealots"]</xpath>
      <match Class="PatchOperationAdd"><xpath>Defs/FactionDef[defName="LP_Zealots"]</xpath><value><forcedMemes><li>LP_Meme_Tyr</li></forcedMemes></value></match>
    </nomatch>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/FactionDef[defName="LP_Zealots"]</xpath>
    <match Class="PatchOperationAddModExtension"><xpath>Defs/FactionDef[defName="LP_Zealots"]</xpath><value><li Class="LichPhylactery.LP_FactionIdeoExtension"><precepts><li>LP_Arcane_Forbidden</li><li>LP_Undead_Abhorrent</li></precepts></li></value></match>
  </Operation>
  <!-- 拉洛克 -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/FactionDef[defName="LP_Larloch"]/forcedMemes</xpath>
    <match Class="PatchOperationAdd"><xpath>Defs/FactionDef[defName="LP_Larloch"]/forcedMemes</xpath><value><li>LP_Meme_Undeath</li><li>LP_Meme_Weave</li></value></match>
    <nomatch Class="PatchOperationConditional">
      <xpath>Defs/FactionDef[defName="LP_Larloch"]</xpath>
      <match Class="PatchOperationAdd"><xpath>Defs/FactionDef[defName="LP_Larloch"]</xpath><value><forcedMemes><li>LP_Meme_Undeath</li><li>LP_Meme_Weave</li></forcedMemes></value></match>
    </nomatch>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/FactionDef[defName="LP_Larloch"]</xpath>
    <match Class="PatchOperationAddModExtension"><xpath>Defs/FactionDef[defName="LP_Larloch"]</xpath><value><li Class="LichPhylactery.LP_FactionIdeoExtension"><precepts><li>LP_Undead_Sacred</li><li>LP_Apotheosis_Acceptable</li></precepts></li></value></match>
  </Operation>
  <!-- 凯兰沃教会：原来没有 forcedMemes，新建时要带一个结构模因（不然原版生成神名时 StructureMeme 为空会报错） -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/FactionDef[defName="LP_KelemvorChurch"]/forcedMemes</xpath>
    <match Class="PatchOperationAdd"><xpath>Defs/FactionDef[defName="LP_KelemvorChurch"]/forcedMemes</xpath><value><li>LP_Meme_Kelemvor</li></value></match>
    <nomatch Class="PatchOperationConditional">
      <xpath>Defs/FactionDef[defName="LP_KelemvorChurch"]</xpath>
      <match Class="PatchOperationAdd"><xpath>Defs/FactionDef[defName="LP_KelemvorChurch"]</xpath><value><forcedMemes><li>Structure_TheistAbstract</li><li>LP_Meme_Kelemvor</li></forcedMemes></value></match>
    </nomatch>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/FactionDef[defName="LP_KelemvorChurch"]</xpath>
    <match Class="PatchOperationAddModExtension"><xpath>Defs/FactionDef[defName="LP_KelemvorChurch"]</xpath><value><li Class="LichPhylactery.LP_FactionIdeoExtension"><precepts><li>LP_Undead_Abhorrent</li><li>LP_Apotheosis_Blasphemy</li></precepts></li></value></match>
  </Operation>
</Patch>
