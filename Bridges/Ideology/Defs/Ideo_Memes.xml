      <li><precept>LP_Funeral_GreyRobe</precept><pattern>LP_FuneralGreyRobe</pattern></li>
    </requiredRituals>
    <agreeableTraits>
      <LP_Devotee>4</LP_Devotee>
      <li>LP_Background_Acolyte</li>
    </agreeableTraits>
    <generalRules>
      <rulesStrings>
        <li>memeAdjective->灰袍</li>
        <li>memeAdjective->安息</li>
        <li>memeHyphenPrefix->冥</li>
        <li>memeConcept->安息</li>
        <li>memeConcept->审判</li>
        <li>memeLeaderNoun->守墓人</li>
        <li>memeLeaderAdjective->灰袍</li>
        <li>memeMoralist->送灵人</li>
