<?xml version="1.0" encoding="utf-8"?>
<!-- 1.56.0「文化之神」：DND 模因（ArtSource/Ideology-1.56.0-spec.md 第二节）。只在启用文化 DLC 时由 LoadFolders 加载（Bridges/Ideology）。
     神祇模因带 LichPhylactery.LP_IdeoDeityExtension；被动效果在 Source/IdeoPrecepts.cs。 -->
<Defs>

  <MemeDef Name="LP_MemeBase" Abstract="True">
    <groupDef>Misc</groupDef>
    <category>Normal</category>
    <impact>2</impact>
    <randomizationSelectionWeightFactor>1</randomizationSelectionWeightFactor>
  </MemeDef>

  <MemeDef Name="LP_DeityMemeBase" ParentName="LP_MemeBase" Abstract="True">
    <exclusionTags>
      <li>LP_DeityMeme</li>
    </exclusionTags>
  </MemeDef>

  <!-- ==================== 神祇模因 ==================== -->
  <MemeDef ParentName="LP_DeityMemeBase">
    <defName>LP_Meme_Lathander</defName>
    <label>晨主之光</label>
    <description>洛山达是黎明、新生与复苏之神。每一个早晨都是他的恩赐，每一具不死之躯都是对他的冒犯。文化的守护神固定为洛山达。\n\n被动：清晨5～8点全局工作速度+5%；殖民地每有一个死灵造物，信徒心情-1（最多-5）。</description>
    <iconPath>UI/Memes/LP/Lathander</iconPath>
    <requireOne>
      <li><li>LP_Undead_Abhorrent</li></li>
    </requireOne>
    <requiredRituals>
      <li><precept>LP_Festival_Lathander</precept><pattern>LP_FestivalPattern_Lathander</pattern></li>
    </requiredRituals>
    <agreeableTraits>
      <LP_Devotee>1</LP_Devotee>
      <li>LP_Background_FolkHero</li>
    </agreeableTraits>
    <disagreeableTraits>
      <LP_Devotee>8</LP_Devotee>
      <li>LP_Atheist</li>
    </disagreeableTraits>
    <generalRules>
      <rulesStrings>
        <li>memeAdjective->晨曦</li>
        <li>memeAdjective->黎明</li>
        <li>memeHyphenPrefix->晨</li>
        <li>memeConcept->黎明</li>
        <li>memeConcept->新生</li>
        <li>memeLeaderNoun->晨祭司</li>
        <li>memeLeaderAdjective->晨光</li>
        <li>memeMoralist->晨颂者</li>
      </rulesStrings>
    </generalRules>
    <modExtensions>
      <li Class="LichPhylactery.LP_IdeoDeityExtension">
        <deity>LP_Deity_Lathander</deity>
        <deityTitle>晨主</deityTitle>
        <gender>Male</gender>
        <festivalQuadrum>Aprimay</festivalQuadrum>
        <festivalDay>1</festivalDay>
        <festivalPrecept>LP_Festival_Lathander</festivalPrecept>
        <statue>LP_Statue_Lathander</statue>
      </li>
    </modExtensions>
  </MemeDef>

  <MemeDef ParentName="LP_DeityMemeBase">
    <defName>LP_Meme_Tyr</defName>
    <label>正义之秤</label>
    <description>提尔是蒙眼的正义之神，用一只断手托起天平。罪人必受审判，无辜者必得庇护。文化的守护神固定为提尔。\n\n被动：审判仪式和释放囚犯给提尔的神眷再×2。</description>
    <iconPath>UI/Memes/LP/Tyr</iconPath>
    <requireOne>
      <li>
        <li>Execution_RespectedIfGuilty</li>
        <li>Execution_HorribleIfInnocent</li>
      </li>
    </requireOne>
    <requiredRituals>
      <li><precept>LP_Festival_Tyr</precept><pattern>LP_FestivalPattern_Tyr</pattern></li>
    </requiredRituals>
    <agreeableTraits>
      <LP_Devotee>2</LP_Devotee>
      <li>LP_Background_Soldier</li>
      <li>LP_Background_Noble</li>
    </agreeableTraits>
    <disagreeableTraits>
      <li>LP_Background_Criminal</li>
      <LP_Devotee>7</LP_Devotee>
    </disagreeableTraits>
    <generalRules>
      <rulesStrings>
        <li>memeAdjective->公正</li>
        <li>memeAdjective->审判</li>
        <li>memeHyphenPrefix->秤</li>
        <li>memeConcept->正义</li>
        <li>memeConcept->律法</li>
        <li>memeLeaderNoun->大法官</li>
        <li>memeLeaderAdjective->公正</li>
        <li>memeMoralist->审判者</li>
      </rulesStrings>
    </generalRules>
    <modExtensions>
      <li Class="LichPhylactery.LP_IdeoDeityExtension">
        <deity>LP_Deity_Tyr</deity>
        <deityTitle>蒙眼的审判者</deityTitle>
        <gender>Male</gender>
        <festivalQuadrum>Jugust</festivalQuadrum>
        <festivalDay>8</festivalDay>
        <festivalPrecept>LP_Festival_Tyr</festivalPrecept>
        <statue>LP_Statue_Tyr</statue>
      </li>
    </modExtensions>
  </MemeDef>

  <MemeDef ParentName="LP_DeityMemeBase">
    <defName>LP_Meme_Mystra</defName>
    <label>魔网之女</label>
    <description>密斯特拉是魔法女神，魔网的守护者。每一道法术都从她的织网上取走一根丝线。文化的守护神固定为密斯特拉。\n\n被动：身上带着魔法物品的信徒心情+2（魔网的礼物）。</description>
    <iconPath>UI/Memes/LP/Mystra</iconPath>
    <requireOne>
      <li><li>LP_Arcane_Revered</li></li>
    </requireOne>
    <requiredRituals>
      <li><precept>LP_Festival_Mystra</precept><pattern>LP_FestivalPattern_Mystra</pattern></li>
    </requiredRituals>
    <agreeableTraits>
      <LP_Devotee>3</LP_Devotee>
      <li>LP_Background_Sage</li>
    </agreeableTraits>
    <disagreeableTraits>
      <LP_Devotee>8</LP_Devotee>
    </disagreeableTraits>
    <generalRules>
      <rulesStrings>
        <li>memeAdjective->魔网</li>
        <li>memeAdjective->星辉</li>
        <li>memeHyphenPrefix->网</li>
        <li>memeConcept->魔网</li>
        <li>memeConcept->奥秘</li>
        <li>memeLeaderNoun->织网者</li>
        <li>memeLeaderAdjective->星辉</li>
        <li>memeMoralist->守网人</li>
      </rulesStrings>
    </generalRules>
    <modExtensions>
      <li Class="LichPhylactery.LP_IdeoDeityExtension">
