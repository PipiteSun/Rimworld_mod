        <festivalDay>15</festivalDay>
        <festivalPrecept>LP_Festival_Mystra</festivalPrecept>
        <statue>LP_Statue_Mystra</statue>
      </li>
    </modExtensions>
  </MemeDef>

  <MemeDef ParentName="LP_DeityMemeBase">
    <defName>LP_Meme_Kelemvor</defName>
    <label>亡者之判</label>
    <description>凯兰沃是死亡之神，他公正地审判每一个亡魂。死亡不可怕，可怕的是拒绝死亡。文化的守护神固定为凯兰沃。\n\n被动：入葬给凯兰沃的神眷再×2；看到尸体不难受（必带的「尸体：不在乎」）。</description>
    <iconPath>UI/Memes/LP/Kelemvor</iconPath>
    <requireOne>
      <li><li>LP_Undead_Abhorrent</li></li>
      <li><li>Corpses_DontCare</li></li>
    </requireOne>
    <requiredRituals>
