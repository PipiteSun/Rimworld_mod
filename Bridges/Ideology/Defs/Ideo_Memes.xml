        <li>memeHyphenPrefix->巨</li>
        <li>memeConcept->位阶</li>
        <li>memeLeaderNoun->位阶之首</li>
        <li>memeLeaderAdjective->高大</li>
        <li>memeMoralist->位阶守护者</li>
      </rulesStrings>
    </generalRules>
  </MemeDef>

