        <festivalDay>1</festivalDay>
        <festivalPrecept>LP_Festival_Kelemvor</festivalPrecept>
        <statue>LP_Statue_Kelemvor</statue>
      </li>
    </modExtensions>
  </MemeDef>

  <MemeDef ParentName="LP_DeityMemeBase">
    <defName>LP_Meme_Malar</defName>
    <label>兽王之猎</label>
    <description>马拉尔是野兽与狩猎之神。强者猎杀，弱者成为猎物。文化的守护神固定为马拉尔。\n\n被动：殖民地每有一只驯服的狼、熊或冬狼，信徒心情+1（最多+3）。</description>
