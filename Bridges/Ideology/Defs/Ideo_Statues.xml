<!-- 1.56.0：神像与神殿（规格第七节）。只在装了文化 DLC 时加载：神像的作用都和文化有关。效果在 Source/IdeoTemple.cs。 -->
<Defs>

  <ThingDef Name="LP_StatueBase" ParentName="BuildingBase" Abstract="True">
    <thingClass>Building</thingClass>
    <category>Building</category>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>(2,2)</drawSize>
    </graphicData>
    <size>(2,2)</size>
    <rotatable>false</rotatable>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <fillPercent>0.5</fillPercent>
    <pathCost>50</pathCost>
    <castEdgeShadows>true</castEdgeShadows>
    <staticSunShadowHeight>0.35</staticSunShadowHeight>
    <useHitPoints>true</useHitPoints>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories><li>BuildingsArt</li></thingCategories>
    <stuffCategories>
      <li>Stony</li>
      <li>Metallic</li>
    </stuffCategories>
    <costStuffCount>150</costStuffCount>
    <costList><Gold>20</Gold></costList>
    <statBases>
      <WorkToBuild>20000</WorkToBuild>
      <MaxHitPoints>300</MaxHitPoints>
      <Mass>60</Mass>
      <Flammability>0</Flammability>
      <Beauty>60</Beauty>
    </statBases>
    <designationCategory>Misc</designationCategory>
    <constructionSkillPrerequisite>6</constructionSkillPrerequisite>
    <researchPrerequisites><li>LP_Research_Faith</li></researchPrerequisites>
    <building><artificialForMeditationPurposes>false</artificialForMeditationPurposes></building>
  </ThingDef>

  <ThingDef ParentName="LP_StatueBase">
    <defName>LP_Statue_Lathander</defName>
    <label>洛山达像</label>
    <description>高举太阳圆盘的晨主的石像。洛山达是守护神时放在任一家园地图，守护神每天神眷+0.3（不论几座只算一次）；文化的神有立像时信徒心情+1，没有时-1。和圣坛放在同一个房间就成了神殿：在神殿里祈祷神眷×1.25，庆典品质+10%。</description>
    <graphicData><texPath>Things/Building/LP/Statues/Lathander</texPath></graphicData>
    <uiOrder>2630</uiOrder>
    <modExtensions><li Class="LichPhylactery.LP_StatueExtension"><deity>LP_Deity_Lathander</deity></li></modExtensions>
  </ThingDef>

