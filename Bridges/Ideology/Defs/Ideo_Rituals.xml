        <curve><points><li>0, 0</li><li>50, 0.1</li><li>120, 0.2</li></points></curve>
      </li>
      <li Class="LichPhylactery.RitualOutcomeComp_LPFestival"><kind>cleric</kind><label>有神官主持</label><qualityOffset>0.15</qualityOffset></li>
