<!-- 1.56.0：9 场神祇庆典 + 灰袍葬礼（规格第五节）。结果 worker、品质 comp 和目标过滤在 Source/IdeoRituals.cs。
     日期由 Harmony 后缀 RitualObligationTrigger_Date.Init 固定成扩展里的 festivalQuadrum / festivalDay。 -->
<Defs>

  <RitualObligationTargetFilterDef>
    <defName>LP_Target_FaithAltar</defName>
    <workerClass>LichPhylactery.RitualObligationTargetWorker_FaithAltar</workerClass>
  </RitualObligationTargetFilterDef>

  <RitualOutcomeEffectDef Name="LP_FestivalOutcomeBase" Abstract="True">
    <description>根据仪式品质，参与者获得 {MINMOOD}～{MAXMOOD} 心情，持续 {MOODDAYS} 天；这位神的神眷：糟糕-3、平淡+2、不错+6、难忘+12。</description>
    <workerClass>LichPhylactery.RitualOutcomeEffectWorker_LPFestival</workerClass>
    <outcomeChances>
      <li><label>糟糕</label><chance>0.05</chance><memory>TerribleFestival</memory><description>{0}糟透了！大家熬着尴尬的寒暄等它结束。</description><positivityIndex>-2</positivityIndex></li>
      <li><label>平淡</label><chance>0.15</chance><memory>BoringFestival</memory><description>{0}很平淡。大家都放不开。</description><positivityIndex>-1</positivityIndex></li>
      <li><label>不错</label><chance>0.6</chance><memory>FunFestival</memory><description>{0}很不错。大家都很高兴有机会一起放松。</description><positivityIndex>1</positivityIndex></li>
      <li><label>难忘</label><chance>0.2</chance><memory>UnforgettableFestival</memory><description>{0}令人难忘！神明似乎也在注视着这场庆典。</description><positivityIndex>2</positivityIndex></li>
    </outcomeChances>
  </RitualOutcomeEffectDef>

