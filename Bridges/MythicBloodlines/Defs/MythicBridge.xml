<?xml version='1.0' encoding='utf-8'?>
<Defs>
  <!-- 1.21.0 神兽血裔联动：仅在启用神兽血裔时加载。种族一律按基因判断（血裔用 BloodlineAPI.GetBloodline）。 -->
  <ThoughtDef>
    <defName>LPMB_Relation_SuanniFireGiant</defName>
    <workerClass>LichPhylactery.MythicBridge.ThoughtWorker_MythicRelation</workerClass>
    <stages>
      <li>
        <label>匠心相通</label>
        <description>火巨人的熔炉手艺货真价实，和点化器物的心意相通。</description>
        <baseMoodEffect>2</baseMoodEffect>
      </li>
    </stages>
    <modExtensions>
      <li Class="LichPhylactery.MythicBridge.MythicRelation">
        <observer>Suanni</observer>
        <target>FireGiant</target>
      </li>
    </modExtensions>
  </ThoughtDef>
  <ThoughtDef>
    <defName>LPMB_Relation_FireGiantSuanni</defName>
    <workerClass>LichPhylactery.MythicBridge.ThoughtWorker_MythicRelation</workerClass>
    <stages>
      <li>
        <label>识货的狻猊</label>
        <description>那个狻猊一眼就看得出锻件的好坏，是个识货的人。</description>
        <baseMoodEffect>2</baseMoodEffect>
      </li>
    </stages>
    <modExtensions>
      <li Class="LichPhylactery.MythicBridge.MythicRelation">
        <observer>FireGiant</observer>
        <target>Suanni</target>
      </li>
    </modExtensions>
  </ThoughtDef>
  <ThoughtDef>
    <defName>LPMB_Relation_SuanniForceDragon</defName>
    <workerClass>LichPhylactery.MythicBridge.ThoughtWorker_MythicRelation</workerClass>
    <stages>
      <li>
        <label>宝物知音</label>
        <description>力能龙裔也爱好东西，和它聊宝贝聊得来。</description>
        <baseMoodEffect>2</baseMoodEffect>
      </li>
    </stages>
    <modExtensions>
      <li Class="LichPhylactery.MythicBridge.MythicRelation">
        <observer>Suanni</observer>
        <target>ForceDragon</target>
      </li>
    </modExtensions>
  </ThoughtDef>
  <ThoughtDef>
    <defName>LPMB_Relation_ForceDragonSuanni</defName>
    <workerClass>LichPhylactery.MythicBridge.ThoughtWorker_MythicRelation</workerClass>
    <stages>
      <li>
        <label>点化宝物的狻猊</label>
        <description>狻猊能让宝物更上一层，龙的宝库就缺这样的人。</description>
        <baseMoodEffect>3</baseMoodEffect>
      </li>
    </stages>
    <modExtensions>
      <li Class="LichPhylactery.MythicBridge.MythicRelation">
        <observer>ForceDragon</observer>
        <target>Suanni</target>
      </li>
    </modExtensions>
  </ThoughtDef>
  <ThoughtDef>
    <defName>LPMB_Relation_JumangElf</defName>
    <workerClass>LichPhylactery.MythicBridge.ThoughtWorker_MythicRelation</workerClass>
    <stages>
      <li>
        <label>林木之友</label>
        <description>精灵懂得照料草木，和春生之力一脉相承。</description>
        <baseMoodEffect>2</baseMoodEffect>
      </li>
    </stages>
    <modExtensions>
      <li Class="LichPhylactery.MythicBridge.MythicRelation">
        <observer>Jumang</observer>
        <target>Elf</target>
      </li>
    </modExtensions>
  </ThoughtDef>
  <ThoughtDef>
    <defName>LPMB_Relation_ElfJumang</defName>
    <workerClass>LichPhylactery.MythicBridge.ThoughtWorker_MythicRelation</workerClass>
    <stages>
      <li>
        <label>春神后裔</label>
        <description>句芒一来，连树林都更有生气了。</description>
        <baseMoodEffect>2</baseMoodEffect>
      </li>
    </stages>
    <modExtensions>
      <li Class="LichPhylactery.MythicBridge.MythicRelation">
        <observer>Elf</observer>
        <target>Jumang</target>
      </li>
    </modExtensions>
  </ThoughtDef>
  <ThoughtDef>
    <defName>LPMB_Relation_JumangFireGiant</defName>
    <workerClass>LichPhylactery.MythicBridge.ThoughtWorker_MythicRelation</workerClass>
    <stages>
      <li>
        <label>焚林之火</label>
        <description>火巨人走到哪里都带着烟火气，让草木不得安宁。</description>
        <baseMoodEffect>-2</baseMoodEffect>
      </li>
    </stages>
    <modExtensions>
      <li Class="LichPhylactery.MythicBridge.MythicRelation">
        <observer>Jumang</observer>
        <target>FireGiant</target>
      </li>
    </modExtensions>
  </ThoughtDef>
  <ThoughtDef>
    <defName>LPMB_Relation_FireGiantJumang</defName>
    <workerClass>LichPhylactery.MythicBridge.ThoughtWorker_MythicRelation</workerClass>
    <stages>
      <li>
        <label>多事的木灵</label>
        <description>句芒总嫌锻炉烧了树，真是多管闲事。</description>
        <baseMoodEffect>-2</baseMoodEffect>
      </li>
    </stages>
    <modExtensions>
      <li Class="LichPhylactery.MythicBridge.MythicRelation">
        <observer>FireGiant</observer>
        <target>Jumang</target>
      </li>
    </modExtensions>
  </ThoughtDef>
  <ThoughtDef>
    <defName>LPMB_Relation_BaizeMindFlayer</defName>
    <workerClass>LichPhylactery.MythicBridge.ThoughtWorker_MythicRelation</workerClass>
    <stages>
      <li>
        <label>不可名状之物</label>
        <description>白泽通晓万物之形，却看不透那团触须后的心智，令人不寒而栗。</description>
        <baseMoodEffect>-3</baseMoodEffect>
      </li>
    </stages>
    <modExtensions>
      <li Class="LichPhylactery.MythicBridge.MythicRelation">
        <observer>Baize</observer>
        <target>MindFlayer</target>
      </li>
    </modExtensions>
  </ThoughtDef>
  <ThoughtDef>
    <defName>LPMB_Relation_MindFlayerBaize</defName>
    <workerClass>LichPhylactery.MythicBridge.ThoughtWorker_MythicRelation</workerClass>
    <stages>
      <li>
        <label>看穿心智者</label>
        <description>那个白泽的目光像要剖开我的心智。</description>
        <baseMoodEffect>-3</baseMoodEffect>
      </li>
    </stages>
    <modExtensions>
      <li Class="LichPhylactery.MythicBridge.MythicRelation">
        <observer>MindFlayer</observer>
        <target>Baize</target>
      </li>
    </modExtensions>
  </ThoughtDef>
  <ThoughtDef>
    <defName>LPMB_Relation_BaizeLich</defName>
    <workerClass>LichPhylactery.MythicBridge.ThoughtWorker_MythicRelation</workerClass>
    <stages>
      <li>
        <label>逆命而行</label>
        <description>巫妖以命匣逃避天命，白泽看了心里不舒服。</description>
        <baseMoodEffect>-2</baseMoodEffect>
      </li>
    </stages>
    <modExtensions>
      <li Class="LichPhylactery.MythicBridge.MythicRelation">
        <observer>Baize</observer>
        <target>Lich</target>
      </li>
    </modExtensions>
  </ThoughtDef>
  <ThoughtDef>
    <defName>LPMB_Relation_LichBaize</defName>
    <workerClass>LichPhylactery.MythicBridge.ThoughtWorker_MythicRelation</workerClass>
    <stages>
      <li>
        <label>知命者的审视</label>
        <description>白泽总在打量我的命数，令人厌烦。</description>
        <baseMoodEffect>-2</baseMoodEffect>
      </li>
    </stages>
    <modExtensions>
      <li Class="LichPhylactery.MythicBridge.MythicRelation">
        <observer>Lich</observer>
        <target>Baize</target>
      </li>
    </modExtensions>
  </ThoughtDef>
  <ThoughtDef>
    <defName>LPMB_Relation_TaotieTroll</defName>
    <workerClass>LichPhylactery.MythicBridge.ThoughtWorker_MythicRelation</workerClass>
    <stages>
      <li>
        <label>吃得来的同伴</label>
        <description>巨魔和我一样胃口无底，一起吃饭才痛快。</description>
        <baseMoodEffect>2</baseMoodEffect>
      </li>
    </stages>
    <modExtensions>
      <li Class="LichPhylactery.MythicBridge.MythicRelation">
        <observer>Taotie</observer>
        <target>Troll</target>
      </li>
    </modExtensions>
  </ThoughtDef>
  <ThoughtDef>
    <defName>LPMB_Relation_TrollTaotie</defName>
    <workerClass>LichPhylactery.MythicBridge.ThoughtWorker_MythicRelation</workerClass>
    <stages>
      <li>
        <label>好胃口的饕餮</label>
        <description>饕餮吃得比我还多，终于不用被嫌弃食量了。</description>
        <baseMoodEffect>2</baseMoodEffect>
      </li>
    </stages>
    <modExtensions>
      <li Class="LichPhylactery.MythicBridge.MythicRelation">
        <observer>Troll</observer>
        <target>Taotie</target>
      </li>
    </modExtensions>
  </ThoughtDef>
  <ThoughtDef>
    <defName>LPMB_Relation_TaotieDwarf</defName>
    <workerClass>LichPhylactery.MythicBridge.ThoughtWorker_MythicRelation</workerClass>
    <stages>
      <li>
        <label>护食的矮人</label>
        <description>矮人把酒和肉藏得紧紧的，一口都不肯分。</description>
        <baseMoodEffect>-1</baseMoodEffect>
      </li>
    </stages>
    <modExtensions>
      <li Class="LichPhylactery.MythicBridge.MythicRelation">
        <observer>Taotie</observer>
        <target>Dwarf</target>
      </li>
    </modExtensions>
  </ThoughtDef>
  <ThoughtDef>
    <defName>LPMB_Relation_DwarfTaotie</defName>
    <workerClass>LichPhylactery.MythicBridge.ThoughtWorker_MythicRelation</workerClass>
    <stages>
      <li>
        <label>偷吃的饕餮</label>
        <description>那个饕餮总盯着我的酒桶和腌肉。</description>
        <baseMoodEffect>-1</baseMoodEffect>
      </li>
    </stages>
    <modExtensions>
      <li Class="LichPhylactery.MythicBridge.MythicRelation">
        <observer>Dwarf</observer>
        <target>Taotie</target>
      </li>
    </modExtensions>
  </ThoughtDef>
  <HediffDef>
    <defName>LPMB_TrollBloodRegen</defName>
    <label>巨魔血余力</label>
    <description>饕餮饮下巨魔血后获得的微弱再生：以巨魔四分之一的速度愈合伤口、恢复失血。不会长回肢体，也不会复活；身上着火时暂停。持续12小时，再次饮用只刷新时间。</description>
    <hediffClass>LichPhylactery.MythicBridge.Hediff_LesserTrollRegen</hediffClass>
    <defaultLabelColor>(0.55, 0.85, 0.45)</defaultLabelColor>
    <isBad>false</isBad>
    <scenarioCanAdd>false</scenarioCanAdd>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>30000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
  </HediffDef>
  <HediffDef>
    <defName>LPMB_FireGiantFlesh</defName>
    <label>火巨人之肉</label>
    <description>饕餮吞下火巨人的血肉，暂时沾上了一丝熔火之力：受到的火焰伤害减半。持续24小时，再次食用只刷新时间。</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.95, 0.55, 0.3)</defaultLabelColor>
    <isBad>false</isBad>
    <scenarioCanAdd>false</scenarioCanAdd>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>60000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <modExtensions>
      <li Class="LichPhylactery.MythicBridge.DamageFactorExtension">
        <factor>0.5</factor>
        <damageDefs>
          <li>Flame</li>
          <li>Burn</li>
        </damageDefs>
        <keywords>
          <li>Flame</li>
          <li>Incendiary</li>
        </keywords>
        <excludedKeywords>
          <li>Acid</li>
        </excludedKeywords>
      </li>
    </modExtensions>
  </HediffDef>
  <HediffDef>
    <defName>LPMB_DragonFlesh</defName>
    <label>力能龙之肉</label>
    <description>饕餮吞下力能龙裔的血肉，体内残留着力场的余韵：受到的力场伤害减半。持续24小时，再次食用只刷新时间。</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.55, 0.7, 1)</defaultLabelColor>
    <isBad>false</isBad>
    <scenarioCanAdd>false</scenarioCanAdd>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>60000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <modExtensions>
      <li Class="LichPhylactery.MythicBridge.DamageFactorExtension">
        <factor>0.5</factor>
        <damageDefs>
          <li>LP_Force</li>
        </damageDefs>
        <keywords>
          <li>Force</li>
        </keywords>
      </li>
    </modExtensions>
  </HediffDef>
</Defs>
