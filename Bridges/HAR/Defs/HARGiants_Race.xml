  <!-- 塞伊远征军：不进 XML 的兵种表，由 EttinRaid 在 ≥800 点的战斗袭击里以 10% 加入一名（顶掉 2 名普通随从），发独眼巨锤或棍棒、双盔。 -->
  <PawnKindDef ParentName="LP_FHBase">
    <defName>LP_FH_EttinBrute</defName>
    <label>双头蛮兵</label>
    <race>LP_Ettin</race>
    <combatPower>160</combatPower>
    <xenotypeSet>
      <xenotypeChances>
        <LP_EttinKin>1</LP_EttinKin>
      </xenotypeChances>
    </xenotypeSet>
    <minGenerationAge>22</minGenerationAge>
    <apparelMoney>100~300</apparelMoney>
    <apparelTags Inherit="False">
      <li>Neolithic</li>
    </apparelTags>
    <weaponMoney>0</weaponMoney>
    <skills>
      <li>
        <skill>Melee</skill>
        <range>6~12</range>
      </li>
    </skills>
    <initialResistanceRange>18~28</initialResistanceRange>
  </PawnKindDef>
  <!-- 巨人迁徙：流浪的双头巨人；独眼巨人牧人（带绵羊）；同盟商队的独眼巨人护卫（CyclopsGuard 按 10% 插入）。不进同盟的袭击和据点组。 -->
  <PawnKindDef ParentName="LP_FCBase">
    <defName>LP_FC_EttinWanderer</defName>
    <label>流浪的双头巨人</label>
    <race>LP_Ettin</race>
    <combatPower>150</combatPower>
    <useFactionXenotypes>false</useFactionXenotypes>
    <xenotypeSet>
      <xenotypeChances>
        <LP_EttinKin>1</LP_EttinKin>
      </xenotypeChances>
    </xenotypeSet>
    <minGenerationAge>22</minGenerationAge>
    <apparelMoney>100~300</apparelMoney>
    <apparelTags Inherit="False">
      <li>Neolithic</li>
    </apparelTags>
    <weaponMoney>100~250</weaponMoney>
    <weaponTags>
      <li>NeolithicMeleeBasic</li>
      <li>NeolithicMeleeDecent</li>
    </weaponTags>
    <initialResistanceRange>18~28</initialResistanceRange>
  </PawnKindDef>
  <PawnKindDef ParentName="LP_FCBase">
    <defName>LP_FC_CyclopsShepherd</defName>
    <label>独眼巨人牧人</label>
    <race>LP_Cyclops</race>
    <combatPower>130</combatPower>
    <useFactionXenotypes>false</useFactionXenotypes>
    <xenotypeSet>
