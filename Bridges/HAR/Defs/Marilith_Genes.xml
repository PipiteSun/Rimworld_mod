<?xml version="1.0" encoding="utf-8"?>
<!-- 1.33.0 六臂蛇人的异种型与基因（只在启用 HAR 时加载）。HAR 种族只生成这个异种型；基因可在基因工作台提取、植入。
     代谢合计 -4：六臂连击 -2、蛇行 -1、缠绕 -1、剑刃风暴 -1、深渊之躯 -1、冷血 +2。规则代码见 Source/Marilith.cs。 -->
<Defs>

  <XenotypeDef>
    <defName>LP_MarilithKin</defName>
    <label>六臂蛇人</label>
    <description>六臂蛇人的血脉：六条手臂同时挥刀，蛇尾在泥沼浅水里滑行、缠住敌人；身躯能扛住深渊的火与寒，却怕冷。血脉会遗传给子女。</description>
    <descriptionShort>可遗传的蛇身种族。背包里的近战武器当副手连击，剑刃风暴、缠绕；泥沼浅水走得快，抗火抗寒抗毒，怕冷。</descriptionShort>
    <iconPath>Marilith/Xenotype</iconPath>
    <inheritable>true</inheritable>
    <combatPowerFactor>1.4</combatPowerFactor>
    <factionlessGenerationWeight>0</factionlessGenerationWeight>
    <genes>
      <li>LP_MarilithBlades</li>
      <li>LP_SerpentGlide</li>
      <li>LP_SerpentConstrict</li>
      <li>LP_BladeStorm</li>
      <li>LP_AbyssalHide</li>
      <li>LP_ColdBlood</li>
    </genes>
  </XenotypeDef>

  <GeneDef Name="LP_MarilithGeneBase" Abstract="True">
    <displayCategory>Miscellaneous</displayCategory>
    <selectionWeight>0</selectionWeight>
    <biostatCpx>2</biostatCpx>
  </GeneDef>

  <GeneDef ParentName="LP_MarilithGeneBase">
    <defName>LP_MarilithBlades</defName>
    <label>六臂连击</label>
    <description>需要多于两条手臂。背包里的近战武器会被额外的手臂拿来当副手：每对能用的额外手臂拿一把（最多两把，挑最好的）。主手拿近战武器或空手时，每次普通近战命中后，每把副手各追加一击（伤害按模组设置，默认50%）。装在只有两条手臂的人身上没有效果。</description>
    <iconPath>Marilith/Genes/Blades</iconPath>
    <displayCategory>Violence</displayCategory>
    <biostatCpx>3</biostatCpx>
    <biostatMet>-2</biostatMet>
    <customEffectDescriptions>
      <li>需要多于两条手臂（人类身上无效）。</li>
      <li>副手：背包里品质×DPS最高的近战武器，数量 = 能用的额外手臂对数（最多2）。</li>
      <li>普通近战命中后，每把副手各追加一击；主手拿远程武器时不触发，技能命中不触发。</li>
    </customEffectDescriptions>
    <modExtensions>
      <li Class="LichPhylactery.OffhandExtension">
        <max>2</max>
        <perExtraArmPair>true</perExtraArmPair>
      </li>
    </modExtensions>
  </GeneDef>

  <GeneDef ParentName="LP_MarilithGeneBase">
    <defName>LP_SerpentGlide</defName>
    <label>蛇行</label>
    <description>蛇尾贴着地面滑行，泥地、沼泽和浅水拖不住它：在这些地形上的移动消耗减半。</description>
    <iconPath>Marilith/Genes/Glide</iconPath>
    <displayCategory>Movement</displayCategory>
    <biostatMet>-1</biostatMet>
    <customEffectDescriptions>
      <li>泥地、沼泽、浅水的地形移动消耗减半（不影响寻路的绕行判断）。</li>
    </customEffectDescriptions>
  </GeneDef>

  <GeneDef ParentName="LP_MarilithGeneBase">
    <defName>LP_SerpentConstrict</defName>
    <label>缠绕</label>
    <description>用蛇尾（或长臂）缠住贴身的敌人：对方3秒内动弹不得，每秒受到6点钝伤（按双方体型比修正，×0.5～×2）；缠绕期间自己也不能移动。冷却12小时。</description>
    <iconPath>Marilith/Genes/Constrict</iconPath>
    <displayCategory>Violence</displayCategory>
    <biostatMet>-1</biostatMet>
    <abilities>
      <li>LP_SerpentConstrictAbility</li>
    </abilities>
    <descriptionHyperlinks>
      <AbilityDef>LP_SerpentConstrictAbility</AbilityDef>
    </descriptionHyperlinks>
  </GeneDef>

  <GeneDef ParentName="LP_MarilithGeneBase">
    <defName>LP_BladeStorm</defName>
    <label>剑刃风暴</label>
    <description>所有手臂一起挥舞：对身边1格内的每个敌人，主手和每把能用的副手各攻击一次。冷却2天。副手要有额外的手臂才能用；只有两条手臂时只有主手那一击。</description>
    <iconPath>Marilith/Genes/BladeStorm</iconPath>
    <displayCategory>Violence</displayCategory>
    <biostatMet>-1</biostatMet>
    <abilities>
      <li>LP_BladeStormAbility</li>
    </abilities>
    <descriptionHyperlinks>
      <AbilityDef>LP_BladeStormAbility</AbilityDef>
    </descriptionHyperlinks>
  </GeneDef>

  <GeneDef ParentName="LP_MarilithGeneBase">
    <defName>LP_AbyssalHide</defName>
    <label>深渊之躯</label>
    <description>在深渊的火海与冰窟里长成的鳞甲：受到的火焰、烧伤、冻伤和电击伤害×75%，毒素抗性+50%。</description>
    <iconPath>Marilith/Genes/AbyssalHide</iconPath>
    <displayCategory>ResistanceAndWeakness</displayCategory>
    <biostatMet>-1</biostatMet>
    <damageFactors>
      <Flame>0.75</Flame>
      <Burn>0.75</Burn>
      <Frostbite>0.75</Frostbite>
      <ElectricalBurn>0.75</ElectricalBurn>
    </damageFactors>
    <statOffsets>
      <ToxicResistance>0.5</ToxicResistance>
    </statOffsets>
  </GeneDef>

  <GeneDef ParentName="LP_MarilithGeneBase">
    <defName>LP_ColdBlood</defName>
    <label>冷血</label>
    <description>冷血的身体跟着天气变：环境温度低于0℃时移动速度×85%。</description>
    <iconPath>Marilith/Genes/ColdBlood</iconPath>
    <displayCategory>ResistanceAndWeakness</displayCategory>
    <biostatCpx>1</biostatCpx>
    <biostatMet>2</biostatMet>
    <customEffectDescriptions>
      <li>环境温度低于0℃时移动速度×85%。</li>
    </customEffectDescriptions>
  </GeneDef>

  <!-- 鳞色：蛇人生成时随机一种作为内源基因（青绿40%、墨绿35%、赤金25%），遗传时随父母。 -->
  <GeneDef ParentName="GeneSkinColorOverride">
    <defName>LP_SkinSerpentTeal</defName>
    <label>青绿鳞</label>
    <labelShortAdj>青绿</labelShortAdj>
    <description>六臂蛇人青绿色的鳞皮。</description>
    <skinColorOverride>(92, 138, 120)</skinColorOverride>
    <randomBrightnessFactor>0.06</randomBrightnessFactor>
    <selectionWeight>0</selectionWeight>
    <displayOrderInCategory>1</displayOrderInCategory>
  </GeneDef>
  <GeneDef ParentName="GeneSkinColorOverride">
    <defName>LP_SkinSerpentDark</defName>
    <label>墨绿鳞</label>
    <labelShortAdj>墨绿</labelShortAdj>
    <description>六臂蛇人深墨绿色的鳞皮。</description>
    <skinColorOverride>(70, 98, 78)</skinColorOverride>
    <randomBrightnessFactor>0.06</randomBrightnessFactor>
    <selectionWeight>0</selectionWeight>
    <displayOrderInCategory>1</displayOrderInCategory>
  </GeneDef>
  <GeneDef ParentName="GeneSkinColorOverride">
    <defName>LP_SkinSerpentGold</defName>
    <label>赤金鳞</label>
    <labelShortAdj>赤金</labelShortAdj>
    <description>六臂蛇人带金属光泽的赤金色鳞皮。</description>
    <skinColorOverride>(178, 120, 74)</skinColorOverride>
    <randomBrightnessFactor>0.06</randomBrightnessFactor>
    <selectionWeight>0</selectionWeight>
    <displayOrderInCategory>1</displayOrderInCategory>
  </GeneDef>

  <!-- ==================== 状态 ==================== -->
  <HediffDef>
    <defName>LP_SixArms</defName>
    <label>六臂</label>
    <description>六条手臂一起干活，操作额外提高。每只能用的额外手（中、下两对）操作+10%，四只都在时+40%；额外的手臂断了，加成跟着降。</description>
    <hediffClass>LichPhylactery.Hediff_SixArms</hediffClass>
    <defaultLabelColor>(0.6, 0.85, 0.7)</defaultLabelColor>
    <isBad>false</isBad>
    <everCurableByItem>false</everCurableByItem>
    <keepOnBodyPartRestoration>true</keepOnBodyPartRestoration>
  </HediffDef>
  <HediffDef>
    <defName>LP_Constricted</defName>
    <label>被缠住</label>
    <description>被蛇尾死死缠住，动弹不得，每秒都在受挤压。</description>
    <hediffClass>LichPhylactery.Hediff_Constricted</hediffClass>
    <defaultLabelColor>(0.9, 0.5, 0.4)</defaultLabelColor>
    <isBad>true</isBad>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>180</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
  </HediffDef>
  <HediffDef>
    <defName>LP_Constricting</defName>
    <label>缠绕中</label>
    <description>正用蛇尾缠着敌人，暂时不能移动。</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.6, 0.85, 0.6)</defaultLabelColor>
    <isBad>false</isBad>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>180</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
  </HediffDef>

  <!-- ==================== 能力 ==================== -->
  <AbilityDef>
    <defName>LP_SerpentConstrictAbility</defName>
    <label>缠绕</label>
    <description>缠住一名贴身的敌人3秒：对方无法行动，每秒受到6点钝伤（按体型比×0.5～×2）；期间自己不能移动。冷却12小时。</description>
    <iconPath>Marilith/Abilities/Constrict</iconPath>
    <cooldownTicksRange>30000</cooldownTicksRange>
    <hostile>true</hostile>
    <aiCanUse>false</aiCanUse>
    <casterMustBeCapableOfViolence>true</casterMustBeCapableOfViolence>
    <displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
    <disableGizmoWhileUndrafted>false</disableGizmoWhileUndrafted>
    <sendMessageOnCooldownComplete>false</sendMessageOnCooldownComplete>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <range>1.9</range>
      <warmupTime>0.3</warmupTime>
      <violent>true</violent>
      <targetParams>
        <canTargetPawns>true</canTargetPawns>
        <canTargetBuildings>false</canTargetBuildings>
        <canTargetLocations>false</canTargetLocations>
        <canTargetSelf>false</canTargetSelf>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="LichPhylactery.CompProperties_SerpentConstrict">
        <ticks>180</ticks>
        <damagePerSecond>6</damagePerSecond>
      </li>
    </comps>
  </AbilityDef>
  <AbilityDef>
    <defName>LP_BladeStormAbility</defName>
    <label>剑刃风暴</label>
    <description>对身边1格内的每个敌人，主手与每把能用的副手各攻击一次（必中，按真实近战伤害结算；副手伤害按设置倍率）。冷却2天。</description>
    <iconPath>Marilith/Abilities/BladeStorm</iconPath>
    <cooldownTicksRange>120000</cooldownTicksRange>
    <hostile>true</hostile>
    <aiCanUse>false</aiCanUse>
    <targetRequired>false</targetRequired>
    <casterMustBeCapableOfViolence>true</casterMustBeCapableOfViolence>
    <displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
    <disableGizmoWhileUndrafted>false</disableGizmoWhileUndrafted>
    <sendMessageOnCooldownComplete>false</sendMessageOnCooldownComplete>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <range>0</range>
      <warmupTime>0.4</warmupTime>
      <violent>true</violent>
      <targetParams>
        <canTargetSelf>true</canTargetSelf>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="LichPhylactery.CompProperties_BladeStorm" />
    </comps>
  </AbilityDef>

</Defs>
