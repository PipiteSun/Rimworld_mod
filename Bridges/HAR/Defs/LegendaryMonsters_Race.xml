<!-- 1.52.1 传奇怪的 HAR 种族：贝希尔（蛇形十二足）、眼魔（漂浮球体 + 主眼 + 10 根眼柄）、半巫妖（漂浮头骨）。只在启用 HAR 时加载。
     写法同 1.52.0 五色龙：ParentName="Human"、列表 Inherit="False"、身体贴图是整只怪（按本色画好）、头型贴图透明、skinShader Cutout；
     体型 / 生命 / 护甲在各自唯一的生命阶段里，画面大小由主程序集的根节点补丁按 LP_MonsterExtension.renderScale 放大。规则代码在 Source/LegendaryMonsters.cs。
     “漂浮囊”（LP_FloatSac）是给眼魔和半巫妖的移动能力来源（人形的移动能力要靠带 MovingLimbCore 标签的部位）。 -->
<Defs>

  <!-- ==================== 部位 ==================== -->
  <BodyPartDef>
    <defName>LP_BeholderMainEye</defName>
    <label>主眼</label>
    <hitPoints>25</hitPoints>
    <skinCovered>false</skinCovered>
    <solid>false</solid>
    <bleedRate>1</bleedRate>
    <tags><li>SightSource</li></tags>
  </BodyPartDef>
  <BodyPartDef>
    <defName>LP_BeholderStalk</defName>
    <label>眼柄</label>
    <hitPoints>14</hitPoints>
    <skinCovered>true</skinCovered>
    <solid>false</solid>
    <bleedRate>1</bleedRate>
    <frostbiteVulnerability>0.5</frostbiteVulnerability><!-- 1.63.0：同上 -->
  </BodyPartDef>
  <BodyPartDef>
    <defName>LP_FloatSac</defName>
    <label>漂浮囊</label>
    <hitPoints>30</hitPoints>
    <skinCovered>false</skinCovered>
    <solid>false</solid>
    <bleedRate>1</bleedRate>
    <tags><li>MovingLimbCore</li></tags>
    <frostbiteVulnerability>0.1</frostbiteVulnerability><!-- 1.63.0：原版要求身体至少有一处会冻伤（开发者模式配置检查）；半巫妖身上只有这一个自定义部位 -->
  </BodyPartDef>

