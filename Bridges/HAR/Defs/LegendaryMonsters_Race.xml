  <AlienRace.ThingDef_AlienRace ParentName="LP_LegendaryMonsterBase">
    <defName>LP_Behir</defName>
    <label>贝希尔</label>
    <description>蓝色鳞片、十二条腿的巨大蛇形怪物，住在高山和沙漠的洞穴里。它是真龙的死敌：闻到龙的气味就会追上去，喷出一道闪电，把敌人整个吞下。</description>
    <statBases><MoveSpeed>5.0</MoveSpeed></statBases>
    <race>
      <body>LP_BehirBody</body>
      <lifeStageAges Inherit="False"><li><def>LP_BehirStage</def><minAge>0</minAge></li></lifeStageAges>
    </race>
    <tools Inherit="False">
      <li><label>咬</label><capacities><li>Bite</li></capacities><power>30</power><cooldownTime>2.0</cooldownTime><armorPenetration>0.4</armorPenetration><linkedBodyPartsGroup>Teeth</linkedBodyPartsGroup></li>
      <li><label>左前爪</label><capacities><li>Scratch</li></capacities><power>14</power><cooldownTime>1.4</cooldownTime><armorPenetration>0.25</armorPenetration><linkedBodyPartsGroup>FrontLeftPaw</linkedBodyPartsGroup></li>
      <li><label>右前爪</label><capacities><li>Scratch</li></capacities><power>14</power><cooldownTime>1.4</cooldownTime><armorPenetration>0.25</armorPenetration><linkedBodyPartsGroup>FrontRightPaw</linkedBodyPartsGroup></li>
      <li><label>尾巴</label><capacities><li>Blunt</li></capacities><power>20</power><cooldownTime>2.2</cooldownTime><armorPenetration>0.2</armorPenetration><linkedBodyPartsGroup>LP_DragonTail</linkedBodyPartsGroup></li>
    </tools>
    <alienRace>
      <generalSettings>
        <humanRecipeImport>false</humanRecipeImport><allowHumanBios>false</allowHumanBios><corpseCategory>CorpsesHumanlike</corpseCategory>
        <alienPartGenerator>
          <headTypes Inherit="False"><li>LP_MonsterHead_LP_Behir</li></headTypes>
          <bodyTypes Inherit="False"><li>Hulk</li></bodyTypes>
          <colorChannels Inherit="False"><li><name>skin</name><first Class="ColorGenerator_Single"><color>(1,1,1,1)</color></first></li></colorChannels>
          <bodyAddons Inherit="False" />
        </alienPartGenerator>
      </generalSettings>
      <graphicPaths><body>LegendaryMonsters/Behir/</body><head><path>LegendaryMonsters/Heads/</path></head><skinShader>Cutout</skinShader></graphicPaths>
      <raceRestriction><onlyUseRaceRestrictedApparel>true</onlyUseRaceRestrictedApparel><onlyUseRaceRestrictedWeapons>true</onlyUseRaceRestrictedWeapons></raceRestriction>
    </alienRace>
  </AlienRace.ThingDef_AlienRace>

