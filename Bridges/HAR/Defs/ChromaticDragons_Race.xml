  <AlienRace.ThingDef_AlienRace ParentName="LP_ChromaticDragonBase">
    <defName>LP_RedDragon</defName>
    <label>红龙</label>
    <description>最强大也最贪婪的五色龙。红龙住在火山和高山里，睡在金山上，喷吐烈焰。它们傲慢、残忍，认为世上一切财宝本来就该属于自己。

真龙有智慧，会说话，活上千年。它们有传奇抗性、传奇动作和骇人威仪，倒下就会死去，不会投降。</description>
    <modExtensions Inherit="True">
      <li Class="LichPhylactery.LP_DragonExtension"><color>Red</color></li>
    </modExtensions>
    <alienRace>
      <generalSettings>
        <humanRecipeImport>false</humanRecipeImport>
        <allowHumanBios>false</allowHumanBios>
        <corpseCategory>CorpsesHumanlike</corpseCategory>
        <alienPartGenerator>
          <headTypes Inherit="False"><li>LP_DragonHead_Red</li></headTypes>
          <bodyTypes Inherit="False"><li>Hulk</li></bodyTypes>
          <colorChannels Inherit="False"><li><name>skin</name><first Class="ColorGenerator_Single"><color>(1,1,1,1)</color></first></li></colorChannels>
          <bodyAddons Inherit="False" />
        </alienPartGenerator>
      </generalSettings>
      <graphicPaths>
        <body>ChromaticDragons/Red/</body>
        <head><path>ChromaticDragons/Heads/</path></head>
        <skinShader>Cutout</skinShader>
      </graphicPaths>
      <raceRestriction>
        <onlyUseRaceRestrictedApparel>true</onlyUseRaceRestrictedApparel>
        <onlyUseRaceRestrictedWeapons>true</onlyUseRaceRestrictedWeapons>
      </raceRestriction>
    </alienRace>
  </AlienRace.ThingDef_AlienRace>
