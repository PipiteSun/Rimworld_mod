  <VEF.Abilities.AbilityDef ParentName="VPE_PsycastBase">
    <defName>LP_SacredFlame</defName>
    <label>神圣打击</label>
    <description>20 格内的一个敌人受 20 × 神恩强度点神圣伤害，无视掩体；对亡灵、邪魔和夺心魔翻倍。需要社交 12 级。</description>
    <iconPath>LP/Classes/Cleric/SacredFlame</iconPath>
    <abilityClass>LichPhylactery.VPEBridge.Ability_SacredFlame</abilityClass>
    <targetMode>Pawn</targetMode>
    <targetingParameters><canTargetPawns>true</canTargetPawns><canTargetHumans>true</canTargetHumans><canTargetAnimals>true</canTargetAnimals><canTargetMechs>true</canTargetMechs><canTargetSelf>false</canTargetSelf><canTargetBuildings>false</canTargetBuildings><canTargetLocations>false</canTargetLocations></targetingParameters>
    <range>20</range>
    <requireLineOfSight>false</requireLineOfSight>
    <power>20</power>
    <powerStatFactors><LP_DivinePower>1</LP_DivinePower></powerStatFactors>
    <castTime>30</castTime>
    <cooldownTime>900</cooldownTime>
    <showUndrafted>false</showUndrafted>
    <modExtensions>
      <li Class="LichPhylactery.VPEBridge.LP_ClassAbilityExt">
        <path>LP_Path_Cleric</path><level>3</level><order>1</order>
        <psyfocusCost>0.12</psyfocusCost><entropyGain>12</entropyGain>
        <requiredSkillLevel>12</requiredSkillLevel>
        <prerequisites><li>LP_Guidance</li></prerequisites>
      </li>
    </modExtensions>
  </VEF.Abilities.AbilityDef>

  <VEF.Abilities.AbilityDef ParentName="VPE_PsycastBase">
    <defName>LP_TurnUndead</defName>
    <label>驱散亡灵</label>
    <description>半径 6 × 神恩强度内的敌对亡灵惊恐逃散 10 秒 × 神恩强度；没有心智的骷髅和死灵造物改为被击晕；巫妖只被减速。需要社交 12 级。</description>
    <iconPath>LP/Classes/Cleric/TurnUndead</iconPath>
    <abilityClass>LichPhylactery.VPEBridge.Ability_TurnUndead</abilityClass>
    <targetMode>Self</targetMode>
    <radius>6</radius>
    <radiusStatFactors><LP_DivinePower>1</LP_DivinePower></radiusStatFactors>
    <durationTime>600</durationTime>
    <durationTimeStatFactors><LP_DivinePower>1</LP_DivinePower></durationTimeStatFactors>
    <castTime>60</castTime>
    <cooldownTime>3600</cooldownTime>
    <showUndrafted>false</showUndrafted>
    <modExtensions>
      <li Class="LichPhylactery.VPEBridge.LP_ClassAbilityExt">
        <path>LP_Path_Cleric</path><level>3</level><order>2</order>
        <psyfocusCost>0.2</psyfocusCost><entropyGain>15</entropyGain>
        <requiredSkillLevel>12</requiredSkillLevel>
        <prerequisites><li>LP_LesserRestoration</li></prerequisites>
      </li>
    </modExtensions>
  </VEF.Abilities.AbilityDef>

  <VEF.Abilities.AbilityDef ParentName="VPE_PsycastBase">
    <defName>LP_MassHeal</defName>
    <label>群体治疗</label>
    <description>治疗半径 5 内的所有友军各 15 × 神恩强度点伤势。需要社交 15 级。</description>
    <iconPath>LP/Classes/Cleric/MassHeal</iconPath>
    <abilityClass>LichPhylactery.VPEBridge.Ability_MassHeal</abilityClass>
    <targetMode>Self</targetMode>
    <radius>5</radius>
    <power>15</power>
    <powerStatFactors><LP_DivinePower>1</LP_DivinePower></powerStatFactors>
    <castTime>90</castTime>
    <cooldownTime>2500</cooldownTime>
    <showUndrafted>true</showUndrafted>
    <modExtensions>
      <li Class="LichPhylactery.VPEBridge.LP_ClassAbilityExt">
