        <requiredSkillLevel>15</requiredSkillLevel>
        <prerequisites><li>LP_SacredFlame</li></prerequisites>
      </li>
    </modExtensions>
  </VEF.Abilities.AbilityDef>

  <VEF.Abilities.AbilityDef ParentName="VPE_PsycastBase">
    <defName>LP_DeathWard</defName>
    <label>死亡守卫</label>
    <description>守护一名友军一天：疼痛 ×0.5；本应因伤倒地时立即治疗 30 × 神恩强度点伤势并消耗守卫（一天内只触发一次）。需要社交 15 级。</description>
    <iconPath>LP/Classes/Cleric/DeathWard</iconPath>
    <abilityClass>LichPhylactery.VPEBridge.Ability_DeathWard</abilityClass>
    <targetMode>Pawn</targetMode>
    <targetingParameters><canTargetPawns>true</canTargetPawns><canTargetHumans>true</canTargetHumans><canTargetAnimals>true</canTargetAnimals><canTargetMechs>false</canTargetMechs><canTargetSelf>true</canTargetSelf><canTargetBuildings>false</canTargetBuildings><canTargetLocations>false</canTargetLocations></targetingParameters>
    <range>20</range>
    <requireLineOfSight>false</requireLineOfSight>
    <power>30</power>
    <powerStatFactors><LP_DivinePower>1</LP_DivinePower></powerStatFactors>
    <durationTime>60000</durationTime>
    <castTime>60</castTime>
    <cooldownTime>60000</cooldownTime>
    <showUndrafted>true</showUndrafted>
    <modExtensions>
      <li Class="LichPhylactery.VPEBridge.LP_ClassAbilityExt">
        <path>LP_Path_Cleric</path><level>4</level><order>2</order>
        <psyfocusCost>0.25</psyfocusCost><entropyGain>15</entropyGain>
        <requiredSkillLevel>15</requiredSkillLevel>
        <prerequisites><li>LP_TurnUndead</li></prerequisites>
      </li>
    </modExtensions>
  </VEF.Abilities.AbilityDef>

  <VEF.Abilities.AbilityDef ParentName="VPE_PsycastBase">
    <defName>LP_Raise</defName>
    <label>复生术</label>
    <description>让一具死亡不超过 3 天的人形尸体复活（对巫妖、死灵造物和大脑被吞噬的尸体无效），复活者 3 天“复生虚弱”。神恩强度 1.25 以上时不会出现复活精神病。需要精神力满、社交 18 级，并学会群体治疗或死亡守卫。</description>
    <iconPath>LP/Classes/Cleric/Raise</iconPath>
    <abilityClass>LichPhylactery.VPEBridge.Ability_Raise</abilityClass>
    <targetMode>Thing</targetMode>
    <targetingParameters><canTargetPawns>false</canTargetPawns><canTargetItems>true</canTargetItems><canTargetCorpses>true</canTargetCorpses><canTargetBuildings>false</canTargetBuildings><canTargetLocations>false</canTargetLocations><mapObjectTargetsMustBeAutoAttackable>false</mapObjectTargetsMustBeAutoAttackable></targetingParameters>
    <range>12</range>
    <requireLineOfSight>false</requireLineOfSight>
    <castTime>300</castTime>
    <cooldownTime>300000</cooldownTime>
    <showUndrafted>true</showUndrafted>
    <modExtensions>
      <li Class="LichPhylactery.VPEBridge.LP_ClassAbilityExt">
        <path>LP_Path_Cleric</path><level>5</level><order>1</order>
        <psyfocusCost>0.5</psyfocusCost><entropyGain>40</entropyGain>
        <requiredSkillLevel>18</requiredSkillLevel>
        <prerequisites><li>LP_MassHeal</li><li>LP_DeathWard</li></prerequisites>
      </li>
    </modExtensions>
  </VEF.Abilities.AbilityDef>
</Defs>
