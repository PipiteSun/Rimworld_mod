<!-- 1.27.0 DND 职业路径的能力（VPE 联动）。数值说明见 ArtSource/Classes-1.27.0-report.md。时间单位为刻（2500 刻 = 1 小时，60000 刻 = 1 天）。 -->
<Defs>
  <VEF.Abilities.AbilityDef ParentName="VPE_PsycastBase">
    <defName>LP_CureWounds</defName>
    <label>治疗伤口</label>
    <description>立即治疗一名目标（可以是自己）共 20 × 神恩强度点伤势，优先流血最严重的伤口。需要社交 6 级。</description>
    <iconPath>LP/Classes/Cleric/CureWounds</iconPath>
    <abilityClass>LichPhylactery.VPEBridge.Ability_Heal</abilityClass>
    <targetMode>Pawn</targetMode>
    <targetingParameters><canTargetPawns>true</canTargetPawns><canTargetHumans>true</canTargetHumans><canTargetAnimals>true</canTargetAnimals><canTargetMechs>false</canTargetMechs><canTargetSelf>true</canTargetSelf><canTargetBuildings>false</canTargetBuildings><canTargetLocations>false</canTargetLocations></targetingParameters>
    <range>12</range>
    <requireLineOfSight>false</requireLineOfSight>
    <power>20</power>
    <powerStatFactors><LP_DivinePower>1</LP_DivinePower></powerStatFactors>
    <castTime>60</castTime>
    <cooldownTime>1800</cooldownTime>
    <showUndrafted>true</showUndrafted>
    <modExtensions>
      <li Class="LichPhylactery.VPEBridge.LP_ClassAbilityExt">
        <path>LP_Path_Cleric</path><level>1</level><order>1</order>
        <psyfocusCost>0.1</psyfocusCost><entropyGain>8</entropyGain>
        <requiredSkillLevel>6</requiredSkillLevel>
      </li>
    </modExtensions>
  </VEF.Abilities.AbilityDef>

  <VEF.Abilities.AbilityDef ParentName="VPE_PsycastBase">
    <defName>LP_Bless</defName>
    <label>祝福</label>
    <description>祝福一名友军 1 小时 × 神恩强度：近战命中 +10%，射击精度提高，心情 +3。需要社交 6 级。</description>
    <iconPath>LP/Classes/Cleric/Bless</iconPath>
    <abilityClass>LichPhylactery.VPEBridge.Ability_TargetBuff</abilityClass>
    <targetMode>Pawn</targetMode>
    <targetingParameters><canTargetPawns>true</canTargetPawns><canTargetHumans>true</canTargetHumans><canTargetAnimals>true</canTargetAnimals><canTargetMechs>false</canTargetMechs><canTargetSelf>true</canTargetSelf><canTargetBuildings>false</canTargetBuildings><canTargetLocations>false</canTargetLocations></targetingParameters>
    <range>20</range>
    <requireLineOfSight>false</requireLineOfSight>
    <durationTime>2500</durationTime>
    <durationTimeStatFactors><LP_DivinePower>1</LP_DivinePower></durationTimeStatFactors>
    <castTime>30</castTime>
    <cooldownTime>600</cooldownTime>
    <showUndrafted>true</showUndrafted>
    <modExtensions>
      <li Class="LichPhylactery.VPEBridge.LP_ClassAbilityExt">
        <path>LP_Path_Cleric</path><level>1</level><order>2</order>
        <psyfocusCost>0.08</psyfocusCost><entropyGain>6</entropyGain>
        <requiredSkillLevel>6</requiredSkillLevel>
      </li>
    </modExtensions>
  </VEF.Abilities.AbilityDef>

  <VEF.Abilities.AbilityDef ParentName="VPE_PsycastBase">
    <defName>LP_LesserRestoration</defName>
    <label>次级复原术</label>
    <description>移除目标身上最严重的一种疾病（食物中毒、流感、瘟疫、感染、肌肉寄生虫、肠道蠕虫等），并止住所有出血 6 小时。需要社交 9 级。</description>
    <iconPath>LP/Classes/Cleric/LesserRestoration</iconPath>
    <abilityClass>LichPhylactery.VPEBridge.Ability_LesserRestoration</abilityClass>
    <targetMode>Pawn</targetMode>
    <targetingParameters><canTargetPawns>true</canTargetPawns><canTargetHumans>true</canTargetHumans><canTargetAnimals>true</canTargetAnimals><canTargetMechs>false</canTargetMechs><canTargetSelf>true</canTargetSelf><canTargetBuildings>false</canTargetBuildings><canTargetLocations>false</canTargetLocations></targetingParameters>
    <range>12</range>
    <requireLineOfSight>false</requireLineOfSight>
    <durationTime>15000</durationTime>
    <castTime>90</castTime>
    <cooldownTime>2500</cooldownTime>
    <showUndrafted>true</showUndrafted>
    <modExtensions>
      <li Class="LichPhylactery.VPEBridge.LP_ClassAbilityExt">
        <path>LP_Path_Cleric</path><level>2</level><order>1</order>
        <psyfocusCost>0.15</psyfocusCost><entropyGain>10</entropyGain>
        <requiredSkillLevel>9</requiredSkillLevel>
        <prerequisites><li>LP_CureWounds</li></prerequisites>
      </li>
    </modExtensions>
  </VEF.Abilities.AbilityDef>

