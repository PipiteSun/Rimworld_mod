<?xml version="1.0" encoding="utf-8"?>
<!-- 1.27.0 职业伤害类型：奥术力（法师）、闪电（法师）。神圣 LP_Radiant 1.39.0 起移到主模组 Defs/Faith.xml（信仰的神术不依赖 VPE），牧师照常用它。 -->
<Defs>
  <DamageDef>
    <defName>LP_ArcaneForce</defName>
    <label>奥术力</label>
    <workerClass>DamageWorker_AddInjury</workerClass>
    <externalViolence>true</externalViolence>
    <deathMessage>{0}被奥术之力撕碎了。</deathMessage>
    <hediff>Crush</hediff>
    <hediffSolid>Crack</hediffSolid>
    <harmAllLayersUntilOutside>true</harmAllLayersUntilOutside>
    <impactSoundType>Blunt</impactSoundType>
    <armorCategory>Blunt</armorCategory>
    <defaultDamage>10</defaultDamage>
    <defaultArmorPenetration>0.3</defaultArmorPenetration>
    <overkillPctToDestroyPart>0.2~0.7</overkillPctToDestroyPart>
    <isRanged>true</isRanged>
    <makesAnimalsFlee>true</makesAnimalsFlee>
  </DamageDef>
  <DamageDef>
    <defName>LP_Lightning</defName>
    <label>闪电</label>
    <workerClass>DamageWorker_AddInjury</workerClass>
    <externalViolence>true</externalViolence>
    <deathMessage>{0}被闪电击毙了。</deathMessage>
    <hediff>Burn</hediff>
    <hediffSolid>Crack</hediffSolid>
    <harmAllLayersUntilOutside>true</harmAllLayersUntilOutside>
    <impactSoundType>Blunt</impactSoundType>
    <armorCategory>Heat</armorCategory>
    <defaultDamage>20</defaultDamage>
    <defaultArmorPenetration>0.5</defaultArmorPenetration>
    <isRanged>true</isRanged>
    <makesAnimalsFlee>true</makesAnimalsFlee>
  </DamageDef>

</Defs>
