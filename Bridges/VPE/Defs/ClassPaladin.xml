<?xml version="1.0" encoding="utf-8"?>
<!-- 1.36.0 DND 职业路径：圣武士（VPE 联动）。主 格斗 / 副 社交，任一 ≥ 6 可解锁；左支格斗、右支社交，终极 圣光化身看格斗 18。武器那一下走原版近战；神术部分（psychicMode=Yes）乘心灵敏感度。 -->
<Defs>
  <VanillaPsycastsExpanded.PsycasterPathDef Class="LichPhylactery.VPEBridge.LP_ClassPathDef">
    <defName>LP_Path_Paladin</defName>
    <label>圣武士</label>
    <description>DND 圣武士以誓言为剑：至圣斩、誓仇、神圣武器、援护换位（格斗），圣疗、守护灵光、勇气灵光、放逐邪恶（社交），终极 圣光化身。格斗或社交任一 6 级即可入门；每个能力看自己那门技能（6/9/12/15/18）。武器那一下照常结算，追加的神圣伤害和治疗乘心灵敏感度。巫妖不能学。</description>
    <tab>DND职业</tab>
    <order>6</order>
    <requiredSkill>Melee</requiredSkill>
    <alternateSkill>Social</alternateSkill>
    <requiredSkillLevel>6</requiredSkillLevel>
    <martial>true</martial>
    <classPsychic>false</classPsychic>
    <lockedReason>需要格斗或社交 6 级，或冒险者魅力 13（巫妖不能学）</lockedReason>
    <tooltip>圣武士：格斗支执掌圣斩，社交支执掌灵光与圣疗。</tooltip>
    <background>LP/Classes/Paladin/Background</background>
    <altBackground>LP/Classes/Paladin/Background</altBackground>
    <backgroundColor>(0.5,0.42,0.16)</backgroundColor>
    <ignoreLockRestrictionsForNeurotrainers>false</ignoreLockRestrictionsForNeurotrainers>
  </VanillaPsycastsExpanded.PsycasterPathDef>

  <HediffDef ParentName="LP_ClassBuffBase">
    <defName>LP_SmiteReady</defName>
    <label>至圣斩</label>
    <description>下一次近战命中追加神圣伤害（严重度 = 伤害量），10 秒内有效。</description>
    <defaultLabelColor>(1,0.9,0.55)</defaultLabelColor>
    <maxSeverity>1000</maxSeverity>
  </HediffDef>

  <HediffDef ParentName="LP_ClassBuffBase">
    <defName>LP_SacredWeapon</defName>
    <label>神圣武器</label>
    <description>每次近战命中追加神圣伤害（严重度 = 伤害量）。</description>
    <defaultLabelColor>(1,0.9,0.55)</defaultLabelColor>
    <maxSeverity>1000</maxSeverity>
  </HediffDef>

  <HediffDef ParentName="LP_ClassBuffBase">
    <defName>LP_Enmity</defName>
    <hediffClass>LichPhylactery.VPEBridge.Hediff_Enmity</hediffClass>
    <label>誓仇</label>
    <description>被圣武士立誓追讨：那名圣武士对它的伤害提高。</description>
    <isBad>true</isBad>
    <defaultLabelColor>(0.95,0.6,0.4)</defaultLabelColor>
  </HediffDef>

  <HediffDef ParentName="LP_ClassBuffBase">
    <defName>LP_ProtectionAura</defName>
    <hediffClass>LichPhylactery.VPEBridge.Hediff_ClassScaled</hediffClass>
    <label>守护灵光</label>
    <description>在圣武士的守护灵光里：受到伤害降低（×0.8～×0.95，随神恩强度），精神崩溃阈值 −5%。</description>
    <defaultLabelColor>(1,0.9,0.55)</defaultLabelColor>
    <stages><li><statOffsets><MentalBreakThreshold>-0.05</MentalBreakThreshold></statOffsets></li></stages>
    <modExtensions><li Class="LichPhylactery.VPEBridge.ScaledHediffExtension">
      <scaledFactors>
        <li><stat>IncomingDamageFactor</stat><baseValue>1</baseValue><perSeverity>-0.1</perSeverity><min>0.8</min><max>1</max></li>
      </scaledFactors>
    </li></modExtensions>
  </HediffDef>

  <HediffDef ParentName="LP_ClassBuffBase">
    <defName>LP_CourageAura</defName>
    <label>勇气灵光</label>
    <description>在圣武士的勇气灵光里：不会恐慌逃跑。</description>
    <defaultLabelColor>(1,0.9,0.55)</defaultLabelColor>
  </HediffDef>

  <HediffDef ParentName="LP_ClassBuffBase">
    <defName>LP_Sheltered</defName>
    <label>受庇护</label>
    <description>圣武士挡在身前：受到伤害 ×0.5。</description>
    <defaultLabelColor>(1,0.9,0.55)</defaultLabelColor>
    <stages><li><statFactors><IncomingDamageFactor>0.5</IncomingDamageFactor></statFactors></li></stages>
  </HediffDef>

  <HediffDef ParentName="LP_ClassBuffBase">
    <defName>LP_HolyAvatar</defName>
    <label>圣光化身</label>
    <description>圣光加身：每秒灼伤周围的敌人、治疗周围的友军（严重度 = 每秒伤害），免疫击晕与恐慌。</description>
    <defaultLabelColor>(1,0.95,0.7)</defaultLabelColor>
    <maxSeverity>1000</maxSeverity>
    <comps><li Class="LichPhylactery.VPEBridge.HediffCompProperties_ClassPulse"><interval>60</interval><radius>6</radius><damageEnemies>true</damageEnemies><healAllies>true</healAllies><healFactor>0.4</healFactor></li></comps>
  </HediffDef>

  <ThoughtDef>
    <defName>LP_EnmityAvenged</defName>
    <durationDays>1</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>誓仇得报</label><description>我立誓追讨的敌人倒下了。</description><baseMoodEffect>5</baseMoodEffect></li></stages>
  </ThoughtDef>

  <VEF.Abilities.AbilityDef ParentName="VPE_PsycastBase">
    <defName>LP_DivineSmite</defName>
    <label>至圣斩</label>
    <description>10 秒内下一次近战命中额外造成 10 × 战技强度 × 心灵敏感度 神圣伤害，对亡灵、邪魔、夺心魔翻倍。武器那一下照常结算（Isekai 加成生效）。 需要格斗 6 级。</description>
    <iconPath>LP/Classes/Paladin/DivineSmite</iconPath>
    <abilityClass>LichPhylactery.VPEBridge.Ability_DivineSmite</abilityClass>
    <targetMode>Self</targetMode>
    <power>10</power>
    <powerStatFactors><LP_MartialPower>1</LP_MartialPower></powerStatFactors>
    <durationTime>600</durationTime>
    <castTime>15</castTime>
    <cooldownTime>900</cooldownTime>
    <showUndrafted>false</showUndrafted>
    <modExtensions>
      <li Class="LichPhylactery.VPEBridge.LP_ClassAbilityExt">
        <path>LP_Path_Paladin</path><level>1</level><order>1</order>
        <psyfocusCost>0.06</psyfocusCost><entropyGain>6</entropyGain>
        <requiredSkillLevel>6</requiredSkillLevel>
        <psychicMode>Yes</psychicMode>
      </li>
    </modExtensions>
  </VEF.Abilities.AbilityDef>

  <VEF.Abilities.AbilityDef ParentName="VPE_PsycastBase">
    <defName>LP_LayOnHands</defName>
    <label>圣疗</label>
    <description>触碰一名友军（或自己）治疗 25 × 神恩强度 × 心灵敏感度；没有伤口时改为解除食物中毒或清除 30% 毒素积累。 需要社交 6 级。</description>
    <iconPath>LP/Classes/Paladin/LayOnHands</iconPath>
    <abilityClass>LichPhylactery.VPEBridge.Ability_LayOnHands</abilityClass>
    <targetMode>Pawn</targetMode>
    <targetingParameters><canTargetPawns>true</canTargetPawns><canTargetHumans>true</canTargetHumans><canTargetAnimals>true</canTargetAnimals><canTargetMechs>false</canTargetMechs><canTargetSelf>true</canTargetSelf><canTargetBuildings>false</canTargetBuildings><canTargetLocations>false</canTargetLocations></targetingParameters>
    <range>1.9</range>
    <requireLineOfSight>true</requireLineOfSight>
    <power>25</power>
    <powerStatFactors><LP_DivinePower>1</LP_DivinePower></powerStatFactors>
    <castTime>30</castTime>
    <cooldownTime>2500</cooldownTime>
    <showUndrafted>true</showUndrafted>
    <modExtensions>
      <li Class="LichPhylactery.VPEBridge.LP_ClassAbilityExt">
        <path>LP_Path_Paladin</path><level>1</level><order>2</order>
        <psyfocusCost>0.1</psyfocusCost><entropyGain>8</entropyGain>
        <requiredSkillLevel>6</requiredSkillLevel>
        <skill>Social</skill>
        <psychicMode>Yes</psychicMode>
      </li>
    </modExtensions>
  </VEF.Abilities.AbilityDef>

  <VEF.Abilities.AbilityDef ParentName="VPE_PsycastBase">
    <defName>LP_VowOfEnmity</defName>
    <label>誓仇</label>
    <description>标记一个敌人 1 天：施法者对它造成的所有伤害 ×(1 + 0.25 × 战技强度)；它死后施法者心情 +5（誓仇得报）。 需要格斗 9 级。</description>
    <iconPath>LP/Classes/Paladin/VowOfEnmity</iconPath>
    <abilityClass>LichPhylactery.VPEBridge.Ability_VowOfEnmity</abilityClass>
    <targetMode>Pawn</targetMode>
    <targetingParameters><canTargetPawns>true</canTargetPawns><canTargetHumans>true</canTargetHumans><canTargetAnimals>true</canTargetAnimals><canTargetMechs>true</canTargetMechs><canTargetSelf>false</canTargetSelf><canTargetBuildings>false</canTargetBuildings><canTargetLocations>false</canTargetLocations></targetingParameters>
    <range>20</range>
    <requireLineOfSight>true</requireLineOfSight>
    <durationTime>60000</durationTime>
    <castTime>15</castTime>
    <cooldownTime>2500</cooldownTime>
    <showUndrafted>false</showUndrafted>
    <modExtensions>
      <li Class="LichPhylactery.VPEBridge.LP_ClassAbilityExt">
        <path>LP_Path_Paladin</path><level>2</level><order>1</order>
        <psyfocusCost>0.06</psyfocusCost><entropyGain>5</entropyGain>
        <requiredSkillLevel>9</requiredSkillLevel>
        <prerequisites><li>LP_DivineSmite</li></prerequisites>
      </li>
    </modExtensions>
  </VEF.Abilities.AbilityDef>

  <VEF.Abilities.AbilityDef ParentName="VPE_PsycastBase">
    <defName>LP_AuraOfProtection</defName>
    <label>守护灵光</label>
    <description>被动：半径 5 内友军（含自己）受到的伤害 ×(1 − 0.1 × 神恩强度)（最低 ×0.8），精神崩溃阈值 −5%。多名圣武士不叠加，取最强。 需要社交 9 级。</description>
    <iconPath>LP/Classes/Paladin/AuraOfProtection</iconPath>
    <abilityClass>LichPhylactery.VPEBridge.Ability_ClassPassive</abilityClass>
    <targetMode>Self</targetMode>
    <castTime>0</castTime>
    <showUndrafted>true</showUndrafted>
    <modExtensions>
      <li Class="LichPhylactery.VPEBridge.LP_ClassAbilityExt">
        <path>LP_Path_Paladin</path><level>2</level><order>2</order>
        <psyfocusCost>0</psyfocusCost><entropyGain>0</entropyGain>
        <requiredSkillLevel>9</requiredSkillLevel>
        <skill>Social</skill>
        <prerequisites><li>LP_LayOnHands</li></prerequisites>
      </li>
    </modExtensions>
  </VEF.Abilities.AbilityDef>

  <VEF.Abilities.AbilityDef ParentName="VPE_PsycastBase">
    <defName>LP_SacredWeapon</defName>
    <label>神圣武器</label>
    <description>1 小时 × 战技强度：每次近战命中追加 4 × 战技强度 × 心灵敏感度 神圣伤害（对亡灵、邪魔、夺心魔翻倍）。 需要格斗 12 级。</description>
    <iconPath>LP/Classes/Paladin/SacredWeapon</iconPath>
    <abilityClass>LichPhylactery.VPEBridge.Ability_DivineSmite</abilityClass>
    <targetMode>Self</targetMode>
    <power>4</power>
    <powerStatFactors><LP_MartialPower>1</LP_MartialPower></powerStatFactors>
    <durationTime>2500</durationTime>
    <durationTimeStatFactors><LP_MartialPower>1</LP_MartialPower></durationTimeStatFactors>
    <castTime>30</castTime>
    <cooldownTime>60000</cooldownTime>
    <showUndrafted>true</showUndrafted>
    <modExtensions>
      <li Class="LichPhylactery.VPEBridge.LP_ClassAbilityExt">
        <path>LP_Path_Paladin</path><level>3</level><order>1</order>
        <psyfocusCost>0.12</psyfocusCost><entropyGain>10</entropyGain>
        <requiredSkillLevel>12</requiredSkillLevel>
        <psychicMode>Yes</psychicMode>
        <prerequisites><li>LP_VowOfEnmity</li></prerequisites>
      </li>
    </modExtensions>
  </VEF.Abilities.AbilityDef>

  <VEF.Abilities.AbilityDef ParentName="VPE_PsycastBase">
    <defName>LP_AuraOfCourage</defName>
    <label>勇气灵光</label>
    <description>被动：半径 5 内友军不会进入恐慌逃跑，并立即摆脱“震慑”。 需要社交 12 级。</description>
    <iconPath>LP/Classes/Paladin/AuraOfCourage</iconPath>
    <abilityClass>LichPhylactery.VPEBridge.Ability_ClassPassive</abilityClass>
    <targetMode>Self</targetMode>
    <castTime>0</castTime>
    <showUndrafted>true</showUndrafted>
    <modExtensions>
      <li Class="LichPhylactery.VPEBridge.LP_ClassAbilityExt">
        <path>LP_Path_Paladin</path><level>3</level><order>2</order>
        <psyfocusCost>0</psyfocusCost><entropyGain>0</entropyGain>
        <requiredSkillLevel>12</requiredSkillLevel>
        <skill>Social</skill>
        <prerequisites><li>LP_AuraOfProtection</li></prerequisites>
      </li>
    </modExtensions>
  </VEF.Abilities.AbilityDef>

  <VEF.Abilities.AbilityDef ParentName="VPE_PsycastBase">
    <defName>LP_Intercept</defName>
    <label>援护换位</label>
    <description>与 12 × 战技强度 格内的一名友军瞬间换位，对方获得“受庇护”10 秒：受到伤害 ×0.5。 需要格斗 15 级。</description>
    <iconPath>LP/Classes/Paladin/Intercept</iconPath>
    <abilityClass>LichPhylactery.VPEBridge.Ability_Intercept</abilityClass>
    <targetMode>Pawn</targetMode>
    <targetingParameters><canTargetPawns>true</canTargetPawns><canTargetHumans>true</canTargetHumans><canTargetAnimals>true</canTargetAnimals><canTargetMechs>true</canTargetMechs><canTargetSelf>false</canTargetSelf><canTargetBuildings>false</canTargetBuildings><canTargetLocations>false</canTargetLocations></targetingParameters>
    <range>12</range>
    <requireLineOfSight>false</requireLineOfSight>
    <rangeStatFactors><LP_MartialPower>1</LP_MartialPower></rangeStatFactors>
    <castTime>0</castTime>
    <cooldownTime>3600</cooldownTime>
    <showUndrafted>false</showUndrafted>
    <modExtensions>
      <li Class="LichPhylactery.VPEBridge.LP_ClassAbilityExt">
        <path>LP_Path_Paladin</path><level>4</level><order>1</order>
        <psyfocusCost>0.1</psyfocusCost><entropyGain>8</entropyGain>
        <requiredSkillLevel>15</requiredSkillLevel>
        <prerequisites><li>LP_SacredWeapon</li></prerequisites>
      </li>
    </modExtensions>
  </VEF.Abilities.AbilityDef>

  <VEF.Abilities.AbilityDef ParentName="VPE_PsycastBase">
    <defName>LP_DispelEvil</defName>
    <label>放逐邪恶</label>
    <description>半径 5 × 神恩强度 内敌对的亡灵、邪魔、夺心魔各受 30 × 神恩强度 × 心灵敏感度 神圣伤害并击晕 2 秒；敌对的召唤物直接被驱散。 需要社交 15 级。</description>
    <iconPath>LP/Classes/Paladin/DispelEvil</iconPath>
    <abilityClass>LichPhylactery.VPEBridge.Ability_DispelEvil</abilityClass>
    <targetMode>Self</targetMode>
    <radius>5</radius>
    <radiusStatFactors><LP_DivinePower>1</LP_DivinePower></radiusStatFactors>
    <power>30</power>
    <powerStatFactors><LP_DivinePower>1</LP_DivinePower></powerStatFactors>
    <castTime>45</castTime>
    <cooldownTime>2500</cooldownTime>
    <showUndrafted>false</showUndrafted>
    <modExtensions>
      <li Class="LichPhylactery.VPEBridge.LP_ClassAbilityExt">
        <path>LP_Path_Paladin</path><level>4</level><order>2</order>
        <psyfocusCost>0.25</psyfocusCost><entropyGain>18</entropyGain>
        <requiredSkillLevel>15</requiredSkillLevel>
        <skill>Social</skill>
        <psychicMode>Yes</psychicMode>
        <prerequisites><li>LP_AuraOfCourage</li></prerequisites>
      </li>
    </modExtensions>
  </VEF.Abilities.AbilityDef>

  <VEF.Abilities.AbilityDef ParentName="VPE_PsycastBase">
    <defName>LP_HolyAvatar</defName>
    <label>圣光化身</label>
    <description>30 秒 × 战技强度：半径 6 内的敌人每秒受 5 × 战技强度 × 心灵敏感度 神圣伤害（对亡灵、邪魔翻倍），友军每秒治疗它的 40%；自己免疫击晕与恐慌。 需要格斗 18 级。</description>
    <iconPath>LP/Classes/Paladin/HolyAvatar</iconPath>
    <abilityClass>LichPhylactery.VPEBridge.Ability_SelfPowerBuff</abilityClass>
    <targetMode>Self</targetMode>
    <power>5</power>
    <powerStatFactors><LP_MartialPower>1</LP_MartialPower></powerStatFactors>
    <durationTime>1800</durationTime>
    <durationTimeStatFactors><LP_MartialPower>1</LP_MartialPower></durationTimeStatFactors>
    <castTime>60</castTime>
    <cooldownTime>180000</cooldownTime>
    <showUndrafted>false</showUndrafted>
    <modExtensions>
      <li Class="LichPhylactery.VPEBridge.LP_ClassAbilityExt">
        <path>LP_Path_Paladin</path><level>5</level><order>1</order>
        <psyfocusCost>0.4</psyfocusCost><entropyGain>30</entropyGain>
        <requiredSkillLevel>18</requiredSkillLevel>
        <psychicMode>Yes</psychicMode>
        <prerequisites><li>LP_Intercept</li><li>LP_DispelEvil</li></prerequisites>
      </li>
    </modExtensions>
  </VEF.Abilities.AbilityDef>
</Defs>
