<?xml version="1.0" encoding="utf-8"?>
<!-- 1.36.0 DND 职业路径：术士（VPE 联动）。主 社交 / 副 智识，任一 ≥ 6 可解锁（血脉种族 4）；左支社交（天赋强度）、右支智识（奥术强度），终极 魔涌看社交 18。效果乘心灵敏感度。 -->
<Defs>
  <VanillaPsycastsExpanded.PsycasterPathDef Class="LichPhylactery.VPEBridge.LP_ClassPathDef">
    <defName>LP_Path_Sorcerer</defName>
    <label>术士</label>
    <description>DND 术士生来带着魔力：混沌箭、魅惑人类、龙族之翼、群体暗示（社交），燃烧之手、超魔·孪生、冰风暴、超魔·强效（智识），终极 魔涌。社交或智识任一 6 级即可入门；力能龙裔、元素裔、巨灵、泰坦、风暴巨人、云巨人、六臂蛇人有术士血脉，所有门槛 −2、天赋强度 +15%。效果乘心灵敏感度。</description>
    <tab>DND职业</tab>
    <order>7</order>
    <requiredSkill>Social</requiredSkill>
    <alternateSkill>Intellectual</alternateSkill>
    <requiredSkillLevel>6</requiredSkillLevel>
    <classPsychic>true</classPsychic>
    <lockedReason>需要社交或智识 6 级（术士血脉 4 级），或冒险者魅力 13</lockedReason>
    <tooltip>术士：社交支是天生的魅力法术，智识支是超魔与元素。</tooltip>
    <background>LP/Classes/Sorcerer/Background</background>
    <altBackground>LP/Classes/Sorcerer/Background</altBackground>
    <backgroundColor>(0.42,0.16,0.4)</backgroundColor>
    <ignoreLockRestrictionsForNeurotrainers>false</ignoreLockRestrictionsForNeurotrainers>
  </VanillaPsycastsExpanded.PsycasterPathDef>

  <StatDef ParentName="LP_ClassPowerBase">
    <defName>LP_InnatePower</defName>
    <label>天赋强度</label>
    <description>DND 术士社交一支的强度倍率：0.5 + 社交等级/20，带术士血脉（力能龙裔、元素裔、巨灵、泰坦、风暴巨人、云巨人、六臂蛇人）的再 +15%。混沌箭的伤害、魅惑的时长、龙族之翼的距离、魔涌的持续时间都乘这个倍率。</description>
    <parts><li Class="LichPhylactery.VPEBridge.StatPart_ClassSkill"><skill>Social</skill></li><li Class="LichPhylactery.VPEBridge.StatPart_Bloodline" /></parts>
    <displayPriorityInCategory>4216</displayPriorityInCategory>
  </StatDef>

  <HediffDef ParentName="LP_ClassBuffBase">
    <defName>LP_Twinned</defName>
    <label>超魔·孪生</label>
    <description>下一个单体术士法术会同时作用于第二个目标。</description>
    <defaultLabelColor>(0.9,0.5,0.8)</defaultLabelColor>
    <comps Inherit="False"><li Class="HediffCompProperties_Disappears"><disappearsAfterTicks>1800~1800</disappearsAfterTicks><showRemainingTime>true</showRemainingTime></li></comps>
  </HediffDef>

  <HediffDef ParentName="LP_ClassBuffBase">
    <defName>LP_Empowered</defName>
    <label>超魔·强效</label>
    <description>接下来的术士法术伤害 ×1.5（严重度 = 剩余次数）。</description>
    <defaultLabelColor>(0.9,0.5,0.8)</defaultLabelColor>
    <comps Inherit="False"><li Class="HediffCompProperties_Disappears"><disappearsAfterTicks>1800~1800</disappearsAfterTicks><showRemainingTime>true</showRemainingTime></li></comps>
  </HediffDef>

  <HediffDef ParentName="LP_ClassBuffBase">
    <defName>LP_DragonWingsLanded</defName>
    <label>龙翼</label>
    <description>刚刚乘龙翼飞起：近战闪避 +20%。</description>
    <defaultLabelColor>(0.9,0.5,0.8)</defaultLabelColor>
    <stages><li><statOffsets><MeleeDodgeChance>0.2</MeleeDodgeChance></statOffsets></li></stages>
  </HediffDef>

  <HediffDef ParentName="LP_ClassBuffBase">
    <defName>LP_SorcerousSurge</defName>
    <label>魔涌</label>
    <description>体内魔力奔涌：术士法术不耗精神力、冷却 ×0.25，每次施法 20% 触发狂野魔法。</description>
    <defaultLabelColor>(0.95,0.45,0.8)</defaultLabelColor>
  </HediffDef>

  <HediffDef ParentName="LP_ClassBuffBase">
    <defName>LP_WildInvisible</defName>
    <label>狂野魔法：隐形</label>
    <description>狂野魔法让身形消失了几秒。</description>
    <defaultLabelColor>(0.9,0.5,0.8)</defaultLabelColor>
    <comps><li Class="HediffCompProperties_Invisibility"><visibleToPlayer>true</visibleToPlayer><affectedByDisruptor>false</affectedByDisruptor></li></comps>
  </HediffDef>

  <VEF.Abilities.AbilityDef ParentName="VPE_PsycastBase">
    <defName>LP_ChaosBolt</defName>
    <label>混沌箭</label>
    <description>向 25 格内的敌人射出混沌之力，12 × 天赋强度 伤害，类型随机：火焰（点燃）、闪电（击晕）、奥术力、冰霜（减速）；力能龙裔固定为力场。有 1/8 概率再跳到 6 格内另一个敌人。 需要社交 6 级。</description>
    <iconPath>LP/Classes/Sorcerer/ChaosBolt</iconPath>
    <abilityClass>LichPhylactery.VPEBridge.Ability_ChaosBolt</abilityClass>
    <targetMode>Pawn</targetMode>
    <targetingParameters><canTargetPawns>true</canTargetPawns><canTargetHumans>true</canTargetHumans><canTargetAnimals>true</canTargetAnimals><canTargetMechs>true</canTargetMechs><canTargetSelf>false</canTargetSelf><canTargetBuildings>false</canTargetBuildings><canTargetLocations>false</canTargetLocations></targetingParameters>
    <range>25</range>
    <requireLineOfSight>true</requireLineOfSight>
    <power>12</power>
    <powerStatFactors><LP_InnatePower>1</LP_InnatePower></powerStatFactors>
    <castTime>30</castTime>
    <cooldownTime>360</cooldownTime>
    <showUndrafted>false</showUndrafted>
    <modExtensions>
      <li Class="LichPhylactery.VPEBridge.LP_ClassAbilityExt">
        <path>LP_Path_Sorcerer</path><level>1</level><order>1</order>
        <psyfocusCost>0.08</psyfocusCost><entropyGain>8</entropyGain>
        <requiredSkillLevel>6</requiredSkillLevel>
      </li>
    </modExtensions>
  </VEF.Abilities.AbilityDef>

  <VEF.Abilities.AbilityDef ParentName="VPE_PsycastBase">
    <defName>LP_BurningHands</defName>
    <label>燃烧之手</label>
    <description>面前 90° 扇形 6 格喷出火焰：10 × 奥术强度 火焰伤害并点燃，地面可能起火。 需要智识 6 级。</description>
    <iconPath>LP/Classes/Sorcerer/BurningHands</iconPath>
    <abilityClass>LichPhylactery.VPEBridge.Ability_BurningHands</abilityClass>
    <targetMode>Location</targetMode>
    <targetingParameters><canTargetPawns>true</canTargetPawns><canTargetBuildings>true</canTargetBuildings><canTargetLocations>true</canTargetLocations><canTargetSelf>false</canTargetSelf></targetingParameters>
    <range>6</range>
    <requireLineOfSight>true</requireLineOfSight>
    <power>10</power>
    <powerStatFactors><LP_ArcanePower>1</LP_ArcanePower></powerStatFactors>
    <castTime>30</castTime>
    <cooldownTime>900</cooldownTime>
    <showUndrafted>false</showUndrafted>
    <modExtensions>
      <li Class="LichPhylactery.VPEBridge.LP_ClassAbilityExt">
        <path>LP_Path_Sorcerer</path><level>1</level><order>2</order>
        <psyfocusCost>0.1</psyfocusCost><entropyGain>10</entropyGain>
        <requiredSkillLevel>6</requiredSkillLevel>
        <skill>Intellectual</skill>
      </li>
    </modExtensions>
  </VEF.Abilities.AbilityDef>

  <VEF.Abilities.AbilityDef ParentName="VPE_PsycastBase">
    <defName>LP_CharmPerson</defName>
    <label>魅惑人类</label>
    <description>魅惑一个人形：敌人陷入恍惚 8 秒 × 天赋强度，不再攻击；对囚犯则抵抗 −10 × 天赋强度。心智抗性可以抵抗。 需要社交 9 级。</description>
    <iconPath>LP/Classes/Sorcerer/CharmPerson</iconPath>
    <abilityClass>LichPhylactery.VPEBridge.Ability_CharmPerson</abilityClass>
    <targetMode>Pawn</targetMode>
    <targetingParameters><canTargetPawns>true</canTargetPawns><canTargetHumans>true</canTargetHumans><canTargetAnimals>false</canTargetAnimals><canTargetMechs>false</canTargetMechs><canTargetSelf>false</canTargetSelf><canTargetBuildings>false</canTargetBuildings><canTargetLocations>false</canTargetLocations></targetingParameters>
    <range>20</range>
    <requireLineOfSight>true</requireLineOfSight>
    <power>10</power>
    <powerStatFactors><LP_InnatePower>1</LP_InnatePower></powerStatFactors>
    <durationTime>480</durationTime>
    <durationTimeStatFactors><LP_InnatePower>1</LP_InnatePower></durationTimeStatFactors>
    <castTime>30</castTime>
    <cooldownTime>1800</cooldownTime>
    <showUndrafted>false</showUndrafted>
    <modExtensions>
      <li Class="LichPhylactery.VPEBridge.LP_ClassAbilityExt">
        <path>LP_Path_Sorcerer</path><level>2</level><order>1</order>
        <psyfocusCost>0.12</psyfocusCost><entropyGain>10</entropyGain>
        <requiredSkillLevel>9</requiredSkillLevel>
        <prerequisites><li>LP_ChaosBolt</li></prerequisites>
      </li>
    </modExtensions>
  </VEF.Abilities.AbilityDef>

  <VEF.Abilities.AbilityDef ParentName="VPE_PsycastBase">
    <defName>LP_TwinSpell</defName>
    <label>超魔·孪生</label>
    <description>30 秒内的下一个单体术士法术（混沌箭、魅惑人类）同时作用于主目标 6 格内的另一个敌人。 需要智识 9 级。</description>
    <iconPath>LP/Classes/Sorcerer/TwinSpell</iconPath>
    <abilityClass>LichPhylactery.VPEBridge.Ability_TwinSpell</abilityClass>
    <targetMode>Self</targetMode>
    <castTime>0</castTime>
    <cooldownTime>1800</cooldownTime>
    <showUndrafted>false</showUndrafted>
    <modExtensions>
      <li Class="LichPhylactery.VPEBridge.LP_ClassAbilityExt">
        <path>LP_Path_Sorcerer</path><level>2</level><order>2</order>
        <psyfocusCost>0.08</psyfocusCost><entropyGain>5</entropyGain>
        <requiredSkillLevel>9</requiredSkillLevel>
        <skill>Intellectual</skill>
        <prerequisites><li>LP_BurningHands</li></prerequisites>
      </li>
    </modExtensions>
  </VEF.Abilities.AbilityDef>

  <VEF.Abilities.AbilityDef ParentName="VPE_PsycastBase">
    <defName>LP_DragonWings</defName>
    <label>龙族之翼</label>
    <description>展开龙翼，飞到 15 × 天赋强度 格内的可站立格，飞行中不受攻击；起飞后 15 秒内闪避 +20%。 需要社交 12 级。</description>
    <iconPath>LP/Classes/Sorcerer/DragonWings</iconPath>
    <abilityClass>LichPhylactery.VPEBridge.Ability_DragonWings</abilityClass>
    <targetMode>Location</targetMode>
    <targetingParameters><canTargetPawns>true</canTargetPawns><canTargetBuildings>true</canTargetBuildings><canTargetLocations>true</canTargetLocations><canTargetSelf>false</canTargetSelf></targetingParameters>
    <range>15</range>
    <requireLineOfSight>true</requireLineOfSight>
    <rangeStatFactors><LP_InnatePower>1</LP_InnatePower></rangeStatFactors>
    <castTime>15</castTime>
    <cooldownTime>7200</cooldownTime>
    <showUndrafted>true</showUndrafted>
    <modExtensions>
      <li Class="LichPhylactery.VPEBridge.LP_ClassAbilityExt">
        <path>LP_Path_Sorcerer</path><level>3</level><order>1</order>
        <psyfocusCost>0.15</psyfocusCost><entropyGain>10</entropyGain>
        <requiredSkillLevel>12</requiredSkillLevel>
        <prerequisites><li>LP_CharmPerson</li></prerequisites>
      </li>
    </modExtensions>
  </VEF.Abilities.AbilityDef>

  <VEF.Abilities.AbilityDef ParentName="VPE_PsycastBase">
    <defName>LP_IceStorm</defName>
    <label>冰风暴</label>
    <description>25 格内一点降下冰风暴：半径 3 内的敌人受 8 × 奥术强度 冰霜伤害和一半的钝器伤害，并减速 6 秒；地面积雪。 需要智识 12 级。</description>
    <iconPath>LP/Classes/Sorcerer/IceStorm</iconPath>
    <abilityClass>LichPhylactery.VPEBridge.Ability_IceStorm</abilityClass>
    <targetMode>Location</targetMode>
    <targetingParameters><canTargetPawns>true</canTargetPawns><canTargetBuildings>true</canTargetBuildings><canTargetLocations>true</canTargetLocations><canTargetSelf>false</canTargetSelf></targetingParameters>
    <range>25</range>
    <requireLineOfSight>true</requireLineOfSight>
    <radius>3</radius>
    <power>8</power>
    <powerStatFactors><LP_ArcanePower>1</LP_ArcanePower></powerStatFactors>
    <castTime>60</castTime>
    <cooldownTime>3600</cooldownTime>
    <showUndrafted>false</showUndrafted>
    <modExtensions>
      <li Class="LichPhylactery.VPEBridge.LP_ClassAbilityExt">
        <path>LP_Path_Sorcerer</path><level>3</level><order>2</order>
        <psyfocusCost>0.2</psyfocusCost><entropyGain>18</entropyGain>
        <requiredSkillLevel>12</requiredSkillLevel>
        <skill>Intellectual</skill>
        <prerequisites><li>LP_TwinSpell</li></prerequisites>
      </li>
    </modExtensions>
  </VEF.Abilities.AbilityDef>

  <VEF.Abilities.AbilityDef ParentName="VPE_PsycastBase">
    <defName>LP_MassSuggestion</defName>
    <label>群体暗示</label>
    <description>20 格内一点半径 4 内的敌对人形各自判定心智抗性，未抵抗的陷入恍惚 15 秒 × 天赋强度。 需要社交 15 级。</description>
    <iconPath>LP/Classes/Sorcerer/MassSuggestion</iconPath>
    <abilityClass>LichPhylactery.VPEBridge.Ability_MassSuggestion</abilityClass>
    <targetMode>Location</targetMode>
    <targetingParameters><canTargetPawns>true</canTargetPawns><canTargetBuildings>true</canTargetBuildings><canTargetLocations>true</canTargetLocations><canTargetSelf>false</canTargetSelf></targetingParameters>
    <range>20</range>
    <requireLineOfSight>true</requireLineOfSight>
    <radius>4</radius>
    <durationTime>900</durationTime>
    <durationTimeStatFactors><LP_InnatePower>1</LP_InnatePower></durationTimeStatFactors>
    <castTime>60</castTime>
    <cooldownTime>2500</cooldownTime>
    <showUndrafted>false</showUndrafted>
    <modExtensions>
      <li Class="LichPhylactery.VPEBridge.LP_ClassAbilityExt">
        <path>LP_Path_Sorcerer</path><level>4</level><order>1</order>
        <psyfocusCost>0.25</psyfocusCost><entropyGain>20</entropyGain>
        <requiredSkillLevel>15</requiredSkillLevel>
        <prerequisites><li>LP_DragonWings</li></prerequisites>
      </li>
    </modExtensions>
  </VEF.Abilities.AbilityDef>

  <VEF.Abilities.AbilityDef ParentName="VPE_PsycastBase">
    <defName>LP_EmpoweredSpell</defName>
    <label>超魔·强效</label>
    <description>30 秒内接下来的两个术士法术伤害 ×1.5。 需要智识 15 级。</description>
    <iconPath>LP/Classes/Sorcerer/EmpoweredSpell</iconPath>
    <abilityClass>LichPhylactery.VPEBridge.Ability_EmpoweredSpell</abilityClass>
    <targetMode>Self</targetMode>
    <castTime>0</castTime>
    <cooldownTime>2500</cooldownTime>
    <showUndrafted>false</showUndrafted>
    <modExtensions>
      <li Class="LichPhylactery.VPEBridge.LP_ClassAbilityExt">
        <path>LP_Path_Sorcerer</path><level>4</level><order>2</order>
        <psyfocusCost>0.15</psyfocusCost><entropyGain>10</entropyGain>
        <requiredSkillLevel>15</requiredSkillLevel>
        <skill>Intellectual</skill>
        <prerequisites><li>LP_IceStorm</li></prerequisites>
      </li>
    </modExtensions>
  </VEF.Abilities.AbilityDef>

  <VEF.Abilities.AbilityDef ParentName="VPE_PsycastBase">
    <defName>LP_SorcerousSurge</defName>
    <label>魔涌</label>
    <description>30 秒 × 天赋强度：术士法术不耗精神力、冷却 ×0.25；每次施法有 20% 触发狂野魔法——治愈之光、隐形、灵能共鸣、繁花，或者自燃、乱序传送、熵涌、混乱精魂。 需要社交 18 级。</description>
    <iconPath>LP/Classes/Sorcerer/SorcerousSurge</iconPath>
    <abilityClass>LichPhylactery.VPEBridge.Ability_SorcerousSurge</abilityClass>
    <targetMode>Self</targetMode>
    <durationTime>1800</durationTime>
    <durationTimeStatFactors><LP_InnatePower>1</LP_InnatePower></durationTimeStatFactors>
    <castTime>30</castTime>
    <cooldownTime>180000</cooldownTime>
    <showUndrafted>false</showUndrafted>
    <modExtensions>
      <li Class="LichPhylactery.VPEBridge.LP_ClassAbilityExt">
        <path>LP_Path_Sorcerer</path><level>5</level><order>1</order>
        <psyfocusCost>0.4</psyfocusCost><entropyGain>30</entropyGain>
        <requiredSkillLevel>18</requiredSkillLevel>
        <prerequisites><li>LP_MassSuggestion</li><li>LP_EmpoweredSpell</li></prerequisites>
      </li>
    </modExtensions>
  </VEF.Abilities.AbilityDef>
</Defs>
