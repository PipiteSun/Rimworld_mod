  <VEF.Abilities.AbilityDef ParentName="VPE_PsycastBase">
    <defName>LP_SuppressingFire</defName>
    <label>压制射击</label>
    <description>对一片区域倾泻火力：用当前武器的子弹连射 6 发（每 0.1 秒一发，落在目标点半径 3 内的随机格，伤害 ×0.5）；区域内的敌人被压制 6 秒：移动 ×0.6、远程命中 ×0.75。射程 = 当前武器射程，需要远程武器。冷却 1 分钟。需要射击 9 级。</description>
    <iconPath>LP/Classes/Fighter/SuppressingFire</iconPath>
    <abilityClass>LichPhylactery.VPEBridge.Ability_SuppressingFire</abilityClass>
    <targetMode>Location</targetMode>
    <targetingParameters><canTargetPawns>true</canTargetPawns><canTargetBuildings>true</canTargetBuildings><canTargetLocations>true</canTargetLocations><canTargetSelf>false</canTargetSelf></targetingParameters>
    <range>30</range>
    <requireLineOfSight>true</requireLineOfSight>
    <radius>3</radius>
    <castTime>20</castTime>
    <cooldownTime>3600</cooldownTime>
    <showUndrafted>false</showUndrafted>
    <modExtensions>
      <li Class="LichPhylactery.VPEBridge.LP_ClassAbilityExt">
        <path>LP_Path_Fighter</path><level>2</level><order>3</order>
        <psyfocusCost>0.08</psyfocusCost><entropyGain>6</entropyGain>
        <requiredSkillLevel>9</requiredSkillLevel><skill>Shooting</skill>
        <prerequisites><li>LP_SteadyAim</li></prerequisites>
      </li>
    </modExtensions>
  </VEF.Abilities.AbilityDef>

  <VEF.Abilities.AbilityDef ParentName="VPE_PsycastBase">
    <defName>LP_PrecisionShot</defName>
    <label>精准射击</label>
    <description>立刻对一个敌人打出一发当前武器的子弹，必中，伤害 ×(1.5 + 0.5 × 射术强度)，穿甲 +30%。征召时多一个按钮切换模式：要害（只有上面的效果）/ 打腿（伤害 ×0.7，目标移动 ×0.5 持续 10 秒）/ 打手（伤害 ×0.5，按缴械击的公式判定打落武器，用敏捷调整值和射术强度）。射程 = 当前武器射程，需要远程武器。冷却 20 秒。需要射击 12 级。</description>
    <iconPath>LP/Classes/Fighter/PrecisionShot</iconPath>
    <abilityClass>LichPhylactery.VPEBridge.Ability_PrecisionShot</abilityClass>
    <targetMode>Pawn</targetMode>
    <targetingParameters><canTargetPawns>true</canTargetPawns><canTargetHumans>true</canTargetHumans><canTargetAnimals>true</canTargetAnimals><canTargetMechs>true</canTargetMechs><canTargetSelf>false</canTargetSelf><canTargetBuildings>false</canTargetBuildings><canTargetLocations>false</canTargetLocations></targetingParameters>
    <range>30</range>
    <requireLineOfSight>true</requireLineOfSight>
    <castTime>30</castTime>
    <cooldownTime>1200</cooldownTime>
    <showUndrafted>false</showUndrafted>
    <modExtensions>
      <li Class="LichPhylactery.VPEBridge.LP_ClassAbilityExt">
        <path>LP_Path_Fighter</path><level>3</level><order>4</order>
        <psyfocusCost>0.08</psyfocusCost><entropyGain>6</entropyGain>
        <requiredSkillLevel>12</requiredSkillLevel><skill>Shooting</skill>
        <prerequisites><li>LP_SuppressingFire</li></prerequisites>
      </li>
    </modExtensions>
  </VEF.Abilities.AbilityDef>

