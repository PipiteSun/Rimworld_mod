  <VEF.Abilities.AbilityDef ParentName="VPE_PsycastBase">
    <defName>LP_Trip</defName>
    <label>绊摔</label>
    <description>把身边的目标绊倒：击晕 1.5 秒 × 战技强度并击退 1 格；体型 2 以上的目标只被震慑不被击退。需要格斗 9 级。</description>
    <iconPath>LP/Classes/Fighter/Trip</iconPath>
    <abilityClass>LichPhylactery.VPEBridge.Ability_Trip</abilityClass>
    <targetMode>Pawn</targetMode>
    <targetingParameters><canTargetPawns>true</canTargetPawns><canTargetHumans>true</canTargetHumans><canTargetAnimals>true</canTargetAnimals><canTargetMechs>true</canTargetMechs><canTargetSelf>false</canTargetSelf><canTargetBuildings>false</canTargetBuildings><canTargetLocations>false</canTargetLocations></targetingParameters>
    <range>1.9</range>
    <requireLineOfSight>true</requireLineOfSight>
    <durationTime>90</durationTime>
    <durationTimeStatFactors><LP_MartialPower>1</LP_MartialPower></durationTimeStatFactors>
    <castTime>15</castTime>
    <cooldownTime>1800</cooldownTime>
    <showUndrafted>false</showUndrafted>
    <modExtensions>
      <li Class="LichPhylactery.VPEBridge.LP_ClassAbilityExt">
        <path>LP_Path_Fighter</path><level>2</level><order>1</order>
        <psyfocusCost>0.08</psyfocusCost><entropyGain>6</entropyGain>
        <requiredSkillLevel>9</requiredSkillLevel>
        <prerequisites><li>LP_BattleCry</li></prerequisites>
      </li>
    </modExtensions>
  </VEF.Abilities.AbilityDef>

