  <VEF.Abilities.AbilityDef ParentName="VPE_PsycastBase">
    <defName>LP_Whirlwind</defName>
    <label>旋风斩</label>
    <description>对相邻的所有敌人各结算一次当前近战武器的伤害（必中，伤害 × 战技强度；近战伤害系数、武器品质与 Isekai 的精炼/力量加成都算在内）。需要格斗 15 级。</description>
    <iconPath>LP/Classes/Fighter/Whirlwind</iconPath>
    <abilityClass>LichPhylactery.VPEBridge.Ability_Whirlwind</abilityClass>
    <targetMode>Self</targetMode>
    <radius>1.5</radius>
    <castTime>20</castTime>
    <cooldownTime>3600</cooldownTime>
    <showUndrafted>false</showUndrafted>
    <modExtensions>
      <li Class="LichPhylactery.VPEBridge.LP_ClassAbilityExt">
        <path>LP_Path_Fighter</path><level>4</level><order>1</order>
        <psyfocusCost>0.15</psyfocusCost><entropyGain>12</entropyGain>
        <requiredSkillLevel>15</requiredSkillLevel>
        <prerequisites><li>LP_WeaponMastery</li></prerequisites>
      </li>
    </modExtensions>
  </VEF.Abilities.AbilityDef>

  <VEF.Abilities.AbilityDef ParentName="VPE_PsycastBase">
    <defName>LP_GuardStance</defName>
    <label>守护姿态</label>
    <description>30 秒 × 战技强度内护甲 +16% ～ +30%（随战技强度分档），移动 ×0.7；半径 3 内友军受到的伤害有 30% 转到自己身上。冷却 2 小时。需要格斗 15 级。</description>
    <iconPath>LP/Classes/Fighter/GuardStance</iconPath>
    <abilityClass>LichPhylactery.VPEBridge.Ability_SelfBuff</abilityClass>
    <targetMode>Self</targetMode>
    <durationTime>1800</durationTime>
    <durationTimeStatFactors><LP_MartialPower>1</LP_MartialPower></durationTimeStatFactors>
    <castTime>30</castTime>
    <cooldownTime>5000</cooldownTime>
    <showUndrafted>false</showUndrafted>
    <modExtensions>
      <li Class="LichPhylactery.VPEBridge.LP_ClassAbilityExt">
        <path>LP_Path_Fighter</path><level>4</level><order>2</order>
        <psyfocusCost>0.15</psyfocusCost><entropyGain>12</entropyGain>
