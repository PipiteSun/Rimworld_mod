    <defName>LP_Charge</defName>
    <label>冲锋</label>
    <description>扑向 8 格内的一个敌人：跳到它身边，落地立刻用当前武器结算一次近战（必中，伤害 ×(1 + 0.3 × 战技强度)）；体型 1 以下的目标被撞倒（击晕 1 秒）。冷却 20 秒。需要格斗 6 级。</description>
    <iconPath>LP/Classes/Fighter/Charge</iconPath>
    <abilityClass>LichPhylactery.VPEBridge.Ability_Charge</abilityClass>
    <targetMode>Pawn</targetMode>
    <targetingParameters><canTargetPawns>true</canTargetPawns><canTargetHumans>true</canTargetHumans><canTargetAnimals>true</canTargetAnimals><canTargetMechs>true</canTargetMechs><canTargetSelf>false</canTargetSelf><canTargetBuildings>false</canTargetBuildings><canTargetLocations>false</canTargetLocations></targetingParameters>
    <range>8</range>
    <requireLineOfSight>true</requireLineOfSight>
    <castTime>10</castTime>
    <cooldownTime>1200</cooldownTime>
    <showUndrafted>false</showUndrafted>
    <modExtensions>
      <li Class="LichPhylactery.VPEBridge.LP_ClassAbilityExt">
        <path>LP_Path_Fighter</path><level>1</level><order>3</order>
        <psyfocusCost>0.05</psyfocusCost><entropyGain>4</entropyGain>
        <requiredSkillLevel>6</requiredSkillLevel>
      </li>
    </modExtensions>
  </VEF.Abilities.AbilityDef>

  <VEF.Abilities.AbilityDef ParentName="VPE_PsycastBase">
    <defName>LP_DisarmingStrike</defName>
    <label>缴械击</label>
    <description>对身边的敌人结算一次近战，然后试着打落它的武器（落到 2 格外）。成功率 = 50% + 10% ×（自己的力量调整值 + 熟练加值 − 目标的）+ 20% ×（战技强度 − 1），限 15%～90%；体型 2 以上再减半。没有冒险者等级的一方按调整值 0、熟练加值 +2 算。机械体、动物、没拿武器的只吃那一击。冷却 30 秒。需要格斗 12 级。</description>
    <iconPath>LP/Classes/Fighter/DisarmingStrike</iconPath>
    <abilityClass>LichPhylactery.VPEBridge.Ability_DisarmingStrike</abilityClass>
    <targetMode>Pawn</targetMode>
    <targetingParameters><canTargetPawns>true</canTargetPawns><canTargetHumans>true</canTargetHumans><canTargetAnimals>true</canTargetAnimals><canTargetMechs>true</canTargetMechs><canTargetSelf>false</canTargetSelf><canTargetBuildings>false</canTargetBuildings><canTargetLocations>false</canTargetLocations></targetingParameters>
    <range>1.9</range>
    <requireLineOfSight>true</requireLineOfSight>
    <castTime>15</castTime>
    <cooldownTime>1800</cooldownTime>
    <showUndrafted>false</showUndrafted>
    <modExtensions>
      <li Class="LichPhylactery.VPEBridge.LP_ClassAbilityExt">
        <path>LP_Path_Fighter</path><level>3</level><order>3</order>
        <psyfocusCost>0.06</psyfocusCost><entropyGain>5</entropyGain>
        <requiredSkillLevel>12</requiredSkillLevel>
        <prerequisites><li>LP_Trip</li></prerequisites>
      </li>
    </modExtensions>
  </VEF.Abilities.AbilityDef>

