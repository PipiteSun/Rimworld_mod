<Defs>
  <VEF.Abilities.AbilityDef ParentName="VPE_PsycastBase">
    <defName>LP_SecondWind</defName>
    <label>回气</label>
    <description>调匀呼吸，600刻内持续治疗自己的伤势，总量 20 × 战技强度，优先流血伤口。需要格斗或射击 6 级（看两者里较高的一项，强度也按它）。</description>
    <iconPath>LP/Classes/Fighter/SecondWind</iconPath>
    <abilityClass>LichPhylactery.VPEBridge.Ability_SecondWind</abilityClass>
    <targetMode>Self</targetMode>
    <power>20</power>
    <powerStatFactors><LP_MartialPower>1</LP_MartialPower></powerStatFactors>
    <castTime>30</castTime>
    <cooldownTime>5000</cooldownTime>
    <showUndrafted>true</showUndrafted>
    <modExtensions>
      <li Class="LichPhylactery.VPEBridge.LP_ClassAbilityExt">
