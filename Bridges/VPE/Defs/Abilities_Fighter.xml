  <VEF.Abilities.AbilityDef ParentName="VPE_PsycastBase">
    <defName>LP_BattleCry</defName>
    <label>战吼</label>
    <description>一声怒吼，半径 4 × 战技强度内的敌人被震慑 5 秒 × 战技强度：移动 ×0.7，命中下降。需要格斗或射击 6 级（看两者里较高的一项，强度也按它）。</description>
    <iconPath>LP/Classes/Fighter/BattleCry</iconPath>
    <abilityClass>LichPhylactery.VPEBridge.Ability_AreaEnemies</abilityClass>
    <targetMode>Self</targetMode>
    <radius>4</radius>
    <radiusStatFactors><LP_MartialPower>1</LP_MartialPower></radiusStatFactors>
    <durationTime>300</durationTime>
    <durationTimeStatFactors><LP_MartialPower>1</LP_MartialPower></durationTimeStatFactors>
    <castTime>30</castTime>
    <cooldownTime>2500</cooldownTime>
