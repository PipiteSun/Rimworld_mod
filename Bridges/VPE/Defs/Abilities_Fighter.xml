        <psyfocusCost>0.3</psyfocusCost><entropyGain>20</entropyGain>
        <requiredSkillLevel>18</requiredSkillLevel>
        <prerequisites><li>LP_Whirlwind</li><li>LP_GuardStance</li></prerequisites>
      </li>
    </modExtensions>
