    <tab>LP_FireGiantTech</tab>
    <researchViewX>2</researchViewX>
    <researchViewY>2.1</researchViewY>
  </ResearchProjectDef>

  <!-- ==================== 1.39.0 信仰（Y 2.8：巨人谱系和种族兵装之间的空行） ==================== -->
  <ResearchProjectDef>
    <defName>LP_Research_Faith</defName>
    <label>信仰与神术</label>
    <description>按费伦诸神的教义建起圣坛：选择殖民地的守护神、祈祷、献祭，制作圣徽和祝圣圣水。解锁守护神像（圣坛旁的附件：圣坛速度+10%、祈祷娱乐+20%）。佩戴圣徽的人能消耗神眷施放神术。</description>
    <baseCost>800</baseCost>
    <techLevel>Medieval</techLevel>
    <tab>LP_FireGiantTech</tab>
    <researchViewX>0</researchViewX>
    <researchViewY>2.8</researchViewY>
  </ResearchProjectDef>
  <ResearchProjectDef>
    <defName>LP_Research_Planetouched</defName>
    <label>天界与地狱血统</label>
    <description>研究阿斯莫与提夫林身上的天界、地狱血统。完成后神选仪式可以顺带把信徒的异种基因换成阿斯莫（善神）或提夫林（恶神）。派系里的阿斯莫和提夫林不需要这项研究。</description>
    <baseCost>1200</baseCost>
    <techLevel>Medieval</techLevel>
    <prerequisites>
      <li>LP_Research_Faith</li>
    </prerequisites>
    <tab>LP_FireGiantTech</tab>
    <researchViewX>1</researchViewX>
    <researchViewY>2.8</researchViewY>
  </ResearchProjectDef>

