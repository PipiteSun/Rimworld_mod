<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- ==================== 巨魔血（余烬氏族、黑网收购） ==================== -->

  <ThingDef ParentName="ResourceBase">
    <defName>LP_TrollBlood</defName>
    <label>巨魔血</label>
    <description>从巨魔身上抽出的一瓶暗绿色血液，离体后仍在缓慢蠕动。火巨人用它淬火，黑网商人说它能卖给想要长生的人。\n\n可以对巨魔做“抽取巨魔血”手术获得；巨魔很快就能把血补回来。</description>
    <graphicData>
      <texPath>Factions/Items/TrollBlood</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <stackLimit>25</stackLimit>
    <statBases>
      <MarketValue>45</MarketValue>
      <Mass>0.2</Mass>
      <DeteriorationRate>2</DeteriorationRate>
      <Flammability>0.5</Flammability>
    </statBases>
    <thingCategories>
      <li>ItemsMisc</li>
    </thingCategories>
    <tradeability>All</tradeability>
    <tradeTags>
      <li>LP_TrollBlood</li>
    </tradeTags>
    <healthAffectsPrice>false</healthAffectsPrice>
  </ThingDef>

  <RecipeDef ParentName="SurgeryFlesh">
    <defName>LP_ExtractTrollBlood</defName>
    <label>抽取巨魔血</label>
    <description>从巨魔身上抽出两瓶巨魔血。会造成一些失血，但巨魔的血很快就能补回来。只能对巨魔做。</description>
    <workerClass>LichPhylactery.Recipe_ExtractTrollBlood</workerClass>
    <jobString>正在抽取巨魔血。</jobString>
    <workAmount>500</workAmount>
    <hideBodyPartNames>true</hideBodyPartNames>
    <targetsBodyPart>false</targetsBodyPart>
    <isViolation>true</isViolation>
    <anesthetize>false</anesthetize>
    <uiIconThing>LP_TrollBlood</uiIconThing>
    <recipeUsers>
      <li>Human</li>
    </recipeUsers>
    <descriptionHyperlinks>
      <ThingDef>LP_TrollBlood</ThingDef>
    </descriptionHyperlinks>
  </RecipeDef>

