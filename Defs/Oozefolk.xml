  <!-- ==================== 能力 ==================== -->
  <AbilityDef ParentName="LP_OozeAbilityBase">
    <defName>LP_OozeEngulf</defName>
    <label>吞没</label>
    <description>把一具尸体整个吞进身体里慢慢消化，需要2小时，可以被打断。尸体消失，衣服和武器留在原地。人形尸体：原生质+25、饱食度+50%；动物：原生质=体型×15（最多30），饱食度=体型×30%（最多60%）；开始腐烂的尸体减半。干尸、机械体、巫妖与死灵造物、流浆人的尸体不能吞没。15格内看见的殖民者会心情-3（1天；食人者、精神病态和流浆人不在乎）。吞没人形尸体算作吃人肉。也可以选中流浆人后右键尸体下令。</description>
    <iconPath>Oozefolk/Abilities/Engulf</iconPath>
    <cooldownTicksRange>60</cooldownTicksRange>
    <hostile>false</hostile>
    <jobDef>CastAbilityOnThingMelee</jobDef>
    <casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence>
    <verbProperties>
      <verbClass>Verb_CastAbilityTouch</verbClass>
      <drawAimPie>true</drawAimPie>
      <range>-1</range>
      <warmupTime>83.33</warmupTime>
      <violent>false</violent>
      <targetParams>
        <canTargetPawns>false</canTargetPawns>
        <canTargetCorpses>true</canTargetCorpses>
        <canTargetItems>true</canTargetItems>
        <canTargetBuildings>false</canTargetBuildings>
        <canTargetSelf>false</canTargetSelf>
        <canTargetLocations>false</canTargetLocations>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="LichPhylactery.CompProperties_OozeAbility">
        <effect>engulf</effect>
      </li>
    </comps>
  </AbilityDef>

  <AbilityDef ParentName="LP_OozeAbilityBase">
