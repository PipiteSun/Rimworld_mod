    </customEffectDescriptions>
  </GeneDef>

  <GeneDef ParentName="LP_OozeGeneBase">
    <defName>LP_OozeSplit</defName>
    <label>分裂繁殖</label>
    <description>流浆人不靠怀孕繁衍，而是攒够原生质后把自己分成两半：分出来的是一个婴儿，带着父体全部的内源基因。代价是不能和任何人（包括别的流浆人）以普通方式生育。</description>
    <iconPath>Oozefolk/Genes/Split</iconPath>
    <displayCategory>Reproduction</displayCategory>
    <biostatMet>0</biostatMet>
