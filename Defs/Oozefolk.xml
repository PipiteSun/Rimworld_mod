  <GeneDef ParentName="LP_OozeGeneBase">
    <defName>LP_OozeAmorphous</defName>
    <label>无定形</label>
    <description>身体没有固定形状，能挤过任何缝隙：可以从门缝里“渗过”一扇门，哪怕门锁着、是别人的门。被关起来的时候也更容易越狱，越狱途中锁着的门挡不住他们。</description>
    <iconPath>Oozefolk/Genes/Amorphous</iconPath>
    <displayCategory>Movement</displayCategory>
    <biostatMet>-1</biostatMet>
