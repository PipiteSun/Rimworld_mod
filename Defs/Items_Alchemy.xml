    <fixedIngredientFilter><thingDefs><li>LP_TrollBlood</li></thingDefs></fixedIngredientFilter>
    <products><LP_PotionTrollRegen>1</LP_PotionTrollRegen></products>
  </RecipeDef>

  <RecipeDef ParentName="LP_ThrowableRecipeBase">
    <defName>LP_MakeAlchemistFire</defName>
    <label>制作炼金之火</label>
    <description>用20份化学燃料和10份布制作一组炼金之火。</description>
    <jobString>正在制作炼金之火。</jobString>
    <ingredients>
      <li><filter><thingDefs><li>Chemfuel</li></thingDefs></filter><count>20</count></li>
      <li><filter><thingDefs><li>Cloth</li></thingDefs></filter><count>10</count></li>
    </ingredients>
    <fixedIngredientFilter><thingDefs><li>Chemfuel</li><li>Cloth</li></thingDefs></fixedIngredientFilter>
    <products><LP_AlchemistFire>1</LP_AlchemistFire></products>
  </RecipeDef>
