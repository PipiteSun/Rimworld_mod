    </ingredients>
    <fixedIngredientFilter><thingDefs><li>LP_TrollBlood</li><li>MedicineIndustrial</li></thingDefs></fixedIngredientFilter>
    <products><LP_PotionGreaterHealing>1</LP_PotionGreaterHealing></products>
  </RecipeDef>
  <RecipeDef ParentName="LP_PotionRecipeBase">
    <defName>LP_BrewPotionGiantStrength</defName>
    <label>调配巨人之力药水</label>
