      <li><filter><thingDefs><li>Silver</li></thingDefs></filter><count>15</count></li>
      <li><filter><thingDefs><li>MedicineHerbal</li></thingDefs></filter><count>2</count></li>
    </ingredients>
    <fixedIngredientFilter><thingDefs><li>Silver</li><li>MedicineHerbal</li></thingDefs></fixedIngredientFilter>
