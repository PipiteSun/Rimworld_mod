      <li><filter><thingDefs><li>LP_BrainJar</li></thingDefs></filter><count>1</count></li>
    </ingredients>
    <fixedIngredientFilter><thingDefs><li>LP_BrainJar</li></thingDefs></fixedIngredientFilter>
