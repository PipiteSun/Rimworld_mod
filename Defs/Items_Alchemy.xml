<?xml version="1.0" encoding="utf-8"?>
<!-- 1.22.0 物品与炼金：炼金桌、两项研究（1.35.0 起在 Defs/Research.xml）、炼金速度属性、炼金配方。 -->
<Defs>

  <StatDef>
    <defName>LP_AlchemySpeed</defName>
    <label>炼金速度</label>
    <description>在炼金桌调配药水和投掷物、在附魔台制作魔法物品的速度。按智识与医疗两项技能的平均等级计算。</description>
    <category>PawnWork</category>
    <defaultBaseValue>1</defaultBaseValue>
    <minValue>0.1</minValue>
    <toStringStyle>PercentZero</toStringStyle>
    <supressDisabledError>true</supressDisabledError>
    <statFactors>
      <li>WorkSpeedGlobal</li>
    </statFactors>
    <capacityFactors>
      <li>
        <capacity>Sight</capacity>
        <weight>0.6</weight>
        <max>1</max>
      </li>
      <li>
        <capacity>Manipulation</capacity>
        <weight>1</weight>
      </li>
    </capacityFactors>
    <parts>
      <li Class="LichPhylactery.StatPart_AlchemySkill" />
    </parts>
    <displayPriorityInCategory>4300</displayPriorityInCategory>
  </StatDef>

  <ThingDef ParentName="BenchBase">
    <defName>LP_AlchemyTable</defName>
    <label>炼金桌</label>
    <description>摆满烧瓶、蒸馏器和研钵的工作台。在这里调配DND药水、炼金投掷物、雾瓶、风暴宝珠、凝胶敷料和抑灵剂，并淬炼寒铁；魔法物品改在附魔台、圣物在圣坛、卷轴和手册在卷轴书桌制作。配方速度按智识与医疗的平均等级计算。可连接蒸馏器（+15%）和工具柜。</description>
    <thingClass>Building_WorkTable</thingClass>
    <graphicData>
      <texPath>Items/AlchemyTable</texPath>
      <shaderType>CutoutComplex</shaderType>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(2,1)</drawSize>
      <damageData>
        <cornerTL>Damage/Corner</cornerTL>
        <cornerTR>Damage/Corner</cornerTR>
        <cornerBL>Damage/Corner</cornerBL>
        <cornerBR>Damage/Corner</cornerBR>
      </damageData>
    </graphicData>
    <castEdgeShadows>true</castEdgeShadows>
    <staticSunShadowHeight>0.20</staticSunShadowHeight>
    <size>(2,1)</size>
    <stuffCategories>
      <li>Metallic</li>
      <li>Woody</li>
      <li>Stony</li>
    </stuffCategories>
    <costStuffCount>75</costStuffCount>
    <costList>
      <Steel>50</Steel>
      <ComponentIndustrial>2</ComponentIndustrial>
    </costList>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <fillPercent>0.5</fillPercent>
    <useHitPoints>True</useHitPoints>
    <statBases>
      <WorkToBuild>2500</WorkToBuild>
      <MaxHitPoints>180</MaxHitPoints>
      <Flammability>1.0</Flammability>
      <Cleanliness>-2</Cleanliness>
    </statBases>
    <designationCategory>Production</designationCategory>
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <surfaceType>Item</surfaceType>
    <inspectorTabs>
      <li>ITab_Bills</li>
    </inspectorTabs>
    <building>
      <workTableRoomRole>Laboratory</workTableRoomRole>
      <spawnedConceptLearnOpportunity>BillsTab</spawnedConceptLearnOpportunity>
    </building>
    <!-- 1.47.0：可连接蒸馏器和工具柜。 -->
    <comps>
      <li Class="CompProperties_AffectedByFacilities">
        <linkableFacilities>
          <li>ToolCabinet</li>
          <li>LP_Alembic</li>
        </linkableFacilities>
      </li>
    </comps>
    <placeWorkers>
      <li>PlaceWorker_ShowFacilitiesConnections</li>
    </placeWorkers>
    <constructionSkillPrerequisite>4</constructionSkillPrerequisite>
    <researchPrerequisites>
      <li>LP_DNDAlchemy</li>
    </researchPrerequisites>
  </ThingDef>

  <WorkGiverDef>
    <defName>LP_DoBillsAlchemy</defName>
    <label>炼金</label>
    <giverClass>WorkGiver_DoBill</giverClass>
    <workType>Crafting</workType>
    <workTags>
      <li>Intellectual</li>
    </workTags>
    <priorityInType>96</priorityInType>
    <fixedBillGiverDefs>
      <li>LP_AlchemyTable</li>
    </fixedBillGiverDefs>
    <verb>炼金</verb>
    <gerund>正在炼金桌工作</gerund>
    <requiredCapacities>
      <li>Manipulation</li>
    </requiredCapacities>
    <prioritizeSustains>true</prioritizeSustains>
  </WorkGiverDef>

  <RecipeDef Name="LP_AlchemyRecipeBase" Abstract="True">
    <workSpeedStat>LP_AlchemySpeed</workSpeedStat>
    <workSkill>Intellectual</workSkill>
    <effectWorking>Cook</effectWorking>
    <soundWorking>Recipe_Drug</soundWorking>
    <recipeUsers>
      <li>LP_AlchemyTable</li>
    </recipeUsers>
    <researchPrerequisite>LP_DNDAlchemy</researchPrerequisite>
    <workAmount>1200</workAmount>
    <allowMixingIngredients>false</allowMixingIngredients>
  </RecipeDef>
  <RecipeDef Name="LP_PotionRecipeBase" ParentName="LP_AlchemyRecipeBase" Abstract="True">
    <modExtensions>
      <li Class="LichPhylactery.AlchemyRecipeExtension">
        <potion>true</potion>
      </li>
    </modExtensions>
  </RecipeDef>
  <RecipeDef Name="LP_ThrowableRecipeBase" ParentName="LP_AlchemyRecipeBase" Abstract="True">
    <workAmount>2400</workAmount>
    <modExtensions>
      <li Class="LichPhylactery.AlchemyRecipeExtension" />
    </modExtensions>
  </RecipeDef>

  <RecipeDef ParentName="LP_PotionRecipeBase">
    <defName>LP_BrewPotionHealing</defName>
    <label>调配治疗药水</label>
    <description>用1瓶巨魔血和2份草药调配1瓶治疗药水。</description>
    <jobString>正在调配治疗药水。</jobString>
    <ingredients>
      <li><filter><thingDefs><li>LP_TrollBlood</li></thingDefs></filter><count>1</count></li>
      <li><filter><thingDefs><li>MedicineHerbal</li></thingDefs></filter><count>2</count></li>
    </ingredients>
    <fixedIngredientFilter><thingDefs><li>LP_TrollBlood</li><li>MedicineHerbal</li></thingDefs></fixedIngredientFilter>
    <products><LP_PotionHealing>1</LP_PotionHealing></products>
  </RecipeDef>
  <RecipeDef ParentName="LP_PotionRecipeBase">
    <defName>LP_BrewPotionGreaterHealing</defName>
