    <jobString>正在调配英雄药水。</jobString>
    <ingredients>
      <li><filter><thingDefs><li>Beer</li></thingDefs></filter><count>3</count></li>
      <li><filter><thingDefs><li>Gold</li></thingDefs></filter><count>2</count></li>
    </ingredients>
    <fixedIngredientFilter><thingDefs><li>Beer</li><li>Gold</li></thingDefs></fixedIngredientFilter>
    <products><LP_PotionHeroism>1</LP_PotionHeroism></products>
  </RecipeDef>
  <RecipeDef ParentName="LP_PotionRecipeBase">
    <defName>LP_BrewPotionMindShield</defName>
    <label>调配心智护盾药水</label>
    <description>把1个脑浆罐里残留的心智提炼成3瓶心智护盾药水。</description>
