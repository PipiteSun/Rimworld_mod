  <graphicData><texPath>FireGiant/Equipment/Helmet</texPath><graphicClass>Graphic_Single</graphicClass></graphicData>
  <techLevel>Industrial</techLevel>
  <statBases><MaxHitPoints>350</MaxHitPoints><Mass>4</Mass><WorkToMake>14000</WorkToMake><Flammability>0</Flammability><ArmorRating_Sharp>1.1</ArmorRating_Sharp><ArmorRating_Blunt>0.45</ArmorRating_Blunt><ArmorRating_Heat>0.8</ArmorRating_Heat><Insulation_Cold>5</Insulation_Cold><Insulation_Heat>5</Insulation_Heat><EquipDelay>3</EquipDelay></statBases>
  <costList><Steel>100</Steel><Plasteel>20</Plasteel><ComponentIndustrial>2</ComponentIndustrial></costList>
  <thingCategories><li>ApparelArmor</li></thingCategories>
