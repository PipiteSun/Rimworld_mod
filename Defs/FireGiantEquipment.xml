<Defs>
 <ThingDef ParentName="BaseMeleeWeapon_Blunt_Quality">
  <defName>LP_FireGiantMaul</defName><label>火巨人熔炉重锤</label>
  <description>为火巨人锻造的双手重锤。厚重铁锤头以玻璃钢加固，挥击缓慢却能重创披甲目标。只有具备熔火巨人本源的角色能够装备；在熔火锻炉制作。</description>
  <graphicData><texPath>FireGiant/Equipment/Maul</texPath><graphicClass>Graphic_Single</graphicClass><drawSize>(1.5,1.5)</drawSize></graphicData>
  <techLevel>Industrial</techLevel><equippedAngleOffset>-45</equippedAngleOffset>
  <statBases><MaxHitPoints>500</MaxHitPoints><Mass>12</Mass><WorkToMake>22000</WorkToMake><Flammability>0</Flammability></statBases>
  <costList><Steel>200</Steel><Plasteel>40</Plasteel></costList>
  <recipeMaker><recipeUsers Inherit="False"><li>LP_FireGiantForge</li></recipeUsers><researchPrerequisite>LP_GiantForging</researchPrerequisite><skillRequirements><Crafting>6</Crafting></skillRequirements></recipeMaker>
  <tools><li><label>锤头</label><capacities><li>Blunt</li></capacities><power>40</power><armorPenetration>0.35</armorPenetration><cooldownTime>3.6</cooldownTime></li></tools>
 </ThingDef>
 <ThingDef ParentName="ApparelBase">
