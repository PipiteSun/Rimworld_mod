<?xml version="1.0" encoding="utf-8"?>
<!-- 1.24.0 种族物品：元素符、象牙号角、食人魔大棒、风羽披风、寒冰魔尾刺、霜刺长枪、炎魔之心、炎魔火鞭、天穹之剑、神灯。
     种族制作限制、种族加成沿用 1.22.0 的 RaceGearExtension；附带能力沿用 CompGrantAbility。 -->
<Defs>
  <!-- ==================== 元素符 ==================== -->
  <ThingDef Name="LP_ElementalFocusBase" ParentName="LP_AccessoryBase" Abstract="True">
    <statBases><MarketValue>900</MarketValue></statBases>
    <apparel><bodyPartGroups><li>LeftHand</li></bodyPartGroups></apparel>
  </ThingDef>
  <ThingDef ParentName="LP_ElementalFocusBase">
    <defName>LP_ElementalFocus_Fire</defName>
    <label>炽焰符</label>
    <description>嵌着红色晶石的秘银护符，握在左手里微微发烫。炽焰血脉的元素裔或巨灵佩戴时：火花冷却减半，火焰伤害再减半（合计只受四分之一）。其他人佩戴：可燃性减半。只有炽焰血脉的元素裔能在附魔台制作。</description>
    <graphicData><texPath>Races124/Items/FocusFire</texPath><graphicClass>Graphic_Single</graphicClass></graphicData>
    <modExtensions><li Class="LichPhylactery.RaceGearExtension"><race>ElementFire</race></li></modExtensions>
  </ThingDef>
  <ThingDef ParentName="LP_ElementalFocusBase">
    <defName>LP_ElementalFocus_Water</defName>
    <label>潮汐符</label>
    <description>秘银框里封着一滴永不干涸的水。潮汐血脉的元素裔或巨灵佩戴时：水流冷却减半，灭火范围扩大到5×5。其他人佩戴：获得水中行动（浅水、沼泽不减速）。只有潮汐血脉的元素裔能在附魔台制作。</description>
    <graphicData><texPath>Races124/Items/FocusWater</texPath><graphicClass>Graphic_Single</graphicClass></graphicData>
    <modExtensions>
      <li Class="LichPhylactery.RaceGearExtension"><race>ElementWater</race></li>
      <li Class="LichPhylactery.AmphibiousExtension" />
    </modExtensions>
  </ThingDef>
  <ThingDef ParentName="LP_ElementalFocusBase">
    <defName>LP_ElementalFocus_Earth</defName>
    <label>岩石符</label>
    <description>一块精金打磨的沉重符石。岩石血脉的元素裔或巨灵佩戴时：采矿速度从×130%提高到×160%。其他人佩戴：采矿速度×115%。只有岩石血脉的元素裔能在附魔台制作。</description>
    <graphicData><texPath>Races124/Items/FocusEarth</texPath><graphicClass>Graphic_Single</graphicClass></graphicData>
    <modExtensions><li Class="LichPhylactery.RaceGearExtension"><race>ElementEarth</race></li></modExtensions>
  </ThingDef>
  <ThingDef ParentName="LP_ElementalFocusBase">
    <defName>LP_ElementalFocus_Air</defName>
    <label>疾风符</label>
    <description>秘银环上缠着永远飘动的布条。疾风血脉的元素裔或巨灵佩戴时：风跃冷却减半，移动速度从×110%提高到×120%。其他人佩戴：移动速度×105%。只有疾风血脉的元素裔能在附魔台制作。</description>
    <graphicData><texPath>Races124/Items/FocusAir</texPath><graphicClass>Graphic_Single</graphicClass></graphicData>
    <modExtensions><li Class="LichPhylactery.RaceGearExtension"><race>ElementAir</race></li></modExtensions>
  </ThingDef>
  <RecipeDef Name="LP_FocusRecipeBase" ParentName="LP_AlchemyRecipeBase" Abstract="True">
    <recipeUsers Inherit="False"><li>LP_EnchantingTable</li></recipeUsers>
    <workAmount>4000</workAmount>
  </RecipeDef>
  <RecipeDef ParentName="LP_FocusRecipeBase">
    <defName>LP_MakeElementalFocus_Fire</defName>
    <label>制作炽焰符</label>
    <description>用20秘银和50化合燃料制作一枚炽焰符。只有炽焰血脉的元素裔能做。</description>
    <jobString>正在制作炽焰符。</jobString>
    <ingredients>
      <li><filter><thingDefs><li>LP_Mithral</li></thingDefs></filter><count>20</count></li>
      <li><filter><thingDefs><li>Chemfuel</li></thingDefs></filter><count>50</count></li>
    </ingredients>
    <fixedIngredientFilter><thingDefs><li>LP_Mithral</li><li>Chemfuel</li></thingDefs></fixedIngredientFilter>
    <products><LP_ElementalFocus_Fire>1</LP_ElementalFocus_Fire></products>
  </RecipeDef>
  <RecipeDef ParentName="LP_FocusRecipeBase">
    <defName>LP_MakeElementalFocus_Water</defName>
    <label>制作潮汐符</label>
    <description>用20秘银和20份草药制作一枚潮汐符。只有潮汐血脉的元素裔能做。</description>
    <jobString>正在制作潮汐符。</jobString>
    <ingredients>
      <li><filter><thingDefs><li>LP_Mithral</li></thingDefs></filter><count>20</count></li>
      <li><filter><thingDefs><li>MedicineHerbal</li></thingDefs></filter><count>20</count></li>
    </ingredients>
    <fixedIngredientFilter><thingDefs><li>LP_Mithral</li><li>MedicineHerbal</li></thingDefs></fixedIngredientFilter>
    <products><LP_ElementalFocus_Water>1</LP_ElementalFocus_Water></products>
  </RecipeDef>
  <RecipeDef ParentName="LP_FocusRecipeBase">
    <defName>LP_MakeElementalFocus_Earth</defName>
    <label>制作岩石符</label>
    <description>用20秘银和5份精金制作一枚岩石符。只有岩石血脉的元素裔能做。</description>
    <jobString>正在制作岩石符。</jobString>
    <ingredients>
      <li><filter><thingDefs><li>LP_Mithral</li></thingDefs></filter><count>20</count></li>
      <li><filter><thingDefs><li>LP_Adamantine</li></thingDefs></filter><count>5</count></li>
    </ingredients>
    <fixedIngredientFilter><thingDefs><li>LP_Mithral</li><li>LP_Adamantine</li></thingDefs></fixedIngredientFilter>
    <products><LP_ElementalFocus_Earth>1</LP_ElementalFocus_Earth></products>
  </RecipeDef>
  <RecipeDef ParentName="LP_FocusRecipeBase">
    <defName>LP_MakeElementalFocus_Air</defName>
    <label>制作疾风符</label>
    <description>用20秘银和30份布制作一枚疾风符。只有疾风血脉的元素裔能做。</description>
    <jobString>正在制作疾风符。</jobString>
    <ingredients>
      <li><filter><thingDefs><li>LP_Mithral</li></thingDefs></filter><count>20</count></li>
      <li><filter><thingDefs><li>Cloth</li></thingDefs></filter><count>30</count></li>
    </ingredients>
    <fixedIngredientFilter><thingDefs><li>LP_Mithral</li><li>Cloth</li></thingDefs></fixedIngredientFilter>
    <products><LP_ElementalFocus_Air>1</LP_ElementalFocus_Air></products>
  </RecipeDef>

  <!-- ==================== 象牙号角 ==================== -->

  <!-- ==================== 食人魔大棒 ==================== -->

  <!-- ==================== 风羽披风 ==================== -->

  <!-- ==================== 寒冰魔尾刺、霜刺长枪 ==================== -->
  <ThingDef ParentName="ResourceBase">
    <defName>LP_IceDevilStinger</defName>
    <label>寒冰魔尾刺</label>
    <description>寒冰魔被遣返九狱时留下的尾刺，摸上去冷得扎手，永远不会融化。黑网和红袍商人都肯收购。</description>
    <graphicData><texPath>Races124/Items/IceDevilStinger</texPath><graphicClass>Graphic_StackCount</graphicClass></graphicData>
    <stackLimit>10</stackLimit>
    <useHitPoints>false</useHitPoints>
    <healthAffectsPrice>false</healthAffectsPrice>
    <techLevel>Medieval</techLevel>
    <statBases><MarketValue>300</MarketValue><Mass>0.6</Mass><Flammability>0</Flammability></statBases>
    <thingCategories><li>ItemsMisc</li></thingCategories>
    <tradeTags><li>LP_FiendLoot</li></tradeTags>
  </ThingDef>

  <!-- ==================== 炎魔之心、炎魔火鞭 ==================== -->
  <ThingDef ParentName="ResourceBase">
    <defName>LP_BalorHeart</defName>
    <label>炎魔之心</label>
    <description>炎魔崩解后留下的心脏，像一块还在跳动的熔岩。黑网和红袍商人都肯出高价收购。（以后可用来锻造火焰舌。）</description>
    <graphicData><texPath>Races124/Items/BalorHeart</texPath><graphicClass>Graphic_Single</graphicClass></graphicData>
    <stackLimit>1</stackLimit>
    <useHitPoints>false</useHitPoints>
    <healthAffectsPrice>false</healthAffectsPrice>
    <techLevel>Medieval</techLevel>
    <statBases><MarketValue>2500</MarketValue><Mass>2</Mass><Flammability>0</Flammability></statBases>
    <thingCategories><li>ItemsMisc</li></thingCategories>
    <tradeTags><li>LP_FiendLoot</li></tradeTags>
  </ThingDef>

  <!-- ==================== 天穹之剑 ==================== -->

  <!-- ==================== 神灯 ==================== -->
  <ThingDef ParentName="ResourceBase">
    <defName>LP_WonderLamp</defName>
    <label>神灯</label>
    <description>一盏古旧的黄铜油灯，灯身上刻着看不懂的符文。右键“擦拭神灯”：沉睡的神灯会召出一位巨灵加入殖民地（随机为火、水、土、风之一）；巨灵在外时神灯“有主”；巨灵被击倒或杀死时回到灯里，神灯“暗淡”15天，之后能再擦出同一个巨灵；灯里的巨灵与外界隔绝（不冻伤、不挨饿、不会死），擦出来是满状态；暗淡时选中神灯可花1000白银立刻唤醒。\n\n神灯必须留在你手里：卖掉、被偷或被毁，巨灵一天后就会离去。不能制作；黑网商队必带一盏，红袍商人偶尔也有。</description>
    <thingClass>LichPhylactery.WonderLamp</thingClass>
    <graphicData><texPath>Races124/Items/WonderLamp_Asleep</texPath><graphicClass>Graphic_Single</graphicClass></graphicData>
    <stackLimit>1</stackLimit>
    <useHitPoints>true</useHitPoints>
    <healthAffectsPrice>false</healthAffectsPrice>
    <techLevel>Medieval</techLevel>
    <statBases><MarketValue>3500</MarketValue><Mass>1</Mass><MaxHitPoints>300</MaxHitPoints><Flammability>0</Flammability><DeteriorationRate>0</DeteriorationRate></statBases>
    <thingCategories><li>ItemsMisc</li></thingCategories>
    <tradeTags><li>LP_WonderLamp</li></tradeTags>
    <smeltable>false</smeltable>
    <burnableByRecipe>false</burnableByRecipe>
  </ThingDef>
</Defs>
