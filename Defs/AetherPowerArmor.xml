<?xml version="1.0" encoding="utf-8"?>
<!-- 1.150.0 以太动力甲：两套 DND 后期动力甲（Peter 11-12 出的设计图）。
     奇械动力甲 + 奇械呼吸盔（青铜，不能染色）；誓约堡垒重甲 + 堡垒巨盔（钢灰金，灰色甲面可以染色）。
     研究在「魔法与炼金」页 (6,0.7) (7,0.7)；在原版制造台上做。
     不依赖搁置中的 Shelved/NewContent-1.126-1.127，也不依赖已删除的器械师/巨人锻造等内容。 -->
<Defs>

  <ResearchProjectDef>
    <defName>LP_Research_AetherArmor</defName>
    <label>以太动力甲</label>
    <description>把秘银织进动力甲的关节与伺服结构，用以太核心代替普通电池。能在制造台上制作「奇械动力甲」和「奇械呼吸盔」。</description>
    <baseCost>4000</baseCost>
    <techLevel>Spacer</techLevel>
    <prerequisites>
      <li>PoweredArmor</li>
      <li>LP_MythicMetallurgy</li>
      <li>LP_Research_WondrousCraft</li>
    </prerequisites>
    <tab>LP_FireGiantTech</tab>
    <researchViewX>6</researchViewX>
    <researchViewY>0.7</researchViewY>
  </ResearchProjectDef>

  <ResearchProjectDef>
    <defName>LP_Research_AetherBastion</defName>
    <label>誓约堡垒甲</label>
    <description>以精金铸造整块胸甲与肩甲，再刻上守誓符文，做出最厚重的动力甲。能在制造台上制作「誓约堡垒重甲」和「堡垒巨盔」。</description>
    <baseCost>6000</baseCost>
    <techLevel>Spacer</techLevel>
    <prerequisites>
      <li>LP_Research_AetherArmor</li>
    </prerequisites>
    <tab>LP_FireGiantTech</tab>
    <researchViewX>7</researchViewX>
    <researchViewY>0.7</researchViewY>
  </ResearchProjectDef>

  <ThingDef ParentName="ArmorMachineableBase">
    <defName>LP_AetherArtificerArmor</defName>
    <label>奇械动力甲</label>
    <description>青铜外壳、胸口嵌着以太核心的动力甲。秘银伺服让它比原版动力甲更灵活，背后的工具挂件和以太辅助让穿戴者干活更快。\n\n比海军动力甲略强，移动只慢一点。</description>
    <techLevel>Spacer</techLevel>
    <recipeMaker>
      <researchPrerequisite>LP_Research_AetherArmor</researchPrerequisite>
      <unfinishedThingDef>UnfinishedTechArmor</unfinishedThingDef>
      <skillRequirements><Crafting>8</Crafting></skillRequirements>
      <recipeUsers Inherit="False"><li>FabricationBench</li></recipeUsers>
      <displayPriority>110</displayPriority>
    </recipeMaker>
    <graphicData>
      <texPath>LP/AetherArmor/ArtificerArmor/ArtificerArmor_Icon</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <thingCategories><li>ApparelArmor</li></thingCategories>
    <tradeTags><li>HiTechArmor</li><li>Armor</li></tradeTags>
    <generateCommonality>0</generateCommonality>
    <statBases>
      <WorkToMake>60000</WorkToMake>
      <MaxHitPoints>380</MaxHitPoints>
      <Mass>12</Mass>
      <Flammability>0.3</Flammability>
      <ArmorRating_Sharp>1.1</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.48</ArmorRating_Blunt>
      <ArmorRating_Heat>0.56</ArmorRating_Heat>
      <Insulation_Cold>40</Insulation_Cold>
      <Insulation_Heat>12</Insulation_Heat>
      <EquipDelay>10</EquipDelay>
    </statBases>
    <equippedStatOffsets>
      <MoveSpeed>-0.2</MoveSpeed>
      <WorkSpeedGlobal>0.08</WorkSpeedGlobal>
      <SlaveSuppressionOffset MayRequire="Ludeon.RimWorld.Ideology">-0.3</SlaveSuppressionOffset>
      <VacuumResistance MayRequire="Ludeon.RimWorld.Odyssey">0.3</VacuumResistance>
    </equippedStatOffsets>
    <costList>
      <Plasteel>100</Plasteel>
      <LP_Mithral>40</LP_Mithral>
      <ComponentSpacer>4</ComponentSpacer>
    </costList>
    <apparel>
      <wornGraphicPath>LP/AetherArmor/ArtificerArmor/ArtificerArmor</wornGraphicPath>
      <bodyPartGroups><li>Torso</li><li>Neck</li><li>Shoulders</li><li>Arms</li><li>Legs</li></bodyPartGroups>
      <layers><li>Middle</li><li>Shell</li></layers>
      <defaultOutfitTags><li>Soldier</li></defaultOutfitTags>
      <useDeflectMetalEffect>true</useDeflectMetalEffect>
      <canBeGeneratedToSatisfyWarmth>false</canBeGeneratedToSatisfyWarmth>
    </apparel>
  </ThingDef>
  <ThingDef ParentName="ArmorHelmetMakeableBase">
    <defName>LP_AetherAcolyteHelm</defName>
    <label>奇械呼吸盔</label>
    <description>配套奇械动力甲的全封闭头盔，琥珀色目镜内置瞄准辅助，能缩短瞄准时间。</description>
    <techLevel>Spacer</techLevel>
    <recipeMaker>
      <researchPrerequisite>LP_Research_AetherArmor</researchPrerequisite>
      <unfinishedThingDef>UnfinishedTechArmor</unfinishedThingDef>
      <skillRequirements><Crafting>8</Crafting></skillRequirements>
      <recipeUsers Inherit="False"><li>FabricationBench</li></recipeUsers>
      <displayPriority>109</displayPriority>
    </recipeMaker>
    <graphicData>
      <texPath>LP/AetherArmor/AcolyteHelm/AcolyteHelm_Icon</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <tradeTags><li>HiTechArmor</li><li>Armor</li></tradeTags>
    <generateCommonality>0</generateCommonality>
    <statBases>
      <WorkToMake>22000</WorkToMake>
      <MaxHitPoints>140</MaxHitPoints>
      <Mass>1.5</Mass>
      <Flammability>0.3</Flammability>
      <ArmorRating_Sharp>1.1</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.48</ArmorRating_Blunt>
      <ArmorRating_Heat>0.56</ArmorRating_Heat>
      <Insulation_Cold>5</Insulation_Cold>
      <Insulation_Heat>3</Insulation_Heat>
      <EquipDelay>2</EquipDelay>
    </statBases>
    <equippedStatOffsets>
      <AimingDelayFactor>-0.1</AimingDelayFactor>
      <SlaveSuppressionOffset MayRequire="Ludeon.RimWorld.Ideology">-0.1</SlaveSuppressionOffset>
      <VacuumResistance MayRequire="Ludeon.RimWorld.Odyssey">0.65</VacuumResistance>
    </equippedStatOffsets>
    <costList>
      <Plasteel>35</Plasteel>
      <LP_Mithral>10</LP_Mithral>
      <ComponentSpacer>1</ComponentSpacer>
    </costList>
    <apparel>
      <wornGraphicPath>LP/AetherArmor/AcolyteHelm/AcolyteHelm</wornGraphicPath>
      <bodyPartGroups><li>FullHead</li></bodyPartGroups>
      <layers><li>Overhead</li></layers>
      <renderSkipFlags><li>Hair</li><li>Beard</li></renderSkipFlags>
