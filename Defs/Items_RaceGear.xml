  <!-- 矮人投掷锤 -->
  <ThingDef ParentName="BaseMeleeWeapon_Blunt_Quality">
    <defName>LP_DwarvenThrowingHammer</defName>
    <label>矮人投掷锤</label>
    <description>矮人铁匠打造的短柄战锤，锤头刻着回归符文。既能近战挥砸，也能用“投掷”能力掷向8格内的敌人，命中后锤子会自己飞回主人手中（冷却30秒）。矮人投掷没有冷却。只有矮人能在符文铁砧打造。</description>
    <graphicData><texPath>Items/RaceGear/DwarvenThrowingHammer</texPath><graphicClass>Graphic_Single</graphicClass></graphicData>
    <uiIconScale>1.2</uiIconScale>
    <techLevel>Medieval</techLevel>
    <costStuffCount>60</costStuffCount>
    <statBases><WorkToMake>9000</WorkToMake><Mass>1.6</Mass><MarketValue>260</MarketValue></statBases>
    <equippedAngleOffset>-65</equippedAngleOffset>
    <recipeMaker>
      <recipeUsers Inherit="False"><li>LP_RuneAnvil</li></recipeUsers>
      <researchPrerequisite>LP_RacialArmory</researchPrerequisite>
      <skillRequirements><Crafting>6</Crafting></skillRequirements>
      <displayPriority>410</displayPriority>
    </recipeMaker>
    <stuffCategories><li>Metallic</li></stuffCategories>
    <weaponTags><li>LP_DwarvenGear</li></weaponTags>
    <tradeTags><li>LP_DwarvenGear</li></tradeTags>
    <weaponClasses><li>Melee</li></weaponClasses>
    <tools>
      <li><label>锤柄</label><capacities><li>Poke</li></capacities><power>9</power><cooldownTime>2</cooldownTime></li>
      <li><label>锤头</label><labelUsedInLogging>false</labelUsedInLogging><capacities><li>Blunt</li></capacities><power>16</power><cooldownTime>2</cooldownTime></li>
    </tools>
    <comps>
      <li Class="LichPhylactery.CompProperties_GrantAbility"><ability>LP_HammerThrow</ability></li>
    </comps>
    <modExtensions><li Class="LichPhylactery.RaceGearExtension"><race>Dwarf</race></li></modExtensions>
  </ThingDef>
  <AbilityDef>
    <defName>LP_HammerThrow</defName>
    <label>投掷战锤</label>
    <description>把矮人投掷锤掷向8格内的目标，造成一次锤头伤害（随品质和材料提高），锤子随即飞回手中。冷却30秒；矮人使用没有冷却。</description>
    <iconPath>Items/Abilities/HammerThrow</iconPath>
    <hostile>true</hostile>
    <casterMustBeCapableOfViolence>true</casterMustBeCapableOfViolence>
    <cooldownTicksRange>1800</cooldownTicksRange>
    <displayGizmoWhileUndrafted>false</displayGizmoWhileUndrafted>
    <disableGizmoWhileUndrafted>true</disableGizmoWhileUndrafted>
    <aiCanUse>true</aiCanUse>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <warmupTime>0.5</warmupTime>
      <range>8</range>
      <soundCast>ThrowGrenade</soundCast>
      <targetParams>
        <canTargetPawns>true</canTargetPawns>
        <canTargetSelf>false</canTargetSelf>
        <canTargetBuildings>false</canTargetBuildings>
        <canTargetLocations>false</canTargetLocations>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="LichPhylactery.CompProperties_ItemAbility"><effect>hammer</effect></li>
    </comps>
  </AbilityDef>

