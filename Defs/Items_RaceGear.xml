  <ThingDef ParentName="ApparelBase">
    <defName>LP_BoneTalisman</defName>
    <label>骨质护符</label>
    <description>巫妖用骨片和人皮串成的护符。敌方死灵造物不会主动攻击佩戴者；佩戴者若先动手攻击死灵造物，它们照常还手。佩戴在饰品位置，不占用其他装备位置。只有巫妖能在死灵仪式台制作。</description>
    <graphicData><texPath>Items/RaceGear/BoneTalisman</texPath><graphicClass>Graphic_Single</graphicClass></graphicData>
    <techLevel>Medieval</techLevel>
    <statBases><MaxHitPoints>80</MaxHitPoints><Mass>0.2</Mass><MarketValue>500</MarketValue><EquipDelay>1</EquipDelay></statBases>
    <thingCategories><li>ApparelMisc</li></thingCategories>
    <tradeTags><li>LP_LichGear</li></tradeTags>
    <smeltable>false</smeltable>
    <apparel>
      <countsAsClothingForNudity>false</countsAsClothingForNudity>
      <bodyPartGroups><li>Torso</li></bodyPartGroups>
      <layers><li>LP_Accessory</li></layers>
      <tags><li>LP_LichGear</li></tags>
    </apparel>
    <modExtensions><li Class="LichPhylactery.RaceGearExtension"><race>Lich</race></li></modExtensions>
  </ThingDef>
  <RecipeDef>
    <defName>LP_MakeBoneTalisman</defName>
    <label>制作骨质护符</label>
    <description>巫妖用10份人皮和20份白银制作一枚骨质护符。只有巫妖能做。</description>
    <jobString>正在制作骨质护符。</jobString>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <workSkill>Crafting</workSkill>
    <workAmount>3000</workAmount>
    <recipeUsers Inherit="False"><li>LP_Altar</li></recipeUsers>
    <ingredients>
      <li><filter><thingDefs><li>Leather_Human</li></thingDefs></filter><count>10</count></li>
      <li><filter><thingDefs><li>Silver</li></thingDefs></filter><count>20</count></li>
    </ingredients>
    <fixedIngredientFilter><thingDefs><li>Leather_Human</li><li>Silver</li></thingDefs></fixedIngredientFilter>
    <products><LP_BoneTalisman>1</LP_BoneTalisman></products>
  </RecipeDef>
