<?xml version="1.0" encoding="utf-8"?>
<!-- 1.29.0 DND 枪械与法杖：两项研究（1.35.0 起在 Defs/Research.xml，“DND边缘大陆”页签）、13 件武器（D 魔法枪 3、E 高级魔法枪 2、F 魔力矮人枪械 5、G 法杖 3）、投射物、状态与寒霜伤害。
     F、G 组的伤害按射手心灵敏感度乘“魔力系数”（Source/Guns.cs）；伤害数值写的是系数 1.0 时的值。
     黑曜石用 Odyssey DLC 自带的 Obsidian（MayRequire，没装 Odyssey 时熔岩穿甲枪的配方不需要黑曜石）。 -->
<Defs>

  <!-- ==================== 基类 ==================== -->
  <ThingDef Name="LP_ArcaneGunBase" ParentName="BaseGunWithQuality" Abstract="True">
    <weaponTags>
      <li>LP_ArcaneGun</li>
    </weaponTags>
    <comps>
      <li Class="CompProperties_Biocodable"/>
    </comps>
    <uiIconScale>1.3</uiIconScale>
    <relicChance>0</relicChance>
  </ThingDef>
  <ThingDef Name="LP_StaffBase" ParentName="LP_ArcaneGunBase" Abstract="True">
    <techLevel>Medieval</techLevel>
    <smeltable>false</smeltable>
    <burnableByRecipe>true</burnableByRecipe>
    <equippedAngleOffset>-45</equippedAngleOffset>
    <statBases>
      <Flammability>1</Flammability>
      <Mass>2</Mass>
      <WorkToMake>14000</WorkToMake>
      <AccuracyTouch>0.85</AccuracyTouch>
      <AccuracyShort>0.80</AccuracyShort>
      <AccuracyMedium>0.70</AccuracyMedium>
      <AccuracyLong>0.55</AccuracyLong>
    </statBases>
    <tradeTags>
      <li>LP_Staff</li>
    </tradeTags>
    <recipeMaker>
      <workSpeedStat>LP_AlchemySpeed</workSpeedStat>
      <workSkill>Intellectual</workSkill>
      <effectWorking>Cook</effectWorking>
      <soundWorking>Recipe_Drug</soundWorking>
      <recipeUsers Inherit="False">
        <li>LP_EnchantingTable</li>
      </recipeUsers>
      <unfinishedThingDef>UnfinishedWeapon</unfinishedThingDef>
      <researchPrerequisite>LP_Research_Subduing</researchPrerequisite>
      <skillRequirements>
        <Intellectual>6</Intellectual>
      </skillRequirements>
    </recipeMaker>
    <!-- 双手长杖，也能当钝器 -->
    <tools>
      <li>
        <label>杖身</label>
        <capacities><li>Blunt</li></capacities>
        <power>9</power>
        <cooldownTime>2</cooldownTime>
      </li>
    </tools>
  </ThingDef>
  <ThingDef Name="LP_ArcaneBulletBase" ParentName="BaseBullet" Abstract="True">
    <thingClass>LichPhylactery.LP_ArcaneBullet</thingClass>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
  </ThingDef>

  <!-- ==================== D 组：魔法枪（普通枪） ==================== -->



  <!-- ==================== E 组：高级魔法枪（不能制作） ==================== -->

  <!-- 天火降世：伤害、穿甲、射程与原版电荷长枪相同（启动时同步，见 Source/Guns.cs 的 GunStartup），瞄准和冷却各少 30%。 -->

  <!-- ==================== F 组：魔力矮人枪械（魔力系数 = 0.5 + 0.5 × 敏感度，上限 2） ==================== -->





  <!-- ==================== G 组：法杖（魔力系数 = 心灵敏感度，最低 0.2、不封顶；敏感度 0 不能用） ==================== -->



  <!-- ==================== 伤害与状态 ==================== -->
  <DamageDef>
    <defName>LP_Frost</defName>
    <label>寒霜</label>
    <workerClass>DamageWorker_AddInjury</workerClass>
    <externalViolence>true</externalViolence>
    <deathMessage>{0}被冻成了冰雕。</deathMessage>
    <hediff>Frostbite</hediff>
    <hediffSolid>Crack</hediffSolid>
    <harmAllLayersUntilOutside>true</harmAllLayersUntilOutside>
    <impactSoundType>Blunt</impactSoundType>
    <armorCategory>Heat</armorCategory>
    <defaultDamage>12</defaultDamage>
    <defaultArmorPenetration>0.15</defaultArmorPenetration>
    <isRanged>true</isRanged>
    <makesAnimalsFlee>true</makesAnimalsFlee>
  </DamageDef>

  <HediffDef Name="LP_GunHediffBase" Abstract="True">
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>true</isBad>
    <scenarioCanAdd>false</scenarioCanAdd>
    <initialSeverity>1</initialSeverity>
    <comps>
      <li Class="HediffCompProperties_Disappears"><disappearsAfterTicks>180~180</disappearsAfterTicks><showRemainingTime>true</showRemainingTime></li>
    </comps>
  </HediffDef>
  <HediffDef ParentName="LP_GunHediffBase">
    <defName>LP_RuneBrand</defName>
    <label>符文灼印</label>
    <description>被山岳之怒打出的符文还在发烫：受到的魔力伤害（符文枪械、法杖）+15%。</description>
    <defaultLabelColor>(1,0.75,0.35)</defaultLabelColor>
  </HediffDef>
  <HediffDef ParentName="LP_GunHediffBase">
    <defName>LP_FrostStaffChill</defName>
    <label>寒霜缠身</label>
    <description>被寒霜弹冻住了半边身子：移速 -40%。</description>
    <defaultLabelColor>(0.6,0.85,1)</defaultLabelColor>
    <comps Inherit="False">
      <li Class="HediffCompProperties_Disappears"><disappearsAfterTicks>240~240</disappearsAfterTicks><showRemainingTime>true</showRemainingTime></li>
    </comps>
    <stages><li><statFactors><MoveSpeed>0.6</MoveSpeed></statFactors></li></stages>
  </HediffDef>
</Defs>
