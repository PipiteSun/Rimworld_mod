<?xml version="1.0" encoding="utf-8"?>
<!-- 1.62.0 DND 性格特性与诅咒之力（ArtSource/Traits-1.62.0-spec.md；代码在 Source/DndTraits.cs）。
     性格特性（阵营 / 种族互动 / 职业天赋 / 怪癖）commonality 0：生成后缀（DndTraits.OnGenerated）自己掷，每人最多 2 个、最多 1 个阵营，只用原版 3 个特性名额里的空位。
     诅咒之力（红色）算强力特性（1.66.0 热修：可以和其他强力特性并存，诅咒之间用 LP_Curse 互斥），由 HeroTraits.OnGenerated 的同一次随机给出（KindCurse）。
     同一特性不同程度的互斥（仁善 × 心理变态等）在代码里判断（TraitDef 的互斥不分程度）。数值写在描述里，规则在代码里。 -->
<Defs>

  <!-- ==================== 阵营 ==================== -->
  <TraitDef>
    <defName>LP_Order</defName>
    <commonality>0</commonality>
    <degreeDatas>
      <li>
        <degree>1</degree>
        <label>守序</label>
        <description>{PAWN_nameDef}相信规矩、秩序和说到做到。\n\n- 作息表“工作”时段内全局工作速度 +5%\n- 不会发生纵火、乱跑、出走类精神崩溃\n- 殖民地有领袖或头衔持有者：心情 +3「秩序井然」\n- 自己的作息表全是“任意”：心情 -3「毫无章法」</description>
      </li>
      <li>
        <degree>-1</degree>
        <label>混乱</label>
        <description>{PAWN_nameDef}讨厌被管着，想到什么就做什么。\n\n- 灵感出现的几率 ×1.5\n- 连续征召超过 6 小时：心情 -4「被管束」</description>
      </li>
    </degreeDatas>
    <modExtensions>
      <li Class="LichPhylactery.TraitRarityExt"><tier>Common</tier><kind>性格特性</kind></li>
    </modExtensions>
  </TraitDef>

  <TraitDef>
    <defName>LP_Morality</defName>
    <commonality>0</commonality>
    <degreeDatas>
      <li>
        <degree>1</degree>
        <label>仁善</label>
        <description>{PAWN_nameDef}心地善良，见不得别人受苦。\n\n- 救援倒地的人、给囚犯包扎：心情 +2「善举」\n- 用制伏武器打倒敌人（不伤性命）：心情 +2「手下留情」\n- 处决、摘取器官带来的坏心情之外再 -5「良心不安」\n- 殖民地有死灵造物：心情 -2\n- 装了 VPE 时，牧师路径的神圣伤害 +15%\n- 不会和心理变态、嗜血、巫妖信徒同时出现；成为巫妖后失去这个特性</description>
      </li>
      <li>
        <degree>-1</degree>
        <label>邪恶</label>
        <description>{PAWN_nameDef}只在乎自己想要什么，别人的痛苦不算什么。\n\n- 处决、摘取器官、奴役不会让{PAWN_objective}心情变差\n- 压制奴隶的效果 +20%\n- 殖民地有巫妖：心情 +2「黑暗庇护」\n- 不会和善良、不死猎人同时出现</description>
      </li>
    </degreeDatas>
    <modExtensions>
      <li Class="LichPhylactery.TraitRarityExt"><tier>Common</tier><kind>性格特性</kind></li>
    </modExtensions>
  </TraitDef>

  <!-- ==================== 种族互动 ==================== -->
  <TraitDef>
    <defName>LP_DragonStance</defName>
    <commonality>0</commonality>
    <degreeDatas>
      <li>
        <degree>-1</degree>
        <label>惧龙</label>
        <description>{PAWN_nameDef}小时候见过龙烧掉一整座村子。\n\n- 地图上有龙：心情 -6「龙威压顶」\n- 龙在 10 格内时，每隔几秒有 10% 的几率掉头逃开\n- 龙裔和五色真龙不会有这个特性</description>
      </li>
      <li>
        <degree>1</degree>
        <label><![CDATA[<color=#7FBF6A>屠龙志士</color>]]></label>
        <description>{PAWN_nameDef}发过誓，这辈子要亲手斩下一条龙。\n\n- 对龙的伤害 +20%（和其他类型伤害加成合计最多 +60%）\n- 击杀龙：心情 +10，持续 10 天\n- 对殖民地的龙裔好感 -10\n- 龙裔不会有这个特性</description>
      </li>
    </degreeDatas>
    <modExtensions>
      <li Class="LichPhylactery.TraitRarityExt"><tier>Common</tier><kind>性格特性</kind><degrees><li>1:Uncommon</li></degrees></li>
    </modExtensions>
  </TraitDef>

  <TraitDef>
    <defName>LP_GiantStance</defName>
    <commonality>0</commonality>
    <degreeDatas>
      <li>
        <degree>1</degree>
        <label>巨人仆从</label>
        <description>{PAWN_nameDef}在巨人的宅邸里长大，跟在大个子身边才踏实。\n\n- 在体型 1.5 以上的殖民者 3 格内干活，全局工作速度 +10%\n- 对体型 1.5 以上的殖民者好感 +15</description>
      </li>
      <li>
        <degree>-1</degree>
        <label><![CDATA[<color=#7FBF6A>巨人杀手</color>]]></label>
        <description>{PAWN_nameDef}专门学过怎么对付比自己高三倍的东西。\n\n- 近战攻击体型 1.5 以上的目标伤害 +20%（和其他类型伤害加成合计最多 +60%）\n- 躲闪体型 1.5 以上敌人的近战攻击 +10%\n- 对巨人好感 -10\n- 巨人种族不会有这个特性</description>
      </li>
    </degreeDatas>
    <modExtensions>
      <li Class="LichPhylactery.TraitRarityExt"><tier>Common</tier><kind>性格特性</kind><degrees><li>-1:Uncommon</li></degrees></li>
    </modExtensions>
  </TraitDef>

  <TraitDef>
    <defName>LP_UndeadStance</defName>
    <commonality>0</commonality>
    <degreeDatas>
      <li>
        <degree>1</degree>
        <label>巫妖信徒</label>
        <description>{PAWN_nameDef}相信不朽的巫妖才是这个世界真正的主人。\n\n- 殖民地有巫妖：心情 +4</description>
      </li>
      <li>
        <degree>-1</degree>
        <label><![CDATA[<color=#7FBF6A>不死猎人</color>]]></label>
        <description>{PAWN_nameDef}把一辈子都花在了让死者安息上。\n\n- 对不死生物的伤害 +20%（和其他类型伤害加成合计最多 +60%）\n- 殖民地有巫妖或死灵造物：心情 -6\n- 巫妖和不死种族不会有这个特性</description>
      </li>
    </degreeDatas>
    <modExtensions>
      <li Class="LichPhylactery.TraitRarityExt"><tier>Common</tier><kind>性格特性</kind><degrees><li>-1:Uncommon</li></degrees></li>
    </modExtensions>
  </TraitDef>

  <TraitDef>
    <defName>LP_RaceAttitude</defName>
    <commonality>0</commonality>
    <degreeDatas>
      <li>
        <degree>1</degree>
        <label>世界公民</label>
        <description>{PAWN_nameDef}走过很多地方，和哪个种族都处得来。\n\n- 不受种族关系的负面心情影响\n- 殖民地每多一个种族，心情 +1（最多 +4）</description>
      </li>
      <li>
        <degree>-1</degree>
        <label>纯血至上</label>
        <description>{PAWN_nameDef}觉得只有自己的种族靠得住。\n\n- 对同种族的人好感 +10，对其他种族 -10\n- 本种族在殖民地占多数：心情 +3，否则 -3</description>
      </li>
    </degreeDatas>
    <modExtensions>
      <li Class="LichPhylactery.TraitRarityExt"><tier>Common</tier><kind>性格特性</kind></li>
    </modExtensions>
  </TraitDef>

  <TraitDef>
    <defName>LP_HiveSurvivor</defName>
    <commonality>0</commonality>
    <degreeDatas>
      <li>
        <label><![CDATA[<color=#7FBF6A>殖巢幸存者</color>]]></label>
        <description>{PAWN_nameDef}从夺心魔的殖巢里活着逃了出来。\n\n- 心智抗性 +50%\n- 地图上有夺心魔：心情 -4\n- 对吉斯洋基好感 +10\n- “逃离殖巢”开局的人类俘虏必带\n- 夺心魔和半夺心魔不会有这个特性</description>
        <statOffsets><LP_MindResist>0.5</LP_MindResist></statOffsets>
      </li>
    </degreeDatas>
    <modExtensions>
      <li Class="LichPhylactery.TraitRarityExt"><tier>Uncommon</tier><kind>性格特性</kind></li>
    </modExtensions>
  </TraitDef>

  <TraitDef>
    <defName>LP_DragonServant</defName>
    <commonality>0</commonality>
    <degreeDatas>
      <li>
        <label>龙之眷从</label>
        <description>{PAWN_nameDef}的祖辈世代侍奉龙。\n\n- 殖民地有龙裔殖民者：心情 +4\n- 把东西搬进龙裔的宝库时移动速度 +30%\n- 不会从龙宝库里往外搬东西\n- 殖民地的龙死去：心情 -15\n- 狗头人出现这个特性的几率 ×5；龙裔不会有这个特性</description>
      </li>
    </degreeDatas>
    <modExtensions>
      <li Class="LichPhylactery.TraitRarityExt"><tier>Common</tier><kind>性格特性</kind></li>
    </modExtensions>
  </TraitDef>

  <TraitDef>
    <defName>LP_GithExile</defName>
    <commonality>0</commonality>
    <degreeDatas>
      <li>
        <label>吉斯流亡者</label>
        <description>{PAWN_nameDef}背弃了巫妖女王维拉基斯。\n\n- 不再因为见到殖民地的巫妖而高兴（替代吉斯洋基原有的巫妖心情）\n- 对巫妖好感 -10\n- 只会出现在吉斯洋基身上</description>
      </li>
    </degreeDatas>
    <modExtensions>
      <li Class="LichPhylactery.TraitRarityExt"><tier>Common</tier><kind>性格特性</kind></li>
    </modExtensions>
  </TraitDef>

  <!-- ==================== 职业天赋 ==================== -->
  <TraitDef>
    <defName>LP_Tactician</defName>
    <commonality>0</commonality>
    <degreeDatas>
      <li>
        <label><![CDATA[<color=#7FBF6A>战术家</color>]]></label>
        <description>{PAWN_nameDef}天生会看战场。\n\n- 被征召时，4 格内的友军近战与射击命中 +5%（多个战术家不叠加）\n- 装了 VPE 时：战士路径经验 +25%（和背景、魔网之子等的经验加成取较高，不叠加）</description>
      </li>
    </degreeDatas>
    <modExtensions>
      <li Class="LichPhylactery.TraitRarityExt"><tier>Uncommon</tier><kind>性格特性</kind></li>
    </modExtensions>
  </TraitDef>

  <TraitDef>
    <defName>LP_ArcaneGift</defName>
    <commonality>0</commonality>
    <degreeDatas>
      <li>
        <label><![CDATA[<color=#7FBF6A>奥术天赋</color>]]></label>
        <description>{PAWN_nameDef}对魔网的流动格外敏感。\n\n- 装了 VPE 时：法师路径经验 +25%（与其他经验加成取较高），心灵熵消耗 -10%\n- 没装 VPE 时：心灵敏感度 +10%\n- 不会和狂野魔法同时出现</description>
      </li>
    </degreeDatas>
    <modExtensions>
      <li Class="LichPhylactery.TraitRarityExt"><tier>Uncommon</tier><kind>性格特性</kind></li>
    </modExtensions>
  </TraitDef>

  <TraitDef>
    <defName>LP_WildMagic</defName>
    <commonality>0</commonality>
    <degreeDatas>
      <li>
        <label><![CDATA[<color=#7FBF6A>狂野魔法</color>]]></label>
        <description>{PAWN_nameDef}身上的魔力从来不太听话。\n\n- 装了 VPE 时：每次施放能力有 5% 的几率引发魔力浪涌；法术伤害 +10%\n- 没装 VPE 时：每天随机一次小浪涌\n- 浪涌共 12 种：隐身 10 秒、脚下长花、敌人头上落下小火球、全队治疗 5 点、召唤一只友善的鸡、心灵熵清空、移速 +50% 1 小时、获得一次灵感、周围敌人眩晕 2 秒；或者自己身上着小火、皮肤变绿 1 天、原地发呆 5 秒。都不会致命\n- 不会和奥术天赋、魔法恐惧同时出现</description>
      </li>
    </degreeDatas>
    <modExtensions>
      <li Class="LichPhylactery.TraitRarityExt"><tier>Uncommon</tier><kind>性格特性</kind></li>
    </modExtensions>
  </TraitDef>

  <TraitDef>
    <defName>LP_Tinkerer</defName>
    <commonality>0</commonality>
    <degreeDatas>
      <li>
        <label><![CDATA[<color=#7FBF6A>机械迷</color>]]></label>
        <description>{PAWN_nameDef}看见齿轮就挪不开眼。\n\n- 修理建筑速度 +20%\n- 装了 VPE 时：器械师路径经验 +25%（与其他经验加成取较高），火器射击冷却 -5%</description>
      </li>
    </degreeDatas>
    <modExtensions>
      <li Class="LichPhylactery.TraitRarityExt"><tier>Uncommon</tier><kind>性格特性</kind></li>
    </modExtensions>
  </TraitDef>

  <TraitDef>
    <defName>LP_NatureBond</defName>
    <commonality>0</commonality>
    <degreeDatas>
      <li>
        <label><![CDATA[<color=#7FBF6A>自然之子</color>]]></label>
        <description>{PAWN_nameDef}在林子里比在屋里自在。\n\n- 待在户外：心情 +2\n- 驯服、训练动物的成功率 +15%\n- 装了 VPE 时：德鲁伊路径经验 +25%（与其他经验加成取较高）</description>
      </li>
    </degreeDatas>
    <modExtensions>
      <li Class="LichPhylactery.TraitRarityExt"><tier>Uncommon</tier><kind>性格特性</kind></li>
    </modExtensions>
  </TraitDef>

  <!-- ==================== 怪癖 ==================== -->
  <TraitDef>
    <defName>LP_Magephobe</defName>
    <commonality>0</commonality>
    <degreeDatas>
      <li>
        <label>魔法恐惧</label>
        <description>{PAWN_nameDef}不信任任何会施法的人。\n\n- 对有灵能、会施法的人好感 -10\n- 被别人施加增益法术：心情 -3\n- 受到敌方法术的伤害 -10%</description>
      </li>
    </degreeDatas>
    <modExtensions>
      <li Class="LichPhylactery.TraitRarityExt"><tier>Common</tier><kind>性格特性</kind></li>
    </modExtensions>
  </TraitDef>

  <TraitDef>
    <defName>LP_ArcaneCraving</defName>
    <commonality>0</commonality>
    <degreeDatas>
      <li>
        <label>秘法上瘾</label>
        <description>{PAWN_nameDef}迷上了魔法流过身体的感觉。\n\n- 超过 5 天没用过魔法药水或魔法卷轴：心情 -6「秘法渴求」\n- 用了一瓶魔法药水或一张魔法卷轴：心情 +4，持续 2 天</description>
      </li>
    </degreeDatas>
    <modExtensions>
      <li Class="LichPhylactery.TraitRarityExt"><tier>Common</tier><kind>性格特性</kind></li>
    </modExtensions>
  </TraitDef>

  <TraitDef>
    <defName>LP_TreasureHunter</defName>
    <commonality>0</commonality>
    <degreeDatas>
      <li>
        <label><![CDATA[<color=#7FBF6A>寻宝狂</color>]]></label>
        <description>{PAWN_nameDef}听到“宝藏”两个字就坐不住。\n\n- 法师塔坠落、进入迷锁地牢：心情 +5「冒险的召唤」\n- 拆除古代遗迹多得 20% 材料\n- 有寻宝狂在迷锁地牢里时，地牢的宝物有 10% 的几率多出一件</description>
      </li>
    </degreeDatas>
    <modExtensions>
      <li Class="LichPhylactery.TraitRarityExt"><tier>Uncommon</tier><kind>性格特性</kind></li>
    </modExtensions>
  </TraitDef>

  <TraitDef>
    <defName>LP_PlaneTouched</defName>
    <commonality>0</commonality>
    <degreeDatas>
      <li>
        <label>位面错乱</label>
        <description>{PAWN_nameDef}曾在两个位面之间迷失了很久。\n\n- 位面裂隙里钻出来的野兽不会主动攻击{PAWN_objective}\n- 每 10～15 天会出神 1 小时\n- 传送类能力冷却 -20%</description>
      </li>
    </degreeDatas>
    <modExtensions>
      <li Class="LichPhylactery.TraitRarityExt"><tier>Common</tier><kind>性格特性</kind></li>
    </modExtensions>
  </TraitDef>

  <!-- ==================== 诅咒之力（红色，占强力特性名额） ==================== -->
  <TraitDef>
    <defName>LP_Revenant</defName>
    <commonality>0</commonality>
    <exclusionTags><li>LP_Curse</li></exclusionTags>
    <degreeDatas>
      <li>
        <degree>0</degree>
        <label><![CDATA[<color=#D05050>复仇亡魂</color>]]></label>
        <description>{PAWN_nameDef}发过血誓：害死{PAWN_objective}的人，一个也跑不掉。\n\n- 被敌对派系的人杀死、凶手还活着时：12 小时后在尸体处复活（伤势全愈，带「亡魂之躯」）；尸体被焚毁或不在了就不能复活。复活后冷却 60 天\n- 对凶手所在派系的伤害 +30%（和其他类型伤害加成合计最多 +60%）\n- 凶手和{PAWN_objective}在同一张地图上时不能隐身\n- 亲手杀死凶手：一次获得升到下一级所需经验的 50%，特性变为「安息之魂」\n\n「亡魂之躯」：受到治疗的效果 -50%、自然愈合 -30%、不会饿死但吃东西没有好心情；殖民者对{PAWN_objective}好感 -10（仁善的人再 -5）。</description>
      </li>
      <li>
        <degree>1</degree>
        <label><![CDATA[<color=#7FBF6A>安息之魂</color>]]></label>
        <description>{PAWN_nameDef}的血仇已经报了，亡魂终于安息。\n\n- 对昔日凶手所在派系的伤害 +15%（和其他类型伤害加成合计最多 +60%）\n- 不再死后复活</description>
      </li>
    </degreeDatas>
    <modExtensions>
      <li Class="LichPhylactery.TraitRarityExt"><tier>Epic</tier><kind>诅咒之力</kind><mark>Curse</mark><degrees><li>1:Uncommon:None</li></degrees></li>
    </modExtensions>
  </TraitDef>

  <TraitDef>
    <defName>LP_Lycanthrope</defName>
    <commonality>0</commonality>
    <exclusionTags><li>LP_Curse</li></exclusionTags>
    <degreeDatas>
      <li>
        <degree>1</degree>
        <label><![CDATA[<color=#D05050>兽化症·狼</color>]]></label>
        <description>{PAWN_nameDef}的血里住着一头狼。\n\n- 每 10～15 天、或者血量低于 30% 时，强制化身狼形 6 小时：近战伤害 ×2、移动速度 +1、每小时恢复 10 点伤势；非银、非魔法武器造成的伤害 -50%（法术、神术不减）\n- 化身期间会狂暴地扑向最近的敌人；附近没有敌人时有 10% 的几率攻击殖民者和家畜\n- 冒险者 10 级起「驯服野性」：不再强制化身、不再失控，可以每天主动化身一次\n- 化身时咬伤别人有 5% 的几率传染（对方已有强力特性时不会）\n- 圣水能伤到{PAWN_objective}</description>
      </li>
      <li>
        <degree>2</degree>
        <label><![CDATA[<color=#D05050>兽化症·熊</color>]]></label>
        <description>{PAWN_nameDef}的血里住着一头熊。\n\n- 每 10～15 天、或者血量低于 30% 时，强制化身熊形 6 小时：近战伤害 ×2、移动速度 +1、每小时恢复 10 点伤势；非银、非魔法武器造成的伤害 -50%（法术、神术不减）\n- 化身期间会狂暴地扑向最近的敌人；附近没有敌人时有 10% 的几率攻击殖民者和家畜\n- 冒险者 10 级起「驯服野性」：不再强制化身、不再失控，可以每天主动化身一次\n- 化身时咬伤别人有 5% 的几率传染（对方已有强力特性时不会）\n- 圣水能伤到{PAWN_objective}</description>
      </li>
      <li>
        <degree>3</degree>
        <label><![CDATA[<color=#D05050>兽化症·虎</color>]]></label>
        <description>{PAWN_nameDef}的血里住着一头虎。\n\n- 每 10～15 天、或者血量低于 30% 时，强制化身虎形 6 小时：近战伤害 ×2、移动速度 +1、每小时恢复 10 点伤势；非银、非魔法武器造成的伤害 -50%（法术、神术不减）\n- 化身期间会狂暴地扑向最近的敌人；附近没有敌人时有 10% 的几率攻击殖民者和家畜\n- 冒险者 10 级起「驯服野性」：不再强制化身、不再失控，可以每天主动化身一次\n- 化身时咬伤别人有 5% 的几率传染（对方已有强力特性时不会）\n- 圣水能伤到{PAWN_objective}</description>
