  <!-- ===================== 堡垒工程师：建筑 ===================== -->
  <ThingDef ParentName="BuildingBase">
    <defName>LP_RuneMine</defName>
    <label>符文地雷</label>
    <description>堡垒工程师埋下的符文：敌人踩上去受 20 × 器械强度 奥术力伤害、倒地 2 秒，然后符文消散。藏在地面里，敌人很难察觉。</description>
    <thingClass>LichPhylactery.Building_RuneMine</thingClass>
    <graphicData><texPath>Things/Building/LP_RuneMine</texPath><graphicClass>Graphic_Single</graphicClass></graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <rotatable>false</rotatable>
    <tickerType>Normal</tickerType>
    <stealable>false</stealable>
    <passability>Standable</passability>
    <statBases><MaxHitPoints>30</MaxHitPoints><Flammability>0</Flammability><Beauty>0</Beauty><TrapSpringChance>1</TrapSpringChance></statBases>
    <building><isTrap>true</isTrap><trapDestroyOnSpring>true</trapDestroyOnSpring><expandHomeArea>false</expandHomeArea><ai_chillDestination>false</ai_chillDestination></building>
  </ThingDef>
  <ThingDef ParentName="BuildingBase">
    <defName>LP_ArcaneCapacitor</defName>
    <label>奥术电容</label>
    <description>堡垒工程师的符文电容：不用燃料，一直输出 300 瓦。3 格内的炮台射速 +15%。每个会「奥术电容」的工程师最多支撑 器械师等级 ÷ 3 台（全殖民地合计）。</description>
    <thingClass>LichPhylactery.Building_ArcaneCapacitor</thingClass>
    <graphicData><texPath>Things/Building/LP_ArcaneCapacitor</texPath><graphicClass>Graphic_Single</graphicClass><drawSize>(1,1)</drawSize></graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <fillPercent>0.4</fillPercent>
    <pathCost>42</pathCost>
    <rotatable>false</rotatable>
    <tickerType>Normal</tickerType>
    <canOverlapZones>false</canOverlapZones>
    <statBases><MaxHitPoints>150</MaxHitPoints><WorkToBuild>1500</WorkToBuild><Flammability>0</Flammability><Mass>10</Mass><Beauty>0</Beauty></statBases>
    <costList><Steel>20</Steel><ComponentIndustrial>1</ComponentIndustrial></costList>
    <designationCategory>Power</designationCategory>
