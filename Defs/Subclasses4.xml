    <stages><li><statOffsets><ToxicEnvironmentResistance>1</ToxicEnvironmentResistance></statOffsets></li></stages>
  </HediffDef>

  <!-- ===================== 装甲师：状态 ===================== -->
  <HediffDef>
    <defName>LP_AR_ArmorOn</defName>
    <hediffClass>LichPhylactery.Hediff_ArcaneArmor</hediffClass>
    <label>奥术装甲</label>
    <description>穿着装甲师亲手改过的奥术装甲：装甲不再拖慢移动。渗透者模式移动 +10%；甲胄升级后三种护甲各 +15%；完美装甲完全密封（毒尘、毒雾、真空都不怕）。脱下或换甲就失效。</description>
    <isBad>false</isBad><everCurableByItem>false</everCurableByItem><scenarioCanAdd>false</scenarioCanAdd><defaultLabelColor>(0.62,0.66,0.74)</defaultLabelColor>
  </HediffDef>
