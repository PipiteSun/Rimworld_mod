      <li Class="LichPhylactery.CompProperties_AlchemistPotion" />
    </comps>
  </ThingDef>
  <ThingDef ParentName="LP_ALPotionBase">
    <defName>LP_ALP_Healing</defName>
    <label>治愈药剂</label>
    <description>炼金师的实验药剂。喝下后止住所有出血，立刻治疗 20 点伤口。谁都能喝，3 天就坏。精炼药剂治疗量 ×1.3。</description>
