  </ThingDef>
  <ThingDef ParentName="LP_PotionBase">
    <defName>LP_ALP_Restorative</defName>
    <label>复原试剂</label>
    <description>炼金师的复原试剂。喝下后治好身上最重的一种疾病（流感、瘟疫、疟疾、昏睡病、肠道或肌肉寄生虫、纤维 / 感官机械虫、食物中毒、伤口感染、肺腐病）；没有病就清除毒素累积。谁都能喝，不会坏。</description>
    <graphicData><texPath>Items/Alchemist/Restorative</texPath><graphicClass>Graphic_Single</graphicClass></graphicData>
    <stackLimit>10</stackLimit>
    <tradeTags Inherit="False" />
    <thingCategories><li>Drugs</li></thingCategories>
    <statBases><MarketValue>150</MarketValue></statBases>
    <ingestible><outcomeDoers><li Class="LichPhylactery.IngestionOutcomeDoer_Alchemist"><effect>restore</effect></li></outcomeDoers></ingestible>
    <comps><li Class="CompProperties_Drug"><listOrder>2406</listOrder></li></comps>
  </ThingDef>
  <ThingDef ParentName="LP_PotionBase">
    <defName>LP_ALP_GreaterRestorative</defName>
    <label>大复原药剂</label>
    <description>化学大师每季只做得出一瓶的药剂。喝下后长回一个缺失的肢体或器官（最大的那个），并清除所有疾病、成瘾和毒素累积。谁都能喝，不会坏。</description>
    <graphicData><texPath>Items/Alchemist/GreaterRestorative</texPath><graphicClass>Graphic_Single</graphicClass></graphicData>
    <stackLimit>5</stackLimit>
    <tradeTags Inherit="False" />
    <thingCategories><li>Drugs</li></thingCategories>
    <statBases><MarketValue>1200</MarketValue></statBases>
    <ingestible><outcomeDoers><li Class="LichPhylactery.IngestionOutcomeDoer_Alchemist"><effect>greater</effect></li></outcomeDoers></ingestible>
    <comps><li Class="CompProperties_Drug"><listOrder>2407</listOrder></li></comps>
  </ThingDef>

  <!-- 药物实验室：1 草药 + 5 钢 → 1 瓶指定药剂，只有炼金师能做。 -->
  <RecipeDef Name="LP_ALRecipeBase" Abstract="True">
    <workSpeedStat>DrugSynthesisSpeed</workSpeedStat>
    <workSkill>Intellectual</workSkill>
    <effectWorking>Cook</effectWorking>
    <soundWorking>Recipe_Drug</soundWorking>
    <recipeUsers><li>DrugLab</li></recipeUsers>
    <workAmount>1250</workAmount>
    <allowMixingIngredients>false</allowMixingIngredients>
    <ingredients>
      <li><filter><thingDefs><li>MedicineHerbal</li></thingDefs></filter><count>1</count></li>
      <li><filter><thingDefs><li>Steel</li></thingDefs></filter><count>5</count></li>
    </ingredients>
    <fixedIngredientFilter><thingDefs><li>MedicineHerbal</li><li>Steel</li></thingDefs></fixedIngredientFilter>
    <modExtensions><li Class="LichPhylactery.AlchemistRecipeExtension" /></modExtensions>
  </RecipeDef>
  <RecipeDef ParentName="LP_ALRecipeBase"><defName>LP_Make_ALP_Healing</defName><label>调配治愈药剂</label><description>用 1 份草药和 5 钢调配 1 瓶治愈药剂。只有炼金师能做（器械师 7 级起是精炼药剂）。</description><jobString>正在调配治愈药剂。</jobString><products><LP_ALP_Healing>1</LP_ALP_Healing></products></RecipeDef>
  <RecipeDef ParentName="LP_ALRecipeBase"><defName>LP_Make_ALP_Swift</defName><label>调配迅捷药剂</label><description>用 1 份草药和 5 钢调配 1 瓶迅捷药剂。只有炼金师能做（器械师 7 级起是精炼药剂）。</description><jobString>正在调配迅捷药剂。</jobString><products><LP_ALP_Swift>1</LP_ALP_Swift></products></RecipeDef>
  <RecipeDef ParentName="LP_ALRecipeBase"><defName>LP_Make_ALP_Tough</defName><label>调配坚韧药剂</label><description>用 1 份草药和 5 钢调配 1 瓶坚韧药剂。只有炼金师能做（器械师 7 级起是精炼药剂）。</description><jobString>正在调配坚韧药剂。</jobString><products><LP_ALP_Tough>1</LP_ALP_Tough></products></RecipeDef>
  <RecipeDef ParentName="LP_ALRecipeBase"><defName>LP_Make_ALP_Light</defName><label>调配轻盈药剂</label><description>用 1 份草药和 5 钢调配 1 瓶轻盈药剂。只有炼金师能做（器械师 7 级起是精炼药剂）。</description><jobString>正在调配轻盈药剂。</jobString><products><LP_ALP_Light>1</LP_ALP_Light></products></RecipeDef>
  <RecipeDef ParentName="LP_ALRecipeBase"><defName>LP_Make_ALP_Lucid</defName><label>调配清醒药剂</label><description>用 1 份草药和 5 钢调配 1 瓶清醒药剂。只有炼金师能做（器械师 7 级起是精炼药剂）。</description><jobString>正在调配清醒药剂。</jobString><products><LP_ALP_Lucid>1</LP_ALP_Lucid></products></RecipeDef>
  <RecipeDef ParentName="LP_ALRecipeBase"><defName>LP_Make_ALP_Courage</defName><label>调配勇气药剂</label><description>用 1 份草药和 5 钢调配 1 瓶勇气药剂。只有炼金师能做（器械师 7 级起是精炼药剂）。</description><jobString>正在调配勇气药剂。</jobString><products><LP_ALP_Courage>1</LP_ALP_Courage></products></RecipeDef>

  <!-- 药剂状态（时长由代码给：1 天，精炼 1.3 天） -->
  <HediffDef ParentName="LP_ClassBuffBase">
    <defName>LP_ALB_Swift</defName>
    <label>迅捷药剂</label>
    <description>移动 +25%。</description>
    <defaultLabelColor>(0.95,0.6,0.25)</defaultLabelColor>
    <stages><li><statFactors><MoveSpeed>1.25</MoveSpeed></statFactors></li></stages>
  </HediffDef>
  <HediffDef ParentName="LP_ClassBuffBase">
    <defName>LP_ALB_Tough</defName>
    <label>坚韧药剂</label>
    <description>受到的伤害 −15%。</description>
    <defaultLabelColor>(0.95,0.6,0.25)</defaultLabelColor>
    <stages><li><statFactors><IncomingDamageFactor>0.85</IncomingDamageFactor></statFactors></li></stages>
  </HediffDef>
  <HediffDef ParentName="LP_ClassBuffBase">
    <defName>LP_ALB_Light</defName>
    <hediffClass>LichPhylactery.Hediff_LightFoot</hediffClass>
    <label>轻盈药剂</label>
    <description>脚下轻得像风：走路无视地形、积雪、植物的减速。</description>
    <defaultLabelColor>(0.95,0.6,0.25)</defaultLabelColor>
  </HediffDef>
  <HediffDef ParentName="LP_ClassBuffBase">
    <defName>LP_ALB_Lucid</defName>
    <label>清醒药剂</label>
