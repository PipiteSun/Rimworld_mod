    <defaultLabelColor>(0.95,0.6,0.25)</defaultLabelColor>
    <stages><li><capMods><li><capacity>Consciousness</capacity><offset>0.1</offset></li></capMods><disablesNeeds><li>Rest</li></disablesNeeds></li></stages>
