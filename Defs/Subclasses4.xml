<!-- 1.111.0 器械师子职业（子职业设计稿，见 Source/ClassSubclass4.cs）：炼金师、装甲师、堡垒工程师。器械师 3 级选一个（选定不能改），能力在器械师 3 / 7 / 11 / 15 级获得。
     没有资源，只看冷却。数值是器械强度 100% 时的值。 -->
<Defs>
  <!-- ===================== 子职业 ===================== -->
  <LichPhylactery.LP_SubclassDef>
    <defName>LP_Sub_Alchemist</defName>
    <label>炼金师</label>
    <description>做药的器械师：每天早上背包里多出实验药剂（治愈、迅捷、坚韧、轻盈、清醒、勇气，谁都能喝，3 天就坏），还能做复原试剂治病解毒，最后学会长回断肢的大复原药剂、不怕毒酸火。</description>
    <parent>LP_Class_Artificer</parent><order>2</order><emblem>LP/Classes/Subclass/Emblem_Alchemist</emblem><color>(0.95,0.6,0.25)</color>
    <abilities><li><ability>LP_AL_Experimental</ability><level>3</level></li><li><ability>LP_AL_Savant</ability><level>7</level></li><li><ability>LP_AL_Restorative</ability><level>11</level></li>
      <li><ability>LP_AL_Chemist</ability><level>15</level></li><li><ability>LP_AL_PickPotion</ability><level>15</level></li><li><ability>LP_AL_GreaterRestorative</ability><level>15</level></li></abilities>
  </LichPhylactery.LP_SubclassDef>
  <LichPhylactery.LP_SubclassDef>
    <defName>LP_Sub_Armorer</defName>
    <label>装甲师</label>
    <description>把身上的护甲改成奥术装甲：不再拖慢脚步，两种模式随时切换——守护者用雷霆拳套嘲讽敌人、展开防御力场；渗透者用内置的闪电发射器远程点射、跑得更快、更难被打中。等级越高装甲越硬，最后完全密封。</description>
    <parent>LP_Class_Artificer</parent><order>3</order><emblem>LP/Classes/Subclass/Emblem_Armorer</emblem><color>(0.62,0.66,0.74)</color>
    <abilities><li><ability>LP_AR_ArcaneArmor</ability><level>3</level></li><li><ability>LP_AR_ArmorMode</ability><level>3</level></li><li><ability>LP_AR_Field</ability><level>3</level></li><li><ability>LP_AR_Launcher</ability><level>3</level></li>
      <li><ability>LP_AR_Modifications</ability><level>7</level></li><li><ability>LP_AR_Upgrade</ability><level>11</level></li><li><ability>LP_AR_Perfected</ability><level>15</level></li></abilities>
  </LichPhylactery.LP_SubclassDef>
  <LichPhylactery.LP_SubclassDef>
    <defName>LP_Sub_FortEngineer</defName>
    <label>堡垒工程师</label>
    <description>守家的器械师（为边缘世界新设的专精）：自己建的墙、门、掩体、炮台更结实，修得更快；埋下隐藏的符文地雷，建奥术电容给炮台提速，临战加固一片建筑，最后建起要塞核心自动修防线、给炮台全线升级。</description>
    <parent>LP_Class_Artificer</parent><order>4</order><emblem>LP/Classes/Subclass/Emblem_FortEngineer</emblem><color>(0.72,0.6,0.42)</color>
    <abilities><li><ability>LP_FE_Reinforce</ability><level>3</level></li><li><ability>LP_FE_RuneMine</ability><level>3</level></li><li><ability>LP_FE_Capacitor</ability><level>7</level></li>
      <li><ability>LP_FE_Fortify</ability><level>11</level></li><li><ability>LP_FE_Citadel</ability><level>15</level></li></abilities>
  </LichPhylactery.LP_SubclassDef>

  <!-- ===================== 炼金师：药剂 ===================== -->
