  <ThingDef ParentName="LP_ALPotionBase">
    <defName>LP_ALP_Courage</defName>
    <label>勇气药剂</label>
    <description>炼金师的实验药剂。1 天内心情 +10，精神崩溃阈值 −5%。谁都能喝，3 天就坏。精炼药剂持续时间 ×1.3。</description>
    <descriptionHyperlinks><HediffDef>LP_ALB_Courage</HediffDef></descriptionHyperlinks>
