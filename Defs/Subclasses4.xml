    <ingestible><outcomeDoers><li Class="LichPhylactery.IngestionOutcomeDoer_Alchemist"><effect>heal</effect></li></outcomeDoers></ingestible>
    <comps><li Class="CompProperties_Drug"><listOrder>2400</listOrder></li></comps>
  </ThingDef>
  <ThingDef ParentName="LP_ALPotionBase">
    <defName>LP_ALP_Swift</defName>
    <label>迅捷药剂</label>
