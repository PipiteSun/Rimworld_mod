    <thingCategories><li>Grenades</li></thingCategories>
    <weaponTags><li>LP_Nonlethal</li></weaponTags>
    <burnableByRecipe>true</burnableByRecipe>
    <costList>
      <Cloth>20</Cloth>
      <LP_Mithral>2</LP_Mithral>
      <MedicineHerbal>2</MedicineHerbal>
    </costList>
