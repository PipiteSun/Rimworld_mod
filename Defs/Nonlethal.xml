      <skillRequirements>
        <Crafting>5</Crafting>
      </skillRequirements>
    </recipeMaker>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>LP_Proj_Net</defaultProjectile>
        <warmupTime>1.2</warmupTime>
        <range>22</range>
        <soundCast>Bow_Large</soundCast>
      </li>
    </verbs>
    <tools>
      <li>
        <label>弩托</label>
        <capacities><li>LP_SubdueStrike</li></capacities>
        <power>8</power>
        <cooldownTime>2</cooldownTime>
      </li>
    </tools>
    <rotateInShelves>false</rotateInShelves>
  </ThingDef>
  <ThingDef ParentName="BaseBullet">
    <defName>LP_Proj_Net</defName>
    <label>束缚网</label>
    <thingClass>LichPhylactery.Projectile_LPNet</thingClass>
    <graphicData>
      <texPath>LP/Nonlethal/Proj_Net</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>1.2</drawSize>
    </graphicData>
    <projectile>
      <damageDef>LP_Subdue</damageDef>
      <damageAmountBase>8</damageAmountBase>
      <speed>32</speed>
      <arcHeightFactor>0.2</arcHeightFactor>
    </projectile>
    <modExtensions>
      <li Class="LichPhylactery.NonlethalShotExt">
        <stunTicks>150</stunTicks>
        <hediff>LP_Netted</hediff>
        <hediffTicks>360</hediffTicks>
      </li>
    </modExtensions>
  </ThingDef>

