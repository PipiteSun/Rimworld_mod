  <!-- 4. 安眠法杖：G 组法杖（魔力系数、心灵熵、驱散粉尘、敏感度 0 不能用都照 1.29.0 规则），附魔台；研究要制伏战术 + 奥术法杖 -->
  <ThingDef ParentName="LP_StaffBase">
    <defName>LP_SleepStaff</defName>
    <label>安眠法杖</label>
    <description>弯曲的灰白木杖，杖头的月牙托着一颗淡紫色水晶，射出催人入睡的安眠魔弹。威力随持有者的心灵敏感度变化（魔力系数 = 敏感度，最低 0.2，不封顶）；敏感度为0的人用它，法杖毫无回应。有心灵链接的人每次施放增加心灵熵；没有心灵链接的人只能发挥70%的威力。精灵这类心智坚定的种族按心智抗性少受影响。\n\n非致命：只会让目标昏迷倒地，不会造成伤口，也不会杀死目标。适合抓俘虏。</description>
    <graphicData><texPath>LP/Nonlethal/SleepStaff</texPath><graphicClass>Graphic_Single</graphicClass></graphicData>
    <soundInteract>Interact_Rifle</soundInteract>
    <weaponTags Inherit="False">
      <li>LP_Nonlethal</li>
    </weaponTags>
    <tradeTags Inherit="False">
      <li>LP_NonlethalStaff</li>
    </tradeTags>
    <statBases>
      <RangedWeapon_Cooldown>2.2</RangedWeapon_Cooldown>
    </statBases>
    <costList>
      <WoodLog>40</WoodLog>
      <LP_Mithral>8</LP_Mithral>
      <ComponentIndustrial>1</ComponentIndustrial>
    </costList>
    <recipeMaker>
      <researchPrerequisites>
        <li>LP_Research_Subduing</li>
      </researchPrerequisites>
    </recipeMaker>
    <verbs>
      <li>
        <verbClass>LichPhylactery.Verb_ArcaneShoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>LP_Bolt_Sleep</defaultProjectile>
        <warmupTime>1.0</warmupTime>
        <range>28</range>
        <soundCast>Shot_ChargeBlaster</soundCast>
        <muzzleFlashScale>6</muzzleFlashScale>
      </li>
    </verbs>
    <tools Inherit="False">
      <li>
        <label>杖身</label>
        <capacities><li>LP_SubdueStrike</li></capacities>
        <power>8</power>
        <cooldownTime>2</cooldownTime>
      </li>
    </tools>
    <comps>
      <li Class="LichPhylactery.CompProperties_ArcaneWeapon"><group>G</group></li>
    </comps>
  </ThingDef>
  <ThingDef ParentName="LP_ArcaneBulletBase">
    <defName>LP_Bolt_Sleep</defName>
    <label>安眠魔弹</label>
    <graphicData><texPath>LP/Nonlethal/Proj_SleepBolt</texPath><shaderType>TransparentPostLight</shaderType></graphicData>
    <projectile>
      <damageDef>LP_SleepMagic</damageDef>
      <damageAmountBase>16</damageAmountBase>
      <armorPenetrationBase>0</armorPenetrationBase>
