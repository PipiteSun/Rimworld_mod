<?xml version="1.0" encoding="utf-8"?>
<!-- 1.24.0 象人：可遗传的魁梧种族。原版壮硕体型+灰色皮肤+无发，自绘象鼻。 -->
<Defs>
  <XenotypeDef>
    <defName>LP_Loxodon</defName>
    <label>象人</label>
    <description>长着象头和长鼻的高大种族，皮肤灰而厚，性情沉稳得像一块磐石。象人力气大、搬得多，长鼻像第三只手，双手受伤时还能用鼻子干活；他们几乎不知道恐惧为何物。代价是走得慢、不擅射击。血脉会遗传给子女。</description>
    <descriptionShort>可遗传的魁梧种族。体型×1.3、搬运约1.5倍、象鼻托底操作能力、免疫恐惧、皮厚；走得慢、不擅射击。</descriptionShort>
    <iconPath>Races124/Xenotypes/Loxodon</iconPath>
    <inheritable>true</inheritable>
    <combatPowerFactor>1.3</combatPowerFactor>
    <factionlessGenerationWeight>0</factionlessGenerationWeight>
    <genes>
      <li>LP_LoxodonStature</li>
      <li>LP_LoxodonTrunk</li>
      <li>LP_LoxodonCalm</li>
      <li>LP_LoxodonHide</li>
      <li>LP_SkinLoxodon</li>
      <li>Body_Hulk</li>
      <li>AptitudeStrong_Construction</li>
      <li>Aggression_DeadCalm</li>
      <li>MoveSpeed_Slow</li>
      <li>AptitudePoor_Shooting</li>
      <li>Hair_BaldOnly</li>
      <li>Beard_NoBeardOnly</li>
    </genes>
  </XenotypeDef>

  <GeneDef>
    <defName>LP_LoxodonStature</defName>
    <label>象人体型</label>
    <description>高大厚重的象人身材。实际体型为普通人的130%（负重、商队载重随之提高，也更容易被远程命中），显示为115%大小；手上搬运量约为普通人的150%。饭量也大一些，胃也更大（巨胃：饱食度上限×130%）。体型越大，生命和近战越强（见巨躯规则：生命总量×115%、近战伤害×109%）。</description>
    <geneClass>LichPhylactery.Gene_LinkedHediff</geneClass>
    <iconPath>Races124/Genes/LoxodonStature</iconPath>
    <displayCategory>Miscellaneous</displayCategory>
    <selectionWeight>0</selectionWeight>
    <biostatCpx>1</biostatCpx>
    <biostatMet>0</biostatMet>
    <customEffectDescriptions>
      <li>实际体型：×130%（与其他体型效果相乘）。</li>
      <li>显示大小：×115%。</li>
      <li>搬运量：约为普通人的150%（体型×130%后再×115%）。</li>
      <li>食量：×120%。</li>
    </customEffectDescriptions>
    <modExtensions>
      <li Class="LichPhylactery.SmallBodyExtension">
        <bodySize>1.3</bodySize>
        <renderScale>1.15</renderScale>
        <carryFactor>1.15</carryFactor>
      </li>
      <li Class="LichPhylactery.LinkedHediffExtension">
        <hediff>LP_LoxodonAppetite</hediff>
      </li>
    </modExtensions>
  </GeneDef>
  <HediffDef>
    <defName>LP_LoxodonAppetite</defName>
    <label>象人食量</label>
    <description>高大的身躯需要更多食物。</description>
    <hediffClass>LichPhylactery.Hediff_GeneLinked</hediffClass>
    <defaultLabelColor>(0.65, 0.65, 0.7)</defaultLabelColor>
    <isBad>false</isBad>
    <everCurableByItem>false</everCurableByItem>
    <stages>
      <li>
        <hungerRateFactor>1.2</hungerRateFactor>
      </li>
    </stages>
  </HediffDef>

  <GeneDef>
    <defName>LP_LoxodonTrunk</defName>
    <label>象鼻</label>
    <description>一条灵活有力的长鼻，取代普通的鼻子。象鼻像第三只手：双手都受了伤时，象人还能用鼻子卷起东西干活，操作能力不会低于50%。</description>
    <iconPath>Races124/Genes/LoxodonTrunk</iconPath>
    <displayCategory>Miscellaneous</displayCategory>
    <selectionWeight>0</selectionWeight>
    <biostatCpx>1</biostatCpx>
    <biostatMet>-1</biostatMet>
    <exclusionTags>
      <li>Nose</li>
    </exclusionTags>
    <customEffectDescriptions>
      <li>第三只手：操作能力不低于50%（但不超过意识水平）。</li>
      <li>与原版鼻子基因、牛鼻互斥。</li>
    </customEffectDescriptions>
    <renderNodeProperties>
      <li>
        <nodeClass>PawnRenderNode_AttachmentHead</nodeClass>
        <workerClass>PawnRenderNodeWorker_FlipWhenCrawling</workerClass>
        <texPath>Races124/Trunk/Trunk</texPath>
        <useSkinShader>true</useSkinShader>
        <useRottenColor>true</useRottenColor>
        <colorType>Skin</colorType>
        <parentTagDef>Head</parentTagDef>
        <rotDrawMode>Fresh, Rotting</rotDrawMode>
        <visibleFacing>
          <li>East</li>
          <li>South</li>
          <li>West</li>
        </visibleFacing>
        <drawData>
          <defaultData>
            <layer>66</layer>
          </defaultData>
        </drawData>
      </li>
    </renderNodeProperties>
  </GeneDef>

  <GeneDef>
    <defName>LP_LoxodonCalm</defName>
    <label>沉稳</label>
    <description>象人遇事不慌，几乎不会被吓到：不会陷入恐慌逃跑，巫妖的恐惧凝视对他们无效，看到触须披风之类的可怕东西也无动于衷。心智抗性+20%。</description>
    <iconPath>Races124/Genes/LoxodonCalm</iconPath>
    <displayCategory>Mood</displayCategory>
    <selectionWeight>0</selectionWeight>
    <biostatCpx>1</biostatCpx>
    <biostatMet>-1</biostatMet>
    <statOffsets>
      <LP_MindResist>0.2</LP_MindResist>
    </statOffsets>
    <customEffectDescriptions>
      <li>免疫恐惧类精神状态（恐慌逃跑、恐惧凝视）和“看到触须披风”的心情。</li>
    </customEffectDescriptions>
  </GeneDef>

  <GeneDef>
    <defName>LP_LoxodonHide</defName>
    <label>厚皮</label>
    <description>象人的皮又厚又韧：钝器护甲+10%，锐器护甲+5%，也更耐热。</description>
    <iconPath>Races124/Genes/LoxodonHide</iconPath>
    <displayCategory>Healing</displayCategory>
    <selectionWeight>0</selectionWeight>
    <biostatCpx>1</biostatCpx>
    <biostatMet>-1</biostatMet>
    <statOffsets>
      <ArmorRating_Blunt>0.1</ArmorRating_Blunt>
      <ArmorRating_Sharp>0.05</ArmorRating_Sharp>
      <ComfyTemperatureMax>5</ComfyTemperatureMax>
    </statOffsets>
  </GeneDef>

  <GeneDef ParentName="GeneSkinColorOverride">
    <defName>LP_SkinLoxodon</defName>
    <label>象灰肤色</label>
    <labelShortAdj>象灰</labelShortAdj>
    <description>象人的灰色厚皮。</description>
    <skinColorOverride>(150, 150, 155)</skinColorOverride>
    <randomBrightnessFactor>0.06</randomBrightnessFactor>
    <selectionWeight>0</selectionWeight>
    <displayOrderInCategory>1</displayOrderInCategory>
  </GeneDef>

  <!-- ==================== 种族关系 ==================== -->
  <ThoughtDef>
    <defName>LP_RacialRelation_LoxodonMinotaur</defName>
    <workerClass>LichPhylactery.ThoughtWorker_DNDRacialRelation</workerClass>
    <stages>
      <li>
        <label>同为兽首</label>
        <description>那个牛头人和我一样顶着一颗兽首。别人看我们的眼神，我们都懂。</description>
        <baseMoodEffect>2</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>
  <LichPhylactery.RacialRelationDef>
    <defName>LP_Relation_LoxodonMinotaur</defName>
    <label>象人看牛头人</label>
    <observer>LP_Loxodon</observer>
    <target>LP_Minotaur</target>
    <thought>LP_RacialRelation_LoxodonMinotaur</thought>
  </LichPhylactery.RacialRelationDef>
  <ThoughtDef>
    <defName>LP_RacialRelation_MinotaurLoxodon</defName>
    <workerClass>LichPhylactery.ThoughtWorker_DNDRacialRelation</workerClass>
    <stages>
      <li>
        <label>同为兽首</label>
        <description>那个象人和我一样顶着一颗兽首，块头也够大。</description>
        <baseMoodEffect>2</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>
  <LichPhylactery.RacialRelationDef>
    <defName>LP_Relation_MinotaurLoxodon</defName>
    <label>牛头人看象人</label>
    <observer>LP_Minotaur</observer>
    <target>LP_Loxodon</target>
    <thought>LP_RacialRelation_MinotaurLoxodon</thought>
  </LichPhylactery.RacialRelationDef>
  <ThoughtDef>
    <defName>LP_RacialRelation_LoxodonOgre</defName>
    <workerClass>LichPhylactery.ThoughtWorker_DNDRacialRelation</workerClass>
    <stages>
      <li>
        <label>粗野的食人魔</label>
        <description>那个食人魔吃相难看、说话粗鲁，象人最看不惯这种人。</description>
        <baseMoodEffect>-2</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>
  <LichPhylactery.RacialRelationDef>
    <defName>LP_Relation_LoxodonOgre</defName>
    <label>象人看食人魔</label>
    <observer>LP_Loxodon</observer>
    <target>LP_Ogre</target>
    <thought>LP_RacialRelation_LoxodonOgre</thought>
  </LichPhylactery.RacialRelationDef>
</Defs>
