        <drawData><defaultData><layer>75</layer></defaultData><dataNorth><layer>75</layer></dataNorth></drawData>
      </li>
    </renderNodeProperties>
  </GeneDef>
  <GeneDef ParentName="LP_AbyssGeneBase">
    <defName>LP_HezrouHide</defName>
    <label>疣皮</label>
    <description>又厚又韧的疣状皮：利器、钝器护甲各 +20%；在浅水、沼泽里行动不受减速。</description>
    <iconPath>Abyss/Genes/HezrouHide</iconPath>
    <statOffsets><ArmorRating_Sharp>0.2</ArmorRating_Sharp><ArmorRating_Blunt>0.2</ArmorRating_Blunt></statOffsets>
    <modExtensions><li Class="LichPhylactery.AmphibiousExtension" /></modExtensions>
  </GeneDef>
  <GeneDef ParentName="LP_AbyssGeneBase">
    <defName>LP_HezrouStench</defName>
    <label>哈兹魔恶臭</label>
    <description>每 5 秒，3 格内的敌对人形做体质豁免（难度 13，基础成功率 50%），失败“恶心”10 秒（操作 -20%、移速 ×0.9）。豁免成功的人 1 分钟内不会再受影响。</description>
    <iconPath>Abyss/Genes/HezrouStench</iconPath>
    <geneClass>LichPhylactery.Gene_HezrouStench</geneClass>
    <displayCategory>Violence</displayCategory>
  </GeneDef>
  <GeneDef ParentName="GeneSkinColorOverride">
    <defName>LP_SkinHezrou</defName>
    <label>绿灰疣皮</label>
    <labelShortAdj>绿灰</labelShortAdj>
    <description>哈兹魔绿灰色、满是疣子的皮。</description>
    <skinColorOverride>(112, 128, 96)</skinColorOverride>
    <randomBrightnessFactor>0.05</randomBrightnessFactor>
    <selectionWeight>0</selectionWeight>
  </GeneDef>

  <!-- ==================== 魅魔 / 梦魔 ==================== -->
  <GeneDef ParentName="LP_AbyssGeneBase">
    <defName>LP_SuccubusNature</defName>
    <label>魅魔之性</label>
    <description>魅魔 / 梦魔的天性：社交影响 +25%、谈判价格 +10%；火焰、烧伤伤害 ×0.5，毒素抗性 +50%；食量只有常人的 20%。不能在圣坛 5 格内工作，看见圣徽心情 -3。带这条基因的人算作魅魔。</description>
    <iconPath>Abyss/Genes/SuccubusNature</iconPath>
    <geneClass>LichPhylactery.Gene_LinkedHediff</geneClass>
    <statFactors><SocialImpact>1.25</SocialImpact></statFactors>
    <statOffsets><TradePriceImprovement>0.1</TradePriceImprovement><ToxicResistance>0.5</ToxicResistance></statOffsets>
    <damageFactors><Flame>0.5</Flame><Burn>0.5</Burn></damageFactors>
    <modExtensions>
      <li Class="LichPhylactery.LP_OutsiderExtension"><plane>Abyss</plane><coldIron>1.5</coldIron><holy>2</holy><taintImmune>true</taintImmune><levelRange>7~9</levelRange><trueNameChance>0.3</trueNameChance><priority>1</priority></li>
      <li Class="LichPhylactery.LinkedHediffExtension"><hediff>LP_SuccubusAppetite</hediff></li>
    </modExtensions>
  </GeneDef>
  <HediffDef>
    <defName>LP_SuccubusAppetite</defName>
    <label>魅魔食量</label>
    <description>魅魔靠吸取别人的精力过活，正经饭只吃一点点：饥饿速度 ×20%。</description>
    <hediffClass>LichPhylactery.Hediff_GeneLinked</hediffClass>
    <isBad>false</isBad>
    <everCurableByItem>false</everCurableByItem>
    <stages><li><hungerRateFactor>0.2</hungerRateFactor></li></stages>
  </HediffDef>
  <GeneDef ParentName="LP_AbyssGeneBase">
    <defName>LP_SuccubusHorns</defName>
