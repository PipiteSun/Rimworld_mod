<?xml version="1.0" encoding="utf-8"?>
<!-- 1.54.0 深渊仪式：恶魔种族（劣魔、巴路古拉、哈兹魔、魅魔/梦魔、纳巴苏、影魔）、可玩的坎比恩、动物魔宠夸塞魔。
     恶魔共用 LP_AbyssCore（判定 + 外来者扩展）；不吃不睡拆成 LP_AbyssUndying（魅魔不带）。各族体型基因上另挂一份优先级更高的扩展（等级范围、真名卷掉率）。规则代码见 Source/AbyssRaces.cs。 -->
<Defs>
  <XenotypeDef Name="LP_DemonBase" Abstract="True">
    <inheritable>false</inheritable>
    <factionlessGenerationWeight>0</factionlessGenerationWeight>
  </XenotypeDef>

  <XenotypeDef ParentName="LP_DemonBase">
    <defName>LP_Dretch</defName>
    <label>劣魔</label>
    <description>深渊里最低等的恶魔：矮胖、灰白、浑身散发着腐臭，脑子只够听懂最简单的命令。劣魔被召来做苦力最合适——搬运、采矿、清扫，别的什么都干不好。它们身边 2 格内的人会被熏得心情变差。</description>
    <descriptionShort>深渊最低等的恶魔。只能干粗活，工作速度 ×0.8，恶臭熏人；倒下即遣返。</descriptionShort>
    <iconPath>Abyss/Xenotypes/Dretch</iconPath>
    <combatPowerFactor>1</combatPowerFactor>
    <genes>
      <li>LP_AbyssCore</li><li>LP_AbyssUndying</li><li>LP_DretchStature</li><li>LP_DretchStench</li><li>LP_DretchToil</li><li>LP_SkinDretch</li>
      <li>Body_Fat</li><li>Hair_BaldOnly</li><li>Beard_NoBeardOnly</li><li>Sterile</li>
    </genes>
  </XenotypeDef>
  <XenotypeDef ParentName="LP_DemonBase">
    <defName>LP_Barlgura</defName>
    <label>巴路古拉</label>
    <description>猿一样的深渊恶魔，橙褐色的皮毛下是一身蛮力。巴路古拉能一跃扑到 8 格外的敌人身边，把周围的人震倒；站着不动时会融进阴影里看不见。它喜欢看别人流血。</description>
    <descriptionShort>猿形恶魔。近战 +20%、负重 +40%、跃击、静立隐形；倒下即遣返（束缚者除外）。</descriptionShort>
    <iconPath>Abyss/Xenotypes/Barlgura</iconPath>
    <combatPowerFactor>1.5</combatPowerFactor>
    <genes>
      <li>LP_AbyssCore</li><li>LP_AbyssUndying</li><li>LP_BarlguraStature</li><li>LP_BarlguraMight</li><li>LP_BarlguraLeap</li><li>LP_BarlguraStill</li><li>LP_BarlguraBrute</li><li>LP_SkinBarlgura</li>
      <li>Body_Hulk</li><li>Hair_BaldOnly</li><li>Beard_NoBeardOnly</li><li>Sterile</li>
    </genes>
  </XenotypeDef>
  <XenotypeDef ParentName="LP_DemonBase">
    <defName>LP_Hezrou</defName>
    <label>哈兹魔</label>
    <description>蟾蜍一样的深渊恶魔，满身疣子的绿灰皮又厚又韧。哈兹魔身上的恶臭能让 3 格内的敌人恶心得握不住武器；它在水里和在泥里一样自在。</description>
    <descriptionShort>蟾蜍形恶魔。利/钝护甲 +20%、恶臭让敌人恶心、水中行动；倒下即遣返（束缚者除外）。</descriptionShort>
    <iconPath>Abyss/Xenotypes/Hezrou</iconPath>
    <combatPowerFactor>1.5</combatPowerFactor>
    <genes>
      <li>LP_AbyssCore</li><li>LP_AbyssUndying</li><li>LP_HezrouStature</li><li>LP_HezrouHide</li><li>LP_HezrouStench</li><li>LP_SkinHezrou</li>
      <li>Body_Hulk</li><li>Hair_BaldOnly</li><li>Beard_NoBeardOnly</li><li>Sterile</li>
    </genes>
  </XenotypeDef>
  <XenotypeDef ParentName="LP_DemonBase">
    <defName>LP_Succubus</defName>
    <label>魅魔</label>
    <description>以诱惑为食的深渊恶魔，女性叫魅魔，男性叫梦魔。它们长着蝠翼、细尾和一对小角，能变形成普通人的样子混进人群；魅惑之吻让人失去抵抗，夜里同床的人会被吸走精力。魅魔可以和凡人生育，孩子是坎比恩。</description>
    <descriptionShort>可玩的恶魔。变形伪装、魅惑之吻、梦境吸取；火焰/毒素抗性，社交 +25%；怕圣坛和圣徽；孩子是坎比恩。</descriptionShort>
    <iconPath>Abyss/Xenotypes/Succubus</iconPath>
    <combatPowerFactor>1</combatPowerFactor>
    <genes>
      <li>LP_AbyssCore</li><li>LP_SuccubusNature</li><li>LP_SuccubusHorns</li><li>LP_SuccubusWings</li><li>LP_SuccubusTail</li><li>LP_SuccubusGuise</li><li>LP_SuccubusKiss</li><li>LP_SuccubusDream</li><li>LP_SkinSuccubus</li>
      <li>Beauty_Pretty</li>
    </genes>
  </XenotypeDef>
  <XenotypeDef ParentName="LP_DemonBase">
    <defName>LP_Nabassu</defName>
    <label>纳巴苏</label>
    <description>石像鬼一样的深渊恶魔：灰黑的石皮、蝠翼、长獠牙。纳巴苏猎食灵魂——被它杀死的人灵魂会被吞掉，再也无法复活，而它每吞一个就更强一分。它的凝视能让人的四肢像石头一样僵硬。</description>
    <descriptionShort>噬魂恶魔。杀死的人不能复活、饱魂层数叠加、石化凝视；倒下即遣返（束缚者除外）。</descriptionShort>
    <iconPath>Abyss/Xenotypes/Nabassu</iconPath>
    <combatPowerFactor>2</combatPowerFactor>
    <genes>
      <li>LP_AbyssCore</li><li>LP_AbyssUndying</li><li>LP_NabassuStature</li><li>LP_NabassuDevour</li><li>LP_NabassuGaze</li><li>LP_SkinNabassu</li>
      <li>Body_Hulk</li><li>Hair_BaldOnly</li><li>Beard_NoBeardOnly</li><li>Sterile</li>
    </genes>
  </XenotypeDef>
  <XenotypeDef ParentName="LP_DemonBase">
    <defName>LP_ShadowDemon</defName>
    <label>影魔</label>
    <description>没有实体的深渊恶魔，像一团人形的黑影。普通武器只能伤到它一半；可它怕光——站在亮处时受到的伤害 ×1.5，动作也慢下来。影魔只在夜里从深渊裂口里出来，不能召唤，也不能束缚。</description>
    <descriptionShort>夜间敌人。非魔法武器伤害减半；亮处受伤 ×1.5、移速 ×0.7。</descriptionShort>
    <iconPath>Abyss/Xenotypes/ShadowDemon</iconPath>
    <combatPowerFactor>1.5</combatPowerFactor>
    <genes>
      <li>LP_AbyssCore</li><li>LP_AbyssUndying</li><li>LP_ShadowDemonForm</li><li>LP_SkinShadowDemon</li>
      <li>Body_Thin</li><li>Hair_BaldOnly</li><li>Beard_NoBeardOnly</li><li>Sterile</li>
    </genes>
  </XenotypeDef>
  <XenotypeDef>
    <defName>LP_Cambion</defName>
    <label>坎比恩</label>
    <description>恶魔和凡人的孩子，或者被深渊彻底浸透后化魔的凡人。坎比恩长着角和一对小号蝠翼，眼睛是金红色的；他们不怕火，天生懂得怎么让别人害怕或者服从。坎比恩是凡人生的，不会被遣返。血脉会遗传。</description>
    <descriptionShort>可遗传。寒铁 ×1.25、深渊腐化 ×0.5、火焰 ×0.5、滑翔跳跃、社交天赋。</descriptionShort>
    <iconPath>Abyss/Xenotypes/Cambion</iconPath>
    <inheritable>true</inheritable>
    <combatPowerFactor>1</combatPowerFactor>
    <factionlessGenerationWeight>0.5</factionlessGenerationWeight>
    <genes>
      <li>LP_CambionBlood</li><li>LP_CambionHorns</li><li>LP_CambionWings</li><li>LP_CambionFire</li><li>LP_CambionPresence</li>
    </genes>
  </XenotypeDef>

  <!-- ==================== 公共基因 ==================== -->
  <GeneDef Name="LP_AbyssGeneBase" Abstract="True">
    <displayCategory>Miscellaneous</displayCategory>
    <selectionWeight>0</selectionWeight>
    <biostatCpx>1</biostatCpx>
    <biostatMet>0</biostatMet>
  </GeneDef>
  <GeneDef ParentName="LP_AbyssGeneBase">
    <defName>LP_AbyssCore</defName>
    <label>深渊之躯</label>
    <description>深渊恶魔的身体：被击倒或杀死时化作黑烟遣返深渊（被束缚的、戴着位面锚链的除外），不会因赤身裸体而不快。寒铁武器对它的伤害 ×1.5，圣水 ×2。</description>
    <iconPath>Abyss/Genes/AbyssCore</iconPath>
    <customEffectDescriptions>
      <li>倒下或死亡：遣返深渊，敌人掉落灵魂币、恶魔血等。</li>
      <li>寒铁武器伤害 ×1.5，圣水伤害 ×2，信仰的光辉伤害 ×1.25。</li>
      <li>不受深渊腐化以外的心灵影响……也不会被腐化。</li>
    </customEffectDescriptions>
    <modExtensions>
      <li Class="LichPhylactery.LP_OutsiderExtension">
        <plane>Abyss</plane>
        <coldIron>1.5</coldIron>
        <holy>2</holy>
        <taintImmune>true</taintImmune>
        <trueNameChance>0.2</trueNameChance>
      </li>
    </modExtensions>
  </GeneDef>
  <GeneDef ParentName="LP_AbyssGeneBase">
    <defName>LP_AbyssUndying</defName>
    <label>不吃不睡</label>
    <description>深渊的造物不需要进食，也不需要睡眠。</description>
    <iconPath>Abyss/Genes/AbyssUndying</iconPath>
    <disablesNeeds><li>Food</li><li>Rest</li></disablesNeeds>
  </GeneDef>

  <!-- ==================== 劣魔 ==================== -->
  <GeneDef ParentName="LP_AbyssGeneBase">
    <defName>LP_DretchStature</defName>
    <label>劣魔体型</label>
    <description>矮小肥胖的身躯：实际体型 ×70%，显示 ×80%，头顶一对小角。</description>
    <iconPath>Abyss/Genes/DretchStature</iconPath>
    <exclusionTags><li>Headbone</li></exclusionTags>
    <modExtensions>
      <li Class="LichPhylactery.SmallBodyExtension"><bodySize>0.7</bodySize><renderScale>0.8</renderScale></li>
      <li Class="LichPhylactery.LP_OutsiderExtension"><plane>Abyss</plane><coldIron>1.5</coldIron><holy>2</holy><taintImmune>true</taintImmune><levelRange>1~2</levelRange><trueNameChance>0.05</trueNameChance><priority>1</priority></li>
    </modExtensions>
    <renderNodeProperties>
      <li>
        <nodeClass>PawnRenderNode_AttachmentHead</nodeClass>
        <workerClass>PawnRenderNodeWorker_FlipWhenCrawling</workerClass>
        <texPath>Abyss/Horns/DretchHorns</texPath>
        <parentTagDef>Head</parentTagDef>
        <rotDrawMode>Fresh, Rotting</rotDrawMode>
        <drawData><defaultData><layer>80</layer></defaultData><dataNorth><layer>10</layer></dataNorth></drawData>
      </li>
    </renderNodeProperties>
  </GeneDef>
  <GeneDef ParentName="LP_AbyssGeneBase">
    <defName>LP_DretchStench</defName>
    <label>劣魔恶臭</label>
    <description>劣魔浑身散发着腐臭：2 格内的其他人形心情 -2。</description>
    <iconPath>Abyss/Genes/DretchStench</iconPath>
    <customEffectDescriptions><li>2 格内其他人形：心情 -2。</li></customEffectDescriptions>
  </GeneDef>
  <GeneDef ParentName="LP_AbyssGeneBase">
    <defName>LP_DretchToil</defName>
    <label>苦力</label>
    <description>劣魔只听得懂最简单的命令：只能搬运、采矿、清扫和干粗活，全局工作速度 ×0.8。</description>
    <iconPath>Abyss/Genes/DretchToil</iconPath>
    <disabledWorkTags>ManualSkilled, Caring, Social, Intellectual, Animals, Artistic, Crafting, Cooking, PlantWork, Constructing</disabledWorkTags>
    <statFactors><WorkSpeedGlobal>0.8</WorkSpeedGlobal></statFactors>
  </GeneDef>
  <GeneDef ParentName="GeneSkinColorOverride">
    <defName>LP_SkinDretch</defName>
    <label>灰白肤色</label>
    <labelShortAdj>灰白</labelShortAdj>
    <description>劣魔死鱼一样的灰白皮肤。</description>
    <skinColorOverride>(186, 182, 168)</skinColorOverride>
    <randomBrightnessFactor>0.05</randomBrightnessFactor>
    <selectionWeight>0</selectionWeight>
  </GeneDef>

  <!-- ==================== 巴路古拉 ==================== -->
  <GeneDef ParentName="LP_AbyssGeneBase">
    <defName>LP_BarlguraStature</defName>
    <label>巴路古拉体型</label>
    <description>猿一样的魁梧身躯：实际体型 ×160%，显示 ×130%，猿脸、外翻的獠牙。巨躯规则让它的生命和近战更强。</description>
    <iconPath>Abyss/Genes/BarlguraStature</iconPath>
    <exclusionTags><li>Headbone</li></exclusionTags>
    <modExtensions>
      <li Class="LichPhylactery.SmallBodyExtension"><bodySize>1.6</bodySize><renderScale>1.3</renderScale></li>
      <li Class="LichPhylactery.LP_OutsiderExtension"><plane>Abyss</plane><coldIron>1.5</coldIron><holy>2</holy><taintImmune>true</taintImmune><levelRange>4~6</levelRange><trueNameChance>0.2</trueNameChance><priority>1</priority></li>
    </modExtensions>
    <renderNodeProperties>
      <li>
        <nodeClass>PawnRenderNode_AttachmentHead</nodeClass>
        <workerClass>PawnRenderNodeWorker_FlipWhenCrawling</workerClass>
        <texPath>Abyss/Heads/BarlguraFace</texPath>
        <parentTagDef>Head</parentTagDef>
        <rotDrawMode>Fresh, Rotting</rotDrawMode>
        <drawData><defaultData><layer>75</layer></defaultData><dataNorth><layer>10</layer></dataNorth></drawData>
      </li>
    </renderNodeProperties>
  </GeneDef>
  <GeneDef ParentName="LP_AbyssGeneBase">
    <defName>LP_BarlguraMight</defName>
    <label>猿力</label>
    <description>巴路古拉一身蛮力：近战伤害 +20%，负重 +40%。</description>
    <iconPath>Abyss/Genes/BarlguraMight</iconPath>
    <statFactors><MeleeDamageFactor>1.2</MeleeDamageFactor><CarryingCapacity>1.4</CarryingCapacity></statFactors>
  </GeneDef>
  <GeneDef ParentName="LP_AbyssGeneBase">
    <defName>LP_BarlguraLeap</defName>
    <label>跃击</label>
    <description>能力“跃击”：一跃扑到 8 格内的目标身边，落地时 1 格内的敌人做敏捷豁免（难度 13，基础成功率 50%），失败倒地 1 秒。冷却 6 小时。</description>
    <iconPath>Abyss/Abilities/Leap</iconPath>
    <displayCategory>Violence</displayCategory>
    <abilities><li>LP_BarlguraLeap</li></abilities>
    <descriptionHyperlinks><AbilityDef>LP_BarlguraLeap</AbilityDef></descriptionHyperlinks>
  </GeneDef>
  <GeneDef ParentName="LP_AbyssGeneBase">
    <defName>LP_BarlguraStill</defName>
    <label>静立隐形</label>
    <description>站着不动、不攻击 3 秒后融进阴影，别人看不见它；一动或一出手就会现形。</description>
    <iconPath>Abyss/Genes/BarlguraStill</iconPath>
    <geneClass>LichPhylactery.Gene_BarlguraStill</geneClass>
  </GeneDef>
  <GeneDef ParentName="LP_AbyssGeneBase">
    <defName>LP_BarlguraBrute</defName>
    <label>嗜杀</label>
    <description>巴路古拉学不会读书、画画、包扎和说好话；看到处决时心情 +5。</description>
    <iconPath>Abyss/Genes/BarlguraBrute</iconPath>
    <disabledWorkTags>Intellectual, Artistic, Caring, Social</disabledWorkTags>
  </GeneDef>
  <GeneDef ParentName="GeneSkinColorOverride">
    <defName>LP_SkinBarlgura</defName>
    <label>橙褐肤色</label>
    <labelShortAdj>橙褐</labelShortAdj>
    <description>巴路古拉橙褐色的粗皮。</description>
    <skinColorOverride>(168, 104, 62)</skinColorOverride>
    <randomBrightnessFactor>0.05</randomBrightnessFactor>
    <selectionWeight>0</selectionWeight>
  </GeneDef>

