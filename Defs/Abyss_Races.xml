    <exclusionTags><li>Headbone</li></exclusionTags>
    <modExtensions>
      <li Class="LichPhylactery.SmallBodyExtension"><bodySize>1.8</bodySize><renderScale>1.4</renderScale></li>
      <li Class="LichPhylactery.LP_OutsiderExtension"><plane>Abyss</plane><coldIron>1.5</coldIron><holy>2</holy><taintImmune>true</taintImmune><levelRange>6~8</levelRange><trueNameChance>0.2</trueNameChance><priority>1</priority></li>
    </modExtensions>
    <renderNodeProperties>
      <li>
        <nodeClass>PawnRenderNode_AttachmentHead</nodeClass>
        <workerClass>PawnRenderNodeWorker_FlipWhenCrawling</workerClass>
        <texPath>Abyss/Heads/HezrouHead</texPath>
        <parentTagDef>Head</parentTagDef>
