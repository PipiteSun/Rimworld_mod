  <!-- ==================== 剧本：冰原之子 ==================== -->
  <ScenPartDef>
    <defName>LP_IceborneKinPart</defName>
    <label>冰原之子</label>
    <scenPartClass>LichPhylactery.ScenPart_IceborneKin</scenPartClass>
    <category>StartingImportant</category>
    <selectionWeight>0</selectionWeight>
    <summaryPriority>490</summaryPriority>
    <maxUses>1</maxUses>
  </ScenPartDef>

  <ScenarioDef ParentName="ScenarioBase">
    <defName>LP_IceborneKin</defName>
    <label>冰原之子</label>
    <description>部落的冰堡被火巨人攻破，两名霜巨人带着两只冬狼一路向南逃，终于在一片陌生的冻土上停下脚步。\n\n两名霜巨人各有一只认主的冬狼；带着短弓、长矛、干肉饼和皮革。余烬氏族的火巨人还记着这笔仇（好感-40）。\n\n建议选冰原或苔原：霜巨人不怕冷、雪地里照样走得快，但受不了暖和天气，也很怕火。</description>
    <scenario>
      <summary>两名霜巨人与两只认主的冬狼。怕热怕火，适合冰原或苔原。</summary>
      <parts>

        <li Class="ScenPart_ConfigPage_ConfigureStartingPawns_Xenotypes">
          <def>ConfigurePawnsXenotypes</def>
          <pawnChoiceCount>8</pawnChoiceCount>
          <customSummary>两名霜巨人。</customSummary>
          <xenotypeCounts>
            <li>
              <xenotype>LP_FrostGiant</xenotype>
              <count>2</count>
              <description>霜巨人</description>
              <requiredAtStart>true</requiredAtStart>
              <allowedDevelopmentalStages>Adult</allowedDevelopmentalStages>
            </li>
          </xenotypeCounts>
        </li>

        <li Class="ScenPart_PlayerPawnsArriveMethod">
          <def>PlayerPawnsArriveMethod</def>
          <visible>false</visible>
          <method>Standing</method>
        </li>

        <li Class="LichPhylactery.ScenPart_IceborneKin">
          <def>LP_IceborneKinPart</def>
          <wolves>2</wolves>
        </li>

        <li Class="LichPhylactery.ScenPart_FactionGoodwill">
          <def>LP_FactionGoodwill</def>
          <faction>LP_EmberClan</faction>
          <goodwill>-40</goodwill>
        </li>

        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>Bow_Short</thingDef>
          <count>2</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>MeleeWeapon_Spear</thingDef>
          <stuff>Steel</stuff>
          <count>2</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>Pemmican</thingDef>
          <count>60</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>Leather_Plain</thingDef>
          <count>100</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>MedicineHerbal</thingDef>
          <count>20</count>
        </li>

        <li Class="ScenPart_GameStartDialog">
          <def>GameStartDialog</def>
          <text>冰堡的城墙在火巨人的熔炉锤下塌了。你们带着两只冬狼一路向南，风雪替你们挡住了追兵。\n\n这里的雪不够厚，天也不够冷，可总比熔炉的火强。冬狼在身边嗅着新的猎物——是时候让这片冻土听见冬之号角了。</text>
          <closeSound>GameStartSting</closeSound>
        </li>

      </parts>
    </scenario>
  </ScenarioDef>
</Defs>
