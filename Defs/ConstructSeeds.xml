<Defs>
  <ThingDef ParentName="ResourceBase">
    <defName>LP_SkeletonSeed</defName>
    <label>骷髅仆役胚体</label>
    <description>用生肉制作的死灵胚体。选中后打开“配置死灵造物”，调整追加生肉、钢铁、玻璃钢与初始属性，再确认唤醒。材料从12格内可达且未禁用的地面物资吸收。</description>
    <thingClass>LichPhylactery.ConstructSeed</thingClass>
    <stackLimit>1</stackLimit>
    <tradeability>None</tradeability>
    <graphicData>
      <texPath>Necromancy/Skeleton_south</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>1.1</drawSize>
    </graphicData>
    <statBases>
      <MaxHitPoints>150</MaxHitPoints>
      <Mass>8</Mass>
      <MarketValue>100</MarketValue>
      <Flammability>0.5</Flammability>
      <DeteriorationRate>0</DeteriorationRate>
    </statBases>
    <thingCategories>
      <li>Manufactured</li>
    </thingCategories>
  </ThingDef>
