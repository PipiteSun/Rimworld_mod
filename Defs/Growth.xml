  <!-- ==================== 传承武器 ==================== -->
  <ThingDef ParentName="BaseMeleeWeapon_Sharp_Quality">
    <defName>LP_Legacy_Sword</defName>
    <label>黎明之誓</label>
    <description>传承长剑。沉睡时只是一把大师级的长剑；第一个用它击杀 10 个敌人的人成为它的主人。主人冒险者 10 级时觉醒（伤害 +15%，能力“黎明斩”），成为传奇冒险者时升华（再 +15%，3 格内友军近战命中 +5%）。别人拿着只是沉睡版；主人死去后它回到沉睡。无法制作。</description>
    <graphicData><texPath>LP/Weapons/Legacy/Sword</texPath><graphicClass>Graphic_Single</graphicClass></graphicData>
    <techLevel>Medieval</techLevel><smeltable>false</smeltable><equippedAngleOffset>-65</equippedAngleOffset>
    <statBases><Mass>2</Mass><MaxHitPoints>300</MaxHitPoints><Flammability>0</Flammability><MarketValue>4500</MarketValue></statBases>
    <tradeTags Inherit="False"><li>LP_Legacy</li></tradeTags>
    <weaponClasses><li>Melee</li></weaponClasses>
    <recipeMaker IsNull="True" />
    <tools>
      <li><label>剑柄</label><capacities><li>Blunt</li></capacities><power>9</power><cooldownTime>2</cooldownTime></li>
      <li><label>剑尖</label><capacities><li>Stab</li></capacities><power>22</power><cooldownTime>2.6</cooldownTime><armorPenetration>0.32</armorPenetration></li>
      <li><label>剑刃</label><labelUsedInLogging>false</labelUsedInLogging><capacities><li>Cut</li></capacities><power>24</power><cooldownTime>2.6</cooldownTime><armorPenetration>0.32</armorPenetration></li>
    </tools>
    <comps><li Class="LichPhylactery.CompProperties_LegacyWeapon"><kind>Sword</kind><ability>LP_LegacyDawnStrike</ability></li></comps>
  </ThingDef>
  <ThingDef ParentName="BaseMeleeWeapon_Blunt_Quality">
    <defName>LP_Legacy_Hammer</defName>
    <label>山之心</label>
    <description>传承战锤。沉睡时只是一把大师级的战锤；第一个用它击杀 10 个敌人的人成为它的主人。主人冒险者 10 级时觉醒（伤害 +15%，能力“震地”），成为传奇冒险者时升华（再 +15%，主人受到的伤害 -10%）。别人拿着只是沉睡版；主人死去后它回到沉睡。无法制作。</description>
    <graphicData><texPath>LP/Weapons/Legacy/Hammer</texPath><graphicClass>Graphic_Single</graphicClass></graphicData>
    <techLevel>Medieval</techLevel><smeltable>false</smeltable><equippedAngleOffset>-65</equippedAngleOffset>
    <statBases><Mass>4</Mass><MaxHitPoints>300</MaxHitPoints><Flammability>0</Flammability><MarketValue>4500</MarketValue></statBases>
    <tradeTags Inherit="False"><li>LP_Legacy</li></tradeTags>
    <weaponClasses><li>Melee</li></weaponClasses>
    <recipeMaker IsNull="True" />
    <tools>
      <li><label>锤柄</label><capacities><li>Poke</li></capacities><power>9</power><cooldownTime>2</cooldownTime></li>
      <li><label>锤头</label><labelUsedInLogging>false</labelUsedInLogging><capacities><li>Blunt</li></capacities><power>28</power><cooldownTime>2.8</cooldownTime><armorPenetration>0.25</armorPenetration></li>
    </tools>
    <comps><li Class="LichPhylactery.CompProperties_LegacyWeapon"><kind>Hammer</kind><ability>LP_LegacyQuake</ability></li></comps>
  </ThingDef>
  <ThingDef ParentName="Bow_Great">
    <defName>LP_Legacy_Bow</defName>
    <label>风语</label>
    <description>传承长弓。沉睡时只是一把大师级的长弓；第一个用它击杀 10 个敌人的人成为它的主人。主人冒险者 10 级时觉醒（伤害 +15%，能力“风之箭”），成为传奇冒险者时升华（再 +15%，射程 +3）。别人拿着只是沉睡版；主人死去后它回到沉睡。无法制作。</description>
    <graphicData><texPath>LP/Weapons/Legacy/Bow</texPath><graphicClass>Graphic_Single</graphicClass></graphicData>
    <smeltable>false</smeltable>
    <statBases><MarketValue>4500</MarketValue><MaxHitPoints>200</MaxHitPoints></statBases>
    <thingSetMakerTags Inherit="False" />
    <weaponTags Inherit="False" />
    <tradeTags Inherit="False"><li>LP_Legacy</li></tradeTags>
    <costList Inherit="False" />
    <recipeMaker IsNull="True" />
    <comps><li Class="LichPhylactery.CompProperties_LegacyWeapon"><kind>Bow</kind><ability>LP_LegacyWindArrow</ability></li></comps>
  </ThingDef>
  <ThingDef ParentName="LP_StaffBase">
    <defName>LP_Legacy_Staff</defName>
    <label>星辉</label>
    <description>传承法杖（按 1.29.0 法杖规则射击：魔力系数 = 心灵敏感度）。沉睡时只是一根大师级的法杖；第一个用它击杀 10 个敌人的人成为它的主人。主人冒险者 10 级时觉醒（伤害 +15%，能力“星落”），成为传奇冒险者时升华（再 +15%，心灵熵恢复 +20%）。别人拿着只是沉睡版；主人死去后它回到沉睡。无法制作。</description>
    <graphicData><texPath>LP/Weapons/Legacy/Staff</texPath><graphicClass>Graphic_Single</graphicClass></graphicData>
    <soundInteract>Interact_Rifle</soundInteract>
    <statBases><RangedWeapon_Cooldown>2.0</RangedWeapon_Cooldown><MarketValue>4500</MarketValue></statBases>
    <tradeTags Inherit="False"><li>LP_Legacy</li></tradeTags>
    <recipeMaker IsNull="True" />
    <verbs>
      <li>
        <verbClass>LichPhylactery.Verb_ArcaneShoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>LP_Bolt_MagicMissile</defaultProjectile>
        <warmupTime>1.0</warmupTime>
        <range>28</range>
        <soundCast>Shot_IncendiaryLauncher</soundCast>
        <muzzleFlashScale>8</muzzleFlashScale>
      </li>
    </verbs>
    <comps>
      <li Class="LichPhylactery.CompProperties_ArcaneWeapon"><group>G</group></li>
      <li Class="LichPhylactery.CompProperties_LegacyWeapon"><kind>Staff</kind><ability>LP_LegacyStarfall</ability></li>
    </comps>
  </ThingDef>

  <!-- ==================== 觉醒能力 ==================== -->
  <AbilityDef Name="LP_LegacyAbilityBase" Abstract="True">
    <displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
    <disableGizmoWhileUndrafted>false</disableGizmoWhileUndrafted>
    <sendMessageOnCooldownComplete>false</sendMessageOnCooldownComplete>
    <showPsycastEffects>false</showPsycastEffects>
    <cooldownTicksRange>60000</cooldownTicksRange>
    <hostile>true</hostile><aiCanUse>true</aiCanUse><ai_IsOffensive>true</ai_IsOffensive>
    <casterMustBeCapableOfViolence>true</casterMustBeCapableOfViolence>
  </AbilityDef>
  <AbilityDef ParentName="LP_LegacyAbilityBase">
    <defName>LP_LegacyDawnStrike</defName>
    <label>黎明斩</label>
    <description>黎明之誓的觉醒能力：对身边一个敌人斩出晨光，30 点光耀伤害并致盲 10 秒（视力 -60%）。每天一次。</description>
    <iconPath>LP/Weapons/Legacy/Sword</iconPath>
    <verbProperties><verbClass>Verb_CastAbility</verbClass><range>2.9</range><warmupTime>0.4</warmupTime>
      <targetParams><canTargetPawns>true</canTargetPawns><canTargetLocations>false</canTargetLocations><canTargetSelf>false</canTargetSelf><canTargetBuildings>false</canTargetBuildings></targetParams></verbProperties>
    <comps><li Class="LichPhylactery.CompProperties_LegacyPower"><effect>dawn</effect></li></comps>
  </AbilityDef>
  <AbilityDef ParentName="LP_LegacyAbilityBase">
    <defName>LP_LegacyQuake</defName>
    <label>震地</label>
    <description>山之心的觉醒能力：重锤砸地，半径 2 内的敌人受到 15 点钝击并倒地 2 秒。每天一次。</description>
    <iconPath>LP/Weapons/Legacy/Hammer</iconPath>
    <targetRequired>false</targetRequired>
    <verbProperties><verbClass>Verb_CastAbility</verbClass><range>0</range><warmupTime>0.6</warmupTime><targetParams><canTargetSelf>true</canTargetSelf></targetParams></verbProperties>
    <comps><li Class="LichPhylactery.CompProperties_LegacyPower"><effect>quake</effect></li></comps>
  </AbilityDef>
  <AbilityDef ParentName="LP_LegacyAbilityBase">
    <defName>LP_LegacyWindArrow</defName>
    <label>风之箭</label>
    <description>风语的觉醒能力：一支风化的箭穿透一整列，路上每个敌人受到 25 点穿刺伤害（射程 30）。每天一次。</description>
    <iconPath>LP/Weapons/Legacy/Bow</iconPath>
    <verbProperties><verbClass>Verb_CastAbility</verbClass><range>30</range><warmupTime>1</warmupTime><requireLineOfSight>true</requireLineOfSight>
      <targetParams><canTargetPawns>true</canTargetPawns><canTargetLocations>true</canTargetLocations><canTargetSelf>false</canTargetSelf><canTargetBuildings>false</canTargetBuildings></targetParams></verbProperties>
    <comps><li Class="LichPhylactery.CompProperties_LegacyPower"><effect>wind</effect></li></comps>
  </AbilityDef>
  <AbilityDef ParentName="LP_LegacyAbilityBase">
    <defName>LP_LegacyStarfall</defName>
    <label>星落</label>
    <description>星辉的觉醒能力：唤下一颗小小的流星，半径 2 内的敌人受到 30 点光耀伤害（射程 25）。每天一次。</description>
    <iconPath>LP/Weapons/Legacy/Staff</iconPath>
    <verbProperties><verbClass>Verb_CastAbility</verbClass><range>25</range><warmupTime>1.2</warmupTime><requireLineOfSight>true</requireLineOfSight>
      <targetParams><canTargetPawns>true</canTargetPawns><canTargetLocations>true</canTargetLocations><canTargetSelf>false</canTargetSelf><canTargetBuildings>false</canTargetBuildings></targetParams></verbProperties>
    <comps><li Class="LichPhylactery.CompProperties_LegacyPower"><effect>starfall</effect></li></comps>
  </AbilityDef>

  <HediffDef>
    <defName>LP_LegacyBlinded</defName>
    <label>晨光致盲</label>
    <description>被黎明斩的光晃花了眼。</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>true</isBad>
    <stages><li><capMods><li><capacity>Sight</capacity><offset>-0.6</offset></li></capMods></li></stages>
    <comps><li Class="HediffCompProperties_Disappears"><disappearsAfterTicks>600</disappearsAfterTicks><showRemainingTime>true</showRemainingTime></li><li Class="HediffCompProperties_DisappearsOnDeath" /></comps>
  </HediffDef>
  <HediffDef>
    <defName>LP_LegacyStarlight</defName>
    <label>星辉共鸣</label>
    <description>升华的星辉与主人共鸣：心灵熵恢复 +20%。</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad><everCurableByItem>false</everCurableByItem>
    <defaultLabelColor>(0.7, 0.65, 0.95)</defaultLabelColor>
    <stages><li><statFactors><PsychicEntropyRecoveryRate>1.2</PsychicEntropyRecoveryRate></statFactors></li></stages>
  </HediffDef>
</Defs>
