      <openGraphic><texPath>LP/Items/Tomes/Tome_STR</texPath><graphicClass>Graphic_Single</graphicClass><drawSize>0.7</drawSize></openGraphic>
      <verticalGraphic><texPath>LP/Items/Tomes/Tome_STR</texPath><graphicClass>Graphic_Single</graphicClass><addTopAltitudeBias>true</addTopAltitudeBias></verticalGraphic>
