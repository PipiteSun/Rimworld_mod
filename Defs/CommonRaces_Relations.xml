<!-- 1.57.0 普通种族的种族关系（共享组件 RacialRelationDef）。observer/target 可以再用 observers/targets 列出多个异种型；
     targetLich = 本殖民地的巫妖也算目标。只计本殖民地成员与囚犯。 -->
<Defs>
  <ThoughtDef Name="LP_RacialRelation157Base" Abstract="True">
    <workerClass>LichPhylactery.ThoughtWorker_DNDRacialRelation</workerClass>
  </ThoughtDef>

  <!-- 精灵 ↔ 卓尔 -5/-5 -->
  <ThoughtDef ParentName="LP_RacialRelation157Base">
    <defName>LP_RacialRelation_ElfDrow</defName>
    <stages><li><label>卓尔叛徒</label><description>和卓尔住在一个屋檐下？那些蛛后的走狗背叛了整个精灵族。</description><baseMoodEffect>-5</baseMoodEffect></li></stages>
  </ThoughtDef>
  <LichPhylactery.RacialRelationDef>
    <defName>LP_Relation_ElfDrow</defName>
    <label>精灵看卓尔</label>
    <observer>LP_Elf</observer>
    <observers><li>LP_WoodElf</li></observers>
    <target>LP_Drow</target>
    <thought>LP_RacialRelation_ElfDrow</thought>
  </LichPhylactery.RacialRelationDef>
  <ThoughtDef ParentName="LP_RacialRelation157Base">
    <defName>LP_RacialRelation_DrowElf</defName>
    <stages><li><label>地表精灵</label><description>那些住在阳光下的软弱精灵，当年把我们赶进了幽暗地域。</description><baseMoodEffect>-5</baseMoodEffect></li></stages>
  </ThoughtDef>
  <LichPhylactery.RacialRelationDef>
    <defName>LP_Relation_DrowElf</defName>
    <label>卓尔看精灵</label>
    <observer>LP_Drow</observer>
    <target>LP_Elf</target>
    <targets><li>LP_WoodElf</li></targets>
    <thought>LP_RacialRelation_DrowElf</thought>
  </LichPhylactery.RacialRelationDef>

