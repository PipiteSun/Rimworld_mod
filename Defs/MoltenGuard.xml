<Defs>
  <ThingDef ParentName="BaseMeleeWeapon_Blunt_Quality">
    <defName>LP_MoltenMaul</defName>
    <label>熔核破城锤</label>
    <description>熔核禁卫的破城重锤。基础钝伤48、穿甲55%、攻击间隔3.6秒。仅限火巨人装备，在熔火锻炉制作。与炉心战盔、熔核重甲共同解锁炉心过载。</description>
    <graphicData>
      <texPath>FireGiant/MoltenGuard/Maul</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1.5,1.5)</drawSize>
    </graphicData>
    <techLevel>Spacer</techLevel>
    <equippedAngleOffset>-45</equippedAngleOffset>
    <statBases>
      <MaxHitPoints>650</MaxHitPoints>
      <Mass>12</Mass>
      <WorkToMake>36000</WorkToMake>
      <Flammability>0</Flammability>
    </statBases>
    <costList>
      <Steel>300</Steel>
      <Plasteel>100</Plasteel>
      <Uranium>30</Uranium>
      <ComponentSpacer>2</ComponentSpacer>
    </costList>
    <tools>
      <li>
        <label>锤头</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>48</power>
        <armorPenetration>0.55</armorPenetration>
        <cooldownTime>3.6</cooldownTime>
      </li>
    </tools>
    <recipeMaker IsNull="True" />
  </ThingDef>
  <ThingDef ParentName="ApparelBase">
    <defName>LP_MoltenHelmet</defName>
    <label>炉心战盔</label>
    <description>熔核禁卫的封闭式战盔。基础利器护甲150%、钝器60%；火巨人穿戴时受到的眩晕持续时间减少30%。只有巨人能穿，在熔火锻炉制作。</description>
    <graphicData>
      <texPath>FireGiant/MoltenGuard/Helmet</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <techLevel>Spacer</techLevel>
    <statBases>
      <MaxHitPoints>450</MaxHitPoints>
      <Mass>4</Mass>
      <WorkToMake>24000</WorkToMake>
      <Flammability>0</Flammability>
      <ArmorRating_Sharp>1.5</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.6</ArmorRating_Blunt>
      <ArmorRating_Heat>1.0</ArmorRating_Heat>
      <Insulation_Cold>5</Insulation_Cold>
      <Insulation_Heat>5</Insulation_Heat>
      <EquipDelay>3</EquipDelay>
    </statBases>
    <costList>
      <Steel>120</Steel>
      <Plasteel>60</Plasteel>
      <Gold>20</Gold>
      <ComponentSpacer>2</ComponentSpacer>
    </costList>
    <thingCategories>
      <li>ApparelArmor</li>
    </thingCategories>
    <apparel>
      <countsAsClothingForNudity>false</countsAsClothingForNudity>
      <bodyPartGroups>
        <li>FullHead</li>
      </bodyPartGroups>
      <wornGraphicPath>FireGiant/MoltenGuard/Worn/Helmet</wornGraphicPath>
      <layers>
        <li>Overhead</li>
      </layers>
      <defaultOutfitTags>
        <li>Soldier</li>
      </defaultOutfitTags>
    </apparel>
    <modExtensions>
      <li Class="LichPhylactery.GiantApparelExtension"><mood>2</mood></li>
    </modExtensions>
    <recipeMaker IsNull="True" />
  </ThingDef>
  <ThingDef ParentName="ApparelBase">
    <defName>LP_MoltenArmor</defName>
    <label>熔核重甲</label>
    <description>熔核禁卫的高级重甲。基础利器护甲160%、钝器75%，移动速度-0.25。只有巨人能穿，在熔火锻炉制作。火巨人全套（加熔核破城锤）技能炉心过载：10秒近战伤害+25%、移动速度+15%；随后10秒移动速度-15%。冷却90秒，从启动时计时；卸下套装不能重置。</description>
    <graphicData>
      <texPath>FireGiant/MoltenGuard/Armor</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <techLevel>Spacer</techLevel>
    <statBases>
      <MaxHitPoints>800</MaxHitPoints>
      <Mass>30</Mass>
      <WorkToMake>65000</WorkToMake>
      <Flammability>0</Flammability>
      <ArmorRating_Sharp>1.6</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.75</ArmorRating_Blunt>
      <ArmorRating_Heat>1.0</ArmorRating_Heat>
      <Insulation_Cold>15</Insulation_Cold>
      <Insulation_Heat>10</Insulation_Heat>
      <EquipDelay>15</EquipDelay>
    </statBases>
    <equippedStatOffsets>
      <MoveSpeed>-0.25</MoveSpeed>
    </equippedStatOffsets>
    <costList>
      <Steel>300</Steel>
      <Plasteel>180</Plasteel>
      <Uranium>50</Uranium>
      <ComponentSpacer>4</ComponentSpacer>
    </costList>
    <thingCategories>
      <li>ApparelArmor</li>
    </thingCategories>
    <apparel>
      <bodyPartGroups>
        <li>Torso</li>
        <li>Neck</li>
        <li>Shoulders</li>
        <li>Arms</li>
        <li>Legs</li>
      </bodyPartGroups>
      <wornGraphicPath>FireGiant/MoltenGuard/Worn/Armor</wornGraphicPath>
      <layers>
        <li>Middle</li>
        <li>Shell</li>
      </layers>
      <defaultOutfitTags>
        <li>Soldier</li>
      </defaultOutfitTags>
    </apparel>
    <thingClass>LichPhylactery.Apparel_MoltenArmor</thingClass>
    <modExtensions>
      <li Class="LichPhylactery.GiantApparelExtension"><mood>2</mood></li>
    </modExtensions>
    <recipeMaker IsNull="True" />
  </ThingDef>
