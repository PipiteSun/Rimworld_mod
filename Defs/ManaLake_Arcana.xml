    <comps><li Class="LichPhylactery.CompProperties_ClassEffect"><effect>ArCloudHand</effect><power>40</power><stat>LP_MartialPower</stat></li></comps>
    <modExtensions><li Class="LichPhylactery.ArcanumExt"><ring>7</ring><cls>LP_Class_Monk</cls></li></modExtensions>
  </AbilityDef>
