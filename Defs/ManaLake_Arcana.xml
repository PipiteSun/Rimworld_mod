    <modExtensions><li Class="LichPhylactery.ArcanumExt"><ring>8</ring><cls>LP_Class_Fighter</cls></li></modExtensions>
  </AbilityDef>
  <AbilityDef ParentName="LP_ClassSelfBase">
    <defName>LP_AC_Warlord</defName>
    <label>万军之主</label>
    <description>秘传（9 环战士）：本地图所有己方人形 1 天内近战命中 +15%、射击精度提高、造成的伤害 ×1.15，不会精神崩溃。冷却 7 天。</description>
    <iconPath>LP/Arcana/Warlord</iconPath>
    <displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
    <cooldownTicksRange>420000</cooldownTicksRange>
    <verbProperties><warmupTime>2</warmupTime></verbProperties>
    <comps><li Class="LichPhylactery.CompProperties_ClassEffect"><effect>ArWarlord</effect><duration>60000</duration><stat>LP_MartialPower</stat><bestSkill>true</bestSkill></li></comps>
    <modExtensions><li Class="LichPhylactery.ArcanumExt"><ring>9</ring><cls>LP_Class_Fighter</cls></li></modExtensions>
  </AbilityDef>

