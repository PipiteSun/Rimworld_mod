<!-- 1.100.0 魔力湖泊职业水晶：12 个职业 × 4 枚（6 / 7 / 8 / 9 环），见 Source/ManaLake.cs、ManaLakeEffects.cs。
     只有那个职业能学（职业等级 11 / 13 / 15 / 17），占秘传槽；不耗资源，冷却 6 环 2 天、7 环 3 天、8 环 5 天、9 环 7 天（个别注明）。
     强度用那个职业的强度属性；数值写的是 ×1 强度时的基础值。 -->
<Defs>

  <!-- ==================== 状态 ==================== -->
  <HediffDef ParentName="LP_ClassBuffBase">
    <defName>LP_ACB_SteelCut</defName>
    <label>斩铁式</label>
    <description>所有攻击无视护甲。</description>
    <defaultLabelColor>(0.95,0.6,0.4)</defaultLabelColor>
  </HediffDef>
  <HediffDef ParentName="LP_ClassBuffBase">
    <defName>LP_ACB_Immovable</defName>
    <label>不动如山</label>
    <description>免疫击晕，不会倒地，受到的伤害 ×0.5。</description>
    <defaultLabelColor>(0.95,0.6,0.4)</defaultLabelColor>
    <stages><li><statFactors><IncomingDamageFactor>0.5</IncomingDamageFactor></statFactors></li></stages>
  </HediffDef>
  <HediffDef ParentName="LP_ClassBuffBase">
    <defName>LP_ACB_SwordDomain</defName>
    <hediffClass>LichPhylactery.Hediff_SwordDomain</hediffClass>
    <label>剑圣之域</label>
    <description>剑气笼罩 3 格：每 0.5 秒对范围里的一名敌人发动一次近战结算。</description>
    <defaultLabelColor>(0.95,0.6,0.4)</defaultLabelColor>
  </HediffDef>
  <HediffDef ParentName="LP_ClassBuffBase">
    <defName>LP_ACB_Warlord</defName>
    <label>万军之主</label>
    <description>近战命中 +15%、射击精度提高、造成的伤害 ×1.15，不会精神崩溃。</description>
    <defaultLabelColor>(0.95,0.75,0.4)</defaultLabelColor>
    <stages><li><blocksMentalBreaks>true</blocksMentalBreaks><statOffsets><MeleeHitChance>0.15</MeleeHitChance><ShootingAccuracyPawn>0.03</ShootingAccuracyPawn></statOffsets></li></stages>
  </HediffDef>
  <HediffDef ParentName="LP_ClassBuffBase">
    <defName>LP_ACP_CloudBody</defName>
    <label>云体</label>
    <description>秘传被动：移动 ×1.3，免疫击晕。</description>
    <defaultLabelColor>(0.75,0.9,1)</defaultLabelColor>
    <comps Inherit="False" />
    <stages><li><statFactors><MoveSpeed>1.3</MoveSpeed></statFactors></li></stages>
  </HediffDef>
  <HediffDef ParentName="LP_ClassBuffBase">
    <defName>LP_ACB_Chained</defName>
    <label>天罚之链</label>
    <description>被神圣锁链锁住：几乎无法移动；每次攻击都会被锁链反噬，受到神圣伤害（数值看严重度）。</description>
    <isBad>true</isBad>
    <maxSeverity>999</maxSeverity>
    <defaultLabelColor>(1,0.9,0.5)</defaultLabelColor>
    <stages><li><statFactors><MoveSpeed>0.05</MoveSpeed></statFactors></li></stages>
  </HediffDef>
  <HediffDef ParentName="LP_ClassBuffBase">
    <defName>LP_ACB_Shield</defName>
    <hediffClass>LichPhylactery.Hediff_ArcanaShield</hediffClass>
    <label>光耀护盾</label>
    <description>吸收伤害的护盾，严重度就是还能吸收的点数。</description>
    <maxSeverity>999</maxSeverity>
    <defaultLabelColor>(1,0.95,0.6)</defaultLabelColor>
  </HediffDef>
  <HediffDef ParentName="LP_ClassBuffBase">
    <defName>LP_ACB_Blinded</defName>
    <label>失明</label>
    <description>被神圣之光或魔法刺瞎，几乎看不见。</description>
    <isBad>true</isBad>
    <defaultLabelColor>(0.9,0.6,0.5)</defaultLabelColor>
    <stages><li><capMods><li><capacity>Sight</capacity><setMax>0.1</setMax></li></capMods></li></stages>
  </HediffDef>
  <HediffDef ParentName="LP_ClassBuffBase">
    <defName>LP_ACB_HolyAura</defName>
    <label>神圣光环</label>
    <description>受到的伤害 ×0.7；近战攻击你的邪魔和亡灵会失明 10 秒。</description>
    <defaultLabelColor>(1,0.95,0.6)</defaultLabelColor>
    <stages><li><statFactors><IncomingDamageFactor>0.7</IncomingDamageFactor></statFactors></li></stages>
  </HediffDef>
  <HediffDef ParentName="LP_ClassBuffBase">
    <defName>LP_ACB_Angelic</defName>
    <label>天界之躯</label>
    <description>天使侍从：受到的伤害 ×0.5，近战伤害 ×1.5。</description>
    <comps Inherit="False" />
    <defaultLabelColor>(1,0.95,0.6)</defaultLabelColor>
    <stages><li><statFactors><IncomingDamageFactor>0.5</IncomingDamageFactor><MeleeDamageFactor>1.5</MeleeDamageFactor></statFactors></li></stages>
  </HediffDef>
  <HediffDef ParentName="LP_ClassBuffBase">
    <defName>LP_ACB_Simulacrum</defName>
    <label>冰雪拟像</label>
    <description>法师用冰雪塑成的拟像：只有本体一半的耐受（受到的伤害 ×2）。</description>
    <comps Inherit="False" />
    <defaultLabelColor>(0.7,0.9,1)</defaultLabelColor>
    <stages><li><statFactors><IncomingDamageFactor>2</IncomingDamageFactor></statFactors></li></stages>
  </HediffDef>
  <HediffDef ParentName="LP_ClassBuffBase">
    <defName>LP_ACB_DragonForm</defName>
    <hediffClass>LichPhylactery.Hediff_ScaledBuff</hediffClass>
    <label>真龙之形</label>
    <description>化身真龙：用龙爪和龙咬战斗，近战伤害 × 野性强度，受到的伤害 ×0.5，移动 ×1.3；不能做精细工作。</description>
    <defaultLabelColor>(0.9,0.4,0.3)</defaultLabelColor>
    <stages><li><disabledWorkTags>Crafting, Intellectual, Caring</disabledWorkTags><statFactors><IncomingDamageFactor>0.5</IncomingDamageFactor><MoveSpeed>1.3</MoveSpeed></statFactors></li></stages>
    <comps><li Class="HediffCompProperties_VerbGiver"><tools><li><label>龙爪</label><capacities><li>Scratch</li></capacities><power>30</power><cooldownTime>1.5</cooldownTime></li><li><label>龙咬</label><capacities><li>Bite</li></capacities><power>36</power><cooldownTime>2</cooldownTime><armorPenetration>0.4</armorPenetration></li></tools></li></comps>
    <modExtensions><li Class="LichPhylactery.ScaledBuffExtension">
      <scaledFactors>
        <li><stat>MeleeDamageFactor</stat><baseValue>0</baseValue><perSeverity>1</perSeverity></li>
      </scaledFactors>
    </li></modExtensions>
  </HediffDef>
  <HediffDef ParentName="LP_ClassBuffBase">
    <defName>LP_ACB_ElementalForm</defName>
    <label>元素化身</label>
    <description>免疫火焰、寒霜、闪电、电击和强酸伤害；术士法术伤害 ×1.3。</description>
    <defaultLabelColor>(1,0.6,0.9)</defaultLabelColor>
  </HediffDef>
  <HediffDef ParentName="LP_ClassBuffBase">
    <defName>LP_ACB_Unstoppable</defName>
    <label>不可阻挡</label>
    <description>狂暴中：免疫击晕。</description>
    <comps Inherit="False" />
    <defaultLabelColor>(0.9,0.3,0.25)</defaultLabelColor>
  </HediffDef>
  <HediffDef ParentName="LP_ClassBuffBase">
    <defName>LP_ACB_Enlarge</defName>
    <label>巨人化</label>
    <description>近战伤害 ×1.5，受到的伤害 ×0.8。</description>
    <defaultLabelColor>(0.9,0.3,0.25)</defaultLabelColor>
    <stages><li><statFactors><MeleeDamageFactor>1.5</MeleeDamageFactor><IncomingDamageFactor>0.8</IncomingDamageFactor></statFactors></li></stages>
  </HediffDef>
  <HediffDef ParentName="LP_ClassBuffBase">
    <defName>LP_ACB_Camouflage</defName>
    <label>自然伪装</label>
    <description>静止不动融进周围：下一次攻击伤害 ×2（攻击或移动后解除）。</description>
    <comps Inherit="False" />
    <defaultLabelColor>(0.5,0.8,0.4)</defaultLabelColor>
  </HediffDef>
  <HediffDef ParentName="LP_ClassBuffBase">
    <defName>LP_ACB_EvolvedBeast</defName>
    <label>兽伴进化</label>
    <description>游侠的兽伴：受到的伤害 ×0.67（相当于生命 +50%），近战伤害 ×1.3，移动 ×1.1。</description>
    <comps Inherit="False" />
    <defaultLabelColor>(0.5,0.8,0.4)</defaultLabelColor>
    <stages><li><statFactors><IncomingDamageFactor>0.67</IncomingDamageFactor><MeleeDamageFactor>1.3</MeleeDamageFactor><MoveSpeed>1.1</MoveSpeed></statFactors></li></stages>
  </HediffDef>
  <HediffDef ParentName="LP_ClassBuffBase">
    <defName>LP_ACB_HuntGodEye</defName>
    <label>猎神之眼</label>
    <description>射击精度大幅提高（几乎必中），对宿敌伤害 ×1.5。</description>
    <defaultLabelColor>(0.5,0.8,0.4)</defaultLabelColor>
    <stages><li><statOffsets><ShootingAccuracyPawn>0.5</ShootingAccuracyPawn></statOffsets></li></stages>
  </HediffDef>
  <HediffDef ParentName="LP_ClassBuffBase">
    <defName>LP_ACB_Crippled</defName>
    <label>致残</label>
    <description>被刺伤筋腱：移动 ×0.5。</description>
    <isBad>true</isBad>
    <defaultLabelColor>(0.75,0.5,0.85)</defaultLabelColor>
    <stages><li><statFactors><MoveSpeed>0.5</MoveSpeed></statFactors></li></stages>
  </HediffDef>

  <!-- 九霄坠击的飞行物、力场发生器 -->
  <ThingDef ParentName="PawnFlyerBase">
    <defName>LP_SkyFallFlyer</defName>
    <label>九霄坠击</label>
    <thingClass>LichPhylactery.LP_SkyFallFlyer</thingClass>
    <pawnFlyer>
      <flightDurationMin>3</flightDurationMin>
      <flightSpeed>10</flightSpeed>
      <heightFactor>6</heightFactor>
    </pawnFlyer>
  </ThingDef>
  <ThingDef ParentName="BuildingBase">
    <defName>LP_ArcaneForceField</defName>
    <label>力场发生器</label>
    <description>器械师拼起来的符文力场柱：子弹能出去，进不来。一天后符文烧尽、自行崩解。</description>
    <altitudeLayer>BuildingOnTop</altitudeLayer>
    <drawerType>MapMeshAndRealTime</drawerType>
    <pathCost>0</pathCost>
    <passability>Standable</passability>
    <fillPercent>0.35</fillPercent>
    <graphicData>
      <texPath>LP/Arcana/ForceFieldPylon</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>0.8</drawSize>
    </graphicData>
    <statBases>
      <MaxHitPoints>300</MaxHitPoints>
      <Flammability>0</Flammability>
    </statBases>
    <tickerType>Normal</tickerType>
    <killedLeavings/>
    <rotatable>false</rotatable>
    <selectable>true</selectable>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <resourcesFractionWhenDeconstructed>0</resourcesFractionWhenDeconstructed>
    <building>
      <claimable>false</claimable>
      <ai_chillDestination>false</ai_chillDestination>
      <isEdifice>false</isEdifice>
    </building>
    <comps>
      <li Class="CompProperties_ProjectileInterceptor">
        <radius>5</radius>
        <interceptGroundProjectiles>true</interceptGroundProjectiles>
        <interceptNonHostileProjectiles>false</interceptNonHostileProjectiles>
        <interceptOutgoingProjectiles>false</interceptOutgoingProjectiles>
        <color>(0.45, 0.75, 1)</color>
        <idlePulseSpeed>3</idlePulseSpeed>
        <minIdleAlpha>0.05</minIdleAlpha>
        <disarmedByEmpForTicks>600</disarmedByEmpForTicks>
      </li>
      <li Class="CompProperties_DestroyAfterDelay">
        <delayTicks>60000</delayTicks>
        <destroyMode>KillFinalize</destroyMode>
        <countdownLabel>崩解倒计时</countdownLabel>
      </li>
    </comps>
  </ThingDef>
  <PawnKindDef ParentName="LP_FighterBase">
    <defName>LP_AC_AngelKind</defName>
    <label>天使侍从</label>
    <combatPower>150</combatPower>
    <apparelMoney>800~1400</apparelMoney>
    <weaponMoney>500~900</weaponMoney>
    <itemQuality>Good</itemQuality>
    <weaponTags>
      <li>MedievalMeleeAdvanced</li>
    </weaponTags>
    <skills>
      <li><skill>Melee</skill><range>12~16</range></li>
    </skills>
  </PawnKindDef>

