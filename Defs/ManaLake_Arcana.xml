    <cooldownTicksRange>180000</cooldownTicksRange>
    <verbProperties><warmupTime>0.1</warmupTime></verbProperties>
    <comps><li Class="LichPhylactery.CompProperties_ClassEffect"><effect>SelfBuff</effect><hediff>LP_ACB_Immovable</hediff><duration>1800</duration><stat>LP_MartialPower</stat><bestSkill>true</bestSkill></li></comps>
    <modExtensions><li Class="LichPhylactery.ArcanumExt"><ring>7</ring><cls>LP_Class_Fighter</cls></li></modExtensions>
  </AbilityDef>
  <AbilityDef ParentName="LP_ClassSelfBase">
    <defName>LP_AC_SwordDomain</defName>
    <label>剑圣之域</label>
    <description>秘传（8 环战士）：20 秒内剑气笼罩身边 3 格，每 0.5 秒对范围里的一名敌人发动一次近战结算（按当前近战武器，伤害 × 战技强度）。冷却 5 天。</description>
