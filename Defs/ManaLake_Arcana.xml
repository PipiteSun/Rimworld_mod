    <modExtensions><li Class="LichPhylactery.ArcanumExt"><ring>6</ring><cls>LP_Class_Fighter</cls></li></modExtensions>
  </AbilityDef>
  <AbilityDef ParentName="LP_ClassSelfBase">
    <defName>LP_AC_Immovable</defName>
