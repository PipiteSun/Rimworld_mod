<!-- 1.66.0 武艺天赋（ArtSource/CombatGifts-1.66.0-spec.md；代码在 Source/CombatGifts.cs）。
     蓝色 #5B9BD5，独立名额，每人最多“每人最多武艺天赋”个（1.66.0 热修，原来 exclusionTags LP_CombatGift 只能一个），和强力特性并存，commonality 0：生成后缀里自己掷。
     描述只写入门数值；精通 / 化境和当前阶段由悬停说明（CombatGiftTip）补上。 -->
<Defs>

  <TraitDef>
    <defName>LP_CG_Mighty</defName>
    <commonality>0</commonality>
    <degreeDatas>
      <li>
        <label><![CDATA[<color=#5B9BD5>巨力</color>]]></label>
        <description>{PAWN_nameDef}天生神力，抡起战锤像抡起柴刀。\n\n入门：力量 +2（上限 +2）；负重 +25%</description>
      </li>
    </degreeDatas>
    <modExtensions>
      <li Class="LichPhylactery.TraitRarityExt"><tier>Rare</tier><kind>武艺天赋</kind></li>
    </modExtensions>
  </TraitDef>

  <TraitDef>
    <defName>LP_CG_Swift</defName>
    <commonality>0</commonality>
