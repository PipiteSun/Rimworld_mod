      <tags><li>LP_AntiMagic</li></tags>
      <careIfWornByCorpse>false</careIfWornByCorpse>
    </apparel>
  </ThingDef>
  <ThingDef ParentName="LP_ThrowableBase">
    <defName>LP_HellfireOrb</defName>
    <label>地狱火宝珠</label>
    <description>死亡骑士化灰后留下的暗红色宝珠，里面翻滚着地狱火。投出去会炸开一个半径 4 的地狱火球：一半火焰、一半死灵伤害（敏捷豁免减半）。只能用一次。</description>
    <graphicData><texPath>LegendaryMonsters/Items/HellfireOrb</texPath><graphicClass>Graphic_Single</graphicClass></graphicData>
    <statBases><MarketValue>900</MarketValue><Mass>0.5</Mass></statBases>
