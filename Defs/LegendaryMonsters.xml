  <ThingDef ParentName="ResourceBase">
    <defName>LP_SoulGem</defName>
    <label>灵魂宝石</label>
    <description>半巫妖眼窝里的宝石，里面关着它吞下的灵魂。巫妖用它：命匣一次获得 100 点献祭经验。别人摔碎它：放出灵魂，地图上的殖民者心情 +5（3 天）。</description>
    <graphicData><texPath>LegendaryMonsters/Items/SoulGem</texPath><graphicClass>Graphic_Single</graphicClass></graphicData>
    <stackLimit>5</stackLimit>
    <thingCategories><li>Items</li></thingCategories>
    <statBases><MarketValue>2500</MarketValue><Mass>0.2</Mass><MaxHitPoints>80</MaxHitPoints><Flammability>0</Flammability></statBases>
    <comps>
      <li Class="CompProperties_Usable"><useJob>UseItem</useJob><useLabel>使用{0_label}</useLabel><useDuration>240</useDuration></li>
      <li Class="CompProperties_UseEffect"><compClass>LichPhylactery.CompUseEffect_SoulGem</compClass></li>
      <li Class="CompProperties_UseEffectDestroySelf" />
    </comps>
  </ThingDef>
  <ThingDef ParentName="ResourceBase">
    <defName>LP_DemilichSkull</defName>
