<?xml version="1.0" encoding="utf-8"?>
<!-- 1.52.1 传奇怪（规则在 Source/LegendaryMonsters.cs，传奇层在 Source/Legendary.cs）。
     贝希尔、眼魔、半巫妖的种族和兵种在 Bridges/HAR/Defs/LegendaryMonsters_Race.xml（只在启用 HAR 时加载）；
     这里是不需要 HAR 的部分：派系「传奇怪物」、死亡骑士、各自的“XX之躯”、掉落物、两个世界地点、龙的猎手事件。 -->
<Defs>

  <FactionDef ParentName="LP_FactionBase">
    <defName>LP_LegendaryBeasts</defName>
    <label>传奇怪物</label>
    <fixedName>传奇怪物</fixedName>
    <description>贝希尔、眼魔、半巫妖这些独来独往的传说中的怪物。它们不结盟、不谈判，对谁都怀着敌意。</description>
    <pawnSingular>怪物</pawnSingular>
    <pawnsPlural>怪物</pawnsPlural>
    <techLevel>Medieval</techLevel>
    <hidden>true</hidden>
    <permanentEnemy>true</permanentEnemy>
    <requiredCountAtGameStart>0</requiredCountAtGameStart>
    <startingCountAtWorldCreation>0</startingCountAtWorldCreation>
    <maxConfigurableAtWorldCreation>0</maxConfigurableAtWorldCreation>
    <displayInFactionSelection>false</displayInFactionSelection>
    <settlementGenerationWeight>0</settlementGenerationWeight>
    <canStageAttacks>false</canStageAttacks>
    <raidsForbidden>true</raidsForbidden>
    <canGenerateQuestSites>false</canGenerateQuestSites>
    <rescueesCanJoin>false</rescueesCanJoin>
    <factionIconPath>LegendaryMonsters/Faction</factionIconPath>
    <colorSpectrum>
      <li>(0.46, 0.30, 0.60)</li>
      <li>(0.34, 0.50, 0.44)</li>
    </colorSpectrum>
    <basicMemberKind>LP_DragonCultist</basicMemberKind>
    <backstoryFilters Inherit="False">
      <li><categories><li>LP_DragonCult</li></categories></li>
    </backstoryFilters>
    <ideoName>无名的饥渴</ideoName>
    <ideoDescription>活着就是为了吞下更多。</ideoDescription>
    <forcedMemes>
      <li MayRequire="Ludeon.RimWorld.Ideology">Structure_Ideological</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">Supremacist</li>
    </forcedMemes>
    <raidCommonalityFromPointsCurve><points><li>(0, 0)</li></points></raidCommonalityFromPointsCurve>
    <pawnGroupMakers>
      <li>
        <kindDef>Combat</kindDef>
        <options><LP_DragonCultist>1</LP_DragonCultist></options>
      </li>
    </pawnGroupMakers>
  </FactionDef>

  <!-- 传奇怪自己的“背景”（只给贝希尔、眼魔、半巫妖）。 -->
  <BackstoryDef>
    <defName>LP_Bs_MonsterSpawn</defName>
    <title>幽暗中诞生</title>
    <titleShort>怪物</titleShort>
    <description>[PAWN_nameDef]诞生在没有光的地方，从小就靠吞掉别的东西活下来。</description>
    <slot>Childhood</slot>
    <spawnCategories><li>LP_MonsterBio</li></spawnCategories>
    <skillGains><Melee>6</Melee></skillGains>
    <workDisables>ManualDumb, ManualSkilled, Caring, Artistic, Crafting, Cooking, Animals, PlantWork, Mining</workDisables>
  </BackstoryDef>
  <BackstoryDef>
    <defName>LP_Bs_MonsterLegend</defName>
    <title>传说中的怪物</title>
    <titleShort>传奇怪</titleShort>
    <description>吟游诗人唱过[PAWN_nameDef]的故事，唱的都是去找它的人再也没有回来。</description>
    <slot>Adulthood</slot>
    <spawnCategories><li>LP_MonsterBio</li></spawnCategories>
    <skillGains><Melee>8</Melee><Shooting>6</Shooting><Intellectual>4</Intellectual></skillGains>
    <workDisables>ManualDumb, ManualSkilled, Caring, Artistic, Crafting, Cooking, Animals, PlantWork, Mining</workDisables>
  </BackstoryDef>

  <!-- ==================== 死亡骑士（人类 + 亡灵之躯，不需要 HAR） ==================== -->  <PawnKindDef ParentName="LP_FHBase">
    <defName>LP_LM_DeathKnight</defName>
    <label>死亡骑士</label>
    <combatPower>700</combatPower>
    <minGenerationAge>30</minGenerationAge>
    <itemQuality>Excellent</itemQuality>
    <apparelMoney>300~600</apparelMoney>
    <apparelTags>
      <li>Medieval</li>
    </apparelTags>
    <weaponMoney>0</weaponMoney>
    <forcedHair>Shaved</forcedHair>
    <canBeSapper>false</canBeSapper>
    <humanPregnancyChance>0</humanPregnancyChance>
    <initialResistanceRange>100~100</initialResistanceRange>
    <modExtensions>
      <li Class="LichPhylactery.LP_LegendaryExtension">
        <title>死亡骑士</title>
        <level>22~24</level>
        <scores><li>20</li><li>11</li><li>20</li><li>12</li><li>16</li><li>18</li></scores>
        <cr>17</cr>
        <resistance>3</resistance>
        <actionPoints>3</actionPoints>
        <actions>
          <li><action>Detect</action><cost>1</cost></li>
          <li><action>UndeadCommand</action><cost>1</cost><cooldown>600</cooldown></li>
          <li><action>Hellfire</action><cost>2</cost><cooldown>300</cooldown></li>
        </actions>
        <legendPoints>2</legendPoints>
        <deathOnDowned>false</deathOnDowned>
      </li>
      <li Class="LichPhylactery.LP_MonsterExtension">
        <kind>deathknight</kind>
        <healthFactor>4</healthFactor>
      </li>
    </modExtensions>
  </PawnKindDef>

  <!-- ==================== 各自的“XX之躯” ==================== -->
  <HediffDef Name="LP_MonsterBodyBase" Abstract="True">
    <hediffClass>LichPhylactery.Hediff_MonsterBody</hediffClass>
    <defaultLabelColor>(0.75, 0.6, 0.95)</defaultLabelColor>
    <isBad>false</isBad>
    <everCurableByItem>false</everCurableByItem>
  </HediffDef>
  <HediffDef ParentName="LP_MonsterBodyBase">
    <defName>LP_BehirBody</defName>
    <label>贝希尔之躯</label>
    <description>蛇一样的十二足猎龙者：闪电吐息每 6 秒有 1/3 几率充好，吐出一道 16 格的闪电（敏捷豁免减半，对机械体 ×2）；把贴身的人吞进肚子（每秒 4 点酸蚀，打它 60 点或里面挣扎 30 点就吐出来）。打真龙和力能龙裔伤害 ×1.5，不怕龙的威仪。倒地即死。</description>
    <stages><li>
      <painFactor>0.6</painFactor><blocksMentalBreaks>true</blocksMentalBreaks>
      <disablesNeeds><li>Food</li><li>Rest</li><li>Joy</li><li>Beauty</li><li>Comfort</li><li>Outdoors</li><li>RoomSize</li><li MayRequire="Ludeon.RimWorld.Ideology">Indoors</li></disablesNeeds>
      <damageFactors><LP_Shock>0</LP_Shock></damageFactors>
      <statOffsets><ComfyTemperatureMin>-40</ComfyTemperatureMin><ComfyTemperatureMax>60</ComfyTemperatureMax></statOffsets>
    </li></stages>
  </HediffDef>
  <HediffDef ParentName="LP_MonsterBodyBase">
    <defName>LP_BeholderBody</defName>
    <label>眼魔之躯</label>
    <description>漂浮的眼球：每 3 秒从眼柄射出 1～2 道射线（全部可以豁免）；打掉一根眼柄就少一种射线。主眼正面 60° 锥形 20 格内不能施法、护盾腰带失效。倒地即死。</description>
    <stages><li>
      <painFactor>0.6</painFactor><blocksMentalBreaks>true</blocksMentalBreaks>
      <disablesNeeds><li>Food</li><li>Rest</li><li>Joy</li><li>Beauty</li><li>Comfort</li><li>Outdoors</li><li>RoomSize</li><li MayRequire="Ludeon.RimWorld.Ideology">Indoors</li></disablesNeeds>
      <statOffsets><ComfyTemperatureMin>-40</ComfyTemperatureMin><ComfyTemperatureMax>40</ComfyTemperatureMax></statOffsets>
    </li></stages>
  </HediffDef>
  <HediffDef ParentName="LP_MonsterBodyBase">
    <defName>LP_DeathKnightBody</defName>
    <label>死亡骑士之躯</label>
    <description>被诅咒的不死骑士：不吃不睡、不会崩溃。每 20 秒朝敌人最密的地方掷一枚地狱火球（半径 4，一半火焰一半死灵，敏捷豁免减半）；15 格内的亡灵伤害与护甲 +20%。倒地后 1 小时化为灰烬，只留下铠甲。</description>
    <stages><li>
      <painFactor>0.5</painFactor><blocksMentalBreaks>true</blocksMentalBreaks>
      <disablesNeeds><li>Food</li><li>Rest</li><li>Joy</li><li>Beauty</li><li>Comfort</li><li>Outdoors</li><li>RoomSize</li><li MayRequire="Ludeon.RimWorld.Ideology">Indoors</li></disablesNeeds>
      <damageFactors><LP_Necrotic>0</LP_Necrotic></damageFactors>
      <statOffsets><ToxicResistance>1</ToxicResistance><ComfyTemperatureMin>-60</ComfyTemperatureMin><ComfyTemperatureMax>60</ComfyTemperatureMax></statOffsets>
    </li></stages>
  </HediffDef>
  <HediffDef ParentName="LP_MonsterBodyBase">
    <defName>LP_DemilichBody</defName>
    <label>半巫妖之躯</label>
    <description>只剩一颗镶着宝石的头骨：每 60 秒发出一次吞魂之嚎（20 格内活人体质豁免难度 21、基础成功率 10%，失败灵魂撕裂、倒地，30 秒内不救治就死；巫妖和死灵造物免疫）。圣水、银器伤害 ×2。倒地即死。</description>
    <stages><li>
      <painFactor>0.3</painFactor><blocksMentalBreaks>true</blocksMentalBreaks>
      <disablesNeeds><li>Food</li><li>Rest</li><li>Joy</li><li>Beauty</li><li>Comfort</li><li>Outdoors</li><li>RoomSize</li><li MayRequire="Ludeon.RimWorld.Ideology">Indoors</li></disablesNeeds>
      <damageFactors><LP_Necrotic>0</LP_Necrotic></damageFactors>
      <statOffsets><ToxicResistance>1</ToxicResistance><ComfyTemperatureMin>-100</ComfyTemperatureMin><ComfyTemperatureMax>100</ComfyTemperatureMax></statOffsets>
    </li></stages>
  </HediffDef>

  <HediffDef>
    <defName>LP_UndeadCommanded</defName>
    <label>亡灵统领</label>
    <description>死亡骑士的意志驱使着这具亡灵：伤害与护甲 +20%。</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <comps><li Class="HediffCompProperties_Disappears"><disappearsAfterTicks>360</disappearsAfterTicks></li></comps>
    <stages><li><statFactors><MeleeDamageFactor>1.2</MeleeDamageFactor><ArmorRating_Sharp>1.2</ArmorRating_Sharp><ArmorRating_Blunt>1.2</ArmorRating_Blunt></statFactors></li></stages>
  </HediffDef>
  <HediffDef>
    <defName>LP_BeholderPetrified</defName>
    <label>石化</label>
    <description>被眼魔的石化射线定住了，全身像石头一样僵硬：一天之内动不了。驱散粉尘可以解除。</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>true</isBad>
    <defaultLabelColor>(0.7, 0.7, 0.7)</defaultLabelColor>
    <comps><li Class="HediffCompProperties_Disappears"><disappearsAfterTicks>60000</disappearsAfterTicks><showRemainingTime>true</showRemainingTime></li></comps>
    <stages><li><capMods><li><capacity>Moving</capacity><setMax>0</setMax></li><li><capacity>Manipulation</capacity><setMax>0.05</setMax></li></capMods></li></stages>
  </HediffDef>
  <HediffDef>
    <defName>LP_SoulTorn</defName>
    <label>灵魂撕裂</label>
    <description>灵魂被半巫妖的嚎叫撕下了一半，吸进了它的宝石。人倒在地上，30 秒内不包扎就会死；包扎之后变成“缝合的灵魂”，一天后恢复。</description>
    <hediffClass>LichPhylactery.Hediff_SoulTorn</hediffClass>
    <isBad>true</isBad>
    <tendable>true</tendable>
    <initialSeverity>1</initialSeverity>
    <lethalSeverity>-1</lethalSeverity>
    <defaultLabelColor>(0.6, 0.9, 0.8)</defaultLabelColor>
    <comps>
      <li Class="HediffCompProperties_TendDuration"><baseTendDurationHours>24</baseTendDurationHours><severityPerDayTended>0</severityPerDayTended></li>
      <li Class="HediffCompProperties_Disappears"><disappearsAfterTicks>120000</disappearsAfterTicks></li>
    </comps>
    <stages>
      <li><minSeverity>0</minSeverity><label>缝合</label><capMods><li><capacity>Consciousness</capacity><offset>-0.2</offset></li></capMods></li>
      <li><minSeverity>0.9</minSeverity><lifeThreatening>true</lifeThreatening><capMods><li><capacity>Consciousness</capacity><setMax>0.1</setMax></li></capMods></li>
    </stages>
  </HediffDef>
  <HediffDef>
    <defName>LP_DemilichCurse</defName>
    <label>半巫妖的诅咒</label>
    <description>半巫妖的诅咒：命中和工作效率降低，一天后消散。</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>true</isBad>
    <comps><li Class="HediffCompProperties_Disappears"><disappearsAfterTicks>60000</disappearsAfterTicks><showRemainingTime>true</showRemainingTime></li></comps>
    <stages><li><statFactors><MeleeHitChance>0.8</MeleeHitChance><ShootingAccuracyPawn>0.8</ShootingAccuracyPawn><WorkSpeedGlobal>0.8</WorkSpeedGlobal></statFactors></li></stages>
  </HediffDef>
  <ThoughtDef>
    <defName>LP_SoulsFreed</defName>
    <thoughtClass>Thought_Memory</thoughtClass>
    <durationDays>3</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>灵魂得到解放</label><description>灵魂宝石碎了，被困的灵魂飘走了。心里轻松了不少。</description><baseMoodEffect>5</baseMoodEffect></li></stages>
  </ThoughtDef>

