    <statBases><MarketValue>7</MarketValue><StuffPower_Armor_Sharp>1.1</StuffPower_Armor_Sharp><StuffPower_Armor_Blunt>0.4</StuffPower_Armor_Blunt><StuffPower_Armor_Heat>1.2</StuffPower_Armor_Heat><StuffPower_Insulation_Cold>14</StuffPower_Insulation_Cold><StuffPower_Insulation_Heat>10</StuffPower_Insulation_Heat></statBases>
