  <ThingDef ParentName="ResourceBase">
    <defName>LP_BeholderEye</defName>
    <label>眼魔主眼</label>
    <description>眼魔中央那只大眼，死后还在发出反魔法的微光。可以在附魔台做成反魔法护符。</description>
    <graphicData><texPath>LegendaryMonsters/Items/BeholderEye</texPath><graphicClass>Graphic_Single</graphicClass></graphicData>
    <stackLimit>5</stackLimit>
    <statBases><MarketValue>1500</MarketValue><Mass>2</Mass><MaxHitPoints>60</MaxHitPoints><Flammability>0.5</Flammability></statBases>
    <thingCategories><li>ResourcesRaw</li></thingCategories>
  </ThingDef>
  <ThingDef ParentName="ResourceBase">
    <defName>LP_BeholderStalk</defName>
    <label>眼魔眼柄</label>
    <description>眼魔的一根眼柄，末端的小眼还在转。法师们拿它当抄写卷轴的高级原料，商人也愿意出好价钱。</description>
    <graphicData><texPath>LegendaryMonsters/Items/BeholderStalk</texPath><graphicClass>Graphic_Single</graphicClass></graphicData>
    <stackLimit>20</stackLimit>
    <statBases><MarketValue>250</MarketValue><Mass>0.3</Mass><MaxHitPoints>40</MaxHitPoints><Flammability>0.5</Flammability></statBases>
    <thingCategories><li>ResourcesRaw</li></thingCategories>
  </ThingDef>
  <ThingDef ParentName="ApparelNoQualityBase">
    <defName>LP_AntiMagicAmulet</defName>
    <label>反魔法护符</label>
    <description>用眼魔主眼做的护符，挂在腰间。佩戴者 3 格内的敌人不能施法、护盾腰带失效——佩戴者自己也不能施法。</description>
    <graphicData><texPath>LegendaryMonsters/Items/AntiMagicAmulet</texPath><graphicClass>Graphic_Single</graphicClass></graphicData>
    <techLevel>Medieval</techLevel>
    <statBases><MarketValue>2400</MarketValue><Mass>0.5</Mass><MaxHitPoints>100</MaxHitPoints><WorkToMake>6000</WorkToMake><EquipDelay>2</EquipDelay></statBases>
    <thingCategories><li>ApparelUtility</li></thingCategories>
    <costList><LP_BeholderEye>1</LP_BeholderEye><Gold>20</Gold></costList>
