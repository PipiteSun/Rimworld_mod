<?xml version="1.0" encoding="utf-8"?>
<!-- 1.16.0 常见种族：半兽人、精灵、矮人（不含亚种）。外貌与大部分能力用原版《生物科技》基因组合，自定义基因只做少量被动机制。 -->
<Defs>
  <!-- ==================== 半兽人 ==================== -->
  <XenotypeDef>
    <defName>LP_HalfOrc</defName>
    <label>半兽人</label>
    <description>兽人与人类的混血后代，血脉会遗传给子女。绿色皮肤、厚重下颌，身体结实，擅长近战，力气大、出手狠；脾气暴躁，学东西慢，不擅长交际，长相也不讨喜。半兽人有一股不肯倒下的狠劲：本该倒地时能咬牙再撑半天；挥出的拳头和刀斧偶尔会打出野蛮重击。</description>
    <descriptionShort>可遗传的混血种族。近战强、身体结实、能在黑暗中视物；暴躁、学得慢、不擅交际。每天一次咬牙硬撑不倒地，近战偶尔重击。</descriptionShort>
    <iconPath>CommonRaces/Xenotypes/HalfOrc</iconPath>
    <inheritable>true</inheritable>
    <combatPowerFactor>1.15</combatPowerFactor>
    <factionlessGenerationWeight>0</factionlessGenerationWeight>
    <genes>
      <li>LP_HalfOrcRelentless</li>
      <li>LP_HalfOrcSavage</li>
      <li>Skin_Green</li>
      <li>Jaw_Heavy</li>
      <li>Beauty_Ugly</li>
      <li>AptitudeStrong_Melee</li>
      <li>MeleeDamage_Strong</li>
      <li>Robust</li>
      <li>DarkVision</li>
      <li>AptitudePoor_Social</li>
      <li>Aggression_Aggressive</li>
      <li>Learning_Slow</li>
    </genes>
  </XenotypeDef>
  <GeneDef>
    <defName>LP_HalfOrcRelentless</defName>
    <label>不屈坚韧</label>
    <description>受到会让人倒下（但不致死）的伤害时，半兽人咬牙硬撑12小时：疼痛不会让其休克倒地，意识不会低于约30%。12小时后伤势照常结算，如果仍然重伤就会倒下。每天最多触发一次；致命伤害照常致死。</description>
    <iconPath>CommonRaces/Genes/Relentless</iconPath>
    <displayCategory>Miscellaneous</displayCategory>
    <biostatCpx>2</biostatCpx>
    <biostatMet>-1</biostatMet>
    <selectionWeight>0</selectionWeight>
    <customEffectDescriptions>
      <li>本该倒地时不倒地，获得12小时"咬牙硬撑"：疼痛不致休克，意识保底约30%。</li>
      <li>冷却1天（健康页显示"不屈冷却"）；双腿失去行动能力仍会倒地；致命伤害不受影响。</li>
    </customEffectDescriptions>
    <modExtensions>
      <li Class="LichPhylactery.OncePerCooldownExtension">
        <workerClass>LichPhylactery.OncePerCooldownWorker_Relentless</workerClass>
        <cooldownHediff>LP_RelentlessCooldown</cooldownHediff>
        <cooldownDays>1</cooldownDays>
        <onDowned>true</onDowned>
        <onDeath>false</onDeath>
        <grantedHediff>LP_RelentlessEndurance</grantedHediff>
        <grantedHours>12</grantedHours>
        <moteText>咬牙硬撑！</moteText>
      </li>
    </modExtensions>
  </GeneDef>
  <GeneDef>
    <defName>LP_HalfOrcSavage</defName>
    <label>野蛮攻击</label>
    <description>半兽人的近战命中有10%概率打出野蛮重击，这一击伤害×150%。</description>
    <iconPath>CommonRaces/Genes/Savage</iconPath>
    <displayCategory>Violence</displayCategory>
    <biostatCpx>1</biostatCpx>
    <biostatMet>0</biostatMet>
    <selectionWeight>0</selectionWeight>
    <customEffectDescriptions>
      <li>近战命中时10%概率重击：伤害×150%。</li>
    </customEffectDescriptions>
  </GeneDef>
  <HediffDef>
    <defName>LP_RelentlessEndurance</defName>
    <label>咬牙硬撑</label>
    <description>凭一股狠劲撑着不倒。疼痛不会让人休克倒地，意识不会低于约30%。效果结束后伤势照常结算。</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.6, 0.85, 0.4)</defaultLabelColor>
    <isBad>false</isBad>
    <everCurableByItem>false</everCurableByItem>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>30000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
  </HediffDef>
  <HediffDef>
    <defName>LP_RelentlessCooldown</defName>
    <label>不屈冷却</label>
    <description>刚刚咬牙硬撑过一次。冷却结束前不会再次触发不屈坚韧。</description>
    <hediffClass>LichPhylactery.Hediff_OncePerCooldown</hediffClass>
    <defaultLabelColor>(0.85, 0.8, 0.5)</defaultLabelColor>
    <isBad>false</isBad>
    <everCurableByItem>false</everCurableByItem>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>60000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
  </HediffDef>

  <!-- ==================== 精灵 ==================== -->
  <XenotypeDef>
    <defName>LP_Elf</defName>
    <label>高等精灵</label>
    <description>修长美丽的长寿种族，血脉会遗传给子女（1.57.0 起称"高等精灵"，旧存档里的精灵就是高等精灵）。白皙的皮肤、金发或银发，尖耳、纤瘦、天生的好射手，学东西快，擅长艺术；睡得少，成年后衰老速度只有常人的四分之一；心智坚定，不易被心灵类效果影响。身体比较脆弱，受伤更重，近战力量也弱，也不屑于粗重活。精灵在睡眠中进入冥想般的"出神"，有灵能的精灵睡觉时会慢慢恢复精神力，醒来时心情更好。</description>
    <descriptionShort>可遗传的长寿种族。射击、艺术强，学得快，睡得少、成年后衰老极慢、心智抗性高；身体脆弱、近战弱、体力活慢。睡眠时冥想，醒来心情更好。</descriptionShort>
    <iconPath>CommonRaces/Xenotypes/Elf</iconPath>
    <inheritable>true</inheritable>
    <combatPowerFactor>1.0</combatPowerFactor>
    <factionlessGenerationWeight>0</factionlessGenerationWeight>
    <genes>
      <li>LP_ElfTrance</li>
      <li>LP_ElfBloodline</li>
      <li>LP_ElfLongevity</li>
      <li>LP_HighElfLineage</li>
      <li>Ears_Pointed</li>
      <li>Body_Thin</li>
      <li>Beauty_Pretty</li>
      <li>AptitudeStrong_Shooting</li>
      <li>AptitudeStrong_Artistic</li>
      <li>Learning_Fast</li>
      <li>LowSleep</li>
      <li>Delicate</li>
      <li>MeleeDamage_Weak</li>
    </genes>
    <modExtensions>
      <li Class="LichPhylactery.RaceLookExtension">
        <skinGenes><li>Skin_Melanin1</li><li>Skin_Melanin2</li></skinGenes>
        <hairGenes><li>Hair_Blonde</li><li>Hair_SandyBlonde</li><li>Hair_SnowWhite</li></hairGenes>
      </li>
    </modExtensions>
  </XenotypeDef>
  <GeneDef>
    <defName>LP_ElfTrance</defName>
    <label>冥想之息</label>
    <description>精灵的睡眠是一种冥想般的出神。睡着时，有灵能（心灵链接）的精灵每晚约恢复20%精神力；没有灵能的精灵没有这项收益。睡满2小时后醒来，获得"清醒冥想"心情+3，持续半天。</description>
    <geneClass>LichPhylactery.Gene_ElfTrance</geneClass>
    <iconPath>CommonRaces/Genes/ElfTrance</iconPath>
    <displayCategory>Miscellaneous</displayCategory>
    <biostatCpx>1</biostatCpx>
    <biostatMet>0</biostatMet>
    <selectionWeight>0</selectionWeight>
    <customEffectDescriptions>
      <li>睡眠中精神力恢复：每8小时约+20%（仅有心灵链接时）。</li>
      <li>睡满2小时醒来：心情+3，持续半天。</li>
    </customEffectDescriptions>
  </GeneDef>
  <GeneDef>
    <defName>LP_ElfBloodline</defName>
    <label>精灵血统</label>
    <description>古老的精灵血脉让心智格外坚定，能抵抗心灵震爆、魅惑、寄生等心智类效果，心灵嗡鸣等心灵类负面心情也会减弱一半。</description>
    <iconPath>CommonRaces/Genes/ElfBloodline</iconPath>
    <displayCategory>Miscellaneous</displayCategory>
    <biostatCpx>1</biostatCpx>
    <biostatMet>0</biostatMet>
    <selectionWeight>0</selectionWeight>
    <statOffsets>
      <LP_MindResist>0.5</LP_MindResist>
    </statOffsets>
  </GeneDef>
  <GeneDef>
    <defName>LP_ElfLongevity</defName>
    <label>精灵长寿</label>
    <description>缓慢的新陈代谢让精灵在成年后衰老得极慢。13岁起衰老逐渐放缓，18岁后生理年龄增长速度只有常人的25%。童年成长不受影响。</description>
    <iconPath>CommonRaces/Genes/ElfLongevity</iconPath>
    <displayCategory>Miscellaneous</displayCategory>
    <biostatCpx>2</biostatCpx>
    <biostatMet>1</biostatMet>
    <selectionWeight>0</selectionWeight>
    <biologicalAgeTickFactorFromAgeCurve>
      <points>
        <li>(13, 1)</li>
        <li>(18.5, 0.25)</li>
      </points>
    </biologicalAgeTickFactorFromAgeCurve>
  </GeneDef>
  <ThoughtDef>
    <defName>LP_ElfTranceRested</defName>
    <durationDays>0.5</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>清醒冥想</label>
        <description>一夜的出神冥想让我头脑清明。</description>
        <baseMoodEffect>3</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <!-- ==================== 矮人 ==================== -->
  <XenotypeDef>
    <defName>LP_Dwarf</defName>
    <label>山地矮人</label>
    <description>矮小敦实的山地种族，血脉会遗传给子女（1.57.0 起称"山地矮人"，旧存档里的矮人就是山地矮人）。体型约为普通人的80%，个个蓄着胡子；身体结实、耐毒、能在黑暗中视物，是天生的矿工、工匠和斧手，只是走得慢。山地矮人从小穿着铁甲长大，衣甲拖慢的速度只算一半。矮人喝酒不会上瘾，宿醉也轻，几杯下肚还会壮起胆子；住在厚岩顶的山腹里时心情更好，挖矿和干活也更快；矮人从不忘记血债。</description>
    <descriptionShort>可遗传的矮小种族。采矿、手工、近战强，身体结实耐毒，能夜视，护甲训练；走得慢、体型小；记仇。酒不上瘾，住在山腹里更快乐也更能干。</descriptionShort>
    <iconPath>CommonRaces/Xenotypes/Dwarf</iconPath>
    <inheritable>true</inheritable>
    <combatPowerFactor>1.1</combatPowerFactor>
    <factionlessGenerationWeight>0</factionlessGenerationWeight>
    <genes>
      <li>LP_DwarfStature</li>
      <li>LP_DwarfLiver</li>
      <li>LP_DwarfStoneEndurance</li>
      <li>Beard_Always</li>
      <li>Jaw_Heavy</li>
      <li>DarkVision</li>
      <li>Robust</li>
      <li>ToxResist_Partial</li>
      <li>AptitudeStrong_Mining</li>
      <li>AptitudeStrong_Crafting</li>
      <li>MoveSpeed_Slow</li>
      <li>AptitudeStrong_Melee</li>
      <li>LP_DwarfArmorTraining</li>
      <li>LP_DwarfGrudge</li>
    </genes>
    <modExtensions>
      <li Class="LichPhylactery.RaceLookExtension">
        <hairGenes><li>Hair_DarkReddish</li><li>Hair_DarkBrown</li><li>Hair_ReddishBrown</li><li>Hair_MidBlack</li></hairGenes>
      </li>
    </modExtensions>
  </XenotypeDef>
  <GeneDef>
    <defName>LP_DwarfStature</defName>
    <label>矮人体型</label>
    <description>矮小敦实的身材。实际体型为普通人的80%（负重、商队载重、被远程命中的概率随之降低），显示为85%大小；手上搬运量再×90%。对巨魔近战时伤害+10%（矮人与巨魔的世仇）。</description>
    <iconPath>CommonRaces/Genes/DwarfStature</iconPath>
    <displayCategory>Miscellaneous</displayCategory>
    <biostatCpx>1</biostatCpx>
    <biostatMet>2</biostatMet>
    <selectionWeight>0</selectionWeight>
    <customEffectDescriptions>
      <li>实际体型：×80%（与其他体型效果相乘）。</li>
      <li>显示大小：×85%。</li>
      <li>搬运量：在体型缩小的基础上再×90%。</li>
      <li>对巨魔近战伤害：+10%。</li>
    </customEffectDescriptions>
    <modExtensions>
      <li Class="LichPhylactery.SmallBodyExtension">
        <bodySize>0.8</bodySize>
        <renderScale>0.85</renderScale>
        <carryFactor>0.9</carryFactor>
      </li>
    </modExtensions>
  </GeneDef>
  <GeneDef>
    <defName>LP_DwarfLiver</defName>
    <label>酒鬼之肝</label>
    <description>矮人的肝脏千锤百炼：喝酒永远不会上瘾，宿醉减半；每次喝酒后获得"壮胆"心情+4，持续6小时。</description>
    <geneClass>LichPhylactery.Gene_DwarfLiver</geneClass>
    <iconPath>CommonRaces/Genes/DwarfLiver</iconPath>
    <displayCategory>Drugs</displayCategory>
    <biostatCpx>1</biostatCpx>
    <biostatMet>0</biostatMet>
    <selectionWeight>0</selectionWeight>
    <chemical>Alcohol</chemical>
    <addictionChanceFactor>0</addictionChanceFactor>
    <customEffectDescriptions>
      <li>酒精成瘾概率：0%。</li>
      <li>宿醉严重度减半。</li>
      <li>喝酒后心情+4（6小时）。</li>
    </customEffectDescriptions>
  </GeneDef>
  <GeneDef>
    <defName>LP_DwarfStoneEndurance</defName>
    <label>石之耐力</label>
    <description>矮人生于山腹。身处厚岩顶下时心情+3，采矿速度和一般劳动（手工、制作等）速度+10%。</description>
    <geneClass>LichPhylactery.Gene_DwarfStoneEndurance</geneClass>
    <iconPath>CommonRaces/Genes/DwarfStoneEndurance</iconPath>
    <displayCategory>Miscellaneous</displayCategory>
    <biostatCpx>1</biostatCpx>
    <biostatMet>0</biostatMet>
    <selectionWeight>0</selectionWeight>
    <customEffectDescriptions>
      <li>在厚岩顶下：心情+3，采矿速度×110%，一般劳动速度×110%。</li>
    </customEffectDescriptions>
  </GeneDef>
  <HediffDef>
    <defName>LP_DwarfUnderMountain</defName>
    <label>山腹之中</label>
    <description>头顶是厚实的岩层，矮人如鱼得水。</description>
    <hediffClass>LichPhylactery.Hediff_DwarfUnderMountain</hediffClass>
    <defaultLabelColor>(0.75, 0.7, 0.6)</defaultLabelColor>
    <isBad>false</isBad>
    <everCurableByItem>false</everCurableByItem>
    <stages>
      <li>
        <statFactors>
          <MiningSpeed>1.1</MiningSpeed>
          <GeneralLaborSpeed>1.1</GeneralLaborSpeed>
        </statFactors>
      </li>
    </stages>
  </HediffDef>
  <ThoughtDef>
    <defName>LP_DwarfUnderMountain</defName>
    <workerClass>ThoughtWorker_Hediff</workerClass>
    <hediff>LP_DwarfUnderMountain</hediff>
    <stages>
      <li>
        <label>山腹之中</label>
        <description>厚实的岩顶就在头上，这才是家的感觉。</description>
        <baseMoodEffect>3</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>
  <ThoughtDef>
    <defName>LP_DwarfDrinkCourage</defName>
    <durationDays>0.25</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>壮胆</label>
        <description>几杯下肚，浑身是胆。</description>
        <baseMoodEffect>4</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <!-- ==================== 种族关系（默认启用，数值小） ==================== -->
  <ThoughtDef>
    <defName>LP_RacialRelation_ElfDwarf</defName>
    <workerClass>LichPhylactery.ThoughtWorker_DNDRacialRelation</workerClass>
    <stages>
      <li>
        <label>粗鲁的矮人</label>
        <description>矮人吵吵嚷嚷、满身酒气，一点也不懂优雅。</description>
        <baseMoodEffect>-2</baseMoodEffect>
      </li>
      <li>
        <label>老战友（矮人）</label>
        <description>一起熬过了这么多日子，那个矮人已经是我的老战友了。</description>
        <baseMoodEffect>2</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>
  <LichPhylactery.RacialRelationDef>
    <defName>LP_Relation_ElfDwarf</defName>
    <label>精灵看矮人</label>
    <observer>LP_Elf</observer>
    <observers><li>LP_WoodElf</li></observers>
    <target>LP_Dwarf</target>
    <targets><li>LP_HillDwarf</li></targets>
    <halvedBy><li>LP_HalfElf</li></halvedBy>
    <thought>LP_RacialRelation_ElfDwarf</thought>
    <daysToAccept>60</daysToAccept>
  </LichPhylactery.RacialRelationDef>
  <ThoughtDef>
    <defName>LP_RacialRelation_DwarfElf</defName>
    <workerClass>LichPhylactery.ThoughtWorker_DNDRacialRelation</workerClass>
    <stages>
      <li>
        <label>傲慢的精灵</label>
        <description>那个精灵鼻孔朝天，连酒都不会喝。</description>
        <baseMoodEffect>-2</baseMoodEffect>
      </li>
      <li>
        <label>老战友（精灵）</label>
        <description>一起熬过了这么多日子，那个精灵已经是我的老战友了。</description>
        <baseMoodEffect>2</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>
  <LichPhylactery.RacialRelationDef>
    <defName>LP_Relation_DwarfElf</defName>
    <label>矮人看精灵</label>
    <observer>LP_Dwarf</observer>
    <observers><li>LP_HillDwarf</li></observers>
    <target>LP_Elf</target>
    <targets><li>LP_WoodElf</li></targets>
    <halvedBy><li>LP_HalfElf</li></halvedBy>
    <thought>LP_RacialRelation_DwarfElf</thought>
    <daysToAccept>60</daysToAccept>
  </LichPhylactery.RacialRelationDef>
  <ThoughtDef>
    <defName>LP_RacialRelation_DwarfFireGiant</defName>
    <workerClass>LichPhylactery.ThoughtWorker_DNDRacialRelation</workerClass>
    <stages>
      <li>
        <label>世仇巨人</label>
        <description>巨人是矮人的世仇，和火巨人住在一起让我浑身不自在。</description>
        <baseMoodEffect>-3</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>
  <LichPhylactery.RacialRelationDef>
    <defName>LP_Relation_DwarfFireGiant</defName>
    <label>矮人看火巨人</label>
    <observer>LP_Dwarf</observer>
    <observers><li>LP_HillDwarf</li></observers>
    <target>LP_FireGiant</target>
    <thought>LP_RacialRelation_DwarfFireGiant</thought>
  </LichPhylactery.RacialRelationDef>
</Defs>
