<Defs>
  <RecipeDef Name="LP_RitualBase" Abstract="True">
    <workerClass>LichPhylactery.RitualRecipe</workerClass>
    <ingredientValueGetterClass>LichPhylactery.RitualCount</ingredientValueGetterClass>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <workSkill>Crafting</workSkill>
    <workSkillLearnFactor>0.3</workSkillLearnFactor>
    <recipeUsers>
      <li>LP_Altar</li>
    </recipeUsers>
    <allowMixingIngredients>true</allowMixingIngredients>
    <interruptIfIngredientIsRotting>false</interruptIfIngredientIsRotting>
    <autoStripCorpses>true</autoStripCorpses>
  </RecipeDef>
  <RecipeDef ParentName="LP_RitualBase">
    <defName>LP_Ascend</defName>
    <label>巫妖仪式</label>
    <description>执行此工作单的角色将成为巫妖。请在详情中指定执行者。制作并绑定命匣，追加巫妖魂核、死灵之触、死灵之躯三个超凡基因，原有基因保留。</description>
    <jobString>正在巫妖仪式。</jobString>
    <workAmount>12000</workAmount>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>Gold</li>
          </thingDefs>
        </filter>
        <count>50</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>Plasteel</li>
          </thingDefs>
        </filter>
        <count>50</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>MedicineIndustrial</li>
          </thingDefs>
        </filter>
        <count>5</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>ComponentSpacer</li>
          </thingDefs>
        </filter>
        <count>2</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>Gold</li>
        <li>Plasteel</li>
        <li>MedicineIndustrial</li>
        <li>ComponentSpacer</li>
      </thingDefs>
      <categories>
      </categories>
    </fixedIngredientFilter>
  </RecipeDef>
  <RecipeDef ParentName="LP_RitualBase">
    <defName>LP_Offer</defName>
    <label>献祭生肉</label>
    <description>消耗100份新鲜生肉，获得100点命匣经验。支持混用不同种类生肉。</description>
    <jobString>正在献祭生肉。</jobString>
    <workAmount>1200</workAmount>
    <ingredients>
      <li>
        <filter>
          <categories>
            <li>MeatRaw</li>
          </categories>
        </filter>
        <count>100</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <categories>
        <li>MeatRaw</li>
      </categories>
    </fixedIngredientFilter>
  </RecipeDef>
  <RecipeDef ParentName="LP_RitualBase">
    <defName>LP_Rebuild</defName>
    <recipeUsers Inherit="False" />
    <label>重塑巫妖身体</label>
    <description>旧版工作单，已停用。拥有死灵之躯的巫妖会在死亡3日后通过完整命匣自动复生，不消耗材料。</description>
    <jobString>正在重塑巫妖身体。</jobString>
    <workAmount>10000</workAmount>
    <ingredients>
      <li>
        <filter>
          <categories>
            <li>MeatRaw</li>
          </categories>
        </filter>
        <count>200</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>MedicineIndustrial</li>
          </thingDefs>
        </filter>
        <count>5</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>ComponentSpacer</li>
          </thingDefs>
        </filter>
        <count>2</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>MedicineIndustrial</li>
        <li>ComponentSpacer</li>
      </thingDefs>
      <categories>
        <li>MeatRaw</li>
      </categories>
    </fixedIngredientFilter>
  </RecipeDef>
  <RecipeDef ParentName="LP_RitualBase">
