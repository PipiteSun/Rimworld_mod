<?xml version="1.0" encoding="utf-8"?>
<!-- 1.57.0 普通种族：精灵/矮人亚种、半身人、侏儒、半精灵、狗头人、地精三族。全部是生物科技异种型 + 基因（不用 HAR）。
     外貌用原版头发/耳朵/肤色基因；发色与肤色写在 LichPhylactery.RaceLookExtension 里，生成时随机挑一个加为内源基因。
     代谢（-2～+2）见 ArtSource/CommonRaces-1.57.0-report.md 的表格。机制代码在 Source/CommonRaceSubraces*.cs。 -->
<Defs>

  <!-- ==================== 精灵亚种 ==================== -->
  <GeneDef>
    <defName>LP_HighElfLineage</defName>
    <label>高等精灵血脉</label>
    <description>古老王庭的后裔，生来擅长艺术与学问，却不屑于粗重的体力活。精灵亚种之间互斥。</description>
    <iconPath>CommonRaces/Genes/HighElfLineage</iconPath>
    <displayCategory>Miscellaneous</displayCategory>
    <exclusionTags><li>LP_ElfLineage</li></exclusionTags>
    <biostatCpx>1</biostatCpx>
    <biostatMet>3</biostatMet>
    <selectionWeight>0</selectionWeight>
    <statFactors>
      <GeneralLaborSpeed>0.8</GeneralLaborSpeed>
      <MiningSpeed>0.7</MiningSpeed>
    </statFactors>
  </GeneDef>
  <GeneDef>
    <defName>LP_WoodElfLineage</defName>
    <label>木精灵血脉</label>
    <description>在古林里长大的精灵，熟悉每一条林间小路，却坐不住书桌。精灵亚种之间互斥。</description>
    <iconPath>CommonRaces/Genes/WoodElfLineage</iconPath>
    <displayCategory>Miscellaneous</displayCategory>
    <exclusionTags><li>LP_ElfLineage</li></exclusionTags>
    <biostatCpx>1</biostatCpx>
    <biostatMet>2</biostatMet>
    <selectionWeight>0</selectionWeight>
    <statFactors>
      <ResearchSpeed>0.8</ResearchSpeed>
    </statFactors>
  </GeneDef>
  <GeneDef>
    <defName>LP_DrowSunlight</defName>
    <label>阳光敏感</label>
    <description>卓尔的眼睛习惯了幽暗地域的黑暗。白天在露天处（天光亮度不低于60%、头上没有屋顶）时，射击和近战的命中率都降到85%。精灵亚种之间互斥。</description>
    <iconPath>CommonRaces/Genes/DrowSunlight</iconPath>
    <displayCategory>Violence</displayCategory>
    <exclusionTags><li>LP_ElfLineage</li></exclusionTags>
    <biostatCpx>1</biostatCpx>
    <biostatMet>2</biostatMet>
    <selectionWeight>0</selectionWeight>
    <customEffectDescriptions>
      <li>白天露天（天光≥60%且无屋顶）：射击与近战命中率×85%。</li>
    </customEffectDescriptions>
  </GeneDef>
  <GeneDef>
    <defName>LP_DrowPoison</defName>
    <label>蛛后之毒</label>
    <description>卓尔的刀刃上抹着罗丝信徒调制的毒液。近战命中时有15%概率让目标中毒：意识-20%、移动速度降到80%，持续6小时（重复中毒只刷新时间）。对机械体无效。</description>
    <iconPath>CommonRaces/Genes/DrowPoison</iconPath>
    <displayCategory>Violence</displayCategory>
    <biostatCpx>1</biostatCpx>
    <biostatMet>-1</biostatMet>
    <selectionWeight>0</selectionWeight>
    <customEffectDescriptions>
      <li>近战命中：15%概率给目标"蛛后之毒"（意识-20%，移速×80%，6小时）。</li>
      <li>机械体不受影响。</li>
    </customEffectDescriptions>
  </GeneDef>
  <GeneDef>
    <defName>LP_DrowDarknessGene</defName>
    <label>黑暗术</label>
    <description>卓尔天生会的法术：在15格内召出一团半径3格的魔法黑暗，持续12秒。黑暗里的敌对单位（卓尔除外）看不清东西，命中率降到70%。不需要心灵链接，冷却1天。</description>
    <iconPath>CommonRaces/Genes/DrowDarkness</iconPath>
    <displayCategory>Ability</displayCategory>
    <biostatCpx>1</biostatCpx>
    <biostatMet>-1</biostatMet>
    <selectionWeight>0</selectionWeight>
    <abilities><li>LP_DrowDarkness</li></abilities>
    <descriptionHyperlinks><AbilityDef>LP_DrowDarkness</AbilityDef></descriptionHyperlinks>
  </GeneDef>
  <AbilityDef>
    <defName>LP_DrowDarkness</defName>
    <label>黑暗术</label>
    <description>在15格内的目标处召出半径3格的魔法黑暗，持续12秒。黑暗中的敌对单位（卓尔除外）射击与近战命中率×70%。不需要心灵链接，冷却1天。</description>
    <iconPath>CommonRaces/Abilities/DrowDarkness</iconPath>
    <cooldownTicksRange>60000</cooldownTicksRange>
    <hostile>true</hostile>
    <casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence>
    <aiCanUse>true</aiCanUse><!-- 1.63.0：敌方卓尔遇敌后会放（见 CompAbilityEffect_DrowDarkness.AICanTargetNow） -->
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <range>15</range>
      <warmupTime>0.5</warmupTime>
      <requireLineOfSight>true</requireLineOfSight>
      <targetParams>
        <canTargetLocations>true</canTargetLocations>
        <canTargetPawns>true</canTargetPawns>
        <canTargetBuildings>false</canTargetBuildings>
        <canTargetSelf>false</canTargetSelf>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="LichPhylactery.CompProperties_DrowDarkness">
        <radius>3</radius>
        <durationTicks>720</durationTicks>
      </li>
    </comps>
  </AbilityDef>
  <HediffDef>
    <defName>LP_DrowVenom</defName>
    <label>蛛后之毒</label>
    <description>卓尔刀刃上的毒液让人头晕腿软。</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.6, 0.4, 0.75)</defaultLabelColor>
    <isBad>true</isBad>
    <stages>
      <li>
        <capMods><li><capacity>Consciousness</capacity><offset>-0.2</offset></li></capMods>
        <statFactors><MoveSpeed>0.8</MoveSpeed></statFactors>
      </li>
    </stages>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>15000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
  </HediffDef>
  <HediffDef>
    <defName>LP_MagicalDarkness</defName>
    <label>魔法黑暗</label>
    <description>身处卓尔召出的魔法黑暗里，什么也看不清：射击与近战命中率×70%。</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.45, 0.4, 0.55)</defaultLabelColor>
    <isBad>true</isBad>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>90</disappearsAfterTicks>
      </li>
    </comps>
  </HediffDef>

  <XenotypeDef>
    <defName>LP_WoodElf</defName>
    <label>木精灵</label>
    <description>住在古林深处的精灵亚种，血脉会遗传给子女。皮肤偏棕、头发深褐或火红，脚步轻快，擅长射箭和照料植物；和其他精灵一样睡得少、成年后衰老极慢、心智坚定，身体也同样脆弱。木精灵不爱钻研书本，研究速度较慢。</description>
    <descriptionShort>可遗传的精灵亚种。射击、种植强，跑得快；睡得少、衰老极慢、心智抗性高；身体脆弱、近战弱、研究慢。</descriptionShort>
    <iconPath>CommonRaces/Xenotypes/WoodElf</iconPath>
    <inheritable>true</inheritable>
    <combatPowerFactor>1.0</combatPowerFactor>
    <factionlessGenerationWeight>0</factionlessGenerationWeight>
    <genes>
      <li>LP_ElfTrance</li>
      <li>LP_ElfBloodline</li>
      <li>LP_ElfLongevity</li>
      <li>LP_WoodElfLineage</li>
      <li>Ears_Pointed</li>
      <li>Body_Thin</li>
      <li>AptitudeStrong_Shooting</li>
      <li>AptitudeStrong_Plants</li>
      <li>MoveSpeed_Quick</li>
      <li>LowSleep</li>
      <li>Delicate</li>
      <li>MeleeDamage_Weak</li>
    </genes>
    <modExtensions>
      <li Class="LichPhylactery.RaceLookExtension">
        <skinGenes><li>Skin_Melanin5</li><li>Skin_Melanin6</li><li>Skin_Melanin7</li></skinGenes>
        <hairGenes><li>Hair_DarkBrown</li><li>Hair_DarkReddish</li><li>Hair_BrightRed</li><li>Hair_ReddishBrown</li></hairGenes>
      </li>
    </modExtensions>
  </XenotypeDef>
  <XenotypeDef>
    <defName>LP_Drow</defName>
    <label>卓尔精灵</label>
    <description>从幽暗地域爬上来的精灵亚种，血脉会遗传给子女。深灰或黑紫的皮肤、雪白的头发，能在黑暗中视物，灵能敏感，擅长近战；刀刃上常抹着蛛后之毒，还天生会召出魔法黑暗。卓尔怕光：受不了紫外线，白天在露天处命中率下降。卓尔与地表精灵世代为敌。</description>
    <descriptionShort>可遗传的精灵亚种。近战强、夜视、灵能敏感，近战偶尔下毒，会黑暗术；怕光，白天露天命中下降；与其他精灵互相敌视。</descriptionShort>
    <iconPath>CommonRaces/Xenotypes/Drow</iconPath>
    <inheritable>true</inheritable>
    <combatPowerFactor>1.1</combatPowerFactor>
    <factionlessGenerationWeight>0</factionlessGenerationWeight>
    <genes>
      <li>LP_ElfTrance</li>
      <li>LP_ElfBloodline</li>
      <li>LP_ElfLongevity</li>
      <li>LP_DrowSunlight</li>
      <li>LP_DrowPoison</li>
      <li>LP_DrowDarknessGene</li>
      <li>Ears_Pointed</li>
      <li>Body_Thin</li>
      <li>DarkVision</li>
      <li>UVSensitivity_Intense</li>
      <li>PsychicAbility_Enhanced</li>
      <li>AptitudeStrong_Melee</li>
      <li>LowSleep</li>
      <li>Delicate</li>
    </genes>
    <modExtensions>
      <li Class="LichPhylactery.RaceLookExtension">
        <skinGenes><li>Skin_SlateGray</li><li>Skin_InkBlack</li><li>Skin_Purple</li></skinGenes>
        <hairGenes><li>Hair_SnowWhite</li></hairGenes>
      </li>
    </modExtensions>
  </XenotypeDef>

  <!-- ==================== 矮人亚种 ==================== -->
  <GeneDef>
    <defName>LP_DwarfArmorTraining</defName>
    <label>矮人护甲训练</label>
    <description>山地矮人从小穿着铁甲长大。身上衣甲造成的移动速度惩罚只算一半。矮人亚种之间互斥。</description>
    <iconPath>CommonRaces/Genes/DwarfArmorTraining</iconPath>
    <displayCategory>Movement</displayCategory>
    <exclusionTags><li>LP_DwarfLineage</li></exclusionTags>
    <biostatCpx>1</biostatCpx>
    <biostatMet>0</biostatMet>
    <selectionWeight>0</selectionWeight>
    <customEffectDescriptions>
      <li>衣甲的负面移动速度修正×50%。</li>
    </customEffectDescriptions>
  </GeneDef>
  <GeneDef>
    <defName>LP_DwarfToughness</defName>
    <label>矮人坚韧</label>
    <description>丘陵矮人的骨肉格外结实：每个身体部位的最大生命值×115%。矮人亚种之间互斥。</description>
    <iconPath>CommonRaces/Genes/DwarfToughness</iconPath>
    <displayCategory>ResistanceAndWeakness</displayCategory>
    <exclusionTags><li>LP_DwarfLineage</li></exclusionTags>
    <biostatCpx>1</biostatCpx>
    <biostatMet>0</biostatMet>
    <selectionWeight>0</selectionWeight>
    <customEffectDescriptions>
      <li>身体部位最大生命值：×115%。</li>
    </customEffectDescriptions>
  </GeneDef>
  <GeneDef>
    <defName>LP_DwarfGrudge</defName>
    <label>矮人记仇</label>
    <description>矮人从不忘记血债。本殖民地的人形成员被某个派系的人杀死时，殖民地里所有带这个基因的人都会记下"血仇：派系名"，心情-3，持续1年（同一派系再犯只刷新时间，不叠加）；血仇未消期间，对这个派系成员的射击与近战命中率×105%。</description>
    <iconPath>CommonRaces/Genes/DwarfGrudge</iconPath>
    <displayCategory>Violence</displayCategory>
    <biostatCpx>1</biostatCpx>
    <biostatMet>1</biostatMet>
    <selectionWeight>0</selectionWeight>
    <customEffectDescriptions>
      <li>同伴被某派系杀死：心情-3"血仇"，持续1年，同派系只刷新。</li>
      <li>对血仇派系成员：射击与近战命中率×105%。</li>
    </customEffectDescriptions>
  </GeneDef>
  <ThoughtDef>
    <defName>LP_DwarfBloodGrudge</defName>
    <thoughtClass>LichPhylactery.Thought_DwarfGrudge</thoughtClass>
    <durationDays>60</durationDays>
    <stackLimit>30</stackLimit>
    <stackedEffectMultiplier>1</stackedEffectMultiplier>
    <stages>
      <li>
        <label>血仇</label>
        <description>他们杀了我们的人。这笔血债，矮人记在石头上。</description>
        <baseMoodEffect>-3</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <XenotypeDef>
    <defName>LP_HillDwarf</defName>
    <label>丘陵矮人</label>
    <description>住在丘陵与浅山里的矮人亚种，血脉会遗传给子女。和山地矮人一样矮小敦实、蓄着胡子、能在黑暗中视物，是天生的矿工和工匠；免疫力特别强，骨肉也格外结实，每个部位能多挨几下。矮人喝酒不上瘾，住在山腹里更快乐，也从不忘记血债。</description>
    <descriptionShort>可遗传的矮人亚种。采矿、手工强，身体结实、免疫强、部位生命×115%，夜视；走得慢、体型小；记仇。</descriptionShort>
    <iconPath>CommonRaces/Xenotypes/HillDwarf</iconPath>
    <inheritable>true</inheritable>
    <combatPowerFactor>1.1</combatPowerFactor>
    <factionlessGenerationWeight>0</factionlessGenerationWeight>
    <genes>
      <li>LP_DwarfStature</li>
      <li>LP_DwarfLiver</li>
      <li>LP_DwarfStoneEndurance</li>
      <li>LP_DwarfToughness</li>
      <li>LP_DwarfGrudge</li>
      <li>Beard_Always</li>
      <li>Jaw_Heavy</li>
      <li>DarkVision</li>
      <li>Robust</li>
      <li>ToxResist_Partial</li>
      <li>Immunity_Strong</li>
      <li>AptitudeStrong_Mining</li>
      <li>AptitudeStrong_Crafting</li>
      <li>MoveSpeed_Slow</li>
    </genes>
    <modExtensions>
      <li Class="LichPhylactery.RaceLookExtension">
        <hairGenes><li>Hair_ReddishBrown</li><li>Hair_SandyBlonde</li><li>Hair_DarkBrown</li><li>Hair_Gray</li></hairGenes>
      </li>
    </modExtensions>
  </XenotypeDef>

  <!-- ==================== 半身人 ==================== -->
  <GeneDef>
    <defName>LP_HalflingBlood</defName>
    <label>半身人血统</label>
    <description>半身人只有常人七成高，胃口却一点不小。实际体型为普通人的70%（负重、商队载重、被远程命中的概率随之降低），饿得比常人快35%。半身人生性勇敢：不会陷入恐慌逃跑之类的恐惧状态，恐惧带来的负面心情减半。</description>
    <geneClass>LichPhylactery.Gene_HalflingBlood</geneClass>
    <iconPath>CommonRaces/Genes/HalflingBlood</iconPath>
    <displayCategory>Miscellaneous</displayCategory>
    <biostatCpx>2</biostatCpx>
    <biostatMet>4</biostatMet>
    <selectionWeight>0</selectionWeight>
    <customEffectDescriptions>
      <li>实际体型：×70%；显示大小：×75%。</li>
      <li>饥饿速度：×135%（健康页显示"好胃口"）。</li>
      <li>勇敢：不会恐慌逃跑或陷入其他恐惧类精神状态；恐惧类负面心情×50%。</li>
    </customEffectDescriptions>
    <modExtensions>
      <li Class="LichPhylactery.SmallBodyExtension">
        <bodySize>0.7</bodySize>
        <renderScale>0.75</renderScale>
      </li>
    </modExtensions>
  </GeneDef>
  <HediffDef>
    <defName>LP_HalflingAppetite</defName>
    <label>好胃口</label>
    <description>半身人一天要吃好几顿：早饭、第二顿早饭、午饭、下午茶……</description>
    <hediffClass>LichPhylactery.Hediff_HalflingAppetite</hediffClass>
    <defaultLabelColor>(0.85, 0.75, 0.5)</defaultLabelColor>
    <isBad>false</isBad>
    <everCurableByItem>false</everCurableByItem>
    <stages><li><hungerRateFactor>1.35</hungerRateFactor></li></stages>
  </HediffDef>
  <GeneDef>
    <defName>LP_HalflingLuck</defName>
    <label>半身人的幸运</label>
    <description>半身人总是走运。一次伤害本该让半身人倒地或死去时，这次伤害只剩10%，头上冒出"真走运！"。之后3天运气用光了（健康页可见），冷却期间不会再触发。</description>
    <iconPath>CommonRaces/Genes/HalflingLuck</iconPath>
    <displayCategory>Miscellaneous</displayCategory>
    <biostatCpx>1</biostatCpx>
    <biostatMet>-1</biostatMet>
    <selectionWeight>0</selectionWeight>
    <customEffectDescriptions>
      <li>会致倒地或死亡的一次伤害：伤势×10%。</li>
      <li>冷却3天（健康页显示"运气用光了"）。</li>
    </customEffectDescriptions>
    <modExtensions>
      <li Class="LichPhylactery.OncePerCooldownExtension">
        <workerClass>LichPhylactery.OncePerCooldownWorker_ReduceDamage</workerClass>
        <cooldownHediff>LP_HalflingLuckCooldown</cooldownHediff>
        <cooldownDays>3</cooldownDays>
        <onDowned>true</onDowned>
        <onDeath>true</onDeath>
        <damageFactor>0.1</damageFactor>
        <moteText>真走运！</moteText>
      </li>
    </modExtensions>
  </GeneDef>
  <HediffDef>
    <defName>LP_HalflingLuckCooldown</defName>
    <label>运气用光了</label>
    <description>刚刚走了一回大运。冷却结束前半身人的幸运不会再次触发。</description>
    <hediffClass>LichPhylactery.Hediff_OncePerCooldown</hediffClass>
    <defaultLabelColor>(0.85, 0.8, 0.5)</defaultLabelColor>
    <isBad>false</isBad>
    <everCurableByItem>false</everCurableByItem>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>180000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
  </HediffDef>
  <GeneDef>
    <defName>LP_HalflingHideBehind</defName>
    <label>躲到大个子身后</label>
    <description>轻足半身人很会找掩护：2格内有体型不小于普通人的友方时，敌人对其远程命中率×85%。半身人亚种之间互斥。</description>
    <iconPath>CommonRaces/Genes/HalflingHideBehind</iconPath>
    <displayCategory>Violence</displayCategory>
    <exclusionTags><li>LP_HalflingLineage</li></exclusionTags>
    <biostatCpx>1</biostatCpx>
    <biostatMet>0</biostatMet>
    <selectionWeight>0</selectionWeight>
    <customEffectDescriptions>
      <li>2格内有体型≥1的友方：被远程命中率×85%（每250刻更新一次）。</li>
    </customEffectDescriptions>
  </GeneDef>
  <GeneDef>
    <defName>LP_HalflingStoutLineage</defName>
    <label>敦实身板</label>
    <description>敦实半身人比轻足族圆一圈，走得也慢一点（移动速度-0.3），却百毒不侵、很少生病。半身人亚种之间互斥。</description>
    <iconPath>CommonRaces/Genes/HalflingStout</iconPath>
    <displayCategory>Movement</displayCategory>
    <exclusionTags><li>LP_HalflingLineage</li></exclusionTags>
    <biostatCpx>1</biostatCpx>
    <biostatMet>1</biostatMet>
    <selectionWeight>0</selectionWeight>
    <statOffsets>
      <MoveSpeed>-0.3</MoveSpeed>
    </statOffsets>
  </GeneDef>

  <XenotypeDef>
