<?xml version="1.0" encoding="utf-8"?>
<!-- 1.22.0 奇物。戒指、护符、伊奥恩石戴在自建的“奇物”层（1.45.0 起由“饰品”改名） LP_Accessory，不占用其他装备位置。 -->
<Defs>
  <ThingDef Name="LP_WondrousApparelBase" ParentName="ApparelBase" Abstract="True">
    <techLevel>Medieval</techLevel>
    <smeltable>false</smeltable>
    <thingCategories><li>ApparelMisc</li></thingCategories>
    <tradeTags><li>LP_Wondrous</li></tradeTags>
    <statBases><EquipDelay>1</EquipDelay></statBases>
  </ThingDef>
  <ThingDef Name="LP_AccessoryBase" ParentName="LP_WondrousApparelBase" Abstract="True">
    <statBases><MaxHitPoints>80</MaxHitPoints><Mass>0.05</Mass><Flammability>0</Flammability></statBases>
    <apparel>
      <countsAsClothingForNudity>false</countsAsClothingForNudity>
      <careIfWornByCorpse>false</careIfWornByCorpse>
      <layers><li>LP_Accessory</li></layers>
    </apparel>
  </ThingDef>

  <ThingDef ParentName="LP_WondrousApparelBase">
    <defName>LP_BagOfHolding</defName>
    <label>次元袋</label>
    <description>袋口小小，里面却连着一个口袋维度。挂在腰带上，搬运量+60，不影响移动速度。受到火焰或锐器伤害时有2%概率被撕破：袋子毁掉，背包里的东西掉一地。</description>
    <graphicData><texPath>Items/Wondrous/BagOfHolding</texPath><graphicClass>Graphic_Single</graphicClass></graphicData>
    <statBases><MaxHitPoints>100</MaxHitPoints><Mass>0.5</Mass><MarketValue>900</MarketValue></statBases>
    <equippedStatOffsets><CarryingCapacity>60</CarryingCapacity></equippedStatOffsets>
    <apparel>
      <countsAsClothingForNudity>false</countsAsClothingForNudity>
      <bodyPartGroups><li>Waist</li></bodyPartGroups>
      <layers><li>Belt</li></layers>
    </apparel>
  </ThingDef>
  <HediffDef>
    <defName>LP_SpeedBurst</defName>
    <label>疾行</label>
    <description>疾行靴的魔力：移动速度×2。</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <comps><li Class="HediffCompProperties_Disappears"><disappearsAfterTicks>3600</disappearsAfterTicks><showRemainingTime>true</showRemainingTime></li></comps>
    <stages><li><statFactors><MoveSpeed>2</MoveSpeed></statFactors></li></stages>
  </HediffDef>

  <ThingDef Name="LP_RingBase" ParentName="LP_AccessoryBase" Abstract="True">
    <statBases><MarketValue>700</MarketValue></statBases>
    <apparel><bodyPartGroups><li>RightHand</li></bodyPartGroups></apparel>
    <modExtensions><li Class="LichPhylactery.AccessorySlot"><slot>Ring</slot><max>2</max></li></modExtensions>
  </ThingDef>
  <ThingDef ParentName="LP_RingBase">
    <defName>LP_RingResistanceFire</defName>
    <label>抗火戒指</label>
    <description>红宝石戒指。佩戴者受到的火焰伤害-50%。最多戴两枚不同的戒指。</description>
    <graphicData><texPath>Items/Wondrous/RingFire</texPath><graphicClass>Graphic_Single</graphicClass></graphicData>
    <modExtensions><li Class="LichPhylactery.ItemDamageFactors"><factor>0.5</factor><damageDefs><li>Flame</li><li>Burn</li></damageDefs><keywords><li>Flame</li><li>Incendiary</li></keywords><excluded><li>Acid</li></excluded></li></modExtensions>
  </ThingDef>
  <ThingDef ParentName="LP_RingBase">
    <defName>LP_RingResistanceCold</defName>
    <label>抗寒戒指</label>
    <description>冰晶戒指。佩戴者受到的寒冷类伤害（冻伤、寒冰射线等）-50%。最多戴两枚不同的戒指。</description>
    <graphicData><texPath>Items/Wondrous/RingCold</texPath><graphicClass>Graphic_Single</graphicClass></graphicData>
    <modExtensions><li Class="LichPhylactery.ItemDamageFactors"><factor>0.5</factor><damageDefs><li>Frostbite</li></damageDefs><keywords><li>Frost</li><li>Cold</li><li>Ice</li><li>Freez</li></keywords></li></modExtensions>
  </ThingDef>
  <ThingDef ParentName="LP_RingBase">
    <defName>LP_RingResistanceAcid</defName>
    <label>抗酸戒指</label>
    <description>翠玉戒指。佩戴者受到的酸液伤害-50%。最多戴两枚不同的戒指。</description>
    <graphicData><texPath>Items/Wondrous/RingAcid</texPath><graphicClass>Graphic_Single</graphicClass></graphicData>
    <modExtensions><li Class="LichPhylactery.ItemDamageFactors"><factor>0.5</factor><keywords><li>Acid</li></keywords></li></modExtensions>
  </ThingDef>
  <ThingDef ParentName="LP_RingBase">
    <defName>LP_RingResistanceMind</defName>
    <label>心灵抗性戒指</label>
    <description>紫晶银戒。佩戴者心智抗性+30%。最多戴两枚不同的戒指。</description>
    <graphicData><texPath>Items/Wondrous/RingMind</texPath><graphicClass>Graphic_Single</graphicClass></graphicData>
    <equippedStatOffsets><LP_MindResist>0.3</LP_MindResist></equippedStatOffsets>
  </ThingDef>
  <ThingDef ParentName="LP_AccessoryBase">
    <defName>LP_AmuletHealth</defName>
    <label>健康护符</label>
    <description>刻着治疗圣徽的金护符。佩戴者不会染上疾病（流感、瘟疫、疟疾、伤口感染等）。</description>
    <graphicData><texPath>Items/Wondrous/AmuletHealth</texPath><graphicClass>Graphic_Single</graphicClass></graphicData>
    <statBases><MarketValue>1100</MarketValue></statBases>
    <apparel><bodyPartGroups><li>Neck</li></bodyPartGroups></apparel>
  </ThingDef>
  <ThingDef ParentName="LP_AccessoryBase">
    <defName>LP_IounStone</defName>
    <label>伊奥恩石</label>
    <description>会自己绕着主人头顶打转的小晶石。每颗石头对应一项技能（射击、近战、建造、医疗、智识、社交、手工之一，生成时随机），环绕时该技能学习速度+50%。最多同时戴两颗，戴第三颗会顶掉最早的那颗。</description>
    <graphicData><texPath>Items/Wondrous/IounStone</texPath><graphicClass>Graphic_Single</graphicClass></graphicData>
    <statBases><MarketValue>1500</MarketValue></statBases>
    <apparel><bodyPartGroups><li>UpperHead</li></bodyPartGroups></apparel>
    <comps><li Class="LichPhylactery.CompProperties_IounStone" /></comps>
  </ThingDef>

  <ThingDef ParentName="ResourceBase">
    <defName>LP_WandDetection</defName>
    <label>探测魔杖</label>
    <description>杖头嵌着青晶的短杖。只要放在地图的储存区里（库存区、货架等），这张地图上所有隐形的人都会被标记、无法隐身。</description>
    <graphicData><texPath>Items/Wondrous/WandDetection</texPath><graphicClass>Graphic_Single</graphicClass></graphicData>
    <stackLimit>1</stackLimit>
    <useHitPoints>true</useHitPoints>
    <techLevel>Medieval</techLevel>
    <statBases><MaxHitPoints>80</MaxHitPoints><Mass>0.4</Mass><MarketValue>1000</MarketValue><Flammability>0.5</Flammability></statBases>
    <thingCategories><li>ItemsMisc</li></thingCategories>
    <tradeTags><li>LP_Wondrous</li></tradeTags>
  </ThingDef>
</Defs>
