    <defName>LP_Shackled</defName>
    <label>镣铐</label>
    <description>红袍法师刻满禁咒的镣铐：近战伤害减半，用不了任何能力，也放不出雷霆一击。被俘或加入殖民地后会被除去。</description>
    <hediffClass>LichPhylactery.Hediff_Shackled</hediffClass>
    <defaultLabelColor>(0.7, 0.3, 0.3)</defaultLabelColor>
    <isBad>true</isBad>
    <everCurableByItem>false</everCurableByItem>
    <stages>
      <li>
        <statFactors>
          <MeleeDamageFactor>0.5</MeleeDamageFactor>
        </statFactors>
      </li>
    </stages>
  </HediffDef>

