    <description>被魔法召来、暂时锁定的天气。</description>
    <weatherDef>RainyThunderstorm</weatherDef>
    <canBePermanent>false</canBePermanent>
  </GameConditionDef>
  <GameConditionDef>
    <defName>LP_AbyssStorm</defName>
    <conditionClass>LichPhylactery.GameCondition_LPWeather</conditionClass>
