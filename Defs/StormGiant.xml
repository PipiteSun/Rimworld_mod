  <GeneDef>
    <defName>LP_StormCrown</defName>
    <label>珊瑚雷纹头冠</label>
    <description>风暴巨人用海渊珊瑚编成的头冠，枝杈上刻着雷纹，下雨时会泛起微光。</description>
    <iconPath>Giants/Genes/StormGiantCore</iconPath>
    <displayCategory>Cosmetic</displayCategory>
    <selectionWeight>0</selectionWeight>
    <biostatCpx>0</biostatCpx>
