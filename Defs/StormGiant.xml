  </GameConditionDef>

  <!-- ==================== 心情 ==================== -->
  <ThoughtDef>
    <defName>LP_StormSinging</defName>
    <workerClass>LichPhylactery.ThoughtWorker_StormSinging</workerClass>
    <stages>
      <li>
        <label>风暴在歌唱</label>
        <description>雨点打在脸上，雷声在云里滚。这是海渊的歌，我听得懂。</description>
        <baseMoodEffect>3</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>
  <ThoughtDef>
    <defName>LP_StormForeboding</defName>
    <workerClass>LichPhylactery.ThoughtWorker_StormForeboding</workerClass>
    <stages>
      <li>
        <label>沉重的预兆</label>
        <description>我看见了还没发生的事，没法假装不知道。只有雨声或独处时，心里才能静一会儿。</description>
        <baseMoodEffect>-3</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <!-- ==================== 镣铐（被奴役的风暴巨人） ==================== -->
