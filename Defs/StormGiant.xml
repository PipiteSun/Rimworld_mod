  <!-- ==================== 能力 ==================== -->
  <AbilityDef>
    <defName>LP_StormLightningBolt</defName>
    <label>闪电束</label>
    <description>朝一个方向放出一道笔直的闪电，贯穿15格：路径上的每个人和建筑受到12点火焰和20点 EMP（遇到墙就停下）。冷却6小时。</description>
    <iconPath>Giants/Abilities/LightningBolt</iconPath>
    <cooldownTicksRange>15000</cooldownTicksRange>
    <hostile>true</hostile>
    <casterMustBeCapableOfViolence>true</casterMustBeCapableOfViolence>
    <aiCanUse>false</aiCanUse>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <range>15</range>
      <warmupTime>0.8</warmupTime>
      <requireLineOfSight>false</requireLineOfSight>
      <soundCast>Thunder_OnMap</soundCast>
      <targetParams>
        <canTargetLocations>true</canTargetLocations>
        <canTargetPawns>true</canTargetPawns>
        <canTargetBuildings>true</canTargetBuildings>
        <canTargetSelf>false</canTargetSelf>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="LichPhylactery.CompProperties_StormAbility"><effect>bolt</effect></li>
    </comps>
  </AbilityDef>
  <AbilityDef>
    <defName>LP_SummonStorm</defName>
    <label>召唤风暴</label>
    <description>（成年）召来一场风暴：地图天气转为雷雨并锁定1天；这一天里每2小时，会有一道雷劈在随机一名敌人3格内。冷却7天。</description>
    <iconPath>Giants/Abilities/SummonStorm</iconPath>
    <cooldownTicksRange>420000</cooldownTicksRange>
    <hostile>false</hostile>
    <targetRequired>false</targetRequired>
    <aiCanUse>false</aiCanUse>
    <displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
    <disableGizmoWhileUndrafted>false</disableGizmoWhileUndrafted>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <range>0</range>
      <warmupTime>2</warmupTime>
      <targetParams><canTargetSelf>true</canTargetSelf></targetParams>
    </verbProperties>
    <comps>
      <li Class="LichPhylactery.CompProperties_StormAbility"><effect>storm</effect></li>
    </comps>
  </AbilityDef>

