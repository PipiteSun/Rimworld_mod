  <!-- ==================== 剧本：海渊流亡者 ==================== -->
  <ScenarioDef ParentName="ScenarioBase">
    <defName>LP_AbyssExile</defName>
    <label>海渊流亡者</label>
    <description>一位风暴巨人被海渊的宫廷放逐，带着两名不肯离开他的人类水手，在一场雷雨里漂上了这片陌生的海岸。\n\n风暴巨人手里只剩一把风暴三叉戟；开局的第一天是一场跟着他们从海上卷来的雷雨。\n\n建议选海岸地图：风暴巨人在浅海和沼泽里行走如履平地，风雨天更强，也能预见大型袭击；但他们子嗣稀少，而且终日忧郁。</description>
    <scenario>
      <summary>一位被放逐的风暴巨人与两名人类水手，带着风暴三叉戟。建议海岸地图。</summary>
      <parts>

        <li Class="ScenPart_ConfigPage_ConfigureStartingPawns_Xenotypes">
          <def>ConfigurePawnsXenotypes</def>
          <pawnChoiceCount>8</pawnChoiceCount>
          <customSummary>一位风暴巨人和两名人类水手。</customSummary>
          <xenotypeCounts>
            <li>
              <xenotype>LP_StormGiant</xenotype>
              <count>1</count>
              <description>风暴巨人</description>
              <requiredAtStart>true</requiredAtStart>
              <allowedDevelopmentalStages>Adult</allowedDevelopmentalStages>
            </li>
            <li>
              <xenotype>Baseliner</xenotype>
              <count>2</count>
              <description>人类水手</description>
              <allowedDevelopmentalStages>Adult</allowedDevelopmentalStages>
            </li>
          </xenotypeCounts>
        </li>

        <li Class="ScenPart_PlayerPawnsArriveMethod">
          <def>PlayerPawnsArriveMethod</def>
          <visible>false</visible>
          <method>Standing</method>
        </li>

        <li Class="LichPhylactery.ScenPart_TimedCondition">
          <def>LP_TimedCondition</def>
          <condition>LP_AbyssStorm</condition>
          <days>1</days>
        </li>

        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>LP_StormTrident</thingDef>
          <count>1</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>Pemmican</thingDef>
          <count>80</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>MedicineHerbal</thingDef>
          <count>15</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>Cloth</thingDef>
          <count>80</count>
        </li>
        <li Class="ScenPart_ScatterThingsNearPlayerStart">
          <def>ScatterThingsNearPlayerStart</def>
          <thingDef>WoodLog</thingDef>
          <count>250</count>
        </li>
