      <li Class="LichPhylactery.TraderGroupExtension">
        <traderKind>LP_FC_CloudNobleTrader</traderKind>
      </li>
    </modExtensions>
  </TraderKindDef>

  <!-- ==================== 剧本：坠落的云堡 ==================== -->
  <ScenarioDef ParentName="ScenarioBase">
    <defName>LP_FallenCloudKeep</defName>
    <label>坠落的云堡</label>
    <description>云端城堡的锚链断了。城堡沉进大地之前，一位云巨人带着三名仆从、一箱白银和几件心爱的艺术品逃了下来。\n\n没有武器，只有钱、体面和一张好嘴；费伦拓荒同盟早就和云堡有生意往来（好感+40）。\n\n云巨人讲究卧室，尽快给他盖一间配得上身份的房间吧。</description>
    <scenario>
      <summary>一位云巨人与三名人类仆从，带着白银、黄金和艺术品，但没有武器。</summary>
      <parts>

        <li Class="ScenPart_ConfigPage_ConfigureStartingPawns_Xenotypes">
          <def>ConfigurePawnsXenotypes</def>
          <pawnChoiceCount>8</pawnChoiceCount>
          <customSummary>一位云巨人和三名人类仆从。</customSummary>
          <xenotypeCounts>
            <li>
              <xenotype>LP_CloudGiant</xenotype>
              <count>1</count>
              <description>云巨人</description>
              <requiredAtStart>true</requiredAtStart>
              <allowedDevelopmentalStages>Adult</allowedDevelopmentalStages>
            </li>
            <li>
              <xenotype>Baseliner</xenotype>
              <count>3</count>
              <description>人类仆从</description>
              <allowedDevelopmentalStages>Adult</allowedDevelopmentalStages>
            </li>
          </xenotypeCounts>
        </li>

        <li Class="ScenPart_PlayerPawnsArriveMethod">
          <def>PlayerPawnsArriveMethod</def>
          <visible>false</visible>
          <method>Standing</method>
        </li>

        <li Class="LichPhylactery.ScenPart_FactionGoodwill">
          <def>LP_FactionGoodwill</def>
          <faction>LP_FaerunColony</faction>
          <goodwill>40</goodwill>
        </li>

        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>Silver</thingDef>
          <count>3000</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>SculptureSmall</thingDef>
          <stuff>BlocksMarble</stuff>
          <count>2</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>Gold</thingDef>
          <count>50</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>MealSimple</thingDef>
          <count>10</count>
        </li>

        <li Class="ScenPart_GameStartDialog">
          <def>GameStartDialog</def>
