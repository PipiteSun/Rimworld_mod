<!-- 1.88.0 职业专属专长：每个职业两个（职业 3 级 / 7 级），只对有这个职业的人显示，用属性提升或战士奖励专长选。
     规则字段（Source/ClassFeats.cs）：powerStats + powerBonus 职业强度；resourceBonus 资源上限；gainFactor 资源获取 ×；cooldownFactor 本职业能力冷却 ×；costReduce 本职业能力消耗 −N（最少 1）。
     数值字段 statOffsets / statFactors 和其他专长一样合进冒险者状态。每个都附带 +1 属性（bonusAbilities）。NPC 职业者也会按 enemyTags 随机选到。 -->
<Defs>
  <LichPhylactery.LP_FeatDef Name="LP_ClassFeatBase" Abstract="True">
    <category>Class</category>
    <enemyTags><li>any</li></enemyTags>
  </LichPhylactery.LP_FeatDef>

  <!-- ===== 战士 ===== -->
  <LichPhylactery.LP_FeatDef ParentName="LP_ClassFeatBase">
    <defName>LP_Feat_Class_FighterVeteran</defName>
    <label>战场老兵</label>
    <description>见过的阵仗多了，什么局面都稳得住。战技强度、射术强度 +15%；斗志上限 +2；疼痛休克阈值 +10%。战士专属。附带力量、敏捷或体质 +1。</description>
    <iconPath>LP/Feats/Class/FighterVeteran</iconPath>
    <order>60</order>
    <requiredClass>LP_Class_Fighter</requiredClass><classLevel>3</classLevel>
    <powerStats><li>LP_MartialPower</li><li>LP_MarksmanPower</li></powerStats><powerBonus>0.15</powerBonus>
    <resourceBonus>2</resourceBonus>
    <statOffsets><PainShockThreshold>0.1</PainShockThreshold></statOffsets>
    <bonusAbilities><li>Str</li><li>Dex</li><li>Con</li></bonusAbilities>
  </LichPhylactery.LP_FeatDef>
  <LichPhylactery.LP_FeatDef ParentName="LP_ClassFeatBase">
    <defName>LP_Feat_Class_FighterHundredBattles</defName>
    <label>百战之躯</label>
    <description>越打越有劲，招式一套接一套。斗志获取 ×1.5；战士能力冷却 ×0.8；近战命中 ×1.05，射击精度 ×1.05。战士专属。附带力量、敏捷或体质 +1。</description>
    <iconPath>LP/Feats/Class/FighterHundredBattles</iconPath>
    <order>61</order>
    <requiredClass>LP_Class_Fighter</requiredClass><classLevel>7</classLevel>
    <gainFactor>1.5</gainFactor><cooldownFactor>0.8</cooldownFactor>
    <statFactors><MeleeHitChance>1.05</MeleeHitChance><ShootingAccuracyPawn>1.05</ShootingAccuracyPawn></statFactors>
    <bonusAbilities><li>Str</li><li>Dex</li><li>Con</li></bonusAbilities>
  </LichPhylactery.LP_FeatDef>

  <!-- ===== 武僧 ===== -->
