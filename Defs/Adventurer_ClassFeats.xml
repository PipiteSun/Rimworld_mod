    <statOffsets><MeditationFocusGain>0.1</MeditationFocusGain></statOffsets>
    <bonusAbilities><li>Dex</li><li>Wis</li></bonusAbilities>
  </LichPhylactery.LP_FeatDef>
  <LichPhylactery.LP_FeatDef ParentName="LP_ClassFeatBase">
    <defName>LP_Feat_Class_MonkShadowless</defName>
    <label>无影身法</label>
    <description>出手看不清，躲闪也看不清。战技强度 +20%；近战闪避 +12；移动速度 +0.4；武僧能力冷却 ×0.85。武僧专属。附带敏捷或感知 +1。</description>
    <iconPath>LP/Feats/Class/MonkShadowless</iconPath>
