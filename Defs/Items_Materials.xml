    </tradeTags>
    <burnableByRecipe>false</burnableByRecipe>
  </ThingDef>

  <ThingDef ParentName="ResourceBase">
    <defName>LP_DragonShed</defName>
    <label>龙鳞蜕</label>
    <description>力能龙裔蜕下的鳞片，轻而坚韧，隐约带着力场的余韵。可以在符文铁砧或熔火锻炉打造成蜕鳞甲。\n\n力能龙裔每晋升一级龙龄蜕下3片；住在宝库里的龙每满60天自然蜕1片。龙不喜欢自己的鳞片被卖掉。</description>
    <graphicData>
      <texPath>Items/Materials/DragonShed</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
    </graphicData>
    <soundInteract>Metal_Drop</soundInteract>
    <soundDrop>Metal_Drop</soundDrop>
