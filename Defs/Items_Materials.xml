  <RecipeDef ParentName="LP_AlchemyRecipeBase">
    <defName>LP_MakeColdIron</defName>
    <label>淬炼寒铁</label>
    <description>用30份钢和10份白银在炼金桌上淬炼出10份寒铁。</description>
    <jobString>正在淬炼寒铁。</jobString>
    <workAmount>1600</workAmount>
    <ingredients>
      <li><filter><thingDefs><li>Steel</li></thingDefs></filter><count>30</count></li>
      <li><filter><thingDefs><li>Silver</li></thingDefs></filter><count>10</count></li>
    </ingredients>
    <fixedIngredientFilter><thingDefs><li>Steel</li><li>Silver</li></thingDefs></fixedIngredientFilter>
    <products><LP_ColdIron>10</LP_ColdIron></products>
    <modExtensions>
      <li Class="LichPhylactery.AlchemyRecipeExtension" />
    </modExtensions>
  </RecipeDef>

