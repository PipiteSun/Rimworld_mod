    <thingCategories>
      <li>ResourcesRaw</li>
    </thingCategories>
    <tradeTags>
      <li>LP_Material</li>
    </tradeTags>
    <burnableByRecipe>false</burnableByRecipe>
  </ThingDef>

  <ThingDef ParentName="LeatherBase">
    <defName>LP_TrollHide</defName>
    <label>巨魔皮</label>
    <description>鞣制过的巨魔皮，厚实而有弹性，离开主人后仍保留着一点再生力：用它做的服装每天恢复1%耐久。只能屠宰巨魔得到。</description>
    <graphicData>
      <texPath>Items/Materials/TrollHide</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
    </graphicData>
    <statBases>
