    </pawnGroupMakers>
    <modExtensions>
      <li Class="LichPhylactery.FactionExtension">
        <toggle>colony</toggle>
        <initialGoodwill>-100</initialGoodwill>
      </li>
    </modExtensions>
  </FactionDef>

