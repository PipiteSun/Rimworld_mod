  <!-- ==================== 塞伊远征军 ==================== -->

  <FactionDef ParentName="LP_FactionBase">
    <defName>LP_FaerunHostile</defName>
    <label>塞伊远征军</label>
    <fixedName>塞伊远征军</fixedName>
    <description>塞伊的红袍法师带着亡灵、符印巨魔和雇来的兽人、牛头人跨海而来，要在这片土地上建起新的魔法帝国。\n\n红袍法师是远征军的头脑：法师一倒，被他绑定的骷髅会当场崩解，符印巨魔会失控狂暴，兽人会四散奔逃。远征军不是天生的死敌，但很难讨好；红袍们对巫妖格外有兴趣。</description>
    <pawnSingular>远征军</pawnSingular>
    <pawnsPlural>远征军</pawnsPlural>
    <leaderTitle>大法师</leaderTitle>
    <techLevel>Medieval</techLevel>
    <naturalEnemy>true</naturalEnemy>
    <categoryTag>LP_Faerun</categoryTag>
    <factionIconPath>Factions/FaerunHostile</factionIconPath>
