      <xenotypeChances>
        <LP_HalfOrc>0.2</LP_HalfOrc>
        <LP_Dwarf>0.1</LP_Dwarf>
        <LP_Elf>0.1</LP_Elf>
        <!-- 1.57.0 -->
        <LP_Goblin>0.05</LP_Goblin>
        <LP_Kobold>0.03</LP_Kobold>
        <LP_Drow>0.03</LP_Drow>
        <LP_HalflingLightfoot>0.03</LP_HalflingLightfoot>
      </xenotypeChances>
    </xenotypeSet>
    <caravanTraderKinds>
      <li>LP_Caravan_BlackNetwork</li>
    </caravanTraderKinds>
    <pawnGroupMakers>
      <li>
        <kindDef>Trader</kindDef>
        <traders>
          <LP_BN_Broker>1</LP_BN_Broker>
        </traders>
        <carriers>
          <Muffalo>4</Muffalo>
          <Dromedary>4</Dromedary>
        </carriers>
        <guards>
          <LP_BN_Enforcer>1</LP_BN_Enforcer>
