    </pawnGroupMakers>
    <modExtensions>
      <li Class="LichPhylactery.FactionExtension">
        <toggle>illithid</toggle>
        <initialGoodwill>-100</initialGoodwill>
        <leaderKinds>
          <li>LP_IC_MindFlayer</li>
        </leaderKinds>
        <followerKinds>
          <li>LP_IC_Thrall</li>
        </followerKinds>
        <followersPerLeader>8</followersPerLeader>
        <leaderCount>1~3</leaderCount>
      </li>
    </modExtensions>
  </FactionDef>

  <!-- ==================== 黑网（隐藏，只出商队） ==================== -->

  <FactionDef ParentName="LP_FactionBase">
