  <!-- 1.19.0 派系。LichPhylactery.FactionExtension：设置开关、初始好感、斩首配置。 -->

  <FactionDef ParentName="FactionBase" Name="LP_FactionBase" Abstract="True">
    <humanlikeFaction>true</humanlikeFaction>
    <requiredCountAtGameStart>1</requiredCountAtGameStart>
    <startingCountAtWorldCreation>1</startingCountAtWorldCreation>
    <maxConfigurableAtWorldCreation>1</maxConfigurableAtWorldCreation>
    <maxCountAtGameStart>1</maxCountAtGameStart>
    <configurationListOrderPriority>300</configurationListOrderPriority>
    <listOrderPriority>25</listOrderPriority>
    <settlementGenerationWeight>1</settlementGenerationWeight>
    <canStageAttacks>true</canStageAttacks>
    <settlementNameMaker>NamerSettlementOutlander</settlementNameMaker>
    <settlementTexturePath>World/WorldObjects/DefaultSettlement</settlementTexturePath>
    <allowedArrivalTemperatureRange>-40~45</allowedArrivalTemperatureRange>
    <raidLootMaker>OutlanderRaidLootMaker</raidLootMaker>
    <fixedIdeo>true</fixedIdeo>
    <requiredPreceptsOnly>false</requiredPreceptsOnly>
    <backstoryFilters>
      <li>
        <categories>
          <li>Outlander</li>
        </categories>
      </li>
    </backstoryFilters>
    <raidCommonalityFromPointsCurve>
      <points>
        <li>(0, 1)</li>
      </points>
    </raidCommonalityFromPointsCurve>
    <maxPawnCostPerTotalPointsCurve>
      <points>
        <li>(0,35)</li>
        <li>(70, 50)</li>
        <li>(800, 100)</li>
        <li>(1300, 150)</li>
        <li>(2000, 220)</li>
        <li>(100000, 10000)</li>
      </points>
    </maxPawnCostPerTotalPointsCurve>
  </FactionDef>

  <!-- ==================== 费伦拓荒同盟 ==================== -->

  <FactionDef ParentName="LP_FactionBase">
    <defName>LP_FaerunColony</defName>
    <label>费伦拓荒同盟</label>
    <fixedName>费伦拓荒同盟</fixedName>
    <description>从费伦大陆远渡而来的拓荒者同盟：人类、矮人、精灵和半兽人一同开垦这片陌生的土地。他们用剑与长弓自保，由圣武士和牧师维持秩序。\n\n同盟高层愿意和任何守规矩的邻居做生意。但他们痛恨亡灵和夺心魔——殖民地里若有巫妖或夺心魔，同盟会疏远你，教会里的狂热分子甚至可能不顾高层反对前来猎巫。</description>
    <pawnSingular>拓荒者</pawnSingular>
    <pawnsPlural>拓荒者</pawnsPlural>
    <leaderTitle>执政官</leaderTitle>
    <techLevel>Medieval</techLevel>
    <categoryTag>LP_Faerun</categoryTag>
    <factionIconPath>Factions/FaerunColony</factionIconPath>
    <colorSpectrum>
      <li>(0.20, 0.42, 0.92)</li>
      <li>(0.42, 0.62, 1.00)</li>
    </colorSpectrum>
    <basicMemberKind>LP_FC_Guard</basicMemberKind>
    <fixedLeaderKinds>
      <li>LP_FC_Knight</li>
    </fixedLeaderKinds>
    <ideoName>拓荒者的誓约</ideoName>
    <ideoDescription>正义、互助与对亡灵的警惕。拓荒者相信众神看着每一块新开垦的田地。</ideoDescription>
    <forcedMemes>
      <li MayRequire="Ludeon.RimWorld.Ideology">Structure_TheistAbstract</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">Collectivist</li>
    </forcedMemes>
    <deityPresets>
      <li>
        <nameType>
          <name>提尔</name><type>正义之神</type>
        </nameType>
        <gender>Male</gender>
        <iconPath>UI/Deities/DeityGeneric</iconPath>
