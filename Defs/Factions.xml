  <!-- ==================== 幽暗殖巢 ==================== -->

  <FactionDef ParentName="LP_FactionBase">
    <defName>LP_IllithidColony</defName>
    <label>幽暗殖巢</label>
    <fixedName>幽暗殖巢</fixedName>
    <description>从幽暗地域深处爬上来的夺心魔殖巢。几个夺心魔用灵能支配着一群被抓来的人类、矮人、精灵和半兽人，让他们像傀儡一样冲锋。\n\n殖巢不和任何人谈判。他们常常从地底挖穿上来，在殖民地中间冒出头。杀掉或击倒夺心魔，被支配的奴仆就会醒过来、瘫倒在地，可以带回去。</description>
    <pawnSingular>殖巢成员</pawnSingular>
    <pawnsPlural>殖巢成员</pawnsPlural>
    <leaderTitle>主脑代言人</leaderTitle>
    <techLevel>Ultra</techLevel>
    <permanentEnemy>true</permanentEnemy>
    <canStageAttacks>false</canStageAttacks>
    <factionIconPath>Factions/IllithidColony</factionIconPath>
    <colorSpectrum>
      <li>(0.52, 0.18, 0.74)</li>
      <li>(0.70, 0.36, 0.92)</li>
    </colorSpectrum>
    <basicMemberKind>LP_IC_Thrall</basicMemberKind>
    <fixedLeaderKinds>
      <li>LP_IC_MindFlayer</li>
    </fixedLeaderKinds>
    <ideoName>主脑的低语</ideoName>
    <ideoDescription>所有心灵终将汇入主脑。</ideoDescription>
    <forcedMemes>
      <li MayRequire="Ludeon.RimWorld.Ideology">Structure_Ideological</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">Supremacist</li>
    </forcedMemes>
    <arrivalModeWhitelist>
      <li>LP_Burrow</li>
      <li>EdgeWalkIn</li>
    </arrivalModeWhitelist>
    <pawnGroupMakers>
      <li>
        <kindDef>Combat</kindDef>
        <commonality>100</commonality>
        <options>
          <LP_IC_MindFlayer>2</LP_IC_MindFlayer>
          <LP_IC_Thrall>12</LP_IC_Thrall>
        </options>
      </li>
      <li>
        <kindDef>Settlement</kindDef>
        <options>
          <LP_IC_MindFlayer>3</LP_IC_MindFlayer>
          <LP_IC_Thrall>12</LP_IC_Thrall>
        </options>
