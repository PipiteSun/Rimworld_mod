    <description>费伦拓荒同盟教会里的狂热分子。他们不顾同盟高层的反对，自行组织起来猎杀巫妖和夺心魔。杀死他们不会影响你和同盟的关系。</description>
    <pawnSingular>狂热分子</pawnSingular>
    <pawnsPlural>狂热分子</pawnsPlural>
    <techLevel>Medieval</techLevel>
    <hidden>true</hidden>
    <permanentEnemy>true</permanentEnemy>
    <displayInFactionSelection>false</displayInFactionSelection>
    <settlementGenerationWeight>0</settlementGenerationWeight>
    <canGenerateQuestSites>false</canGenerateQuestSites>
    <rescueesCanJoin>false</rescueesCanJoin>
    <factionIconPath>Factions/Zealots</factionIconPath>
