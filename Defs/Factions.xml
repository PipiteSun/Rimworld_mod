      <li>
        <nameType>
          <name>提尔</name><type>正义之神</type>
        </nameType>
        <gender>Male</gender>
        <iconPath>UI/Deities/DeityGeneric</iconPath>
      </li>
      <li>
        <nameType>
          <name>拉森德</name><type>晨曦之神</type>
        </nameType>
        <gender>Male</gender>
        <iconPath>UI/Deities/DeityGeneric</iconPath>
      </li>
    </deityPresets>
    <raidCommonalityFromPointsCurve>
      <points>
        <li>(0, 0)</li>
      </points>
    </raidCommonalityFromPointsCurve>
    <pawnGroupMakers>
      <li>
        <kindDef>Combat</kindDef>
        <options>
          <LP_FC_Paladin>2</LP_FC_Paladin>
          <LP_FC_Priest>1</LP_FC_Priest>
