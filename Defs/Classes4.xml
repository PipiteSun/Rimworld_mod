    <cooldownTicksRange>3600</cooldownTicksRange>
    <comps><li Class="LichPhylactery.CompProperties_ClassEffect"><effect>Assassinate</effect><stat>LP_CunningPower</stat></li></comps>
  </AbilityDef>
  <AbilityDef ParentName="LP_ClassSelfBase">
