    <iconPath>LP/Classes/Rogue/SneakAttack</iconPath>
    <comps><li Class="LichPhylactery.CompProperties_ClassEffect"><effect>Passive</effect><passive>true</passive><stat>LP_CunningPower</stat></li></comps>
  </AbilityDef>
  <AbilityDef ParentName="LP_ClassSelfBase">
    <defName>LP_CunningAction</defName>
    <label>灵巧动作</label>
    <description>5 秒 × 诡术强度内移动 ×1.6、近战闪避 +30%，用来冲刺或脱离。游荡者 3 级。</description>
