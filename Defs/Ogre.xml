<?xml version="1.0" encoding="utf-8"?>
<!-- 1.24.0 食人魔：可遗传的巨大种族，偏弱，靠体型（巨躯规则）。能穿普通衣物，不做专属服装。 -->
<Defs>
  <XenotypeDef>
    <defName>LP_Ogre</defName>
    <label>食人魔</label>
    <description>比常人高出一大截的粗野巨人，黄褐色的皮肤、厚下巴、粗眉骨。食人魔力大无穷，一棒子能把人砸飞；可脑子不太灵光，研究慢、学东西慢、做生意总被人压价，长得也丑。血脉会遗传给子女。</description>
    <descriptionShort>可遗传的巨大种族。体型×1.6（生命×1.3、近战×1.18）、近战伤害高；研究×50%、学得慢、被压价、暴躁、丑陋。</descriptionShort>
    <iconPath>Races124/Xenotypes/Ogre</iconPath>
    <inheritable>true</inheritable>
    <combatPowerFactor>1.4</combatPowerFactor>
    <factionlessGenerationWeight>0</factionlessGenerationWeight>
    <genes>
      <li>LP_OgreStature</li>
      <li>LP_OgreDull</li>
      <li>LP_SkinOgre</li>
      <li>Body_Hulk</li>
      <li>Jaw_Heavy</li>
      <li>Brow_Heavy</li>
      <li>MeleeDamage_Strong</li>
      <li>Learning_Slow</li>
      <li>Aggression_Aggressive</li>
      <li>AptitudePoor_Social</li>
      <li>AptitudePoor_Intellectual</li>
      <li>Beauty_Ugly</li>
    </genes>
  </XenotypeDef>

  <GeneDef>
    <defName>LP_OgreStature</defName>
    <label>食人魔体型</label>
    <description>食人魔的巨大身躯。实际体型为普通人的160%，显示为130%大小，搬运量再多10%；饭量是常人的1.3倍，胃也更大（巨胃：饱食度上限×160%）。巨躯规则让食人魔的生命总量×130%、近战伤害×118%。</description>
    <geneClass>LichPhylactery.Gene_LinkedHediff</geneClass>
    <iconPath>Races124/Genes/OgreStature</iconPath>
    <displayCategory>Miscellaneous</displayCategory>
    <selectionWeight>0</selectionWeight>
    <biostatCpx>2</biostatCpx>
    <biostatMet>-4</biostatMet>
    <customEffectDescriptions>
      <li>实际体型：×160%（与其他体型效果相乘）。</li>
      <li>显示大小：×130%。</li>
      <li>搬运量：随体型提高后再×110%。</li>
      <li>食量：×130%。</li>
    </customEffectDescriptions>
    <modExtensions>
      <li Class="LichPhylactery.SmallBodyExtension">
        <bodySize>1.6</bodySize>
        <renderScale>1.3</renderScale>
        <carryFactor>1.1</carryFactor>
      </li>
      <li Class="LichPhylactery.LinkedHediffExtension">
        <hediff>LP_OgreAppetite</hediff>
      </li>
    </modExtensions>
  </GeneDef>
  <HediffDef>
    <defName>LP_OgreAppetite</defName>
    <label>食人魔食量</label>
    <description>巨大的身躯需要大量食物。</description>
    <hediffClass>LichPhylactery.Hediff_GeneLinked</hediffClass>
    <defaultLabelColor>(0.75, 0.65, 0.4)</defaultLabelColor>
    <isBad>false</isBad>
    <everCurableByItem>false</everCurableByItem>
    <stages>
      <li>
        <hungerRateFactor>1.3</hungerRateFactor>
      </li>
    </stages>
  </HediffDef>

  <GeneDef>
    <defName>LP_OgreDull</defName>
    <label>蠢笨</label>
    <description>食人魔的脑子转得慢：研究速度减半，做买卖时常被人压价，也更容易被心灵手段左右（心智抗性-10%，不会低于0）。</description>
    <iconPath>Races124/Genes/OgreDull</iconPath>
    <displayCategory>Miscellaneous</displayCategory>
    <selectionWeight>0</selectionWeight>
    <biostatCpx>1</biostatCpx>
    <biostatMet>0</biostatMet>
    <statFactors>
      <ResearchSpeed>0.5</ResearchSpeed>
    </statFactors>
    <statOffsets>
      <TradePriceImprovement>-0.15</TradePriceImprovement>
      <LP_MindResist>-0.1</LP_MindResist>
    </statOffsets>
  </GeneDef>

  <GeneDef ParentName="GeneSkinColorOverride">
    <defName>LP_SkinOgre</defName>
    <label>食人魔肤色</label>
    <labelShortAdj>黄褐</labelShortAdj>
    <description>食人魔粗糙的黄褐色皮肤。</description>
    <skinColorOverride>(190, 160, 100)</skinColorOverride>
    <randomBrightnessFactor>0.08</randomBrightnessFactor>
    <selectionWeight>0</selectionWeight>
    <displayOrderInCategory>1</displayOrderInCategory>
  </GeneDef>

  <!-- ==================== 种族关系 ==================== -->
  <ThoughtDef>
    <defName>LP_RacialRelation_OgreHalfOrc</defName>
    <workerClass>LichPhylactery.ThoughtWorker_DNDRacialRelation</workerClass>
    <stages>
      <li>
        <label>合得来的半兽人</label>
        <description>那个半兽人不嫌我笨，打架也够狠。</description>
        <baseMoodEffect>1</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>
  <LichPhylactery.RacialRelationDef>
    <defName>LP_Relation_OgreHalfOrc</defName>
    <label>食人魔看半兽人</label>
    <observer>LP_Ogre</observer>
    <target>LP_HalfOrc</target>
    <thought>LP_RacialRelation_OgreHalfOrc</thought>
  </LichPhylactery.RacialRelationDef>
  <ThoughtDef>
    <defName>LP_RacialRelation_DwarfOgre</defName>
    <workerClass>LichPhylactery.ThoughtWorker_DNDRacialRelation</workerClass>
    <stages>
      <li>
        <label>食人魔在附近</label>
        <description>矮人的歌谣里，食人魔总在偷羊、砸矿车。那个大块头最好离我的矿道远一点。</description>
        <baseMoodEffect>-2</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>
  <LichPhylactery.RacialRelationDef>
    <defName>LP_Relation_DwarfOgre</defName>
    <label>矮人看食人魔</label>
    <observer>LP_Dwarf</observer>
    <target>LP_Ogre</target>
    <thought>LP_RacialRelation_DwarfOgre</thought>
  </LichPhylactery.RacialRelationDef>
  <ThoughtDef>
    <defName>LP_RacialRelation_ElfOgre</defName>
    <workerClass>LichPhylactery.ThoughtWorker_DNDRacialRelation</workerClass>
    <stages>
      <li>
        <label>食人魔在附近</label>
        <description>那个食人魔踩坏了花圃，还冲着我傻笑。</description>
        <baseMoodEffect>-2</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>
  <LichPhylactery.RacialRelationDef>
    <defName>LP_Relation_ElfOgre</defName>
    <label>精灵看食人魔</label>
    <observer>LP_Elf</observer>
    <target>LP_Ogre</target>
    <thought>LP_RacialRelation_ElfOgre</thought>
  </LichPhylactery.RacialRelationDef>
</Defs>
