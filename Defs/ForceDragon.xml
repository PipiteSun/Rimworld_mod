      <MaxHitPoints>1000</MaxHitPoints>
      <Flammability>0</Flammability>
    </statBases>
    <building>
      <deconstructible>false</deconstructible>
      <claimable>false</claimable>
      <isInert>true</isInert>
    </building>
  </ThingDef>

  <!-- ==================== 龙蛋 ==================== -->

  <ThingDef>
    <defName>LP_ForceDragonEgg</defName>
    <label>力能龙蛋</label>
    <description>表面像钻石一样闪烁的龙蛋。必须放在力能龙裔的宝库里保温才会孵化，宝库越富有孵得越快；孵出的是一个龙龄为幼龙的力能龙裔婴儿。价格极高。</description>
    <thingClass>ThingWithComps</thingClass>
    <category>Item</category>
    <graphicData>
      <texPath>Things/Item/Resource/AnimalProductRaw/EggOval</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
      <color>(0.78, 0.88, 1)</color>
      <drawSize>1.3</drawSize>
    </graphicData>
    <altitudeLayer>Item</altitudeLayer>
    <tickerType>Rare</tickerType>
    <stackLimit>1</stackLimit>
    <alwaysHaulable>true</alwaysHaulable>
    <selectable>true</selectable>
    <useHitPoints>true</useHitPoints>
    <rotatable>false</rotatable>
    <pathCost>14</pathCost>
    <drawGUIOverlay>true</drawGUIOverlay>
    <healthAffectsPrice>false</healthAffectsPrice>
    <thingCategories>
      <li>ItemsMisc</li>
    </thingCategories>
    <statBases>
      <MaxHitPoints>200</MaxHitPoints>
      <MarketValue>4000</MarketValue>
      <Mass>3</Mass>
      <Flammability>0</Flammability>
      <Beauty>10</Beauty>
    </statBases>
    <comps>
      <li Class="LichPhylactery.CompProperties_DragonEgg" />
    </comps>
  </ThingDef>

  <!-- ==================== 能力 ==================== -->

  <AbilityDef Name="LP_ForceDragonAbilityBase" Abstract="True">
    <cooldownTicksRange>2500</cooldownTicksRange>
    <aiCanUse>false</aiCanUse>
    <displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
    <disableGizmoWhileUndrafted>false</disableGizmoWhileUndrafted>
    <sendMessageOnCooldownComplete>false</sendMessageOnCooldownComplete>
  </AbilityDef>

  <AbilityDef ParentName="LP_ForceDragonAbilityBase">
    <defName>LP_ForceBreath</defName>
    <label>力场吐息</label>
    <description>吐出一道撕裂一切的力场锥。对生物造成力场伤害（幼龙13点，每级+3），对建筑和掩体造成3倍伤害；锥内敌人的护盾腰带、机械体护盾会被直接打碎，每打碎一个回复25点力能。不会点火。射程随龙龄从4格增长到9格。消耗25点力能。</description>
    <iconPath>UI/Abilities/Flashstorm</iconPath>
    <cooldownTicksRange>5000</cooldownTicksRange>
    <hostile>true</hostile>
    <casterMustBeCapableOfViolence>true</casterMustBeCapableOfViolence>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <range>9</range>
      <warmupTime>1</warmupTime>
      <requireLineOfSight>false</requireLineOfSight>
      <targetParams>
