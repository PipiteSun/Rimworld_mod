    <defName>LP_ChargeFlyer</defName>
    <label>冲锋</label>
    <thingClass>LichPhylactery.LP_ChargeFlyer</thingClass>
  </ThingDef>

  <!-- 武僧 -->
  <HediffDef ParentName="LP_ClassBuffBase">
    <defName>LP_MonkStance</defName>
    <hediffClass>LichPhylactery.Hediff_ScaledBuff</hediffClass>
    <label>武艺</label>
