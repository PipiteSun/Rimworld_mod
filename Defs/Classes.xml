<!-- 1.72.0 职业体系脱离 VPE（第一版）：战士、武僧、圣武士在主模组里，原版 RimWorld 能力（不需要心灵链接、不耗精神力 / 心灵熵），装不装 VPE 都能玩。
     职业等级存在冒险者状态里（LichPhylactery.ClassData）；每个冒险者等级 1 点职业点，职业等级总和 ≤ 冒险者等级（最多 20）。
     能力在职业等级 1/3/5/7/10/13/15 自动获得（15 级的终极另要那门技能 15 级）；施放消耗职业资源：战士 斗志、武僧 气、圣武士 神恩。
     状态、属性从 Bridges/VPE 移来（defName 不变），VEF_MeleeAttackDamageFactor 改成原版 MeleeDamageFactor。见 ArtSource/Classes-1.72.0-report.md。 -->
<Defs>
  <!-- ===== 职业 ===== -->
  <LichPhylactery.LP_ClassDef>
    <defName>LP_Class_Fighter</defName>
    <label>战士</label>
    <description>DND 战士：格斗支（回气、冲锋、战吼、绊摔、动作如潮、武器专精、不屈意志、缴械击、旋风斩、守护姿态，终极 战意再临）与射击支（稳固瞄准、压制射击、精准射击、连射，终极 死神之眼）。格斗支的强度看“战技强度”，射击支看“射术强度”。资源：斗志（命中、击杀敌人时积攒，睡觉时回满）。物理职业：额外攻击、战斗风格。</description>
    <mainSkill>Melee</mainSkill>
    <alternateSkill>Shooting</alternateSkill>
    <primary>Str/Dex</primary>
    <order>1</order>
    <resource>Fury</resource>
    <martial>true</martial>
    <legacyPath>LP_Path_Fighter</legacyPath>
    <background>LP/Classes/Background_Fighter</background>
    <color>(0.95,0.6,0.4)</color>
    <abilities>
      <li><ability>LP_SecondWind</ability><level>1</level></li>
      <li><ability>LP_Charge</ability><level>1</level></li>
      <li><ability>LP_SteadyAim</ability><level>1</level></li>
      <li><ability>LP_BattleCry</ability><level>3</level></li>
      <li><ability>LP_SuppressingFire</ability><level>3</level></li>
      <li><ability>LP_Trip</ability><level>5</level></li>
      <li><ability>LP_ActionSurge</ability><level>5</level></li>
      <li><ability>LP_WeaponMastery</ability><level>7</level></li>
      <li><ability>LP_Indomitable</ability><level>7</level></li>
      <li><ability>LP_PrecisionShot</ability><level>7</level></li>
      <li><ability>LP_DisarmingStrike</ability><level>10</level></li>
      <li><ability>LP_Whirlwind</ability><level>10</level></li>
      <li><ability>LP_RapidFire</ability><level>10</level></li>
      <li><ability>LP_GuardStance</ability><level>13</level></li>
      <li><ability>LP_SurgeOfBattle</ability><level>15</level><capstoneSkill>Melee</capstoneSkill></li>
      <li><ability>LP_DeadEye</ability><level>15</level><capstoneSkill>Shooting</capstoneSkill></li>
    </abilities>
    <legendary><li>LP_LegUnyielding</li><li>LP_LegThousandArmies</li></legendary>
  </LichPhylactery.LP_ClassDef>

  <LichPhylactery.LP_ClassDef>
    <defName>LP_Class_Monk</defName>
    <label>武僧</label>
    <description>DND 武僧以气御身：武艺（被动）、疾风连击、拨挡箭矢、震慑拳、乘风步、开掌技、金刚之躯、颤心掌，终极 空灵之身。徒手（或拿短棍）时最强；拳脚走原版近战结算，Isekai 的力量与武器精通照常生效。强度看“战技强度”；“气”的效果（设置开着时）乘心灵敏感度。资源：气（冥想时恢复，睡觉时回满）。物理职业：额外攻击（只在徒手时）、战斗风格。</description>
    <mainSkill>Melee</mainSkill>
    <primary>Dex</primary>
    <order>3</order>
    <resource>Ki</resource>
    <martial>true</martial>
    <legacyPath>LP_Path_Monk</legacyPath>
    <background>LP/Classes/Monk/Background</background>
    <color>(0.95,0.8,0.4)</color>
    <abilities>
      <li><ability>LP_MartialArts</ability><level>1</level></li>
      <li><ability>LP_FlurryOfBlows</ability><level>1</level></li>
      <li><ability>LP_DeflectMissiles</ability><level>3</level></li>
      <li><ability>LP_StunningStrike</ability><level>5</level></li>
      <li><ability>LP_StepOfTheWind</ability><level>7</level></li>
      <li><ability>LP_OpenHand</ability><level>7</level></li>
      <li><ability>LP_DiamondSoul</ability><level>10</level></li>
      <li><ability>LP_QuiveringPalm</ability><level>13</level></li>
      <li><ability>LP_EmptyBody</ability><level>15</level><capstoneSkill>Melee</capstoneSkill></li>
    </abilities>
    <legendary><li>LP_LegFormless</li><li>LP_LegHeavenPalm</li></legendary>
  </LichPhylactery.LP_ClassDef>

  <LichPhylactery.LP_ClassDef>
    <defName>LP_Class_Paladin</defName>
    <label>圣武士</label>
    <description>DND 圣武士以誓言为剑：至圣斩、誓仇、神圣武器、援护换位（格斗，战技强度），圣疗、守护灵光、勇气灵光、放逐邪恶（社交，神恩强度），终极 圣光化身。武器那一下照常结算，追加的神圣伤害和治疗（设置开着时）乘心灵敏感度。资源：神恩（祈祷、冥想时恢复，信奉神明的人快 25%，睡觉时回满）。巫妖不能当圣武士。物理职业：额外攻击、战斗风格。</description>
    <mainSkill>Melee</mainSkill>
    <alternateSkill>Social</alternateSkill>
    <primary>Cha</primary>
    <order>2</order>
    <resource>Grace</resource>
    <martial>true</martial>
    <legacyPath>LP_Path_Paladin</legacyPath>
    <background>LP/Classes/Paladin/Background</background>
    <color>(1,0.9,0.55)</color>
    <abilities>
      <li><ability>LP_DivineSmite</ability><level>1</level></li>
      <li><ability>LP_LayOnHands</ability><level>1</level></li>
      <li><ability>LP_VowOfEnmity</ability><level>3</level></li>
      <li><ability>LP_AuraOfProtection</ability><level>5</level></li>
      <li><ability>LP_SacredWeapon</ability><level>7</level></li>
      <li><ability>LP_AuraOfCourage</ability><level>7</level></li>
      <li><ability>LP_Intercept</ability><level>10</level></li>
      <li><ability>LP_DispelEvil</ability><level>13</level></li>
      <li><ability>LP_HolyAvatar</ability><level>15</level><capstoneSkill>Melee</capstoneSkill></li>
    </abilities>
    <legendary><li>LP_LegDivineIncarnation</li><li>LP_LegUndyingOath</li></legendary>
  </LichPhylactery.LP_ClassDef>

  <!-- ===== 职业强度（1.27.0 起在 VPE 桥里，1.72.0 移到主模组；奥术、天赋等其他强度仍在桥里） ===== -->
  <StatDef Name="LP_ClassPowerBase" Abstract="True">
    <category>PawnMisc</category>
    <defaultBaseValue>1</defaultBaseValue>
    <minValue>0.5</minValue>
    <toStringStyle>PercentZero</toStringStyle>
    <showOnHumanlikes>true</showOnHumanlikes>
    <showOnAnimals>false</showOnAnimals>
    <showOnMechanoids>false</showOnMechanoids>
    <showOnEntities>false</showOnEntities>
    <showIfUndefined>false</showIfUndefined>
    <cacheable>false</cacheable>
  </StatDef>
  <StatDef ParentName="LP_ClassPowerBase">
    <defName>LP_MartialPower</defName>
    <label>战技强度</label>
    <description>DND 战技的强度倍率：0.5 + 格斗等级/20，另加冒险者力量或敏捷（较高者）调整值 × 0.05 与 (熟练加值 − 2) × 0.02。有物理职业（战士、武僧、圣武士、野蛮人、游侠、游荡者）的人另加 0.02 ×（物理职业等级合计 − 1），最多 +40%。回气治疗量、战吼范围、增益持续时间、武僧拳脚与气、圣武士格斗支都乘这个倍率。</description>
    <parts><li Class="LichPhylactery.StatPart_ClassPower"><skill>Melee</skill></li></parts>
    <displayPriorityInCategory>4210</displayPriorityInCategory>
  </StatDef>
  <StatDef ParentName="LP_ClassPowerBase">
    <defName>LP_MarksmanPower</defName>
    <label>射术强度</label>
    <description>DND 战士射击支的强度倍率：0.5 + 射击等级/20，另加冒险者敏捷调整值 × 0.05 与 (熟练加值 − 2) × 0.02；有物理职业的人另加 0.02 ×（物理职业等级合计 − 1），最多 +40%。</description>
    <parts><li Class="LichPhylactery.StatPart_ClassPower"><skill>Shooting</skill></li></parts>
    <displayPriorityInCategory>4213</displayPriorityInCategory>
  </StatDef>
  <StatDef ParentName="LP_ClassPowerBase">
    <defName>LP_DivinePower</defName>
    <label>神恩强度</label>
    <description>神术的强度倍率：0.5 + 社交等级/20，另加冒险者感知或魅力（取较高，牧师看感知、圣武士看魅力）的调整值 × 0.05 与 (熟练加值 − 2) × 0.02。牧师的神术和圣武士的社交支（圣疗、守护灵光、放逐邪恶）用它。</description>
    <parts><li Class="LichPhylactery.StatPart_ClassPower"><skill>Social</skill><ability>Wis/Cha</ability></li><li Class="LichPhylactery.StatPart_LegendaryClassPower"><ability>LP_LegDivineGuardian</ability><bonus>0.2</bonus></li></parts>
    <displayPriorityInCategory>4212</displayPriorityInCategory>
  </StatDef>

  <!-- ===== 状态（defName 与 1.71.0 的 VPE 桥相同） ===== -->
