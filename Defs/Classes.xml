    <defaultLabelColor>(0.9,0.6,0.5)</defaultLabelColor>
    <stages><li><statFactors><MoveSpeed>0.6</MoveSpeed></statFactors></li></stages>
  </HediffDef>
  <HediffDef ParentName="LP_ClassBuffBase">
    <defName>LP_RapidFire</defName>
    <hediffClass>LichPhylactery.Hediff_MartialFlag</hediffClass>
    <label>连射</label>
    <description>射击冷却 ×0.5；连发武器每轮多打 1 发。</description>
    <everCurableByItem>false</everCurableByItem>
    <stages><li><statFactors><RangedCooldownFactor>0.5</RangedCooldownFactor></statFactors></li></stages>
  </HediffDef>
  <HediffDef ParentName="LP_ClassBuffBase">
    <defName>LP_DeadEye</defName>
    <hediffClass>LichPhylactery.Hediff_MartialFlag</hediffClass>
    <label>死神之眼</label>
    <description>远程必中、无视掩体，射击伤害 ×1.5；每次射杀敌人，所有战士战技立刻冷却完毕。</description>
    <everCurableByItem>false</everCurableByItem>
  </HediffDef>
  <HediffDef ParentName="LP_ClassBuffBase">
    <defName>LP_Hobbled</defName>
    <label>腿部中弹</label>
    <description>被精准射击打中腿：移动 ×0.5。</description>
