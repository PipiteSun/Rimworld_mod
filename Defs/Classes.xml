      <li Class="HediffCompProperties_Disappears"><disappearsAfterTicks>600~600</disappearsAfterTicks><showRemainingTime>true</showRemainingTime></li>
    </comps>
  </HediffDef>

  <HediffDef ParentName="LP_ClassBuffBase">
    <defName>LP_SecondWind</defName>
    <maxSeverity>100</maxSeverity>
    <label>回气</label>
    <description>战士调匀呼吸，600刻内持续治疗伤势（总量 = 20 × 战技强度，优先流血伤口）。</description>
    <comps>
      <li Class="LichPhylactery.HediffCompProperties_ClassHeal"><interval>60</interval><ticksTotal>600</ticksTotal></li>
    </comps>
  </HediffDef>
  <HediffDef ParentName="LP_ClassBuffBase">
    <defName>LP_Shaken</defName>
    <label>震慑</label>
    <description>被震慑：移动 ×0.7、近战命中与射击精度下降。</description>
    <isBad>true</isBad>
    <defaultLabelColor>(0.9,0.6,0.5)</defaultLabelColor>
    <stages><li><statFactors><MoveSpeed>0.7</MoveSpeed></statFactors><statOffsets><MeleeHitChance>-0.15</MeleeHitChance><ShootingAccuracyPawn>-0.05</ShootingAccuracyPawn></statOffsets></li></stages>
  </HediffDef>
  <HediffDef ParentName="LP_ClassBuffBase">
    <defName>LP_ActionSurge</defName>
    <label>动作如潮</label>
    <description>近战冷却 ×0.6、射击冷却 ×0.6，移动 ×1.3。</description>
    <stages><li><statFactors><MeleeCooldownFactor>0.6</MeleeCooldownFactor><RangedCooldownFactor>0.6</RangedCooldownFactor><MoveSpeed>1.3</MoveSpeed></statFactors></li></stages>
  </HediffDef>
  <HediffDef ParentName="LP_ClassBuffBase">
    <defName>LP_WeaponMastery</defName>
    <hediffClass>LichPhylactery.Hediff_MartialFlag</hediffClass>
    <label>武器专精</label>
    <description>近战伤害提高（×1.24 ～ ×1.45，随战技强度分档）；远程武器的伤害也乘同一档系数。</description>
    <stages>
      <li><label>熟练</label><statFactors><MeleeDamageFactor>1.24</MeleeDamageFactor></statFactors></li>
      <li><minSeverity>0.95</minSeverity><label>精通</label><statFactors><MeleeDamageFactor>1.3</MeleeDamageFactor></statFactors></li>
      <li><minSeverity>1.1</minSeverity><label>专精</label><statFactors><MeleeDamageFactor>1.35</MeleeDamageFactor></statFactors></li>
      <li><minSeverity>1.25</minSeverity><label>大师</label><statFactors><MeleeDamageFactor>1.4</MeleeDamageFactor></statFactors></li>
      <li><minSeverity>1.45</minSeverity><label>宗师</label><statFactors><MeleeDamageFactor>1.45</MeleeDamageFactor></statFactors></li>
    </stages>
  </HediffDef>
  <HediffDef ParentName="LP_ClassBuffBase">
    <defName>LP_Indomitable</defName>
    <label>不屈意志</label>
    <description>感觉不到疼痛，不会因疼痛倒地，免疫击晕，精神崩溃阈值 -15%。</description>
    <stages><li><painFactor>0</painFactor><statOffsets><MentalBreakThreshold>-0.15</MentalBreakThreshold></statOffsets></li></stages>
  </HediffDef>
  <HediffDef ParentName="LP_ClassBuffBase">
    <defName>LP_GuardStance</defName>
    <label>守护姿态</label>
    <description>护甲提高（+16% ～ +30%，随战技强度分档），移动 ×0.7；半径 3 内友军受到的伤害有 30% 转到自己身上。</description>
    <stages>
      <li><statFactors><MoveSpeed>0.7</MoveSpeed></statFactors><statOffsets><ArmorRating_Sharp>0.16</ArmorRating_Sharp><ArmorRating_Blunt>0.16</ArmorRating_Blunt></statOffsets></li>
      <li><minSeverity>0.95</minSeverity><statFactors><MoveSpeed>0.7</MoveSpeed></statFactors><statOffsets><ArmorRating_Sharp>0.2</ArmorRating_Sharp><ArmorRating_Blunt>0.2</ArmorRating_Blunt></statOffsets></li>
      <li><minSeverity>1.1</minSeverity><statFactors><MoveSpeed>0.7</MoveSpeed></statFactors><statOffsets><ArmorRating_Sharp>0.23</ArmorRating_Sharp><ArmorRating_Blunt>0.23</ArmorRating_Blunt></statOffsets></li>
      <li><minSeverity>1.25</minSeverity><statFactors><MoveSpeed>0.7</MoveSpeed></statFactors><statOffsets><ArmorRating_Sharp>0.26</ArmorRating_Sharp><ArmorRating_Blunt>0.26</ArmorRating_Blunt></statOffsets></li>
      <li><minSeverity>1.45</minSeverity><statFactors><MoveSpeed>0.7</MoveSpeed></statFactors><statOffsets><ArmorRating_Sharp>0.3</ArmorRating_Sharp><ArmorRating_Blunt>0.3</ArmorRating_Blunt></statOffsets></li>
    </stages>
  </HediffDef>
  <HediffDef ParentName="LP_ClassBuffBase">
    <defName>LP_SurgeOfBattle</defName>
    <label>战意再临</label>
    <description>近战冷却 ×0.5、近战伤害 ×1.5，免疫击晕；每次近战击杀让所有战士战技立即冷却完毕。</description>
    <stages><li><statFactors><MeleeCooldownFactor>0.5</MeleeCooldownFactor><MeleeDamageFactor>1.5</MeleeDamageFactor></statFactors></li></stages>
  </HediffDef>
  <!-- 旋风斩、冲锋那一击的临时状态：近战伤害（MeleeDamageFactor）= 严重度，结算完立刻移除。 -->
  <HediffDef ParentName="LP_ClassBuffBase">
    <defName>LP_WhirlwindFury</defName>
    <hediffClass>LichPhylactery.Hediff_StrikeFactor</hediffClass>
    <label>旋风之势</label>
    <description>旋风斩这一下的近战伤害 × 战技强度。</description>
  </HediffDef>
  <HediffDef ParentName="LP_ClassBuffBase">
    <defName>LP_ChargeStrike</defName>
    <hediffClass>LichPhylactery.Hediff_StrikeFactor</hediffClass>
    <label>冲锋之势</label>
    <description>冲锋落地的这一下近战伤害 ×(1 + 0.3 × 战技强度)。</description>
    <everCurableByItem>false</everCurableByItem>
  </HediffDef>

  <HediffDef>
    <defName>LP_ExtraAttack</defName>
    <label>额外攻击</label>
    <description>物理职业的额外攻击：近战冷却、射击冷却缩短，普通近战命中后有机会追击一次。档位：任一物理职业 5 级第 1 档，战士 10 级第 2 档、15 级第 3 档。</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <everCurableByItem>false</everCurableByItem>
    <scenarioCanAdd>false</scenarioCanAdd>
    <initialSeverity>1</initialSeverity>
    <maxSeverity>3</maxSeverity>
    <defaultLabelColor>(0.95,0.6,0.4)</defaultLabelColor>
    <stages>
      <li><minSeverity>0</minSeverity><label>第 1 档</label><statFactors><MeleeCooldownFactor>0.8</MeleeCooldownFactor><RangedCooldownFactor>0.85</RangedCooldownFactor></statFactors></li>
      <li><minSeverity>1.5</minSeverity><label>第 2 档</label><statFactors><MeleeCooldownFactor>0.7</MeleeCooldownFactor><RangedCooldownFactor>0.75</RangedCooldownFactor></statFactors></li>
      <li><minSeverity>2.5</minSeverity><label>第 3 档</label><statFactors><MeleeCooldownFactor>0.6</MeleeCooldownFactor><RangedCooldownFactor>0.65</RangedCooldownFactor></statFactors></li>
    </stages>
  </HediffDef>
  <HediffDef ParentName="LP_ClassBuffBase">
    <defName>LP_SteadyAim</defName>
    <hediffClass>LichPhylactery.Hediff_MartialFlag</hediffClass>
    <label>稳固瞄准</label>
    <description>沉下身子瞄准：射击预热 ×0.5、远程命中 ×1.15，移动 ×0.5。</description>
    <everCurableByItem>false</everCurableByItem>
    <stages><li><statFactors><AimingDelayFactor>0.5</AimingDelayFactor><MoveSpeed>0.5</MoveSpeed></statFactors></li></stages>
