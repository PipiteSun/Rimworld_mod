<?xml version="1.0" encoding="utf-8"?>
<!-- 1.45.1 魔法盔甲衣服（按《DND盔甲与衣服构思》）：34 件（构思的 32 条里余烬奴兵制服和吟游诗人装各含一顶帽子），7 个套装，派系换装。
     双色：CutoutComplex + _m 遮罩（红=材料色，绿=纹章色）；纹章色由 HeraldryExtension 在穿上时按意识形态色 / 派系色给出（Source/MagicApparel.cs）。
     自建披风层 LP_Cape：画在外层之上、腰带和头盔之下。衣甲不受器械师门槛。 -->
<Defs>
  <ApparelLayerDef>
    <defName>LP_Cape</defName>
    <label>披风</label>
    <drawOrder>250</drawOrder>
  </ApparelLayerDef>

  <!-- ===== 基类 ===== -->
  <ThingDef Name="LP_DNDClothBase" ParentName="ApparelMakeableBase" Abstract="True">
    <techLevel>Medieval</techLevel>
    <thingCategories><li>Apparel</li></thingCategories>
    <tradeTags Inherit="False"><li>LP_DNDApparel</li><li>Clothing</li></tradeTags>
    <graphicData><graphicClass>Graphic_Single</graphicClass><shaderType>CutoutComplex</shaderType></graphicData>
    <apparel><useWornGraphicMask>true</useWornGraphicMask></apparel>
    <modExtensions><li Class="LichPhylactery.HeraldryExtension" /></modExtensions>
  </ThingDef>
  <ThingDef Name="LP_DNDArmorBase" ParentName="ArmorSmithableBase" Abstract="True">
    <techLevel>Medieval</techLevel>
    <thingCategories><li>ApparelArmor</li></thingCategories>
    <tradeTags Inherit="False"><li>LP_DNDArmor</li><li>Armor</li></tradeTags>
    <graphicData><graphicClass>Graphic_Single</graphicClass><shaderType>CutoutComplex</shaderType></graphicData>
    <recipeMaker><recipeUsers Inherit="False"><li>LP_RuneAnvil</li></recipeUsers><unfinishedThingDef>UnfinishedMetallicTechArmor</unfinishedThingDef></recipeMaker>
    <apparel><useWornGraphicMask>true</useWornGraphicMask><defaultOutfitTags><li>Soldier</li></defaultOutfitTags></apparel>
    <modExtensions><li Class="LichPhylactery.HeraldryExtension" /></modExtensions>
  </ThingDef>
  <ThingDef Name="LP_DNDHelmBase" ParentName="LP_DNDArmorBase" Abstract="True">
    <thingCategories Inherit="False"><li>ArmorHeadgear</li></thingCategories>
    <recipeMaker><unfinishedThingDef IsNull="True" /></recipeMaker>
    <apparel><parentTagDef>ApparelHead</parentTagDef><layers><li>Overhead</li></layers></apparel>
  </ThingDef>
  <ThingDef Name="LP_DNDHatBase" ParentName="LP_DNDClothBase" Abstract="True">
    <thingCategories Inherit="False"><li>Headgear</li></thingCategories>
    <apparel><parentTagDef>ApparelHead</parentTagDef><layers><li>Overhead</li></layers><bodyPartGroups><li>UpperHead</li></bodyPartGroups></apparel>
  </ThingDef>

  <!-- ==================== 骑士与圣武士 ==================== -->

  <!-- ==================== 矮人 ==================== -->

  <!-- ==================== 游侠与游荡者 ==================== -->

  <!-- ==================== 法师、牧师与红袍 ==================== -->

  <!-- ==================== 死亡骑士、巫妖与亡灵 ==================== -->
  <ThingDef ParentName="LP_DNDArmorBase">
    <defName>LP_DeathknightPlate</defName>
    <label>死亡骑士铠甲</label>
    <description>发黑的铁色板甲，肩甲是向上翘起的锯齿尖刺，左肩挂一个小骷髅饰，胸甲中间的裂纹里透出幽绿；背后一件破成几条的黑披风（占披风层）。护甲为原版板甲的110%；寒冷伤害-20%；近战攻击穿戴者的敌人每次有10%概率陷入恐惧（牛头人、象人和不受心灵影响的不会）。不是亡灵的人穿着心情-3（“冰冷的铠甲在低语”）。只能由巫妖在死灵仪式台锻造（钢150 + 命匣200献祭经验）。\n\n套装“死亡骑士”（铠甲 + 亡魂巨盔）：倒地时以30%生命“再站起来”，每3天一次；巫妖本人穿不触发。</description>
    <graphicData><texPath>LP/Apparel/DeathknightPlate/DeathknightPlate_Icon</texPath></graphicData>
    <recipeMaker IsNull="True" />
    <stuffCategories><li>Metallic</li></stuffCategories>
    <costStuffCount>150</costStuffCount>
    <statBases><MaxHitPoints>300</MaxHitPoints><Mass>16</Mass><MarketValue>2200</MarketValue><StuffEffectMultiplierArmor>0.99</StuffEffectMultiplierArmor><StuffEffectMultiplierInsulation_Cold>1</StuffEffectMultiplierInsulation_Cold><StuffEffectMultiplierInsulation_Heat>0</StuffEffectMultiplierInsulation_Heat><EquipDelay>15</EquipDelay></statBases>
    <equippedStatOffsets><MoveSpeed>-0.8</MoveSpeed></equippedStatOffsets>
    <apparel>
      <bodyPartGroups><li>Torso</li><li>Neck</li><li>Shoulders</li><li>Arms</li><li>Legs</li></bodyPartGroups>
      <wornGraphicPath>LP/Apparel/DeathknightPlate/DeathknightPlate</wornGraphicPath>
      <layers><li>Middle</li><li>Shell</li><li>LP_Cape</li></layers>
      <tags><li>LP_DeathknightGear</li></tags>
    </apparel>
    <comps><li Class="LichPhylactery.CompProperties_ApparelSetPiece" /></comps>
    <modExtensions><li Class="LichPhylactery.ItemDamageFactors"><factor>0.8</factor><damageDefs><li>Frostbite</li><li>LP_Frost</li></damageDefs><keywords><li>Frost</li><li>Cold</li></keywords></li></modExtensions>
  </ThingDef>
  <ThingDef ParentName="LP_DNDHelmBase">
    <defName>LP_HelmRestlessDead</defName>
    <label>亡魂巨盔</label>
    <description>黑铁全盔，前额两根后掠的角，面甲是骷髅牙齿造型，眼缝里两点幽绿。厚重全盔，心智抗性+10%。只能由巫妖在死灵仪式台锻造（钢50 + 命匣80献祭经验）。</description>
    <graphicData><texPath>LP/Apparel/HelmRestlessDead/HelmRestlessDead_Icon</texPath></graphicData>
    <recipeMaker IsNull="True" />
    <stuffCategories><li>Metallic</li></stuffCategories>
    <costStuffCount>50</costStuffCount>
    <statBases><MaxHitPoints>130</MaxHitPoints><Mass>2.5</Mass><MarketValue>800</MarketValue><StuffEffectMultiplierArmor>0.56</StuffEffectMultiplierArmor><StuffEffectMultiplierInsulation_Cold>0.15</StuffEffectMultiplierInsulation_Cold><StuffEffectMultiplierInsulation_Heat>0</StuffEffectMultiplierInsulation_Heat><EquipDelay>2</EquipDelay></statBases>
    <equippedStatOffsets><LP_MindResist>0.1</LP_MindResist><AimingDelayFactor>0.05</AimingDelayFactor></equippedStatOffsets>
    <apparel>
      <bodyPartGroups><li>FullHead</li></bodyPartGroups>
      <wornGraphicPath>LP/Apparel/HelmRestlessDead/HelmRestlessDead</wornGraphicPath>
      <renderSkipFlags><li>Hair</li><li>Beard</li></renderSkipFlags>
      <tags><li>LP_DeathknightGear</li></tags>
    </apparel>
    <comps><li Class="LichPhylactery.CompProperties_ApparelSetPiece" /></comps>
  </ThingDef>
  <ThingDef ParentName="LP_DNDHatBase">
    <defName>LP_CrownOfBone</defName>
    <smeltable>false</smeltable>
    <label>骸骨王冠</label>
    <description>黑铁细冠，前面竖着五根磨亮的指骨，中间镶一颗紫色宝石。社交影响+10%；巫妖戴着时恐惧凝视的范围+1格。只能由巫妖在死灵仪式台制作（金20 + 人皮10）。</description>
    <graphicData><texPath>LP/Apparel/CrownOfBone/CrownOfBone_Icon</texPath></graphicData>
    <recipeMaker IsNull="True" />
    <statBases><MaxHitPoints>100</MaxHitPoints><Mass>0.6</Mass><MarketValue>700</MarketValue><Beauty>2</Beauty><EquipDelay>1</EquipDelay></statBases>
    <colorGenerator Class="ColorGenerator_Single"><color>(0.3,0.28,0.32)</color></colorGenerator>
    <equippedStatOffsets><SocialImpact>0.1</SocialImpact></equippedStatOffsets>
    <apparel>
      <wornGraphicPath>LP/Apparel/CrownOfBone/CrownOfBone</wornGraphicPath>
      <tags><li>LP_LichGear</li></tags>
    </apparel>
  </ThingDef>

  <!-- ==================== 龙、吉斯洋基、余烬 ==================== -->

