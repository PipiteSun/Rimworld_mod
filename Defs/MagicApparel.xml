  <!-- ==================== 条件状态 ==================== -->
  <ThoughtDef>
    <defName>LP_DeathknightWhispers</defName>
    <workerClass>LichPhylactery.ThoughtWorker_DeathknightWhispers</workerClass>
    <stages><li><label>冰冷的铠甲在低语</label><description>死亡骑士铠甲贴着皮肤，冷得像坟墓里的石头，还在耳边低语。</description><baseMoodEffect>-3</baseMoodEffect></li></stages>
  </ThoughtDef>
</Defs>
