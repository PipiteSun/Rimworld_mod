  <!-- ==================== 角色种类 ==================== -->
  <!-- 1.102.0：种族改成原版人类 + 六臂蛇人异种型（不再需要 HAR）。殖民者：开局可在角色编辑里选“六臂蛇人”异种型；深渊仪式束缚、红鹰奴隶商人用这个兵种。
       85% 是女性（MarilithGender 在生成这两个兵种时定性别）。 -->
  <PawnKindDef ParentName="BasePlayerPawnKind">
    <defName>LP_MarilithColonist</defName>
    <label>六臂蛇人殖民者</label>
    <race>Human</race>
    <defaultFactionDef>PlayerColony</defaultFactionDef>
    <combatPower>60</combatPower>
    <useFactionXenotypes>false</useFactionXenotypes>
    <xenotypeSet>
      <xenotypeChances>
        <LP_MarilithKin>1</LP_MarilithKin>
      </xenotypeChances>
    </xenotypeSet>
    <chemicalAddictionChance>0.04</chemicalAddictionChance>
    <apparelTags>
      <li>IndustrialBasic</li>
    </apparelTags>
    <apparelAllowHeadgearChance>0</apparelAllowHeadgearChance>
    <apparelMoney>350~600</apparelMoney>
    <backstoryCryptosleepCommonality>1</backstoryCryptosleepCommonality>
