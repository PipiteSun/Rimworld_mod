  <GeneDef ParentName="LP_MarilithGeneBase">
    <defName>LP_MarilithBlades</defName>
    <label>六臂连击</label>
    <description>需要多于两条手臂。背包里的近战武器会被额外的手臂拿来当副手：每对能用的额外手臂拿一把（最多两把，挑最好的）。主手拿近战武器或空手时，每次普通近战命中后，每把副手各追加一击（伤害按模组设置，默认50%）。装在只有两条手臂的人身上没有效果。</description>
    <iconPath>Marilith/Genes/Blades</iconPath>
    <displayCategory>Violence</displayCategory>
    <biostatCpx>3</biostatCpx>
    <biostatMet>-2</biostatMet>
    <customEffectDescriptions>
      <li>需要多于两条手臂（人类身上无效）。</li>
      <li>副手：背包里品质×DPS最高的近战武器，数量 = 能用的额外手臂对数（最多2）。</li>
      <li>普通近战命中后，每把副手各追加一击；主手拿远程武器时不触发，技能命中不触发。</li>
    </customEffectDescriptions>
    <modExtensions>
      <li Class="LichPhylactery.OffhandExtension">
        <max>2</max>
        <perExtraArmPair>true</perExtraArmPair>
      </li>
    </modExtensions>
  </GeneDef>

  <GeneDef ParentName="LP_MarilithGeneBase">
    <defName>LP_SerpentGlide</defName>
    <label>蛇行</label>
    <description>蛇尾贴着地面滑行，泥地、沼泽和浅水拖不住它：在这些地形上的移动消耗减半。</description>
    <iconPath>Marilith/Genes/Glide</iconPath>
    <displayCategory>Movement</displayCategory>
    <biostatMet>-1</biostatMet>
    <customEffectDescriptions>
      <li>泥地、沼泽、浅水的地形移动消耗减半（不影响寻路的绕行判断）。</li>
    </customEffectDescriptions>
  </GeneDef>

  <GeneDef ParentName="LP_MarilithGeneBase">
    <defName>LP_SerpentConstrict</defName>
    <label>缠绕</label>
    <description>用蛇尾（或长臂）缠住贴身的敌人：对方3秒内动弹不得，每秒受到6点钝伤（按双方体型比修正，×0.5～×2）；缠绕期间自己也不能移动。冷却12小时。</description>
    <iconPath>Marilith/Genes/Constrict</iconPath>
    <displayCategory>Violence</displayCategory>
    <biostatMet>-1</biostatMet>
    <abilities>
      <li>LP_SerpentConstrictAbility</li>
    </abilities>
    <descriptionHyperlinks>
      <AbilityDef>LP_SerpentConstrictAbility</AbilityDef>
    </descriptionHyperlinks>
  </GeneDef>

  <GeneDef ParentName="LP_MarilithGeneBase">
    <defName>LP_BladeStorm</defName>
    <label>剑刃风暴</label>
    <description>所有手臂一起挥舞：对身边1格内的每个敌人，主手和每把能用的副手各攻击一次。冷却2天。副手要有额外的手臂才能用；只有两条手臂时只有主手那一击。</description>
    <iconPath>Marilith/Genes/BladeStorm</iconPath>
    <displayCategory>Violence</displayCategory>
    <biostatMet>-1</biostatMet>
    <abilities>
      <li>LP_BladeStormAbility</li>
    </abilities>
    <descriptionHyperlinks>
      <AbilityDef>LP_BladeStormAbility</AbilityDef>
    </descriptionHyperlinks>
  </GeneDef>

  <GeneDef ParentName="LP_MarilithGeneBase">
    <defName>LP_AbyssalHide</defName>
    <label>深渊之躯</label>
    <description>在深渊的火海与冰窟里长成的鳞甲：受到的火焰、烧伤、冻伤和电击伤害×75%，毒素抗性+50%。</description>
    <iconPath>Marilith/Genes/AbyssalHide</iconPath>
    <displayCategory>ResistanceAndWeakness</displayCategory>
    <biostatMet>-1</biostatMet>
    <damageFactors>
      <Flame>0.75</Flame>
      <Burn>0.75</Burn>
      <Frostbite>0.75</Frostbite>
      <ElectricalBurn>0.75</ElectricalBurn>
    </damageFactors>
    <statOffsets>
      <ToxicResistance>0.5</ToxicResistance>
    </statOffsets>
  </GeneDef>

  <GeneDef ParentName="LP_MarilithGeneBase">
    <defName>LP_ColdBlood</defName>
    <label>冷血</label>
    <description>冷血的身体跟着天气变：环境温度低于0℃时移动速度×85%。</description>
    <iconPath>Marilith/Genes/ColdBlood</iconPath>
    <displayCategory>ResistanceAndWeakness</displayCategory>
    <biostatCpx>1</biostatCpx>
    <biostatMet>2</biostatMet>
    <customEffectDescriptions>
      <li>环境温度低于0℃时移动速度×85%。</li>
    </customEffectDescriptions>
  </GeneDef>

  <!-- 鳞色：蛇人生成时随机一种作为内源基因（青绿40%、墨绿35%、赤金25%），遗传时随父母。 -->
