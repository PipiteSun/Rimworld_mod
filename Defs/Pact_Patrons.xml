  <!-- ==================== 契约状态 ==================== -->
  <HediffDef>
    <defName>LP_PactSigner</defName>
    <label>契约</label>
    <description>和一位异界宗主签下的契约。括号里是宗主和债务（0～3）。债务 1：心情 -6，恩赐给的能力冷却 ×2；债务 2：宗主派讨债者（九狱）或狂猎（妖精），之后每 15 天一次；债务 3：强制执行——签约人被拖进那个位面（巫妖：命匣被收走）。在契约讲台“补偿宗主”可以还债。</description>
    <hediffClass>LichPhylactery.Hediff_PactSigner</hediffClass>
    <isBad>false</isBad>
    <everCurableByItem>false</everCurableByItem>
    <initialSeverity>0.01</initialSeverity>
