    <demands>
      <li><kind>Gathering</kind><label>夏夜的欢宴</label><description>每 15 天举办一次派对或婚礼。</description></li>
      <li><kind>Secret</kind><label>一件秘密</label><description>交出一件秘密：随机两名殖民者互相意见 -20、各自心情 -5（5 天）。</description></li>
      <li><kind>Name</kind><label>一个名字</label><description>随机一名殖民者的名字被收走：改名、心情 -6、社交影响 -20%（10 天）。</description></li>
      <li><kind>Item</kind><label>一件美物</label><description>交出一件品质优秀以上的艺术品。</description><category>Art</category></li>
    </demands>
    <hiddenClausePool>
      <li><kind>NoTreeCut</kind><label>不伐之誓</label><description>殖民者每砍倒一棵树，债务 +1。</description></li>
      <li><kind>Year</kind><label>一年寿命</label><description>每年收走签约人一年寿命（生物年龄 +1）。</description><intervalDays>60</intervalDays></li>
    </hiddenClausePool>
  </LichPhylactery.LP_PatronDef>

