<?xml version="1.0" encoding="utf-8"?>
<!-- 1.55.0 异界契约：七位宗主（九狱四位、妖精两位女王和巫婆集会）、契约状态、恩赐状态与能力、隐藏条款状态、魔能爆、心情、信件。
     宗主的字段见 Source/Pacts.cs 的 LP_PatronDef；恩赐的 workerClass 见 Source/PactBoons.cs。
     条款 kind：SacrificePrisoner / Silver / Item / Gathering / Secret / Name / Year 是偿契要求（Item 的 category：BookOrScroll、Art、SoulCoin）；
     intervalDays > 0 的条款按自己的周期执行（灵魂税、利息、一年寿命）；onExpiry 的在到期时要（迪斯帕特）；其他是特殊规则。 -->
<Defs>
  <!-- ==================== 九狱 ==================== -->
  <LichPhylactery.LP_PatronDef>
    <defName>LP_Patron_Asmodeus</defName>
    <label>阿斯莫蒂尔斯</label>
    <description>九狱之主，第九层涅瑟斯的统治者。他的契约写得最漂亮，也最贵：签下的是灵魂。</description>
    <plane>Hells</plane>
    <term>Soul</term>
    <negotiable>true</negotiable>
    <hiddenCount>2</hiddenCount>
    <reviewDC>18</reviewDC>
    <taintOnSign>0.1</taintOnSign>
    <demandInterval>20~20</demandInterval>
    <iconPath>Pact/Patrons/Asmodeus</iconPath>
    <color>(0.62, 0.12, 0.12)</color>
    <agentLabel>阿斯莫蒂尔斯的代理人</agentLabel>
    <boons>
      <li><key>InfernalMark</key><label>地狱之主的印记</label><description>5 格内的敌对人形心生恐惧：精神崩溃阈值 +15%（每 5 秒刷新）。魔能爆点燃的概率从 20% 提到 40%。</description><workerClass>LichPhylactery.PactBoon_Hediff</workerClass><hediff>LP_Boon_InfernalMark</hediff></li>
      <li><key>HellGuard</key><label>九狱守卫</label><description>能力“召唤角魔”：1 名角魔作为仆从听候差遣 5 天，冷却 15 天。</description><workerClass>LichPhylactery.PactBoon_Ability</workerClass><ability>LP_SummonHornedDevil</ability></li>
      <li><key>Erinyes</key><label>艾林魔</label><description>立即得到 1 名艾林魔束缚者（初始 9 级），终身跟随签约人，服从度不会下降。签约人死亡或契约结束时它回九狱。</description><workerClass>LichPhylactery.PactBoon_Bound</workerClass><kind>LP_HL_Erinyes</kind><count>9</count></li>
    </boons>
    <visibleClauses>
      <li><kind>SacrificePrisoner</kind><label>血祭</label><description>每 20 天处决一名囚犯。</description></li>
    </visibleClauses>
    <demands>
      <li><kind>SacrificePrisoner</kind><label>血祭</label><description>每 20 天处决一名囚犯。</description></li>
    </demands>
    <hiddenClausePool>
      <li><kind>Firstborn</kind><label>长子条款</label><description>签约人的下一个孩子生来就是提夫林；十八岁时有一半的机会被九狱带走。</description></li>
      <li><kind>SoulTax</kind><label>灵魂税</label><description>每季自动收走 3 枚灵魂币，交不出就债务 +1。</description><count>3</count><intervalDays>15</intervalDays></li>
      <li><kind>Hellfire</kind><label>地狱之火</label><description>签约人受到的火焰伤害 ×1.25。</description></li>
    </hiddenClausePool>
  </LichPhylactery.LP_PatronDef>

  <LichPhylactery.LP_PatronDef>
    <defName>LP_Patron_Mephistopheles</defName>
    <label>梅菲斯托菲勒斯</label>
    <description>第八层凯尼亚的冰狱之主，九狱最博学的大公。他收藏知识，也收藏欠他知识的人。</description>
    <plane>Hells</plane>
    <term>Life</term>
    <negotiable>true</negotiable>
    <hiddenCount>2</hiddenCount>
    <reviewDC>18</reviewDC>
    <taintOnSign>0.1</taintOnSign>
    <demandInterval>15~15</demandInterval>
    <iconPath>Pact/Patrons/Mephistopheles</iconPath>
    <color>(0.45, 0.62, 0.8)</color>
    <agentLabel>梅菲斯托菲勒斯的代理人</agentLabel>
    <boons>
      <li><key>IceArcana</key><label>冰狱奥术</label><description>心灵熵上限 +20%；签约人的冰霜伤害（寒冷、冻伤类）命中时额外 +1 层寒气侵体。</description><workerClass>LichPhylactery.PactBoon_Hediff</workerClass><hediff>LP_Boon_IceArcana</hediff></li>
      <li><key>IceGuard</key><label>寒冰守卫</label><description>能力“召唤寒冰魔”：1 名寒冰魔作为仆从听候差遣 5 天（期满正常离开），冷却 15 天。</description><workerClass>LichPhylactery.PactBoon_Ability</workerClass><ability>LP_SummonIceDevil</ability></li>
      <li><key>ForbiddenBooks</key><label>禁书</label><description>签约时和之后每 60 天送来 1 本恶魔学典籍和 1 张随机学派的耐瑟瑞尔秘术残卷。</description><workerClass>LichPhylactery.PactBoon_Books</workerClass><days>60</days></li>
    </boons>
    <visibleClauses>
      <li><kind>Item</kind><label>知识的什一税</label><description>每 15 天交出一本书或一张卷轴。</description><category>BookOrScroll</category></li>
    </visibleClauses>
    <demands>
      <li><kind>Item</kind><label>知识的什一税</label><description>每 15 天交出一本书或一张卷轴。</description><category>BookOrScroll</category></li>
    </demands>
    <hiddenClausePool>
      <li><kind>LongWinter</kind><label>长冬</label><description>每年冬季开始时，殖民地寒潮 10 天。</description></li>
      <li><kind>IceHeart</kind><label>冰心</label><description>签约人的心情始终 -5。</description></li>
      <li><kind>SoulTax</kind><label>灵魂税</label><description>每季自动收走 3 枚灵魂币，交不出就债务 +1。</description><count>3</count><intervalDays>15</intervalDays></li>
    </hiddenClausePool>
  </LichPhylactery.LP_PatronDef>

  <LichPhylactery.LP_PatronDef>
    <defName>LP_Patron_Dispater</defName>
    <label>迪斯帕特</label>
    <description>第二层迪斯的铁城之主，偏执、富有、从不出城。他只签一年的契约，到期时要一大笔银子。</description>
    <plane>Hells</plane>
    <term>Year</term>
    <negotiable>true</negotiable>
    <hiddenCount>2</hiddenCount>
    <reviewDC>18</reviewDC>
    <taintOnSign>0.1</taintOnSign>
    <demandInterval>60~60</demandInterval>
    <iconPath>Pact/Patrons/Dispater</iconPath>
    <color>(0.42, 0.42, 0.46)</color>
    <agentLabel>迪斯帕特的代理人</agentLabel>
    <boons>
      <li><key>IronGold</key><label>铁城之金</label><description>签约时和之后每季空投 1500 银。到期时要还的白银翻倍（12000）。</description><workerClass>LichPhylactery.PactBoon_Drop</workerClass><thing>Silver</thing><count>1500</count><days>15</days><clauseFactor>2</clauseFactor></li>
      <li><key>IronArtisans</key><label>铁城工匠</label><description>签约人活着、在殖民地地图上时，这张地图上的殖民者建造速度 +25%。</description><workerClass>LichPhylactery.PactBoon_ColonyHediff</workerClass><hediff>LP_Boon_IronArtisan</hediff></li>
      <li><key>InfernalForge</key><label>地狱铸炉</label><description>立即空投一座未安装的地狱铸炉：烧灵魂币，能做符文铁砧的所有配方，速度 ×1.5。</description><workerClass>LichPhylactery.PactBoon_Forge</workerClass><thing>LP_InfernalForge</thing></li>
    </boons>
    <visibleClauses>
      <li><kind>Silver</kind><label>铁城的账单</label><description>一年到期时交出 6000 银（选了铁城之金的是 12000）。</description><count>6000</count><onExpiry>true</onExpiry></li>
    </visibleClauses>
    <hiddenClausePool>
      <li><kind>Collateral</kind><label>抵押物</label><description>到期还不上时，殖民地价值最高的一栋建筑被收走。</description></li>
      <li><kind>Interest</kind><label>利息</label><description>每季额外收 500 银，交不出就债务 +1。</description><count>500</count><intervalDays>15</intervalDays></li>
      <li><kind>SoulTax</kind><label>灵魂税</label><description>每季自动收走 3 枚灵魂币，交不出就债务 +1。</description><count>3</count><intervalDays>15</intervalDays></li>
    </hiddenClausePool>
  </LichPhylactery.LP_PatronDef>

  <LichPhylactery.LP_PatronDef>
    <defName>LP_Patron_Glasya</defName>
    <label>格拉西娅</label>
    <description>第六层马尔博格的女主人，阿斯莫蒂尔斯的女儿，九狱最好的律师。没有她解不开的契约——除了她自己的。</description>
    <plane>Hells</plane>
    <term>Life</term>
    <negotiable>true</negotiable>
    <hiddenCount>2</hiddenCount>
    <reviewDC>18</reviewDC>
    <taintOnSign>0.1</taintOnSign>
    <demandInterval>15~15</demandInterval>
    <iconPath>Pact/Patrons/Glasya</iconPath>
    <color>(0.7, 0.32, 0.5)</color>
    <agentLabel>格拉西娅的代理人</agentLabel>
    <boons>
      <li><key>QueenTongue</key><label>女王之舌</label><description>签约人社交影响 +30%，交易价格改善 +15%。</description><workerClass>LichPhylactery.PactBoon_Hediff</workerClass><hediff>LP_Boon_QueenTongue</hediff></li>
      <li><key>SeeClauses</key><label>看穿条款</label><description>殖民地所有其他契约的隐藏条款自动揭开。</description><workerClass>LichPhylactery.PactBoon_SeeClauses</workerClass></li>
      <li><key>Unbind</key><label>解开契约</label><description>立刻解除殖民地里另一份契约，没有任何后果；之后这份契约的代价周期 ×0.75。</description><workerClass>LichPhylactery.PactBoon_Unbind</workerClass></li>
    </boons>
    <visibleClauses>
      <li><kind>Secret</kind><label>秘密</label><description>每 15 天交出一件秘密：随机两名殖民者互相意见 -20、各自心情 -5（5 天）。</description></li>
    </visibleClauses>
    <demands>
      <li><kind>Secret</kind><label>秘密</label><description>每 15 天交出一件秘密：随机两名殖民者互相意见 -20、各自心情 -5（5 天）。</description></li>
    </demands>
    <hiddenClausePool>
      <li><kind>Resale</kind><label>转卖</label><description>签约一年后，契约被转卖给另一位九狱宗主：恩赐保留，代价换成新宗主的。</description></li>
      <li><kind>SoulTax</kind><label>灵魂税</label><description>每季自动收走 3 枚灵魂币，交不出就债务 +1。</description><count>3</count><intervalDays>15</intervalDays></li>
    </hiddenClausePool>
  </LichPhylactery.LP_PatronDef>

