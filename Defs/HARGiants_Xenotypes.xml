  <!-- ==================== 剧本：山脚的弃儿 ==================== -->
  <ScenarioDef ParentName="ScenarioBase">
    <defName>LP_HillOutcasts</defName>
    <label>山脚的弃儿</label>
    <description>一个被族人赶出来的双头巨人、一个丢了羊圈的独眼巨人，和一个不知怎么跟上他们的人类，赶着四只绵羊来到一片山脚下。\n\n他们手里只有两根棍棒、一点钢铁和干粮。双头巨人两个头总在吵架，独眼巨人射不准，可两个大个子干起活来顶好几个人。\n\n建议选丘陵地形：独眼巨人建造快、会锻造，山里的石头和矿脉正合用；羊群能让独眼巨人安心。</description>
    <scenario>
      <summary>一个双头巨人、一个独眼巨人、一个人类和四只绵羊。建议丘陵地图。</summary>
      <parts>

        <li Class="ScenPart_ConfigPage_ConfigureStartingPawns_KindDefs">
          <def>ConfigurePawnsKindDefs</def>
          <pawnChoiceCount>8</pawnChoiceCount>
          <kindCounts>
            <li>
              <kindDef>LP_EttinColonist</kindDef>
              <count>1</count>
              <requiredAtStart>true</requiredAtStart>
            </li>
            <li>
              <kindDef>LP_CyclopsColonist</kindDef>
              <count>1</count>
              <requiredAtStart>true</requiredAtStart>
            </li>
            <li>
              <kindDef>Colonist</kindDef>
              <count>1</count>
            </li>
          </kindCounts>
        </li>

        <li Class="ScenPart_PlayerPawnsArriveMethod">
          <def>PlayerPawnsArriveMethod</def>
          <visible>false</visible>
          <method>Standing</method>
        </li>

        <li Class="ScenPart_StartingAnimal">
          <def>StartingAnimal</def>
          <animalKind>Sheep</animalKind>
          <count>4</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>MeleeWeapon_Club</thingDef>
          <stuff>WoodLog</stuff>
          <count>2</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>Steel</thingDef>
          <count>150</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>Pemmican</thingDef>
          <count>60</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>MedicineHerbal</thingDef>
          <count>15</count>
        </li>

        <li Class="ScenPart_GameStartDialog">
          <def>GameStartDialog</def>
          <text>族人把你们赶下了山。\n\n左头说该往东走，右头说该往西走；独眼巨人一声不吭，只顾数他的四只羊；那个人类小个子一路跟着，赶也赶不走。\n\n现在，这片山脚就是你们的家了。</text>
          <closeSound>GameStartSting</closeSound>
        </li>

      </parts>
    </scenario>
  </ScenarioDef>


</Defs>
