  </LichPhylactery.LP_SubclassDef>
  <LichPhylactery.LP_SubclassDef>
    <defName>LP_Sub_AberrantMind</defName>
    <label>异变心灵</label>
    <description>血里有灵吸怪的影子：安抚崩溃的殖民者、用灵能尖刺伤敌、长出触手，最后能支配一个敌人为你所用。</description>
