  </LichPhylactery.LP_SubclassDef>
  <LichPhylactery.LP_SubclassDef>
    <defName>LP_Sub_Conquest</defName>
    <label>征服之誓</label>
    <description>以恐惧统治。誓言之力每天 1 次（11 级 2 次、15 级 3 次），不耗神恩。戒律：不释放囚犯——殖民地释放囚犯时背誓（1 天内神恩恢复减半、誓言之力不能用；1 天内第三次背誓再加心情 −10）。</description>
    <parent>LP_Class_Paladin</parent><order>1</order><emblem>LP/Classes/Subclass/Emblem_Conquest</emblem><color>(0.55,0.5,0.55)</color>
    <abilities><li><ability>LP_CQ_ConqueringPresence</ability><level>3</level></li><li><ability>LP_CQ_GuidedStrike</ability><level>3</level></li><li><ability>LP_CQ_AuraOfConquest</ability><level>7</level></li>
      <li><ability>LP_CQ_ScornfulRebuke</ability><level>11</level></li><li><ability>LP_CQ_InvincibleConqueror</ability><level>15</level></li></abilities>
  </LichPhylactery.LP_SubclassDef>
  <LichPhylactery.LP_SubclassDef>
    <defName>LP_Sub_Redemption</defName>
    <label>救赎之誓</label>
    <description>以和止战。誓言之力每天 1 次（11 级 2 次、15 级 3 次），不耗神恩。戒律：不亲手杀死倒地的人、囚犯或奴隶（处决也算）——违背就背誓（1 天内神恩恢复减半、誓言之力不能用；1 天内第三次背誓再加心情 −10）。</description>
    <parent>LP_Class_Paladin</parent><order>2</order><emblem>LP/Classes/Subclass/Emblem_Redemption</emblem><color>(0.9,0.92,0.95)</color>
    <abilities><li><ability>LP_RD_EmissaryOfPeace</ability><level>3</level></li><li><ability>LP_RD_RebukeViolent</ability><level>3</level></li><li><ability>LP_RD_AuraOfGuardian</ability><level>7</level></li>
      <li><ability>LP_RD_ProtectiveSpirit</ability><level>11</level></li><li><ability>LP_RD_EmissaryOfRedemption</ability><level>15</level></li><li><ability>LP_RD_Reconcile</ability><level>15</level></li></abilities>
  </LichPhylactery.LP_SubclassDef>

