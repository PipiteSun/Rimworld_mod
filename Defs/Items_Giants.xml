  <!-- ==================== 1.34.0 风暴巨人物品 ==================== -->

  <ThingDef ParentName="ResourceBase">
    <defName>LP_StormOrb</defName>
    <label>风暴宝珠</label>
    <description>一颗封着雷云的水晶球，里面的闪电从来没停过。任何人都能捏碎它：所在地图的天气转为雷雨，并持续1天（不会召下雷击）。在炼金桌用2份位面残渣和10金制作。</description>
    <graphicData>
      <texPath>Giants/Items/StormOrb</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <stackLimit>10</stackLimit>
    <techLevel>Medieval</techLevel>
    <thingCategories><li>Items</li></thingCategories>
    <statBases>
      <MarketValue>260</MarketValue>
      <Mass>0.5</Mass>
      <MaxHitPoints>60</MaxHitPoints>
    </statBases>
    <tradeTags><li>ExoticMisc</li></tradeTags>
    <comps>
      <li Class="CompProperties_Usable">
        <useJob>UseItem</useJob>
        <useLabel>捏碎{0_label}</useLabel>
        <useDuration>120</useDuration>
      </li>
      <li Class="CompProperties_UseEffect">
        <compClass>LichPhylactery.CompUseEffect_StormOrb</compClass>
      </li>
      <li Class="CompProperties_UseEffectDestroySelf" />
    </comps>
  </ThingDef>
  <RecipeDef>
    <defName>LP_MakeStormOrb</defName>
    <label>制作风暴宝珠</label>
    <description>用2份位面残渣和10金制作一颗风暴宝珠。</description>
    <jobString>正在制作风暴宝珠。</jobString>
    <workSpeedStat>LP_AlchemySpeed</workSpeedStat>
    <workSkill>Intellectual</workSkill>
    <effectWorking>Cook</effectWorking>
    <soundWorking>Recipe_Drug</soundWorking>
    <workAmount>2400</workAmount>
    <recipeUsers><li>LP_AlchemyTable</li></recipeUsers>
    <researchPrerequisite>LP_DNDAlchemy</researchPrerequisite>
    <ingredients>
      <li><filter><thingDefs><li>LP_PlanarResidue</li></thingDefs></filter><count>2</count></li>
      <li><filter><thingDefs><li>Gold</li></thingDefs></filter><count>10</count></li>
    </ingredients>
    <fixedIngredientFilter><thingDefs><li>LP_PlanarResidue</li><li>Gold</li></thingDefs></fixedIngredientFilter>
    <products><LP_StormOrb>1</LP_StormOrb></products>
  </RecipeDef>


  <!-- ==================== 1.34.1 云巨人物品 ==================== -->



  <ThingDef ParentName="ResourceBase">
    <defName>LP_SkyAmber</defName>
    <label>天空琥珀</label>
    <description>云端城堡外的高空里才结得出的琥珀，里面封着一缕会流动的云。云巨人拿它当传家宝，放在屋里很漂亮（美观+15）。只有同盟的云巨人奢侈品商队才卖。</description>
    <graphicData>
      <texPath>Giants/Items/SkyAmber</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <stackLimit>10</stackLimit>
    <techLevel>Medieval</techLevel>
    <thingCategories><li>Items</li></thingCategories>
    <statBases>
      <MarketValue>400</MarketValue>
      <Mass>0.3</Mass>
      <Beauty>15</Beauty>
      <MaxHitPoints>80</MaxHitPoints>
    </statBases>
  </ThingDef>
</Defs>
