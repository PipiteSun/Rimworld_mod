<Defs>

  <!-- ==================== 冬狼皮 ==================== -->
  <ThingDef ParentName="LeatherBase">
    <defName>LP_Leather_WinterWolf</defName>
    <label>冬狼皮</label>
    <description>冬狼淡蓝灰色的厚毛皮，毛尖上像挂着霜。比北极狼的皮更保暖，也一样难刺穿。屠宰冬狼得到。</description>
    <possessionCount>20</possessionCount>
    <graphicData>
      <texPath>Giants/Items/WinterWolfLeather</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
    </graphicData>
    <statBases>
      <MarketValue>3.6</MarketValue>
      <StuffPower_Armor_Sharp>1.04</StuffPower_Armor_Sharp>
      <StuffPower_Insulation_Cold>27</StuffPower_Insulation_Cold>
    </statBases>
    <stuffProps>
      <color>(168,190,206)</color>
      <commonality>0.01</commonality>
      <statFactors>
        <Beauty>1.8</Beauty>
      </statFactors>
    </stuffProps>
  </ThingDef>

  <!-- ==================== 霜巨人斧 ==================== -->
  <ThingDef ParentName="BaseMeleeWeapon_Sharp_Quality">
    <defName>LP_FrostGiantAxe</defName>
    <label>霜巨人斧</label>
    <description>霜巨人掠夺者的双刃巨斧，斧刃上永远结着一层霜。劈砍30、钝击14，攻击间隔2.8秒；命中让目标寒霜迟缓4秒（移动速度减半，霜巨人自己免疫）。只有巨人能用。在巨人铁砧用80钢或80寒铁锻造。</description>
    <graphicData>
      <texPath>Giants/Items/FrostGiantAxe</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1.6,1.6)</drawSize>
    </graphicData>
    <uiIconScale>1.1</uiIconScale>
    <techLevel>Medieval</techLevel>
    <costStuffCount>80</costStuffCount>
    <stuffCategories>
      <li>Metallic</li>
    </stuffCategories>
    <weaponTags Inherit="False">
      <li>LP_GiantWeapon</li>
    </weaponTags>
    <statBases>
      <WorkToMake>20000</WorkToMake>
      <Mass>9</Mass>
    </statBases>
    <equippedAngleOffset>-65</equippedAngleOffset>
    <tools>
      <li>
        <label>斧刃</label>
        <capacities>
          <li>Cut</li>
        </capacities>
        <power>30</power>
        <cooldownTime>2.8</cooldownTime>
      </li>
      <li>
        <label>斧柄</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>14</power>
        <cooldownTime>2</cooldownTime>
      </li>
    </tools>
    <recipeMaker><recipeUsers Inherit="False"><li>LP_GiantAnvil</li></recipeUsers><researchPrerequisite>LP_GiantForging</researchPrerequisite></recipeMaker>
    <modExtensions>
      <li Class="LichPhylactery.GiantWeaponExtension" />
    </modExtensions>
  </ThingDef>
  <RecipeDef>
    <defName>LP_MakeFrostGiantAxe</defName>
    <label>锻造霜巨人斧</label>
    <description>用80钢或80寒铁锻造一把霜巨人斧（材料决定斧子的材质）。</description>
    <jobString>正在锻造霜巨人斧。</jobString>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <workSkill>Crafting</workSkill>
    <effectWorking>Smith</effectWorking>
    <soundWorking>Recipe_Smith</soundWorking>
    <workAmount>20000</workAmount>
    <unfinishedThingDef>UnfinishedWeapon</unfinishedThingDef>
    <recipeUsers>
      <li>LP_GiantAnvil</li>
    </recipeUsers>
    <researchPrerequisite>LP_GiantForging</researchPrerequisite>
    <skillRequirements>
      <Crafting>6</Crafting>
    </skillRequirements>
    <ingredients>
      <li><filter><thingDefs><li>Steel</li><li>LP_ColdIron</li></thingDefs></filter><count>80</count></li>
    </ingredients>
    <fixedIngredientFilter><thingDefs><li>Steel</li><li>LP_ColdIron</li></thingDefs></fixedIngredientFilter>
    <productHasIngredientStuff>true</productHasIngredientStuff>
    <products><LP_FrostGiantAxe>1</LP_FrostGiantAxe></products>
  </RecipeDef>

  <!-- ==================== 冬狼皮大氅 ==================== -->
  <ThingDef ParentName="ApparelMakeableBase">
    <defName>LP_WinterWolfCloak</defName>
    <label>冬狼皮大氅</label>
    <description>用整张冬狼皮缝成的大氅，只有巨人披得起来。保暖+40，防护和厚布衣差不多；穿在外层，里面还能套锻工外衣。只有巨人能穿。在缝纫台用60张冬狼皮缝制。</description>
    <graphicData>
      <texPath>Giants/Items/WinterWolfCloak</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <techLevel>Neolithic</techLevel>
    <thingCategories><li>Apparel</li></thingCategories>
    <costList><LP_Leather_WinterWolf>60</LP_Leather_WinterWolf></costList>
    <statBases>
      <MaxHitPoints>220</MaxHitPoints>
      <WorkToMake>14000</WorkToMake>
      <Mass>4</Mass>
      <Flammability>1</Flammability>
      <ArmorRating_Sharp>0.2</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.06</ArmorRating_Blunt>
      <ArmorRating_Heat>0.12</ArmorRating_Heat>
      <Insulation_Cold>40</Insulation_Cold>
      <EquipDelay>3</EquipDelay>
    </statBases>
    <recipeMaker>
      <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
      <workSkill>Crafting</workSkill>
      <effectWorking>Tailor</effectWorking>
      <soundWorking>Recipe_Tailor</soundWorking>
      <recipeUsers Inherit="False">
        <li>HandTailoringBench</li>
        <li>ElectricTailoringBench</li>
        <li>LP_ArcaneLoom</li>
      </recipeUsers>
