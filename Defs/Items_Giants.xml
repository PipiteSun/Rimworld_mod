      <layers>
        <li>Shell</li>
      </layers>
      <tags>
        <li>Neolithic</li>
      </tags>
      <defaultOutfitTags>
        <li>Worker</li>
        <li>Soldier</li>
      </defaultOutfitTags>
    </apparel>
    <modExtensions>
      <li Class="LichPhylactery.GiantApparelExtension"><mood>2</mood></li>
    </modExtensions>
  </ThingDef>

  <!-- ==================== 霜巨人号角 ==================== -->
  <ThingDef ParentName="LP_AccessoryBase">
    <defName>LP_FrostGiantHorn</defName>
    <label>霜巨人号角</label>
    <description>用巨兽的长牙挖空做成、箍着寒铁的战号，挂在腰间。霜巨人戴着它就能吹响“冬之号角”：15格内的友方60秒内近战命中+15%、不会被吓倒，冬狼另外“狂猎”（移动速度×130%）。别人戴着只能吹出“狂猎号角”，只对冬狼有效。冷却1天。在手工制作点用1根象牙（或犀牛角、猛犸象牙）和10寒铁制作。</description>
    <graphicData><texPath>Giants/Items/FrostGiantHorn</texPath><graphicClass>Graphic_Single</graphicClass></graphicData>
    <statBases><MarketValue>700</MarketValue><Mass>1.2</Mass></statBases>
    <apparel><bodyPartGroups><li>Waist</li></bodyPartGroups></apparel>
    <comps>
      <li Class="LichPhylactery.CompProperties_GrantAbility"><ability>LP_WinterHornCall</ability><notForRace>FrostGiant</notForRace></li>
    </comps>
  </ThingDef>
  <RecipeDef>
    <defName>LP_MakeFrostGiantHorn</defName>
    <label>制作霜巨人号角</label>
    <description>用1根象牙（或犀牛角、猛犸象牙）和10寒铁制作一支霜巨人号角。</description>
    <jobString>正在制作霜巨人号角。</jobString>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <workSkill>Crafting</workSkill>
    <effectWorking>Smith</effectWorking>
    <soundWorking>Recipe_Smith</soundWorking>
    <workAmount>3000</workAmount>
    <recipeUsers><li>CraftingSpot</li></recipeUsers>
    <ingredients>
      <li><filter><thingDefs><li>ElephantTusk</li><li>ThrumboHorn</li><li MayRequire="Ludeon.RimWorld.Odyssey">MastodonTusk</li></thingDefs></filter><count>1</count></li>
      <li><filter><thingDefs><li>LP_ColdIron</li></thingDefs></filter><count>10</count></li>
    </ingredients>
    <fixedIngredientFilter><thingDefs><li>ElephantTusk</li><li>ThrumboHorn</li><li MayRequire="Ludeon.RimWorld.Odyssey">MastodonTusk</li><li>LP_ColdIron</li></thingDefs></fixedIngredientFilter>
    <products><LP_FrostGiantHorn>1</LP_FrostGiantHorn></products>
  </RecipeDef>

