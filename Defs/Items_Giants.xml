  <ThingDef ParentName="ResourceBase">
    <defName>LP_StormOrb</defName>
    <label>风暴宝珠</label>
    <description>一颗封着雷云的水晶球，里面的闪电从来没停过。任何人都能捏碎它：所在地图的天气转为雷雨，并持续1天（不会召下雷击）。在炼金桌用2份位面残渣和10金制作。</description>
    <graphicData>
      <texPath>Giants/Items/StormOrb</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <stackLimit>10</stackLimit>
    <techLevel>Medieval</techLevel>
    <thingCategories><li>Items</li></thingCategories>
    <statBases>
      <MarketValue>260</MarketValue>
