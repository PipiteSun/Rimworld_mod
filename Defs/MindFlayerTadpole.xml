<?xml version="1.0" encoding="utf-8"?>
<!-- 1.17.0 夺心魔蝌蚪：物品、植入/摘除手术、寄生五阶段、化形。 -->
<Defs>
  <ThingDef ParentName="ResourceBase">
    <defName>LP_Tadpole</defName>
    <label>夺心魔蝌蚪</label>
    <description>一条滑腻的紫色小蝌蚪，在罐子里不停扭动。通过手术把它放进人形生物的颅腔，它会钻进大脑，在几天内把宿主改造成新的夺心魔（化形）。化形完成的夺心魔加入植入者的阵营。\n\n火巨人的熔火之躯会烫死蝌蚪；巫妖、死灵造物和机械体没有活着的大脑；巨魔的再生会减慢并排出它；心灵失聪者的大脑会让它饿死；心智抗性会拖慢化形。离开宿主的蝌蚪活不过15天。</description>
    <graphicData>
      <texPath>MindFlayer/Items/Tadpole</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>0.7</drawSize>
    </graphicData>
    <stackLimit>10</stackLimit>
    <healthAffectsPrice>false</healthAffectsPrice>
    <tickerType>Rare</tickerType>
    <statBases>
      <MaxHitPoints>20</MaxHitPoints>
      <MarketValue>350</MarketValue>
      <Mass>0.1</Mass>
      <Flammability>1</Flammability>
      <DeteriorationRate>0</DeteriorationRate>
    </statBases>
    <thingCategories>
      <li>Manufactured</li>
    </thingCategories>
    <tradeability>None</tradeability>
    <comps>
      <li Class="CompProperties_Rottable">
        <daysToRotStart>15</daysToRotStart>
        <rotDestroys>true</rotDestroys>
      </li>
    </comps>
  </ThingDef>

  <RecipeDef ParentName="SurgeryFlesh">
    <defName>LP_ImplantTadpole</defName>
    <label>植入夺心魔蝌蚪</label>
    <description>把一条夺心魔蝌蚪放进目标的颅腔。蝌蚪会在约5天内（模组设置可调）把宿主化形为夺心魔，化形后加入实施手术者的阵营。对不情愿的人这是暴行。</description>
    <workerClass>LichPhylactery.Recipe_ImplantTadpole</workerClass>
    <jobString>正在给TargetA植入夺心魔蝌蚪。</jobString>
    <workAmount>1500</workAmount>
    <targetsBodyPart>false</targetsBodyPart>
    <isViolation>true</isViolation>
    <anesthetize>true</anesthetize>
    <surgerySuccessChanceFactor>99</surgerySuccessChanceFactor>
    <recipeUsers>
      <li>Human</li>
    </recipeUsers>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>LP_Tadpole</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>LP_Tadpole</li>
      </thingDefs>
    </fixedIngredientFilter>
  </RecipeDef>
  <RecipeDef ParentName="SurgeryFlesh">
    <defName>LP_RemoveTadpole</defName>
    <label>摘除夺心魔蝌蚪</label>
    <description>开颅取出寄生在大脑里的夺心魔蝌蚪。化形完成之前都可以摘除，蝌蚪会在取出时死去。</description>
    <workerClass>Recipe_RemoveHediff</workerClass>
    <jobString>正在从TargetA的大脑里摘除蝌蚪。</jobString>
    <successfullyRemovedHediffMessage>{0}成功从{1}的大脑里摘除了夺心魔蝌蚪。</successfullyRemovedHediffMessage>
    <workAmount>2500</workAmount>
    <removesHediff>LP_TadpoleParasite</removesHediff>
    <targetsBodyPart>true</targetsBodyPart>
    <isViolation>false</isViolation>
    <anesthetize>true</anesthetize>
    <recipeUsers>
      <li>Human</li>
    </recipeUsers>
    <ingredients>
      <li>
        <filter>
          <categories>
            <li>Medicine</li>
          </categories>
        </filter>
        <count>2</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <categories>
        <li>Medicine</li>
      </categories>
    </fixedIngredientFilter>
  </RecipeDef>

  <HediffDef>
    <defName>LP_TadpoleParasite</defName>
    <label>夺心魔蝌蚪</label>
    <description>一条夺心魔蝌蚪寄生在大脑里，正一点点改写宿主。进度到100%时宿主化形为夺心魔。可以通过手术摘除。</description>
    <hediffClass>LichPhylactery.Hediff_Tadpole</hediffClass>
    <defaultLabelColor>(0.75, 0.5, 0.9)</defaultLabelColor>
    <isBad>true</isBad>
    <everCurableByItem>false</everCurableByItem>
    <initialSeverity>0.001</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <stages>
      <li>
        <label>潜伏</label>
      </li>
      <li>
        <minSeverity>0.2</minSeverity>
        <label>触须</label>
        <statOffsets><PsychicSensitivity>0.1</PsychicSensitivity></statOffsets>
      </li>
      <li>
        <minSeverity>0.4</minSeverity>
        <label>侵蚀</label>
        <statOffsets><PsychicSensitivity>0.2</PsychicSensitivity></statOffsets>
        <capMods>
          <li><capacity>Consciousness</capacity><offset>-0.05</offset></li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.6</minSeverity>
        <label>改写</label>
        <statOffsets><PsychicSensitivity>0.3</PsychicSensitivity></statOffsets>
        <capMods>
          <li><capacity>Consciousness</capacity><offset>-0.1</offset></li>
          <li><capacity>Talking</capacity><offset>-0.2</offset></li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.8</minSeverity>
        <label>化形</label>
        <statOffsets><PsychicSensitivity>0.4</PsychicSensitivity></statOffsets>
        <capMods>
          <li><capacity>Consciousness</capacity><offset>-0.15</offset></li>
          <li><capacity>Talking</capacity><offset>-0.4</offset></li>
          <li><capacity>Eating</capacity><offset>-0.2</offset></li>
        </capMods>
      </li>
    </stages>
  </HediffDef>
  <ThoughtDef>
    <defName>LP_TadpoleParasite</defName>
    <workerClass>ThoughtWorker_Hediff</workerClass>
    <hediff>LP_TadpoleParasite</hediff>
    <stages>
      <li IsNull="True" />
      <li>
        <label>脑中有东西</label>
        <description>脑袋里总有东西在动，偶尔能听见不属于我的念头。</description>
        <baseMoodEffect>-3</baseMoodEffect>
      </li>
      <li>
        <label>头痛欲裂</label>
        <description>有什么东西在啃我的脑子。我越来越记不清自己是谁。</description>
        <baseMoodEffect>-8</baseMoodEffect>
      </li>
      <li>
        <label>自我在溶解</label>
        <description>我的念头正在被改写……</description>
        <baseMoodEffect>-12</baseMoodEffect>
      </li>
      <li>
        <label>即将化形</label>
        <description>……</description>
        <baseMoodEffect>-15</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <BackstoryDef>
    <defName>LP_Ceremorphed</defName>
    <slot>Adulthood</slot>
    <title>化形者</title>
    <titleShort>化形者</titleShort>
    <baseDesc>[PAWN_nameDef]曾经是一个普通人，直到一条夺心魔蝌蚪钻进了[PAWN_possessive]的大脑。化形之后，旧日的记忆只剩下一半，性格也被彻底改写；如今[PAWN_pronoun]是一个以大脑为食的夺心魔。</baseDesc>
    <shuffleable>false</shuffleable>
    <spawnCategories><li>LP_MindFlayerOnly</li></spawnCategories>
  </BackstoryDef>
  <PawnRelationDef>
    <defName>LP_Ceremorph</defName>
    <label>化形植入者</label>
    <importance>60</importance>
    <opinionOffset>15</opinionOffset>
    <reflexive>false</reflexive>
    <implied>false</implied>
  </PawnRelationDef>
</Defs>
