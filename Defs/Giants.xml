<?xml version="1.0" encoding="utf-8"?>
<!-- 1.30.0 巨人通用层：合身的巨人之衣、阶序心情（Source/GiantKin.cs）、火巨人与霜巨人的世仇（共享组件 RacialRelationDef）。 -->
<Defs>

  <!-- ==================== 合身的巨人之衣 ==================== -->
  <ThoughtDef>
    <defName>LP_GiantAttire</defName>
    <workerClass>LichPhylactery.ThoughtWorker_GiantAttire</workerClass>
    <validWhileDespawned>true</validWhileDespawned>
    <stages>
      <li>
        <label>合身的巨人之衣</label>
        <description>为巨人缝制、锻造的衣甲，终于不用再挤在凡人的布片里了。</description>
        <baseMoodEffect>2</baseMoodEffect>
      </li>
      <li>
        <label>合身的巨人之衣（两件）</label>
        <description>为巨人缝制、锻造的衣甲，终于不用再挤在凡人的布片里了。</description>
        <baseMoodEffect>4</baseMoodEffect>
      </li>
      <li>
        <label>合身的巨人之衣（三件）</label>
        <description>从头到脚都是巨人的衣甲，走起路来像个真正的巨人。</description>
        <baseMoodEffect>6</baseMoodEffect>
      </li>
      <li>
        <label>熔核禁卫</label>
        <description>炉心战盔、熔核重甲、熔核破城锤，一样不缺。氏族的禁卫就该是这个样子。</description>
        <baseMoodEffect>8</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <!-- ==================== 阶序（Ordning） ==================== -->
  <ThoughtDef>
    <defName>LP_OrdningAbove</defName>
    <workerClass>LichPhylactery.ThoughtWorker_OrdningAbove</workerClass>
    <stages>
      <li>
        <label>阶序井然</label>
        <description>这里有地位比我更高的巨人。每个巨人都知道自己在阶序里的位置，这让人安心。</description>
        <baseMoodEffect>3</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>
  <ThoughtDef>
    <defName>LP_OrdningBelow</defName>
    <workerClass>LichPhylactery.ThoughtWorker_OrdningBelow</workerClass>
    <stages>
      <li>
        <label>统领众巨</label>
        <description>这里有阶序比我低的巨人，他们理应听我的。</description>
        <baseMoodEffect>2</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>
  <ThoughtDef>
    <defName>LP_ClanHead</defName>
    <workerClass>LichPhylactery.ThoughtWorker_ClanHead</workerClass>
    <stages>
      <li>
        <label>氏族之首</label>
        <description>论刀斧、论手艺，族人里没人比得上我。我就是这个氏族的首领。</description>
        <baseMoodEffect>3</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>
  <ThoughtDef>
    <defName>LP_GiantTongue</defName>
    <workerClass>LichPhylactery.ThoughtWorker_GiantTongue</workerClass>
    <stages>
      <li>
        <label>同族之语</label>
        <description>这里还有别的巨人，可以用巨人的语言痛快地说话了。</description>
        <baseMoodEffect>2</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <!-- ==================== 世仇：火巨人与霜巨人（同住60天后和解） ==================== -->
  <ThoughtDef>
    <defName>LP_RacialRelation_FireFrost</defName>
    <workerClass>LichPhylactery.ThoughtWorker_DNDRacialRelation</workerClass>
    <stages>
      <li>
        <label>世仇（霜巨人）</label>
        <description>冰原上来的霜巨人，我们两族打了几千年的仗。和这种家伙住在一起，炉火都冷了三分。</description>
        <baseMoodEffect>-5</baseMoodEffect>
      </li>
      <li>
        <label>化敌为友（霜巨人）</label>
        <description>一起熬过了这么多日子，那个霜巨人也没那么讨厌了。</description>
        <baseMoodEffect>2</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>
  <LichPhylactery.RacialRelationDef>
    <defName>LP_Relation_FireFrost</defName>
    <label>火巨人看霜巨人</label>
    <observer>LP_FireGiant</observer>
    <target>LP_FrostGiant</target>
    <thought>LP_RacialRelation_FireFrost</thought>
    <daysToAccept>60</daysToAccept>
  </LichPhylactery.RacialRelationDef>
  <ThoughtDef>
    <defName>LP_RacialRelation_FrostFire</defName>
    <workerClass>LichPhylactery.ThoughtWorker_DNDRacialRelation</workerClass>
    <stages>
      <li>
        <label>世仇（火巨人）</label>
        <description>满身炉灰的火巨人，自以为在阶序里高我们一头。和这种家伙住在一起，连雪都化成了泥。</description>
        <baseMoodEffect>-5</baseMoodEffect>
      </li>
      <li>
        <label>化敌为友（火巨人）</label>
        <description>一起熬过了这么多日子，那个火巨人也没那么讨厌了。</description>
        <baseMoodEffect>2</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>
  <LichPhylactery.RacialRelationDef>
    <defName>LP_Relation_FrostFire</defName>
    <label>霜巨人看火巨人</label>
    <observer>LP_FrostGiant</observer>
    <target>LP_FireGiant</target>
    <thought>LP_RacialRelation_FrostFire</thought>
    <daysToAccept>60</daysToAccept>
  </LichPhylactery.RacialRelationDef>
</Defs>
