<?xml version="1.0" encoding="utf-8"?>
<!-- DND 怪物第二批：锈蚀怪、凝胶怪、石化蜥、蝎尾狮、掘地兽、腐尸爬虫。
     贴图是自己画的（ArtSource/RaceArt/draw_wildmonsters.py），招牌规则见 Source/WildMonsters.cs，野外刷新见 Patches/WildMonsters.xml。 -->
<Defs>

  <!-- ========== 状态 ========== -->

  <HediffDef>
    <defName>LP_Engulfed</defName>
    <label>被吞没</label>
    <description>被凝胶怪整个裹进了透明的胶体里，动弹不得、被它带着走，每秒都被酸液灼伤。打倒凝胶怪就能脱身，最多困住6秒。</description>
    <hediffClass>LichPhylactery.Hediff_Engulfed</hediffClass>
    <defaultLabelColor>(0.55, 0.9, 0.6)</defaultLabelColor>
    <isBad>true</isBad>
    <everCurableByItem>false</everCurableByItem>
  </HediffDef>

  <HediffDef>
    <defName>LP_BasiliskGaze</defName>
    <label>石化中</label>
    <description>和石化蜥对上了眼，四肢正从末端开始变僵、发灰。越僵走得越慢；完全僵住时要靠体质撑过去，撑不过去就会变成石头。不再被注视就会慢慢缓过来。瞎了的人不受影响。</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.75, 0.75, 0.7)</defaultLabelColor>
    <isBad>true</isBad>
    <initialSeverity>0.1</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-72</severityPerDay>
      </li>
    </comps>
    <stages>
      <li>
        <label>发僵</label>
        <statFactors><MoveSpeed>0.85</MoveSpeed></statFactors>
      </li>
      <li>
        <minSeverity>0.5</minSeverity>
        <label>半身僵硬</label>
        <statFactors><MoveSpeed>0.6</MoveSpeed></statFactors>
        <capMods><li><capacity>Manipulation</capacity><offset>-0.2</offset></li></capMods>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>LP_BasiliskPetrified</defName>
    <label>石化</label>
    <description>在石化蜥的凝视下变成了石头：半天之内一动不动，之后石皮才会剥落。驱散粉尘可以立刻解除。</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>true</isBad>
    <defaultLabelColor>(0.7, 0.7, 0.7)</defaultLabelColor>
    <comps><li Class="HediffCompProperties_Disappears"><disappearsAfterTicks>30000</disappearsAfterTicks><showRemainingTime>true</showRemainingTime></li></comps>
    <stages><li><capMods><li><capacity>Moving</capacity><setMax>0</setMax></li><li><capacity>Manipulation</capacity><setMax>0.05</setMax></li></capMods></li></stages>
  </HediffDef>

  <HediffDef>
    <defName>LP_CrawlerToxin</defName>
    <label>腐尸爬虫毒素</label>
    <description>腐尸爬虫的触须分泌的麻痹毒素。积累得越多，身体越麻木；积满时全身麻痹10秒。毒素几个小时内就会代谢掉。</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.85, 0.6, 0.65)</defaultLabelColor>
    <isBad>true</isBad>
    <maxSeverity>1</maxSeverity>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-4</severityPerDay>
      </li>
    </comps>
    <stages>
      <li>
        <label>刺麻</label>
        <statFactors><MoveSpeed>0.85</MoveSpeed></statFactors>
      </li>
      <li>
        <minSeverity>0.5</minSeverity>
        <label>麻木</label>
        <statFactors><MoveSpeed>0.6</MoveSpeed></statFactors>
        <capMods><li><capacity>Manipulation</capacity><offset>-0.3</offset></li></capMods>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>LP_CrawlerParalysis</defName>
    <label>全身麻痹</label>
    <description>腐尸爬虫的毒素积满了，全身麻痹倒地，10秒后才能重新动弹。</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>true</isBad>
    <defaultLabelColor>(0.85, 0.6, 0.65)</defaultLabelColor>
    <comps><li Class="HediffCompProperties_Disappears"><disappearsAfterTicks>600</disappearsAfterTicks><showRemainingTime>true</showRemainingTime></li></comps>
    <stages><li><capMods><li><capacity>Moving</capacity><setMax>0</setMax></li><li><capacity>Manipulation</capacity><setMax>0.05</setMax></li></capMods></li></stages>
  </HediffDef>

