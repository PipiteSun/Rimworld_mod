      <foodType>OmnivoreAnimal</foodType>
      <predator>true</predator>
      <maxPreyBodySize>2</maxPreyBodySize>
      <trainability>None</trainability>
      <meatLabel>凝胶块</meatLabel>
      <lifeStageAges>
        <li><def>AnimalBaby</def><minAge>0</minAge></li>
        <li><def>AnimalJuvenile</def><minAge>0.5</minAge></li>
        <li>
          <def>AnimalAdult</def><minAge>1</minAge>
