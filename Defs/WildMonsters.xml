    <statBases>
      <MoveSpeed>4.2</MoveSpeed>
      <MarketValue>350</MarketValue>
      <Wildness>0.7</Wildness>
      <ArmorRating_Sharp>0.25</ArmorRating_Sharp>
    </statBases>
    <race>
      <body>BeetleLike</body>
      <baseBodySize>1.0</baseBodySize>
      <baseHealthScale>1.3</baseHealthScale>
      <baseHungerRate>0.3</baseHungerRate>
      <foodType>OmnivoreAnimal</foodType>
      <trainability>Intermediate</trainability>
      <leatherDef>Leather_Lizard</leatherDef>
      <meatLabel>锈蚀怪肉</meatLabel>
      <manhunterOnDamageChance>0.3</manhunterOnDamageChance>
      <gestationPeriodDays>12</gestationPeriodDays>
      <litterSizeCurve><points><li>(0.5, 0)</li><li>(1, 1)</li><li>(1.5, 0.5)</li><li>(2, 0)</li></points></litterSizeCurve>
      <lifeStageAges>
        <li><def>AnimalBaby</def><minAge>0</minAge></li>
        <li><def>AnimalJuvenile</def><minAge>0.25</minAge></li>
        <li>
          <def>AnimalAdult</def><minAge>0.6</minAge>
          <soundWounded>Pawn_Megascarab_Wounded</soundWounded>
          <soundDeath>Pawn_Megascarab_Death</soundDeath>
