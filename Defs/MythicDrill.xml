<?xml version="1.0" encoding="utf-8"?>
<!-- 1.101.0 秘金深钻：照原版深层钻机（通电、采矿工作、站在交互格钻，可以搬走），不需要深层矿藏，每份随机出秘银或精金。
     研究“秘金深掘”在 Research.xml。代码在 Source/MythicDrill.cs。 -->
<Defs>
  <ThingDef ParentName="BuildingBase">
    <defName>LP_MythicDrill</defName>
    <label>秘金深钻</label>
    <description>矮人样式的深钻：钻杆上刻着寻金符文，在白银探针的引导下穿过岩层，去够那些埋在地壳最深处、地图上看不到的秘银与精金细脉。要通电，并由一名小人在采矿工作里操作；钻探速度和产量按操作者的深层钻探速度、采矿产量计算，和原版深层钻机一样。\n\n不需要深层矿藏，放在哪里都能钻，也可以随时搬走。每钻满一份（原版深层钻机的 1.5 倍工作量）：75% 得到 7 份秘银，25% 得到 3 份精金；矮人操作时秘银翻倍。和原版深层钻机一样会招来虫族。</description>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <texPath>Things/Building/LP_MythicDrill</texPath>
      <drawSize>(2,2)</drawSize>
      <drawRotated>false</drawRotated>
      <shadowData>
        <volume>(0.52, 0.53, 0.09)</volume>
        <offset>(0,0,-0.43)</offset>
      </shadowData>
    </graphicData>
    <size>(1,1)</size>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <fillPercent>0.5</fillPercent>
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <designationCategory>Production</designationCategory>
    <rotatable>true</rotatable>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <constructionSkillPrerequisite>6</constructionSkillPrerequisite>
    <uiIconOffset>(0, 0.03)</uiIconOffset>
    <uiIconScale>0.85</uiIconScale>
    <minifiedDef>MinifiedThing</minifiedDef>
    <building>
      <uninstallWork>1800</uninstallWork>
      <buildingTags>
        <li>Production</li>
      </buildingTags>
      <destroySound>BuildingDestroyed_Metal_Small</destroySound>
    </building>
    <thingCategories>
      <li>BuildingsProduction</li>
    </thingCategories>
    <costList>
      <Steel>150</Steel>
      <Silver>40</Silver>
      <ComponentIndustrial>4</ComponentIndustrial>
    </costList>
    <placeWorkers>
      <li>PlaceWorker_PreventInteractionSpotOverlap</li>
      <li>PlaceWorker_InvalidOverSubstructure</li>
    </placeWorkers>
    <researchPrerequisites>
      <li>LP_Research_MythicDrilling</li>
    </researchPrerequisites>
    <statBases>
      <MaxHitPoints>400</MaxHitPoints>
      <WorkToBuild>14000</WorkToBuild>
      <Flammability>0.5</Flammability>
      <Beauty>-20</Beauty>
      <Mass>45</Mass>
    </statBases>
    <comps>
      <li Class="CompProperties_Forbiddable"/>
      <li Class="CompProperties_Flickable"/>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>300</basePowerConsumption>
      </li>
      <li Class="LichPhylactery.CompProperties_MythicDrill" />
      <li Class="CompProperties_CreatesInfestations" />
    </comps>
  </ThingDef>

  <JobDef>
    <defName>LP_OperateMythicDrill</defName>
    <driverClass>LichPhylactery.JobDriver_OperateMythicDrill</driverClass>
    <reportString>正在TargetA钻探秘金。</reportString>
    <allowOpportunisticPrefix>true</allowOpportunisticPrefix>
  </JobDef>

  <WorkGiverDef>
    <defName>LP_DrillMythic</defName>
    <label>操作秘金深钻</label>
    <giverClass>LichPhylactery.WorkGiver_MythicDrill</giverClass>
    <workType>Mining</workType>
    <priorityInType>49</priorityInType>
    <verb>钻探</verb>
    <gerund>钻探秘金</gerund>
    <requiredCapacities>
      <li>Manipulation</li>
    </requiredCapacities>
    <canBeDoneByMechs>false</canBeDoneByMechs>
  </WorkGiverDef>
</Defs>
