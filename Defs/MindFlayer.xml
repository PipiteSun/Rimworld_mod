<?xml version="1.0" encoding="utf-8"?>
<!-- 1.17.0 夺心魔：异种型、脑髓、吞噬大脑、心灵震爆。外貌为原版无发+紫色皮肤，脑髓代谢基因另加面部触须。 -->
<Defs>
  <XenotypeDef>
    <defName>LP_MindFlayer</defName>
    <label>夺心魔</label>
    <description>章鱼头的灵能掠食者，以智慧生物的大脑为食。夺心魔不会生育，也不会把血脉传给后代：新的夺心魔只能由蝌蚪寄生在人形生物的大脑里，经过"化形"长成。它们心灵极其敏锐、学得飞快、在黑暗中视物，却怕阳光、身体脆弱、相貌骇人、不擅交际。夺心魔靠"脑髓"维生：脑髓每天流失，必须吞噬大脑补充，耗尽时会陷入脑饥。</description>
    <descriptionShort>不可遗传的灵能掠食者。吞噬大脑补充脑髓，能用心灵震爆击晕敌人；心灵极敏锐、学得快、能夜视；怕阳光、脆弱、丑陋、不育。</descriptionShort>
    <iconPath>MindFlayer/Xenotype</iconPath>
    <inheritable>false</inheritable>
    <combatPowerFactor>1.3</combatPowerFactor>
    <factionlessGenerationWeight>0</factionlessGenerationWeight>
    <genes>
      <li>LP_Cerebrum</li>
      <li>LP_MindFlayerSterile</li>
      <li>LP_PsionicSense</li>
      <li>LP_HiveLink</li>
      <li>PsychicAbility_Extreme</li>
      <li>Learning_Fast</li>
      <li>AptitudeStrong_Intellectual</li>
      <li>AptitudePoor_Social</li>
      <li>UVSensitivity_Intense</li>
      <li>DarkVision</li>
      <li>Beauty_VeryUgly</li>
      <li>Hair_BaldOnly</li>
      <li>Beard_NoBeardOnly</li>
      <li>Skin_Purple</li>
      <li>Delicate</li>
    </genes>
  </XenotypeDef>

  <GeneDef>
    <defName>LP_Cerebrum</defName>
    <label>脑髓代谢</label>
    <description>夺心魔的本源。提供"脑髓"资源条（0～100）：每天流失8点，只能靠吞噬大脑补充。脑髓低于30时开始虚弱，低于10时严重衰弱，归零时陷入脑饥，可能失控狂乱。吞噬一个倒地的人形生物可获得（20+3×智识等级）×其心灵敏感度点脑髓（最多80），并吸收其最高技能20%的经验；动物只给3～10点；死亡6小时内的新鲜人形尸体给三分之一。</description>
    <geneClass>LichPhylactery.Gene_Cerebrum</geneClass>
    <resourceGizmoType>LichPhylactery.GeneGizmo_CerebrumResource</resourceGizmoType>
    <resourceLabel>脑髓</resourceLabel>
    <resourceGizmoThresholds>
      <li>0.1</li>
      <li>0.3</li>
    </resourceGizmoThresholds>
    <showGizmoOnWorldView>true</showGizmoOnWorldView>
    <showGizmoWhenDrafted>true</showGizmoWhenDrafted>
    <resourceDescription>夺心魔赖以维生的脑髓。每天流失8点，靠吞噬大脑补充；心灵能力也消耗脑髓。</resourceDescription>
    <iconPath>MindFlayer/Genes/Cerebrum</iconPath>
    <displayCategory>Archite</displayCategory>
    <selectionWeight>0</selectionWeight>
    <biostatCpx>4</biostatCpx>
    <biostatMet>-2</biostatMet>
    <biostatArc>2</biostatArc>
    <abilities>
      <li>LP_DevourBrain</li>
      <li>LP_MindBlast</li>
      <li>LP_Dominate</li>
      <li>LP_TelekineticThrow</li>
      <li>LP_Unseen</li>
      <li>LP_PsychicStorm</li>
    </abilities>
    <descriptionHyperlinks>
      <AbilityDef>LP_DevourBrain</AbilityDef>
      <AbilityDef>LP_MindBlast</AbilityDef>
      <AbilityDef>LP_Dominate</AbilityDef>
      <AbilityDef>LP_TelekineticThrow</AbilityDef>
      <AbilityDef>LP_Unseen</AbilityDef>
      <AbilityDef>LP_PsychicStorm</AbilityDef>
    </descriptionHyperlinks>
    <renderNodeProperties>
      <li>
        <nodeClass>PawnRenderNode_AttachmentHead</nodeClass>
        <workerClass>PawnRenderNodeWorker_FlipWhenCrawling</workerClass>
        <texPath>MindFlayer/Tentacles/FaceTentacles</texPath>
        <colorType>Skin</colorType>
        <parentTagDef>Head</parentTagDef>
        <visibleFacing><li>South</li><li>East</li><li>West</li></visibleFacing>
        <rotDrawMode>Fresh, Rotting</rotDrawMode>
        <baseLayer>52</baseLayer>
      </li>
    </renderNodeProperties>
    <customEffectDescriptions>
      <li>脑髓上限100，每天流失8点；低于30虚弱，低于10衰弱，归零脑饥（可在模组设置中关闭脑饥狂乱）。</li>
      <li>吞噬大脑：人形（20+3×智识）×心灵敏感度，最多80；动物3～10；6小时内的新鲜人形尸体给三分之一。</li>
      <li>吞噬会摧毁目标的大脑：巨魔不会复活，尸体也不再完整。巫妖与死灵造物没有活着的大脑，机械体和心灵失聪者无法吞噬。</li>
    </customEffectDescriptions>
  </GeneDef>
  <GeneDef>
    <defName>LP_MindFlayerSterile</defName>
    <label>夺心魔不育</label>
    <description>夺心魔无法生育。新的夺心魔只能由蝌蚪寄生化形而来。</description>
    <iconPath>MindFlayer/Genes/Sterile</iconPath>
    <displayCategory>Reproduction</displayCategory>
    <selectionWeight>0</selectionWeight>
    <biostatCpx>1</biostatCpx>
    <biostatMet>0</biostatMet>
    <statFactors>
      <Fertility>0</Fertility>
    </statFactors>
  </GeneDef>
  <GeneDef>
    <defName>LP_PsionicSense</defName>
    <label>灵能感知</label>
    <description>夺心魔天生能听见周围心灵的低语，自己的心智也像一堵墙：心智抗性+30%，能抵抗别人的魅惑、心灵震爆和寄生；还能主动读心。</description>
    <iconPath>MindFlayer/Genes/PsionicSense</iconPath>
    <displayCategory>Miscellaneous</displayCategory>
    <selectionWeight>0</selectionWeight>
    <biostatCpx>1</biostatCpx>
    <biostatMet>-1</biostatMet>
    <statOffsets>
      <LP_MindResist>0.3</LP_MindResist>
    </statOffsets>
    <abilities>
      <li>LP_ReadMind</li>
    </abilities>
    <descriptionHyperlinks>
      <AbilityDef>LP_ReadMind</AbilityDef>
    </descriptionHyperlinks>
  </GeneDef>
  <GeneDef>
    <defName>LP_HiveLink</defName>
    <label>群脑联络</label>
    <description>夺心魔的心灵彼此相连。同一地图上每多一个本阵营的夺心魔，心灵敏感度+10%、全局学习速度+5%，最多计3个。同伴死亡时，其余夺心魔会感到"群脑断裂"。</description>
    <geneClass>LichPhylactery.Gene_HiveLink</geneClass>
    <iconPath>MindFlayer/Genes/HiveLink</iconPath>
    <displayCategory>Miscellaneous</displayCategory>
    <selectionWeight>0</selectionWeight>
    <biostatCpx>1</biostatCpx>
    <biostatMet>0</biostatMet>
    <customEffectDescriptions>
      <li>同地图每个本阵营夺心魔同伴：心灵敏感度+10%、全局学习速度+5%（最多3个）。</li>
      <li>同伴死亡：心情-8，持续3天。</li>
    </customEffectDescriptions>
  </GeneDef>

  <!-- 脑髓不足 -->
  <HediffDef>
    <defName>LP_CerebrumHunger</defName>
    <label>脑髓不足</label>
    <description>脑髓不足，夺心魔的身体和意识正在衰弱。吞噬大脑可以恢复。</description>
    <hediffClass>LichPhylactery.Hediff_CerebrumHunger</hediffClass>
    <defaultLabelColor>(0.75, 0.45, 0.85)</defaultLabelColor>
    <isBad>true</isBad>
    <everCurableByItem>false</everCurableByItem>
    <initialSeverity>0.7</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <stages>
      <li>
        <label>不足</label>
        <capMods>
          <li><capacity>Consciousness</capacity><offset>-0.05</offset></li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.9</minSeverity>
        <label>匮乏</label>
        <capMods>
          <li><capacity>Consciousness</capacity><offset>-0.15</offset></li>
          <li><capacity>Moving</capacity><offset>-0.1</offset></li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.999</minSeverity>
        <label>脑饥</label>
        <capMods>
          <li><capacity>Consciousness</capacity><offset>-0.25</offset></li>
          <li><capacity>Moving</capacity><offset>-0.15</offset></li>
        </capMods>
      </li>
    </stages>
  </HediffDef>
  <ThoughtDef>
    <defName>LP_CerebrumHunger</defName>
    <workerClass>ThoughtWorker_Hediff</workerClass>
    <hediff>LP_CerebrumHunger</hediff>
    <stages>
      <li>
        <label>脑髓不足</label>
        <description>我需要新鲜的大脑。</description>
        <baseMoodEffect>-6</baseMoodEffect>
      </li>
      <li>
        <label>脑髓匮乏</label>
        <description>饥饿啃噬着我的意识，我满脑子都是别人的大脑。</description>
        <baseMoodEffect>-12</baseMoodEffect>
      </li>
      <li>
        <label>脑饥</label>
        <description>大脑……我必须马上吃到大脑！</description>
        <baseMoodEffect>-20</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>
  <HediffDef>
    <defName>LP_UndeadTaste</defName>
    <label>亡灵之味</label>
    <description>试图吞噬不死生物的"大脑"，结果只尝到了腐朽的死灵之力。恶心反胃，暂时难以集中精神。</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.55, 0.65, 0.5)</defaultLabelColor>
    <isBad>true</isBad>
    <everCurableByItem>false</everCurableByItem>
    <stages>
      <li>
        <vomitMtbDays>0.25</vomitMtbDays>
        <capMods>
          <li><capacity>Consciousness</capacity><offset>-0.1</offset></li>
        </capMods>
      </li>
    </stages>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>15000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
  </HediffDef>
  <ThoughtDef>
    <defName>LP_UndeadTaste</defName>
    <workerClass>ThoughtWorker_Hediff</workerClass>
    <hediff>LP_UndeadTaste</hediff>
    <stages>
      <li>
        <label>亡灵之味</label>
        <description>那东西根本没有活着的大脑，满嘴都是腐朽的味道。</description>
        <baseMoodEffect>-5</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>
  <HediffDef>
    <defName>LP_HiveLink</defName>
    <label>群脑联络</label>
    <description>与同一地图上的夺心魔同伴心灵相连。</description>
    <hediffClass>LichPhylactery.Hediff_HiveLink</hediffClass>
    <defaultLabelColor>(0.75, 0.6, 0.95)</defaultLabelColor>
    <isBad>false</isBad>
    <everCurableByItem>false</everCurableByItem>
    <initialSeverity>1</initialSeverity>
    <maxSeverity>3</maxSeverity>
    <stages>
      <li>
        <minSeverity>1</minSeverity>
        <label>1名同伴</label>
        <statOffsets><PsychicSensitivity>0.1</PsychicSensitivity><GlobalLearningFactor>0.05</GlobalLearningFactor></statOffsets>
      </li>
      <li>
        <minSeverity>2</minSeverity>
        <label>2名同伴</label>
        <statOffsets><PsychicSensitivity>0.2</PsychicSensitivity><GlobalLearningFactor>0.1</GlobalLearningFactor></statOffsets>
      </li>
      <li>
        <minSeverity>3</minSeverity>
        <label>3名同伴</label>
        <statOffsets><PsychicSensitivity>0.3</PsychicSensitivity><GlobalLearningFactor>0.15</GlobalLearningFactor></statOffsets>
      </li>
    </stages>
  </HediffDef>
  <ThoughtDef>
    <defName>LP_HiveBroken</defName>
    <durationDays>3</durationDays>
    <stackLimit>3</stackLimit>
    <stages>
      <li>
        <label>群脑断裂</label>
        <description>一个同伴的心灵从群脑里消失了，那片空白让我头痛欲裂。</description>
        <baseMoodEffect>-8</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>
  <ThoughtDef>
    <defName>LP_WitnessedBrainDevour</defName>
    <durationDays>4</durationDays>
    <stackLimit>3</stackLimit>
    <stackedEffectMultiplier>0.5</stackedEffectMultiplier>
    <nullifyingTraits>
      <li>Psychopath</li>
      <li>Bloodlust</li>
    </nullifyingTraits>
    <nullifyingPrecepts>
      <li MayRequire="Ludeon.RimWorld.Ideology">LP_BrainDevouring_Sacred</li>
    </nullifyingPrecepts>
    <stages>
      <li>
        <label>目睹吞噬大脑</label>
        <description>我亲眼看见那东西用触须钻进别人的脑壳，把大脑吸了个干净。比吃人还可怕。</description>
        <baseMoodEffect>-25</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>
  <HistoryEventDef>
    <defName>LP_DevouredBrain</defName>
    <label>吞噬大脑</label>
  </HistoryEventDef>

  <!-- 心灵震爆 -->
  <HediffDef>
    <defName>LP_MindBlasted</defName>
    <label>心灵震荡</label>
    <description>被夺心魔的心灵冲击震伤，头脑昏沉。</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.75, 0.55, 0.9)</defaultLabelColor>
    <isBad>true</isBad>
    <everCurableByItem>false</everCurableByItem>
    <stages>
      <li>
        <capMods>
          <li><capacity>Consciousness</capacity><offset>-0.2</offset></li>
        </capMods>
      </li>
    </stages>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>2500</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
  </HediffDef>

  <AbilityDef Name="LP_MindFlayerAbilityBase" Abstract="True">
    <aiCanUse>false</aiCanUse>
    <displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
    <disableGizmoWhileUndrafted>false</disableGizmoWhileUndrafted>
    <sendMessageOnCooldownComplete>false</sendMessageOnCooldownComplete>
  </AbilityDef>
  <AbilityDef ParentName="LP_MindFlayerAbilityBase">
    <defName>LP_DevourBrain</defName>
    <label>吞噬大脑</label>
    <description>用触须钻进一个倒地生物（或死亡不超过6小时的新鲜人形尸体）的头颅，吸食大脑。目标立即死亡（大脑缺失），夺心魔获得脑髓并吸收目标最高技能20%的经验。看到的人会深受震撼，目标所属派系好感-15。巫妖与死灵造物没有活着的大脑，吞噬会失败并留下6小时"亡灵之味"。机械体与心灵失聪者无法吞噬。</description>
    <iconPath>MindFlayer/Abilities/DevourBrain</iconPath>
    <cooldownTicksRange>600</cooldownTicksRange>
    <hostile>true</hostile>
    <casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence>
    <verbProperties>
      <verbClass>Verb_CastAbilityTouch</verbClass>
      <drawAimPie>false</drawAimPie>
      <range>-1</range>
      <warmupTime>3</warmupTime>
      <violent>false</violent>
      <targetParams>
        <canTargetPawns>true</canTargetPawns>
        <canTargetAnimals>true</canTargetAnimals>
        <canTargetCorpses>true</canTargetCorpses>
        <canTargetItems>true</canTargetItems>
        <canTargetBuildings>false</canTargetBuildings>
        <canTargetSelf>false</canTargetSelf>
        <canTargetLocations>false</canTargetLocations>
        <canTargetMechs>false</canTargetMechs>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="LichPhylactery.CompProperties_MindFlayerAbility">
        <effect>devour</effect>
      </li>
    </comps>
  </AbilityDef>
  <AbilityDef ParentName="LP_MindFlayerAbilityBase">
    <defName>LP_MindBlast</defName>
    <label>心灵震爆</label>
    <description>向前方锥形区域（9格）释放心灵冲击。敌对目标会被击晕约4秒（按其心灵敏感度缩放），并陷入1小时"心灵震荡"（意识-20%）。心智抗性可以抵抗；机械体与心灵失聪者不受影响。消耗10点脑髓，冷却1天。</description>
    <iconPath>MindFlayer/Abilities/MindBlast</iconPath>
    <cooldownTicksRange>60000</cooldownTicksRange>
    <hostile>true</hostile>
    <casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <range>9</range>
      <warmupTime>0.5</warmupTime>
      <violent>false</violent>
      <targetParams>
        <canTargetLocations>true</canTargetLocations>
        <canTargetPawns>true</canTargetPawns>
        <canTargetSelf>false</canTargetSelf>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="LichPhylactery.CompProperties_MindFlayerAbility">
        <effect>mindblast</effect>
        <cost>10</cost>
      </li>
    </comps>
  </AbilityDef>

  <!-- 意识形态：吞噬大脑的戒律，仅在加载《意识形态》时注册 -->
  <IssueDef MayRequire="Ludeon.RimWorld.Ideology">
    <defName>LP_BrainDevouring</defName>
    <label>吞噬大脑</label>
    <iconPath>MindFlayer/Abilities/DevourBrain</iconPath>
  </IssueDef>
  <PreceptDef MayRequire="Ludeon.RimWorld.Ideology">
    <defName>LP_BrainDevouring_Abhorrent</defName>
    <issue>LP_BrainDevouring</issue>
    <label>憎恶</label>
    <description>吞噬智慧生物的大脑是最可憎的暴行。</description>
    <impact>Low</impact>
    <displayOrderInIssue>50</displayOrderInIssue>
    <defaultSelectionWeight>1</defaultSelectionWeight>
    <comps>
      <li Class="PreceptComp_KnowsMemoryThought">
        <eventDef>LP_DevouredBrain</eventDef>
        <thought>LP_BrainDevoured_Know_Abhorrent</thought>
      </li>
    </comps>
  </PreceptDef>
  <ThoughtDef MayRequire="Ludeon.RimWorld.Ideology">
    <defName>LP_BrainDevoured_Know_Abhorrent</defName>
    <thoughtClass>Thought_Memory</thoughtClass>
    <durationDays>5</durationDays>
    <stackLimit>5</stackLimit>
    <stackedEffectMultiplier>0.5</stackedEffectMultiplier>
    <nullifyingTraits>
      <li>Psychopath</li>
    </nullifyingTraits>
    <stages>
      <li>
        <label>有人的大脑被吞噬了</label>
        <description>殖民地里有人的大脑被吸食了。这是对一切信仰的亵渎。</description>
        <baseMoodEffect>-4</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>
  <PreceptDef MayRequire="Ludeon.RimWorld.Ideology">
    <defName>LP_BrainDevouring_Acceptable</defName>
    <issue>LP_BrainDevouring</issue>
    <label>可以接受</label>
    <description>夺心魔要吃大脑，就像人要吃饭。</description>
    <impact>Medium</impact>
    <displayOrderInIssue>40</displayOrderInIssue>
    <defaultSelectionWeight>0.2</defaultSelectionWeight>
  </PreceptDef>
  <PreceptDef MayRequire="Ludeon.RimWorld.Ideology">
    <defName>LP_BrainDevouring_Sacred</defName>
    <issue>LP_BrainDevouring</issue>
    <label>神圣</label>
    <description>把心智献给伟大的群脑，是最崇高的归宿。目睹吞噬大脑不会难过，吞噬者自己会感到神圣。</description>
    <impact>High</impact>
    <displayOrderInIssue>30</displayOrderInIssue>
    <defaultSelectionWeight>0</defaultSelectionWeight>
    <comps>
      <li Class="PreceptComp_SelfTookMemoryThought">
        <eventDef>LP_DevouredBrain</eventDef>
        <thought>LP_BrainDevoured_Sacred</thought>
      </li>
    </comps>
  </PreceptDef>
  <ThoughtDef MayRequire="Ludeon.RimWorld.Ideology">
    <defName>LP_BrainDevoured_Sacred</defName>
    <durationDays>3</durationDays>
    <stackLimit>3</stackLimit>
    <stages>
      <li>
        <label>神圣的盛宴</label>
        <description>又一个心智归入了群脑。</description>
        <baseMoodEffect>6</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>
</Defs>
