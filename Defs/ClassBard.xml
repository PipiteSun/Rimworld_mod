    <comps><li Class="LichPhylactery.CompProperties_ClassEffect"><effect>Passive</effect><passive>true</passive><stat>LP_BardicPower</stat></li></comps>
  </AbilityDef>
  <AbilityDef ParentName="LP_ClassMeleeBase">
    <defName>LP_BD_Truce</defName>
    <label>停战之言</label>
    <description>对一支正在袭击的人形队伍里的任何一人（30 格内）喊话。成功率 = 30% + (激昂强度 − 1) × 40%，对方队伍每有一人倒地或死亡 +5%（最多 90%）。成功：整支队伍放弃袭击、离开地图，那个派系好感 +10。失败：那人动摇 30 秒。机械族、虫族、亡灵、异界来客和剧情首领带队的袭击无效。消耗 5 点乐韵，冷却 15 天。雄辩学院，吟游诗人 15 级。</description>
    <iconPath>LP/Classes/Bard/Truce</iconPath>
    <displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
    <casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence>
    <cooldownTicksRange>900000</cooldownTicksRange>
    <verbProperties><range>30</range><warmupTime>2</warmupTime><requireLineOfSight>false</requireLineOfSight></verbProperties>
    <comps><li Class="LichPhylactery.CompProperties_ClassEffect"><effect>BdTruce</effect><cost>5</cost><duration>1800</duration><stat>LP_BardicPower</stat></li></comps>
  </AbilityDef>

