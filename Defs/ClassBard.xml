<!-- 1.123.0 吟游诗人（第 13 个职业，见 ArtSource/Bard-1.123.0-report.md / Source/ClassBard.cs）：社交（副 艺术），主属性魅力，施法职业（能力乘心灵敏感度）。
     资源：乐韵（上限 2 + 吟游等级 + 魅力调整值，最少 2）：醒着慢慢回，睡觉快；演奏乐器、听音乐、做艺术品时恢复 ×1.5；每次闲聊 / 深谈 +0.2。
     能力在 1/3/5/7/10/13/15 级；学院（子职业）3 级选，能力在 3/7/11/15 级；魔法奥秘是学院定义里的分支（secret1 10 级、secret2 13 级、学识学院 secret3 11 级）。 -->
<Defs>
  <!-- ===== 职业 ===== -->
  <LichPhylactery.LP_ClassDef>
    <defName>LP_Class_Bard</defName>
    <label>吟游诗人</label>
    <description>DND 吟游诗人用歌声与言语施法：恶毒嘲讽（戏法）、吟游激励、治疗真言、狂笑术、安歇之歌、万事通（被动）、反迷惑之歌、困惑术、传颂之歌、魔法奥秘（10 / 13 级各从别的施法职业学一个法术）、惑心幻景，终极 创世之言。3 级选学院：学识、勇气、剑舞或雄辩。强度看“激昂强度”（社交或艺术，魅力），伤害与治疗（设置开着时）乘心灵敏感度。资源：乐韵（上限 2 + 吟游等级 + 魅力调整值；醒着慢慢回、睡觉快，演奏乐器、听音乐、做艺术品时更快，每次和人聊天 +0.2）。</description>
    <mainSkill>Social</mainSkill>
    <alternateSkill>Artistic</alternateSkill>
    <primary>Cha</primary>
    <order>13</order>
    <resource>Melody</resource>
    <caster>true</caster>
    <subclassLevel>3</subclassLevel>
    <background>LP/Classes/Bard/Background</background>
    <color>(0.85,0.4,0.6)</color>
    <abilities>
      <li><ability>LP_BD_ViciousMockery</ability><level>1</level></li>
      <li><ability>LP_BD_Inspiration</ability><level>1</level></li>
      <li><ability>LP_BD_HealingWord</ability><level>1</level></li>
      <li><ability>LP_BD_HideousLaughter</ability><level>3</level></li>
      <li><ability>LP_BD_SongOfRest</ability><level>3</level></li>
      <li><ability>LP_BD_JackOfAllTrades</ability><level>5</level></li>
      <li><ability>LP_BD_Countercharm</ability><level>5</level></li>
      <li><ability>LP_BD_Confusion</ability><level>7</level></li>
      <li><ability>LP_BD_Ballad</ability><level>7</level></li>
      <li><ability>LP_BD_MagicalSecrets</ability><level>10</level></li>
      <li><ability>LP_BD_MagicalSecrets2</ability><level>13</level></li>
      <li><ability>LP_BD_Mislead</ability><level>13</level></li>
      <li><ability>LP_BD_WordsOfCreation</ability><level>15</level><capstoneSkill>Social</capstoneSkill></li>
    </abilities>
    <legendary><li>LP_LegUndyingLegend</li><li>LP_LegFinalSong</li></legendary>
  </LichPhylactery.LP_ClassDef>

  <!-- ===== 职业强度 ===== -->
  <StatDef ParentName="LP_ClassPowerBase">
    <defName>LP_BardicPower</defName>
    <label>激昂强度</label>
    <description>吟游诗人能力的强度倍率：0.5 +（社交、艺术里较高的等级）/20，另加冒险者魅力调整值 × 0.10 与熟练加值，吟游诗人等职业等级合计每比 1 高 1 级 +5%（最多 +95%）。传奇「不朽传奇」+20%。魔法奥秘学来的法术也用这个强度。</description>
    <parts><li Class="LichPhylactery.StatPart_ClassPower"><skill>Social</skill><alternateSkill>Artistic</alternateSkill><ability>Cha</ability><levelPer>0.05</levelPer><levelMax>0.95</levelMax><abilityPer>0.10</abilityPer></li><li Class="LichPhylactery.StatPart_LegendaryClassPower"><ability>LP_LegUndyingLegend</ability><bonus>0.2</bonus></li></parts>
    <displayPriorityInCategory>4217</displayPriorityInCategory>
  </StatDef>

  <!-- ===== 状态 ===== -->
  <HediffDef ParentName="LP_ClassBuffBase">
    <defName>LP_BD_Inspired</defName>
    <hediffClass>LichPhylactery.Hediff_BardInspired</hediffClass>
    <label>吟游激励</label>
    <description>吟游诗人的歌声在心里回响：近战命中、射击精度、工作速度提高（越强的激励越多），精神崩溃阈值 −5%。</description>
    <defaultLabelColor>(0.85,0.4,0.6)</defaultLabelColor>
    <stages>
      <li><label>×1</label><statOffsets><MeleeHitChance>0.10</MeleeHitChance><ShootingAccuracyPawn>0.02</ShootingAccuracyPawn><WorkSpeedGlobal>0.10</WorkSpeedGlobal><MentalBreakThreshold>-0.05</MentalBreakThreshold></statOffsets></li>
      <li><minSeverity>1.25</minSeverity><label>×1.5</label><statOffsets><MeleeHitChance>0.15</MeleeHitChance><ShootingAccuracyPawn>0.03</ShootingAccuracyPawn><WorkSpeedGlobal>0.15</WorkSpeedGlobal><MentalBreakThreshold>-0.05</MentalBreakThreshold></statOffsets></li>
      <li><minSeverity>1.75</minSeverity><label>×2</label><statOffsets><MeleeHitChance>0.20</MeleeHitChance><ShootingAccuracyPawn>0.04</ShootingAccuracyPawn><WorkSpeedGlobal>0.20</WorkSpeedGlobal><MentalBreakThreshold>-0.05</MentalBreakThreshold></statOffsets></li>
      <li><minSeverity>2.25</minSeverity><label>×2.5</label><statOffsets><MeleeHitChance>0.25</MeleeHitChance><ShootingAccuracyPawn>0.05</ShootingAccuracyPawn><WorkSpeedGlobal>0.25</WorkSpeedGlobal><MentalBreakThreshold>-0.05</MentalBreakThreshold></statOffsets></li>
      <li><minSeverity>2.75</minSeverity><label>×3</label><statOffsets><MeleeHitChance>0.30</MeleeHitChance><ShootingAccuracyPawn>0.06</ShootingAccuracyPawn><WorkSpeedGlobal>0.30</WorkSpeedGlobal><MentalBreakThreshold>-0.05</MentalBreakThreshold></statOffsets></li>
    </stages>
  </HediffDef>
  <HediffDef ParentName="LP_ClassBuffBase">
    <defName>LP_BD_ValorInspired</defName>
    <label>战斗激励</label>
    <description>勇气学院的战歌：受到的伤害 ×0.9，近战伤害 ×1.15。和吟游激励一起消失。</description>
    <defaultLabelColor>(0.9,0.55,0.35)</defaultLabelColor>
    <stages><li><statFactors><IncomingDamageFactor>0.9</IncomingDamageFactor><MeleeDamageFactor>1.15</MeleeDamageFactor></statFactors></li></stages>
  </HediffDef>
  <HediffDef ParentName="LP_ClassBuffBase">
    <defName>LP_BD_Mocked</defName>
    <label>动摇</label>
    <description>被尖刻的话刺中，心神不宁：近战命中 −20%，射击精度下降。</description>
    <isBad>true</isBad>
    <defaultLabelColor>(0.85,0.4,0.6)</defaultLabelColor>
    <stages><li><statOffsets><MeleeHitChance>-0.20</MeleeHitChance><ShootingAccuracyPawn>-0.06</ShootingAccuracyPawn></statOffsets></li></stages>
  </HediffDef>
  <HediffDef ParentName="LP_ClassBuffBase">
    <defName>LP_BD_Laughing</defName>
    <hediffClass>LichPhylactery.Hediff_BardLaughter</hediffClass>
    <label>狂笑</label>
    <description>笑得停不下来，倒在地上动弹不得。受到伤害立刻清醒。</description>
    <isBad>true</isBad>
    <defaultLabelColor>(0.95,0.75,0.4)</defaultLabelColor>
  </HediffDef>
  <HediffDef ParentName="LP_ClassBuffBase">
    <defName>LP_BD_Resting</defName>
    <label>安歇之歌</label>
    <description>吟游诗人唱了一整夜的安眠曲：睡眠恢复 ×1.3，伤口愈合加快（越强越快）。</description>
    <defaultLabelColor>(0.6,0.75,0.95)</defaultLabelColor>
    <stages>
      <li><label>×1.5 愈合</label><statFactors><RestRateMultiplier>1.3</RestRateMultiplier><InjuryHealingFactor>1.5</InjuryHealingFactor></statFactors></li>
      <li><minSeverity>1.25</minSeverity><label>×1.75 愈合</label><statFactors><RestRateMultiplier>1.3</RestRateMultiplier><InjuryHealingFactor>1.75</InjuryHealingFactor></statFactors></li>
      <li><minSeverity>1.75</minSeverity><label>×2 愈合</label><statFactors><RestRateMultiplier>1.3</RestRateMultiplier><InjuryHealingFactor>2</InjuryHealingFactor></statFactors></li>
      <li><minSeverity>2.25</minSeverity><label>×2.25 愈合</label><statFactors><RestRateMultiplier>1.3</RestRateMultiplier><InjuryHealingFactor>2.25</InjuryHealingFactor></statFactors></li>
      <li><minSeverity>2.75</minSeverity><label>×2.5 愈合</label><statFactors><RestRateMultiplier>1.3</RestRateMultiplier><InjuryHealingFactor>2.5</InjuryHealingFactor></statFactors></li>
    </stages>
  </HediffDef>
  <HediffDef ParentName="LP_SubclassPassiveBase">
    <defName>LP_BD_JackPassive</defName>
    <label>万事通</label>
    <description>什么都会一点：所有技能 +2 级，学习速度 +15%。</description>
    <defaultLabelColor>(0.85,0.4,0.6)</defaultLabelColor>
    <aptitudes><Shooting>2</Shooting><Melee>2</Melee><Construction>2</Construction><Mining>2</Mining><Cooking>2</Cooking><Plants>2</Plants><Animals>2</Animals><Crafting>2</Crafting><Artistic>2</Artistic><Medicine>2</Medicine><Social>2</Social><Intellectual>2</Intellectual></aptitudes>
    <stages><li><statOffsets><GlobalLearningFactor>0.15</GlobalLearningFactor></statOffsets></li></stages>
  </HediffDef>
  <HediffDef ParentName="LP_ClassBuffBase">
    <defName>LP_BD_Countercharmed</defName>
    <label>反迷惑之歌</label>
    <description>心里一直回响着吟游诗人的旋律：心智抗性 +30%，心灵敏感度 −30%（心灵冲击带来的坏心情也随之减轻）。</description>
    <defaultLabelColor>(0.6,0.75,0.95)</defaultLabelColor>
    <stages><li><statOffsets><LP_MindResist>0.3</LP_MindResist><PsychicSensitivity>-0.3</PsychicSensitivity></statOffsets></li></stages>
  </HediffDef>
  <HediffDef ParentName="LP_ClassBuffBase">
    <defName>LP_BD_Confused</defName>
    <hediffClass>LichPhylactery.Hediff_BardConfused</hediffClass>
    <label>困惑</label>
    <description>脑子里一团乱麻：每 2 秒随机发呆、乱走，或者攻击身边的任何人。</description>
    <isBad>true</isBad>
    <defaultLabelColor>(0.85,0.4,0.6)</defaultLabelColor>
  </HediffDef>
  <HediffDef ParentName="LP_ClassBuffBase">
    <defName>LP_BD_CuttingWords</defName>
    <hediffClass>LichPhylactery.Hediff_BardCutting</hediffClass>
    <label>刻薄之语</label>
    <description>被学识学院的吟游诗人挖苦得抬不起头：近战命中 −25%，射击精度下降，造成的伤害 ×0.75。</description>
    <isBad>true</isBad>
    <defaultLabelColor>(0.85,0.4,0.6)</defaultLabelColor>
    <stages><li><statOffsets><MeleeHitChance>-0.25</MeleeHitChance><ShootingAccuracyPawn>-0.08</ShootingAccuracyPawn></statOffsets></li></stages>
  </HediffDef>
  <HediffDef ParentName="LP_SubclassPassiveBase">
    <defName>LP_BD_LorePassive</defName>
    <label>博闻强识</label>
    <description>学识学院的博学：研究速度提高（越强越快）。</description>
    <defaultLabelColor>(0.55,0.6,0.95)</defaultLabelColor>
    <stages>
      <li><label>+10%</label><statOffsets><ResearchSpeed>0.10</ResearchSpeed></statOffsets></li>
      <li><minSeverity>1.25</minSeverity><label>+15%</label><statOffsets><ResearchSpeed>0.15</ResearchSpeed></statOffsets></li>
      <li><minSeverity>1.75</minSeverity><label>+20%</label><statOffsets><ResearchSpeed>0.20</ResearchSpeed></statOffsets></li>
      <li><minSeverity>2.25</minSeverity><label>+25%</label><statOffsets><ResearchSpeed>0.25</ResearchSpeed></statOffsets></li>
      <li><minSeverity>2.75</minSeverity><label>+30%</label><statOffsets><ResearchSpeed>0.30</ResearchSpeed></statOffsets></li>
    </stages>
  </HediffDef>
  <HediffDef ParentName="LP_SubclassPassiveBase">
    <defName>LP_BD_PeerlessPassive</defName>
    <label>无双技艺</label>
    <description>学识学院的大师：社交影响、谈判能力 +15%，手术成功率 +10%；做出的物品有 30% 的成功率品质 +1 档。</description>
    <defaultLabelColor>(0.55,0.6,0.95)</defaultLabelColor>
    <stages><li><statOffsets><SocialImpact>0.15</SocialImpact><NegotiationAbility>0.15</NegotiationAbility><MedicalSurgerySuccessChance>0.10</MedicalSurgerySuccessChance></statOffsets></li></stages>
  </HediffDef>
  <HediffDef ParentName="LP_SubclassPassiveBase">
    <defName>LP_BD_ValorPassive</defName>
    <label>勇气学院</label>
    <description>战歌手的武艺：射击、格斗 +3 级。</description>
    <defaultLabelColor>(0.9,0.55,0.35)</defaultLabelColor>
    <aptitudes><Shooting>3</Shooting><Melee>3</Melee></aptitudes>
  </HediffDef>
  <HediffDef ParentName="LP_SubclassPassiveBase">
    <defName>LP_BD_ExtraAttackPassive</defName>
    <label>额外攻击</label>
    <description>出手更快：近战攻击冷却 ×0.8，瞄准时间 ×0.8。</description>
    <defaultLabelColor>(0.9,0.55,0.35)</defaultLabelColor>
    <stages><li><statFactors><MeleeCooldownFactor>0.8</MeleeCooldownFactor><AimingDelayFactor>0.8</AimingDelayFactor></statFactors></li></stages>
  </HediffDef>
  <HediffDef ParentName="LP_ClassBuffBase">
    <defName>LP_BD_BattleMagicBuff</defName>
    <label>战斗魔法</label>
    <description>施法的余韵还在指尖：下一次攻击几乎不用瞄准、出手更快，伤害 ×1.25（打中一次就消失）。</description>
    <defaultLabelColor>(0.9,0.55,0.35)</defaultLabelColor>
    <stages><li><statFactors><AimingDelayFactor>0.1</AimingDelayFactor><MeleeCooldownFactor>0.5</MeleeCooldownFactor></statFactors></li></stages>
  </HediffDef>
  <HediffDef ParentName="LP_ClassBuffBase">
    <defName>LP_BD_Anthem</defName>
    <label>勇气战吼</label>
    <description>战歌让人热血沸腾：痛觉 ×0.5，移动 ×1.2，心智抗性 +50%。</description>
    <defaultLabelColor>(0.9,0.55,0.35)</defaultLabelColor>
    <stages><li><painFactor>0.5</painFactor><statFactors><MoveSpeed>1.2</MoveSpeed></statFactors><statOffsets><LP_MindResist>0.5</LP_MindResist></statOffsets></li></stages>
  </HediffDef>
  <HediffDef ParentName="LP_SubclassPassiveBase">
    <defName>LP_BD_BladePassive</defName>
    <label>刀光剑舞</label>
    <description>剑舞学院的步法：移动 ×1.15；近战命中时按当前招式触发剑花。</description>
    <defaultLabelColor>(0.75,0.75,0.9)</defaultLabelColor>
    <stages><li><statFactors><MoveSpeed>1.15</MoveSpeed></statFactors></li></stages>
  </HediffDef>
  <HediffDef ParentName="LP_SubclassPassiveBase">
    <defName>LP_BD_SilverPassive</defName>
    <label>银舌</label>
    <description>雄辩学院的口才：谈判能力 ×1.5（招募、说服更容易），交易价格 +10%，社交影响 +20%。</description>
    <defaultLabelColor>(0.95,0.8,0.45)</defaultLabelColor>
    <stages><li><statFactors><NegotiationAbility>1.5</NegotiationAbility></statFactors><statOffsets><TradePriceImprovement>0.10</TradePriceImprovement><SocialImpact>0.20</SocialImpact></statOffsets></li></stages>
  </HediffDef>
  <HediffDef ParentName="LP_ClassBuffBase">
    <defName>LP_BD_FinalSong</defName>
    <hediffClass>LichPhylactery.Hediff_BardFinale</hediffClass>
    <label>终焉之歌</label>
    <description>史诗的最后一段：不会精神崩溃，命中提高，痛觉 ×0.5；期间倒地会立刻治好一半伤势、尽力站起来一次。</description>
    <defaultLabelColor>(1,0.8,0.5)</defaultLabelColor>
    <stages><li><blocksMentalBreaks>true</blocksMentalBreaks><painFactor>0.5</painFactor><statOffsets><MeleeHitChance>0.20</MeleeHitChance><ShootingAccuracyPawn>0.05</ShootingAccuracyPawn></statOffsets></li></stages>
  </HediffDef>
  <HediffDef ParentName="LP_ClassBuffBase">
    <defName>LP_BD_FinaleAura</defName>
    <hediffClass>LichPhylactery.Hediff_BardFinaleAura</hediffClass>
    <label>唱响终焉之歌</label>
    <description>正在唱终焉之歌：30 格内的敌人每 5 秒有 25% 的成功率吓得逃跑（机械体不受影响）。</description>
    <defaultLabelColor>(1,0.8,0.5)</defaultLabelColor>
  </HediffDef>
  <HediffDef ParentName="LP_ClassBuffBase">
    <defName>LP_ACB_Dancing</defName>
    <hediffClass>LichPhylactery.Hediff_BardDance</hediffClass>
    <label>不可抗拒之舞</label>
    <description>身体不听使唤地跳个不停：不能攻击、不能走开，受到的伤害 ×1.3。</description>
    <isBad>true</isBad>
    <defaultLabelColor>(0.85,0.4,0.6)</defaultLabelColor>
    <stages><li><statFactors><IncomingDamageFactor>1.3</IncomingDamageFactor></statFactors></li></stages>
  </HediffDef>
  <HediffDef ParentName="LP_ClassBuffBase">
    <defName>LP_ACB_Foresight</defName>
    <label>预知术</label>
    <description>看得见片刻之后的事：近战命中 +25%，射击精度提高，近战闪避 +25%，心智抗性 +50%，不会被偷袭。</description>
    <defaultLabelColor>(0.85,0.4,0.6)</defaultLabelColor>
    <stages><li><statOffsets><MeleeHitChance>0.25</MeleeHitChance><ShootingAccuracyPawn>0.06</ShootingAccuracyPawn><MeleeDodgeChance>0.25</MeleeDodgeChance><LP_MindResist>0.5</LP_MindResist></statOffsets></li></stages>
  </HediffDef>

  <!-- ===== 心情 ===== -->
  <ThoughtDef>
    <defName>LP_BD_RestSongMood</defName>
    <thoughtClass>Thought_Memory</thoughtClass>
    <durationDays>1</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>安歇之歌</label><description>昨晚听着吟游诗人的歌睡着的，睡得特别香。</description><baseMoodEffect>4</baseMoodEffect></li></stages>
  </ThoughtDef>
  <ThoughtDef>
    <defName>LP_BD_LegendMood</defName>
    <thoughtClass>Thought_Memory</thoughtClass>
    <durationDays>3</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>我们的传说</label><description>我们的故事被写成了歌，传遍了大陆。</description><baseMoodEffect>5</baseMoodEffect></li></stages>
  </ThoughtDef>

  <!-- ===== 幻象分身（惑心幻景） ===== -->
  <ThingDef ParentName="BuildingBase">
    <defName>LP_BD_Phantasm</defName>
    <label>幻象分身</label>
    <description>吟游诗人留下的幻象，一直在嘲笑附近的敌人。10 秒后或受到几次攻击就会消散。</description>
    <thingClass>LichPhylactery.Building_BardPhantasm</thingClass>
    <graphicData><texPath>LP/Classes/Bard/Phantasm</texPath><graphicClass>Graphic_Single</graphicClass><drawSize>(1.4,1.4)</drawSize></graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <tickerType>Normal</tickerType>
    <useHitPoints>true</useHitPoints>
    <rotatable>false</rotatable>
    <statBases><MaxHitPoints>45</MaxHitPoints><Flammability>0</Flammability><Beauty>0</Beauty></statBases>
    <leaveResourcesWhenKilled>false</leaveResourcesWhenKilled>
    <building><claimable>false</claimable></building>
  </ThingDef>

  <!-- ===== 职业能力 ===== -->
  <AbilityDef ParentName="LP_ClassMeleeBase">
    <defName>LP_BD_ViciousMockery</defName>
    <label>恶毒嘲讽</label>
    <description>戏法，不耗乐韵：对 24 格内一个敌人说一句刺耳的话，造成 6 × 激昂强度 心灵伤害（无视护甲），并让它动摇 6 秒（近战命中 −20%，射击精度下降；机械体不会动摇）。冷却 4 秒。吟游诗人 1 级。</description>
    <iconPath>LP/Classes/Bard/ViciousMockery</iconPath>
    <cooldownTicksRange>240</cooldownTicksRange>
    <verbProperties><range>24</range><warmupTime>0.5</warmupTime></verbProperties>
    <comps><li Class="LichPhylactery.CompProperties_ClassEffect"><effect>BdMockery</effect><power>6</power><duration>360</duration><stat>LP_BardicPower</stat><psychic>true</psychic><single>true</single></li></comps>
  </AbilityDef>
  <AbilityDef ParentName="LP_ClassAllyBase">
