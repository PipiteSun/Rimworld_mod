<?xml version="1.0" encoding="utf-8"?>
<!-- 1.22.0 炼金投掷物：照原版手雷/燃烧瓶写法（与原版一样是可反复投掷的装备）。 -->
<Defs>

  <!-- 炼金之火 -->

  <!-- 强酸瓶 -->
  <DamageDef>
    <defName>LP_AlchemyAcid</defName>
    <label>强酸</label>
    <workerClass>DamageWorker_AddInjury</workerClass>
    <externalViolence>true</externalViolence>
    <deathMessage>{0}被强酸溶蚀而死。</deathMessage>
    <hediff>AcidBurn</hediff>
    <armorCategory>Sharp</armorCategory>
    <defaultDamage>14</defaultDamage>
    <defaultArmorPenetration>0.1</defaultArmorPenetration>
  </DamageDef>

  <!-- 圣水 -->

  <!-- 雷鸣石 -->

  <!-- 黏胶袋 -->
  <HediffDef>
    <defName>LP_Tanglefoot</defName>
    <label>被黏住</label>
    <description>脚下黏满炼金胶，几乎迈不开步子。</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>true</isBad>
    <maxSeverity>1</maxSeverity>
    <initialSeverity>1</initialSeverity>
    <comps>
      <li Class="HediffCompProperties_Disappears"><disappearsAfterTicks>600</disappearsAfterTicks><showRemainingTime>true</showRemainingTime></li>
    </comps>
    <stages>
      <li><label>轻微</label><statFactors><MoveSpeed>0.65</MoveSpeed></statFactors></li>
      <li><minSeverity>0.75</minSeverity><statFactors><MoveSpeed>0.3</MoveSpeed></statFactors></li>
    </stages>
  </HediffDef>

  <!-- 驱散粉尘 -->
  <HediffDef>
    <defName>LP_MagicDispelled</defName>
    <label>魔法被驱散</label>
    <description>身上的魔法被驱散压制：护盾腰带停摆，力能龙裔的偏折、朦胧与错位失效，隐形被迫现形。</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>true</isBad>
    <defaultLabelColor>(0.75, 0.75, 0.9)</defaultLabelColor>
    <everCurableByItem>false</everCurableByItem>
    <comps>
      <li Class="HediffCompProperties_Disappears"><disappearsAfterTicks>1800</disappearsAfterTicks><showRemainingTime>true</showRemainingTime></li>
    </comps>
    <modExtensions>
      <li Class="LichPhylactery.DispelExtension">
        <removeHediffs>
          <li>VPE_Overshield</li>
          <li>VPE_FireShield</li>
          <li>VPE_IceShield</li>
          <li>VPE_DeathShield</li>
          <li>VPE_AnimalOvershield</li>
          <li>VPE_GuardianSkipBarrier</li>
        </removeHediffs>
      </li>
    </modExtensions>
  </HediffDef>
</Defs>
