<?xml version="1.0" encoding="utf-8"?>
<!-- 1.18.0 牛头人：可遗传的近战种族。外貌用原版壮硕体型+毛皮（棕色毛色）+自绘牛角与牛鼻。 -->
<Defs>
  <XenotypeDef>
    <defName>LP_Minotaur</defName>
    <label>牛头人</label>
    <description>长着牛头和犄角的魁梧种族，血脉会遗传给子女。牛头人比常人高大一圈，浑身棕色短毛，力气极大，擅长近战，能用犄角顶人；冲锋起来像一头发狂的公牛，能把挡路的敌人撞飞。传说他们生于迷宫，在有屋顶的室内走得更快。代价是学东西慢、脾气暴躁、饭量惊人。</description>
    <descriptionShort>可遗传的魁梧种族。体型×1.3、搬运多、近战强、能用犄角攻击、每天一次蛮牛冲撞，室内移速+10%；学得慢、暴躁、食量大。</descriptionShort>
    <iconPath>MinotaurGith/Xenotypes/Minotaur</iconPath>
    <inheritable>true</inheritable>
    <combatPowerFactor>1.3</combatPowerFactor>
    <factionlessGenerationWeight>0</factionlessGenerationWeight>
    <genes>
      <li>LP_MinotaurCharge</li>
      <li>LP_MinotaurHorns</li>
      <li>LP_MinotaurMaze</li>
      <li>LP_MinotaurStature</li>
      <li>LP_MinotaurSnout</li>
      <li>Body_Hulk</li>
      <li>MeleeDamage_Strong</li>
      <li>AptitudeStrong_Melee</li>
      <li>Furskin</li>
      <li>Hair_DarkBrown</li>
      <li>Learning_Slow</li>
      <li>Aggression_Aggressive</li>
    </genes>
  </XenotypeDef>

  <AbilityDef Name="LP_MinotaurGithAbilityBase" Abstract="True">
    <aiCanUse>false</aiCanUse>
    <displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
    <disableGizmoWhileUndrafted>false</disableGizmoWhileUndrafted>
    <sendMessageOnCooldownComplete>false</sendMessageOnCooldownComplete>
  </AbilityDef>

  <GeneDef>
    <defName>LP_MinotaurCharge</defName>
    <label>蛮牛冲撞</label>
    <description>牛头人低下头，像公牛一样笔直冲出最多8格。撞上的第一个敌人受到约15点钝击（按牛头人的体型放大，牛头人约20点），被撞退2格并眩晕1秒。撞到墙或建筑会停下，不会损坏建筑；友方和中立的人会挡住去路。冷却1天。</description>
    <iconPath>MinotaurGith/Genes/Charge</iconPath>
    <displayCategory>Violence</displayCategory>
    <selectionWeight>0</selectionWeight>
    <biostatCpx>2</biostatCpx>
    <biostatMet>-1</biostatMet>
    <abilities>
      <li>LP_BullRush</li>
    </abilities>
    <descriptionHyperlinks>
      <AbilityDef>LP_BullRush</AbilityDef>
    </descriptionHyperlinks>
  </GeneDef>
  <AbilityDef ParentName="LP_MinotaurGithAbilityBase">
    <defName>LP_BullRush</defName>
    <label>蛮牛冲撞</label>
    <description>朝目标方向笔直冲出最多8格。撞上的第一个敌人受到15×体型的钝击伤害，被撞退2格并眩晕1秒。撞到墙、建筑或挡路的人就停下，不会损坏建筑。冷却1天。</description>
    <iconPath>MinotaurGith/Abilities/BullRush</iconPath>
    <cooldownTicksRange>60000</cooldownTicksRange>
    <hostile>true</hostile>
    <casterMustBeCapableOfViolence>true</casterMustBeCapableOfViolence>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <range>8</range>
      <warmupTime>0.3</warmupTime>
      <violent>true</violent>
      <targetParams>
        <canTargetLocations>true</canTargetLocations>
        <canTargetPawns>true</canTargetPawns>
        <canTargetBuildings>false</canTargetBuildings>
        <canTargetSelf>false</canTargetSelf>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="LichPhylactery.CompProperties_MinotaurGithAbility">
        <effect>charge</effect>
      </li>
    </comps>
  </AbilityDef>

  <GeneDef>
    <defName>LP_MinotaurHorns</defName>
    <label>犄角</label>
    <description>头顶长着一对粗壮弯曲的牛角，取代普通的头骨外形。犄角可以直接用来近战顶刺：锐器伤害比拳头略高，但甩头的动作慢一些。</description>
    <geneClass>LichPhylactery.Gene_MinotaurHorns</geneClass>
    <iconPath>MinotaurGith/Genes/Horns</iconPath>
    <displayCategory>Violence</displayCategory>
    <selectionWeight>0</selectionWeight>
    <biostatCpx>1</biostatCpx>
    <biostatMet>0</biostatMet>
    <exclusionTags>
      <li>Headbone</li>
    </exclusionTags>
    <customEffectDescriptions>
      <li>获得“犄角”近战攻击：锐器（刺）伤害11点，冷却2.6秒（拳头为8.2点、2秒）。</li>
      <li>与原版头骨类基因（迷你角、独角等）互斥。</li>
    </customEffectDescriptions>
    <renderNodeProperties>
      <li>
        <nodeClass>PawnRenderNode_AttachmentHead</nodeClass>
        <workerClass>PawnRenderNodeWorker_FlipWhenCrawling</workerClass>
        <texPath>MinotaurGith/Horns/BullHorns</texPath>
        <color>(255, 255, 255)</color>
        <parentTagDef>Head</parentTagDef>
        <rotDrawMode>Fresh, Rotting</rotDrawMode>
        <drawData>
          <defaultData>
            <layer>80</layer>
          </defaultData>
          <dataNorth>
            <layer>10</layer>
          </dataNorth>
        </drawData>
      </li>
    </renderNodeProperties>
  </GeneDef>
  <HediffDef>
    <defName>LP_MinotaurHornWeapon</defName>
    <label>犄角</label>
    <description>犄角基因带来的天然近战武器。</description>
    <hediffClass>LichPhylactery.Hediff_MinotaurHorns</hediffClass>
    <isBad>false</isBad>
    <everCurableByItem>false</everCurableByItem>
    <comps>
      <li Class="HediffCompProperties_VerbGiver">
        <tools>
          <li>
            <label>犄角</label>
            <capacities>
              <li>Stab</li>
            </capacities>
            <power>11</power>
            <cooldownTime>2.6</cooldownTime>
            <alwaysTreatAsWeapon>true</alwaysTreatAsWeapon>
          </li>
        </tools>
      </li>
    </comps>
  </HediffDef>

  <GeneDef>
    <defName>LP_MinotaurSnout</defName>
    <label>牛鼻</label>
    <description>宽阔湿润的牛鼻子，鼻孔粗大。纯外观。</description>
    <iconPath>MinotaurGith/Genes/Snout</iconPath>
    <displayCategory>Cosmetic</displayCategory>
    <selectionWeight>0</selectionWeight>
    <biostatCpx>0</biostatCpx>
    <biostatMet>0</biostatMet>
    <exclusionTags>
      <li>Nose</li>
    </exclusionTags>
    <renderNodeProperties>
      <li>
        <nodeClass>PawnRenderNode_AttachmentHead</nodeClass>
        <workerClass>PawnRenderNodeWorker_FlipWhenCrawling</workerClass>
        <texPath>MinotaurGith/Snout/BullSnout</texPath>
        <useSkinShader>true</useSkinShader>
        <useRottenColor>true</useRottenColor>
        <colorType>Skin</colorType>
        <parentTagDef>Head</parentTagDef>
        <rotDrawMode>Fresh, Rotting</rotDrawMode>
        <visibleFacing>
          <li>East</li>
          <li>South</li>
          <li>West</li>
        </visibleFacing>
        <drawData>
          <defaultData>
            <layer>66</layer>
          </defaultData>
        </drawData>
      </li>
    </renderNodeProperties>
  </GeneDef>

  <GeneDef>
    <defName>LP_MinotaurMaze</defName>
    <label>迷宫感</label>
    <description>牛头人生于迷宫，在墙壁和屋顶围起来的地方如鱼得水。站在有屋顶的格子上时移动速度+10%。</description>
    <geneClass>LichPhylactery.Gene_MinotaurMaze</geneClass>
    <iconPath>MinotaurGith/Genes/Maze</iconPath>
    <displayCategory>Movement</displayCategory>
    <selectionWeight>0</selectionWeight>
    <biostatCpx>1</biostatCpx>
    <biostatMet>0</biostatMet>
    <customEffectDescriptions>
      <li>在有屋顶的地方：移动速度×110%。</li>
    </customEffectDescriptions>
  </GeneDef>
  <HediffDef>
    <defName>LP_MinotaurMaze</defName>
    <label>迷宫之中</label>
    <description>头顶有屋顶、四周有墙，牛头人走得更快。</description>
    <hediffClass>LichPhylactery.Hediff_MinotaurMaze</hediffClass>
    <defaultLabelColor>(0.75, 0.6, 0.45)</defaultLabelColor>
    <isBad>false</isBad>
    <everCurableByItem>false</everCurableByItem>
    <stages>
      <li>
        <statFactors>
          <MoveSpeed>1.1</MoveSpeed>
        </statFactors>
      </li>
    </stages>
  </HediffDef>

  <GeneDef>
    <defName>LP_MinotaurStature</defName>
    <label>牛头人体型</label>
    <description>魁梧的牛头人身材。实际体型为普通人的130%（负重、商队载重随之提高，也更容易被远程命中），显示为115%大小；手上搬运量约为普通人的150%。庞大的身躯也意味着饭量是常人的一倍半，胃也更大（巨胃：饱食度上限×130%），一顿撑得更久。体型越大，生命和近战越强（见巨躯规则：生命总量×115%、近战伤害×109%）。</description>
    <geneClass>LichPhylactery.Gene_MinotaurStature</geneClass>
    <iconPath>MinotaurGith/Genes/Stature</iconPath>
    <displayCategory>Miscellaneous</displayCategory>
    <selectionWeight>0</selectionWeight>
    <biostatCpx>1</biostatCpx>
    <biostatMet>0</biostatMet>
    <customEffectDescriptions>
      <li>实际体型：×130%（与其他体型效果相乘）。</li>
      <li>显示大小：×115%。</li>
      <li>搬运量：约为普通人的150%（体型×130%后再×115%）。</li>
      <li>食量：×120%；与牛头人整体代谢-1（原版×125%）合计约为普通人的150%。</li>
    </customEffectDescriptions>
    <modExtensions>
      <li Class="LichPhylactery.SmallBodyExtension">
        <bodySize>1.3</bodySize>
        <renderScale>1.15</renderScale>
        <carryFactor>1.15</carryFactor>
      </li>
    </modExtensions>
  </GeneDef>
  <HediffDef>
    <defName>LP_MinotaurAppetite</defName>
    <label>牛头人食量</label>
    <description>庞大的身躯需要大量食物。</description>
    <hediffClass>LichPhylactery.Hediff_MinotaurAppetite</hediffClass>
    <defaultLabelColor>(0.75, 0.6, 0.45)</defaultLabelColor>
    <isBad>false</isBad>
    <everCurableByItem>false</everCurableByItem>
    <stages>
      <li>
        <hungerRateFactor>1.2</hungerRateFactor>
      </li>
    </stages>
  </HediffDef>

  <!-- ==================== 种族关系 ==================== -->
  <ThoughtDef>
    <defName>LP_RacialRelation_MinotaurHalfOrc</defName>
    <workerClass>LichPhylactery.ThoughtWorker_DNDRacialRelation</workerClass>
    <stages>
      <li>
        <label>痛快的半兽人</label>
        <description>那个半兽人说话直、拳头硬，对牛头人的胃口。</description>
        <baseMoodEffect>2</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>
  <LichPhylactery.RacialRelationDef>
    <defName>LP_Relation_MinotaurHalfOrc</defName>
    <label>牛头人看半兽人</label>
    <observer>LP_Minotaur</observer>
    <target>LP_HalfOrc</target>
    <thought>LP_RacialRelation_MinotaurHalfOrc</thought>
  </LichPhylactery.RacialRelationDef>
  <ThoughtDef>
    <defName>LP_RacialRelation_HalfOrcMinotaur</defName>
    <workerClass>LichPhylactery.ThoughtWorker_DNDRacialRelation</workerClass>
    <stages>
      <li>
        <label>壮实的牛头人</label>
        <description>那个牛头人一身蛮力，打起架来让人放心。</description>
        <baseMoodEffect>2</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>
  <LichPhylactery.RacialRelationDef>
    <defName>LP_Relation_HalfOrcMinotaur</defName>
    <label>半兽人看牛头人</label>
    <observer>LP_HalfOrc</observer>
    <target>LP_Minotaur</target>
    <thought>LP_RacialRelation_HalfOrcMinotaur</thought>
  </LichPhylactery.RacialRelationDef>
</Defs>
