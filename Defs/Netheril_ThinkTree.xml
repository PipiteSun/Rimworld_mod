<?xml version="1.0" encoding="utf-8"?>
<!-- 1.52.0 补丁：空闲时自动研读耐瑟卷轴。插在原版 Humanlike 的 Humanlike_PostMain：殖民者主体行为（工作、吃饭睡觉、娱乐、冥想）都没给出 job 之后、闲逛之前。
     insertPriority -10：同一插入点里排在其他模组的默认（0）插入项之后。条件和选卷在 Source/NetherilScrolls.cs 的 NetherilIdle。 -->
<Defs>
  <ThinkTreeDef>
    <defName>LP_NetherilIdleStudy</defName>
    <insertTag>Humanlike_PostMain</insertTag>
    <insertPriority>-10</insertPriority>
    <thinkRoot Class="ThinkNode_ConditionalColonist">
      <subNodes>
        <li Class="ThinkNode_Tagger">
          <tagToGive>Misc</tagToGive>
          <subNodes>
            <li Class="LichPhylactery.JobGiver_NetherilIdleStudy" />
          </subNodes>
        </li>
      </subNodes>
    </thinkRoot>
  </ThinkTreeDef>

  <!-- 1.52.0 补丁：读耐瑟卷轴也算“冥想”类娱乐。原版按娱乐类型挑 JoyGiver，所以加一个冥想类的读耐瑟卷轴（原版“阅读”那个照常也能挑到它们）。 -->
  <!-- 1.63.0：这个娱乐提供者故意用“阅读”工作、算“冥想”类（见上），原版定义检查会报类型不一致；用子类只跳过这一条检查。 -->
  <JoyGiverDef Class="LichPhylactery.JoyGiverDef_CrossKind">
    <defName>LP_NetherilMeditativeReading</defName>
    <giverClass>LichPhylactery.JoyGiver_NetherilRead</giverClass>
    <baseChance>1.5</baseChance>
    <jobDef>Reading</jobDef>
    <joyKind>Meditative</joyKind>
    <requiredCapacities>
      <li>Sight</li>
      <li>Manipulation</li>
    </requiredCapacities>
  </JoyGiverDef>
</Defs>
