  <ThingDef ParentName="LP_LegendaryMonsterBase">
    <defName>LP_Behir</defName>
    <label>贝希尔</label>
    <description>蓝色鳞片、十二条腿的巨大蛇形怪物，住在高山和沙漠的洞穴里。它是真龙的死敌：闻到龙的气味就会追上去，喷出一道闪电，把敌人整个吞下。</description>
    <statBases>
      <MarketValue>6000</MarketValue>
      <PsychicSensitivity>0.8</PsychicSensitivity>
      <Wildness>1</Wildness>
      <LeatherAmount>0</LeatherAmount>
      <MeatAmount>0</MeatAmount>
      <FilthRate>1</FilthRate>
      <MoveSpeed>5.0</MoveSpeed>
      <ComfyTemperatureMin>-40</ComfyTemperatureMin>
      <ComfyTemperatureMax>60</ComfyTemperatureMax>
    </statBases>
    <tradeability>None</tradeability>
    <race>
      <body>LP_BehirBody</body>
      <baseBodySize>1</baseBodySize>
      <baseHealthScale>1</baseHealthScale>
      <baseHungerRate>0.5</baseHungerRate>
      <foodType>CarnivoreAnimal</foodType>
      <useMeatFrom>Thrumbo</useMeatFrom>
      <lifeExpectancy>3000</lifeExpectancy>
      <hasGenders>false</hasGenders>
      <trainability>None</trainability>
      <petness>0</petness>
      <nameOnTameChance>0</nameOnTameChance>
      <manhunterOnDamageChance>0</manhunterOnDamageChance>
      <manhunterOnTameFailChance>0</manhunterOnTameFailChance>
      <canBePredatorPrey>false</canBePredatorPrey>
