<?xml version="1.0" encoding="utf-8"?>
<!-- 1.57.0 普通种族的种族限定背景（照 1.46.0 写法：spawnCategories 用 LP_Race_*，规则在 BackstoryPools.xml）。 -->
<Defs>
  <!-- 木精灵 -->
  <BackstoryDef>
    <defName>LP_Bs_WoodElfChild</defName>
    <title>古林里的小猎手</title>
    <titleShort>小猎手</titleShort>
    <description>[PAWN_nameDef]学会走路的同时就学会了拉弓。古林里的每一棵橡树都认得[PAWN_nameDef]，鹿群也从不躲[PAWN_objective]。</description>
    <slot>Childhood</slot>
    <spawnCategories><li>LP_Race_WoodElf</li></spawnCategories>
    <skillGains><Shooting>3</Shooting><Plants>2</Plants></skillGains>
  </BackstoryDef>
  <BackstoryDef>
    <defName>LP_Bs_WoodElfWarden</defName>
    <title>林地守望者</title>
    <titleShort>守望者</titleShort>
    <description>[PAWN_nameDef]守着古林的边界整整一个世纪：伐木工、偷猎者、迷路的兽人，都在[PAWN_possessive]的箭下掉过头。</description>
    <slot>Adulthood</slot>
    <spawnCategories><li>LP_Race_WoodElf</li></spawnCategories>
    <skillGains><Shooting>4</Shooting><Plants>3</Plants><Animals>2</Animals></skillGains>
    <workDisables>Intellectual</workDisables>
  </BackstoryDef>
  <!-- 卓尔 -->
  <BackstoryDef>
    <defName>LP_Bs_DrowHouseChild</defName>
    <title>魔索布莱城的幼子</title>
    <titleShort>卓尔幼子</titleShort>
    <description>[PAWN_nameDef]出生在幽暗地域一座卓尔家族的蛛网塔里。在那里，孩子学会的第一件事是不要相信兄弟姐妹，第二件事是怎么往刀上抹毒。</description>
    <slot>Childhood</slot>
    <spawnCategories><li>LP_Race_Drow</li></spawnCategories>
    <skillGains><Melee>3</Melee><Social>2</Social></skillGains>
  </BackstoryDef>
  <BackstoryDef>
    <defName>LP_Bs_DrowRenegade</defName>
    <title>逃离蛛后的叛徒</title>
    <titleShort>卓尔叛徒</titleShort>
    <description>[PAWN_nameDef]受够了罗丝祭司的阴谋，带着一把淬毒短剑逃上地表。阳光刺得[PAWN_objective]睁不开眼，可总比回去强。</description>
    <slot>Adulthood</slot>
    <spawnCategories><li>LP_Race_Drow</li></spawnCategories>
    <skillGains><Melee>4</Melee><Medicine>2</Medicine><Social>-2</Social></skillGains>
  </BackstoryDef>
  <!-- 丘陵矮人 -->
  <BackstoryDef>
    <defName>LP_Bs_HillDwarfChild</defName>
    <title>丘陵酿酒坊的孩子</title>
    <titleShort>酿酒坊孩子</titleShort>
    <description>[PAWN_nameDef]在丘陵矮人的酒窖里长大，十岁就能分清三十种麦芽，十二岁第一次把老爹灌倒在桌子底下。</description>
    <slot>Childhood</slot>
    <spawnCategories><li>LP_Race_HillDwarf</li></spawnCategories>
    <skillGains><Cooking>3</Cooking><Mining>2</Mining></skillGains>
  </BackstoryDef>
  <BackstoryDef>
    <defName>LP_Bs_HillDwarfShieldbearer</defName>
    <title>丘陵盾卫</title>
    <titleShort>盾卫</titleShort>
    <description>[PAWN_nameDef]在丘陵矮人的盾墙里站了几十年，挨过的刀伤比别人见过的都多。[PAWN_pronoun]从不说累，只说"再来一杯"。</description>
    <slot>Adulthood</slot>
    <spawnCategories><li>LP_Race_HillDwarf</li></spawnCategories>
    <skillGains><Melee>4</Melee><Construction>3</Construction></skillGains>
  </BackstoryDef>
  <!-- 轻足半身人 -->
  <BackstoryDef>
    <defName>LP_Bs_LightfootChild</defName>
    <title>大篷车上的半身人</title>
    <titleShort>大篷车孩子</titleShort>
    <description>[PAWN_nameDef]跟着家族的大篷车走遍了剑湾沿岸，在每一座集市上都交到了朋友，也在每一座集市上都顺走过一块蜂蜜蛋糕。</description>
    <slot>Childhood</slot>
    <spawnCategories><li>LP_Race_HalflingLightfoot</li></spawnCategories>
    <skillGains><Social>3</Social><Cooking>2</Cooking></skillGains>
  </BackstoryDef>
  <BackstoryDef>
    <defName>LP_Bs_LightfootWanderer</defName>
    <title>轻足游商</title>
    <titleShort>游商</titleShort>
    <description>[PAWN_nameDef]靠一张嘴和一包香料走南闯北。遇到麻烦时，[PAWN_pronoun]总能找到一个大个子挡在前面。</description>
    <slot>Adulthood</slot>
    <spawnCategories><li>LP_Race_HalflingLightfoot</li></spawnCategories>
    <skillGains><Social>4</Social><Plants>2</Plants><Cooking>2</Cooking></skillGains>
  </BackstoryDef>
  <!-- 敦实半身人 -->
  <BackstoryDef>
    <defName>LP_Bs_StoutChild</defName>
    <title>洞穴小屋的孩子</title>
    <titleShort>小屋孩子</titleShort>
    <description>[PAWN_nameDef]在山坡下的圆门洞屋里长大，每天吃六顿饭，睡到太阳晒屁股。家里的菜园是全村最好的。</description>
    <slot>Childhood</slot>
    <spawnCategories><li>LP_Race_HalflingStout</li></spawnCategories>
    <skillGains><Plants>3</Plants><Cooking>2</Cooking></skillGains>
  </BackstoryDef>
  <BackstoryDef>
    <defName>LP_Bs_StoutInnkeeper</defName>
    <title>敦实族旅店老板</title>
    <titleShort>旅店老板</titleShort>
    <description>[PAWN_nameDef]开的旅店以炖菜和麦酒闻名。来过的矮人都说那是地表上最像家的地方，这话[PAWN_pronoun]一直挂在嘴边。</description>
    <slot>Adulthood</slot>
    <spawnCategories><li>LP_Race_HalflingStout</li></spawnCategories>
    <skillGains><Cooking>4</Cooking><Social>2</Social><Plants>2</Plants></skillGains>
  </BackstoryDef>
  <!-- 岩侏儒 -->
  <BackstoryDef>
    <defName>LP_Bs_RockGnomeChild</defName>
    <title>齿轮堆里的侏儒</title>
    <titleShort>齿轮侏儒</titleShort>
    <description>[PAWN_nameDef]五岁拆了家里的钟，六岁装回去了，还多出两个零件。从那以后家里所有会动的东西都被[PAWN_objective]改过。</description>
    <slot>Childhood</slot>
    <spawnCategories><li>LP_Race_RockGnome</li></spawnCategories>
    <skillGains><Crafting>3</Crafting><Intellectual>2</Intellectual></skillGains>
  </BackstoryDef>
  <BackstoryDef>
    <defName>LP_Bs_RockGnomeTinker</defName>
    <title>发条匠人</title>
    <titleShort>发条匠</titleShort>
    <description>[PAWN_nameDef]做的发条甲虫会飞，发条小狗会叫，发条门锁会骂小偷。只是有一半作品在第一次上弦时就炸了。</description>
    <slot>Adulthood</slot>
    <spawnCategories><li>LP_Race_RockGnome</li></spawnCategories>
    <skillGains><Crafting>5</Crafting><Intellectual>3</Intellectual></skillGains>
  </BackstoryDef>
  <!-- 森林侏儒 -->
  <BackstoryDef>
    <defName>LP_Bs_ForestGnomeChild</defName>
    <title>树洞里的侏儒</title>
    <titleShort>树洞侏儒</titleShort>
    <description>[PAWN_nameDef]的童年玩伴是一只獾和三只松鼠。森林侏儒的村子藏在幻术后面，外人从来找不到。</description>
    <slot>Childhood</slot>
    <spawnCategories><li>LP_Race_ForestGnome</li></spawnCategories>
    <skillGains><Animals>3</Animals><Plants>2</Plants></skillGains>
  </BackstoryDef>
  <BackstoryDef>
    <defName>LP_Bs_ForestGnomeFriend</defName>
    <title>林间幻术师</title>
    <titleShort>幻术师</titleShort>
    <description>[PAWN_nameDef]用小小的幻术保护林子：让猎人看见不存在的熊，让迷路的孩子跟着萤火走回家。</description>
    <slot>Adulthood</slot>
    <spawnCategories><li>LP_Race_ForestGnome</li></spawnCategories>
    <skillGains><Animals>4</Animals><Intellectual>2</Intellectual><Plants>2</Plants></skillGains>
  </BackstoryDef>
  <!-- 地侏 -->
  <BackstoryDef>
    <defName>LP_Bs_DeepGnomeChild</defName>
    <title>幽暗地域的矿工之子</title>
    <titleShort>地侏矿工子</titleShort>
    <description>[PAWN_nameDef]在没有阳光的城市里长大，学会的第一件事是一动不动地贴着石壁，等巡逻的卓尔走过去。</description>
    <slot>Childhood</slot>
    <spawnCategories><li>LP_Race_DeepGnome</li></spawnCategories>
    <skillGains><Mining>3</Mining><Intellectual>2</Intellectual></skillGains>
  </BackstoryDef>
  <BackstoryDef>
    <defName>LP_Bs_DeepGnomeGemcutter</defName>
    <title>地侏宝石匠</title>
    <titleShort>宝石匠</titleShort>
    <description>[PAWN_nameDef]能听出石头里哪一块藏着宝石。[PAWN_pronoun]逃上地表时，口袋里只带了一块没切好的蓝宝石和满肚子的不信任。</description>
    <slot>Adulthood</slot>
    <spawnCategories><li>LP_Race_DeepGnome</li></spawnCategories>
    <skillGains><Mining>4</Mining><Crafting>3</Crafting><Social>-2</Social></skillGains>
  </BackstoryDef>
  <!-- 半精灵 -->
  <BackstoryDef>
    <defName>LP_Bs_HalfElfChild</defName>
    <title>两族之间的孩子</title>
    <titleShort>混血孩子</titleShort>
    <description>精灵嫌[PAWN_nameDef]长得太快，人类嫌[PAWN_nameDef]长得太慢。[PAWN_pronoun]学会了在两边都说好话，也学会了在两边都不太当真。</description>
    <slot>Childhood</slot>
    <spawnCategories><li>LP_Race_HalfElf</li></spawnCategories>
    <skillGains><Social>3</Social><Artistic>2</Artistic></skillGains>
  </BackstoryDef>
  <BackstoryDef>
    <defName>LP_Bs_HalfElfEnvoy</defName>
    <title>边境使节</title>
    <titleShort>使节</titleShort>
    <description>[PAWN_nameDef]替人类城邦和精灵王庭跑腿传话多年，调停过三场差点打起来的边境纠纷。两边都离不开[PAWN_objective]，两边也都不完全信[PAWN_objective]。</description>
    <slot>Adulthood</slot>
    <spawnCategories><li>LP_Race_HalfElf</li></spawnCategories>
    <skillGains><Social>5</Social><Intellectual>2</Intellectual></skillGains>
  </BackstoryDef>
  <!-- 狗头人 -->
  <BackstoryDef>
    <defName>LP_Bs_KoboldWarrenChild</defName>
    <title>龙穴里的蛋</title>
    <titleShort>龙穴幼崽</titleShort>
    <description>[PAWN_nameDef]从一颗蛋里孵出来，第一眼看到的是一堆金币，第二眼看到的是金币上睡着的龙。从此[PAWN_pronoun]就知道自己为什么而活。</description>
    <slot>Childhood</slot>
    <spawnCategories><li>LP_Race_Kobold</li></spawnCategories>
    <skillGains><Mining>3</Mining><Crafting>2</Crafting></skillGains>
  </BackstoryDef>
  <BackstoryDef>
    <defName>LP_Bs_KoboldTrapper</defName>
    <title>狗头人陷阱师</title>
    <titleShort>陷阱师</titleShort>
    <description>[PAWN_nameDef]在龙穴的每一条通道里都埋过东西：刺坑、落石、绊索、装满蜜蜂的罐子。冒险者都恨[PAWN_objective]，龙却很喜欢[PAWN_objective]。</description>
    <slot>Adulthood</slot>
    <spawnCategories><li>LP_Race_Kobold</li></spawnCategories>
    <skillGains><Construction>4</Construction><Crafting>3</Crafting><Mining>2</Mining></skillGains>
  </BackstoryDef>
  <!-- 地精三族（共用） -->
  <BackstoryDef>
    <defName>LP_Bs_GoblinCampChild</defName>
    <title>战帮营地的崽子</title>
    <titleShort>营地崽子</titleShort>
    <description>[PAWN_nameDef]在地精战帮的营地里长大，抢剩饭、躲鞭子、偷看大地精操练。活下来的地精崽子，个个都很机灵。</description>
    <slot>Childhood</slot>
    <spawnCategories><li>LP_Race_Goblinoid</li></spawnCategories>
    <skillGains><Melee>2</Melee><Shooting>2</Shooting><Animals>1</Animals></skillGains>
  </BackstoryDef>
  <BackstoryDef>
    <defName>LP_Bs_GoblinoidLegion</defName>
    <title>军团逃兵</title>
    <titleShort>逃兵</titleShort>
    <description>[PAWN_nameDef]曾经在大地精军团的阵列里服役，见过太多同伴被当成攻城的垫脚石。一个雨夜，[PAWN_pronoun]扔下军旗跑了。</description>
    <slot>Adulthood</slot>
    <spawnCategories><li>LP_Race_Goblinoid</li></spawnCategories>
    <skillGains><Shooting>3</Shooting><Melee>3</Melee><Construction>2</Construction></skillGains>
  </BackstoryDef>
  <BackstoryDef>
    <defName>LP_Bs_BugbearAmbusher</defName>
    <title>林道伏击者</title>
    <titleShort>伏击者</titleShort>
    <description>[PAWN_nameDef]能在树影里蹲上一整天，只为等一辆落单的马车。熊地精懒，可伏击的时候从不偷懒。</description>
    <slot>Adulthood</slot>
    <spawnCategories><li>LP_Race_Goblinoid</li></spawnCategories>
    <skillGains><Melee>5</Melee><Animals>2</Animals></skillGains>
    <workDisables>Intellectual</workDisables>
  </BackstoryDef>
</Defs>
