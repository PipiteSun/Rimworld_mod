<?xml version="1.0" encoding="utf-8"?>
<!-- 1.24.0 鸟人：可遗传。真飞不改寻路，做成“翱翔”穿墙位移；自绘翅膀（身体附件）。 -->
<Defs>
  <XenotypeDef>
    <defName>LP_Aarakocra</defName>
    <label>鸟人</label>
    <description>背生双翼、骨头中空的飞禽种族。鸟人能张开翅膀翱翔到12格外，墙、栅栏和河流都拦不住他们；他们眼力好、擅长射箭，在开阔的天空下干活最开心。代价是身子单薄、近战吃亏，在屋檐下闷久了会心情不好。血脉会遗传给子女。</description>
    <descriptionShort>可遗传。能“翱翔”越过墙和水（12格），移速+10%、擅长射击；体型0.9、骨头脆、娇弱、不擅近战，怕封闭。</descriptionShort>
    <iconPath>Races124/Xenotypes/Aarakocra</iconPath>
    <inheritable>true</inheritable>
    <combatPowerFactor>1.1</combatPowerFactor>
    <factionlessGenerationWeight>0</factionlessGenerationWeight>
    <genes>
      <li>LP_AarakocraWings</li>
      <li>LP_AarakocraHollowBones</li>
      <li>LP_AarakocraSkyborn</li>
      <li>LP_SkinAarakocra</li>
      <li>Body_Thin</li>
      <li>AptitudeStrong_Shooting</li>
      <li>Ears_Pointed</li>
      <li>Delicate</li>
      <li>AptitudePoor_Melee</li>
    </genes>
  </XenotypeDef>

  <GeneDef>
    <defName>LP_AarakocraWings</defName>
    <label>羽翼</label>
    <description>背上一对宽大的羽翼。鸟人能“翱翔”到12格内任意能站人的地方，墙、栅栏、水和建筑都拦不住，只是不能飞进山体下面。征召与否都能用，平时可以用来越墙干活。</description>
    <iconPath>Races124/Genes/AarakocraWings</iconPath>
    <displayCategory>Movement</displayCategory>
    <selectionWeight>0</selectionWeight>
    <biostatCpx>2</biostatCpx>
    <biostatMet>-3</biostatMet>
    <abilities>
      <li>LP_Soar</li>
    </abilities>
    <descriptionHyperlinks>
      <AbilityDef>LP_Soar</AbilityDef>
    </descriptionHyperlinks>
    <renderNodeProperties>
      <li>
        <workerClass>PawnRenderNodeWorker_AttachmentBody</workerClass>
        <texPath>Races124/Wings/AarakocraWings</texPath>
        <color>(255, 255, 255)</color>
        <overrideMeshSize>(1.5, 1.5)</overrideMeshSize>
        <parentTagDef>Body</parentTagDef>
        <rotDrawMode>Fresh, Rotting</rotDrawMode>
        <drawData>
          <scaleOffsetByBodySize>true</scaleOffsetByBodySize>
          <defaultData>
            <layer>-2</layer>
          </defaultData>
          <dataNorth>
            <layer>90</layer>
          </dataNorth>
        </drawData>
      </li>
    </renderNodeProperties>
  </GeneDef>
  <AbilityDef ParentName="LP_Races124AbilityBase">
    <defName>LP_Soar</defName>
    <label>翱翔</label>
    <description>张开羽翼飞到12格内任意能站人的地方（穿着风羽披风的鸟人16格），不需要视线，墙、栅栏、水和建筑都拦不住；但不能落到山体（厚岩顶）下面。冷却4小时（穿风羽披风×75%）。</description>
    <iconPath>Races124/Abilities/Soar</iconPath>
    <cooldownTicksRange>10000</cooldownTicksRange>
    <hostile>false</hostile>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <range>16</range>
      <warmupTime>0.4</warmupTime>
      <requireLineOfSight>false</requireLineOfSight>
      <targetParams>
        <canTargetLocations>true</canTargetLocations>
        <canTargetPawns>false</canTargetPawns>
        <canTargetBuildings>false</canTargetBuildings>
        <canTargetSelf>false</canTargetSelf>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="LichPhylactery.CompProperties_Races124Ability"><effect>soar</effect></li>
    </comps>
  </AbilityDef>

  <GeneDef>
    <defName>LP_AarakocraHollowBones</defName>
    <label>空心骨</label>
    <description>鸟人轻巧的中空骨骼。实际体型为普通人的90%（吃得少、更难被射中），但骨头脆，受到的钝器伤害+10%。</description>
    <iconPath>Races124/Genes/AarakocraHollowBones</iconPath>
    <displayCategory>Miscellaneous</displayCategory>
    <selectionWeight>0</selectionWeight>
    <biostatCpx>1</biostatCpx>
    <biostatMet>0</biostatMet>
    <damageFactors>
      <Blunt>1.1</Blunt>
    </damageFactors>
    <customEffectDescriptions>
      <li>实际体型：×90%（显示大小不变）。</li>
    </customEffectDescriptions>
    <modExtensions>
      <li Class="LichPhylactery.SmallBodyExtension">
        <bodySize>0.9</bodySize>
        <renderScale>1.0</renderScale>
      </li>
    </modExtensions>
  </GeneDef>

  <GeneDef>
    <defName>LP_AarakocraSkyborn</defName>
    <label>天生飞禽</label>
    <description>生在天空下的鸟人走得快（移速×110%），在无屋顶的地方干活心情+2；可在有屋顶的地方醒着连续待满1小时就会觉得被关住（心情-3），到露天处待一小会儿就好。睡觉时不算。</description>
    <geneClass>LichPhylactery.Gene_AarakocraSkyborn</geneClass>
    <iconPath>Races124/Genes/AarakocraSkyborn</iconPath>
    <displayCategory>Mood</displayCategory>
    <selectionWeight>0</selectionWeight>
    <biostatCpx>1</biostatCpx>
    <biostatMet>-2</biostatMet>
    <statFactors>
      <MoveSpeed>1.1</MoveSpeed>
    </statFactors>
  </GeneDef>
  <ThoughtDef>
    <defName>LP_AarakocraCaged</defName>
    <workerClass>LichPhylactery.ThoughtWorker_AarakocraCaged</workerClass>
    <validWhileDespawned>false</validWhileDespawned>
    <stages>
      <li>
        <label>囚于屋檐</label>
        <description>头顶全是屋梁，翅膀都张不开。我想看看天。</description>
        <baseMoodEffect>-3</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>
  <ThoughtDef>
    <defName>LP_AarakocraOpenSky</defName>
    <workerClass>LichPhylactery.ThoughtWorker_AarakocraOpenSky</workerClass>
    <validWhileDespawned>false</validWhileDespawned>
    <stages>
      <li>
        <label>天空在上</label>
        <description>头顶就是天空，风从羽毛间穿过。干活都有劲了。</description>
        <baseMoodEffect>2</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <GeneDef ParentName="GeneSkinColorOverride">
    <defName>LP_SkinAarakocra</defName>
    <label>鸟人肤色</label>
    <labelShortAdj>浅褐</labelShortAdj>
    <description>鸟人浅褐色的皮肤，和羽毛的颜色相近。</description>
    <skinColorOverride>(200, 170, 120)</skinColorOverride>
    <randomBrightnessFactor>0.08</randomBrightnessFactor>
    <selectionWeight>0</selectionWeight>
    <displayOrderInCategory>1</displayOrderInCategory>
  </GeneDef>

  <!-- ==================== 种族关系 ==================== -->
  <ThoughtDef>
    <defName>LP_RacialRelation_AarakocraElf</defName>
    <workerClass>LichPhylactery.ThoughtWorker_DNDRacialRelation</workerClass>
    <stages>
      <li>
        <label>林梢的朋友</label>
        <description>那个精灵也喜欢高处和风，我们常在树梢上聊天。</description>
        <baseMoodEffect>1</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>
  <LichPhylactery.RacialRelationDef>
    <defName>LP_Relation_AarakocraElf</defName>
    <label>鸟人看精灵</label>
    <observer>LP_Aarakocra</observer>
    <target>LP_Elf</target>
    <thought>LP_RacialRelation_AarakocraElf</thought>
  </LichPhylactery.RacialRelationDef>
  <ThoughtDef>
    <defName>LP_RacialRelation_ElfAarakocra</defName>
    <workerClass>LichPhylactery.ThoughtWorker_DNDRacialRelation</workerClass>
    <stages>
      <li>
        <label>林梢的朋友</label>
        <description>那个鸟人的羽毛和林子的颜色一样，说话也像鸟鸣。</description>
        <baseMoodEffect>1</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>
  <LichPhylactery.RacialRelationDef>
    <defName>LP_Relation_ElfAarakocra</defName>
    <label>精灵看鸟人</label>
    <observer>LP_Elf</observer>
    <target>LP_Aarakocra</target>
    <thought>LP_RacialRelation_ElfAarakocra</thought>
  </LichPhylactery.RacialRelationDef>
  <ThoughtDef>
    <defName>LP_RacialRelation_AarakocraMindFlayer</defName>
    <workerClass>LichPhylactery.ThoughtWorker_DNDRacialRelation</workerClass>
    <stages>
      <li>
        <label>地底的怪物</label>
        <description>那个夺心魔是从不见天日的地底爬出来的。光是想想就让我羽毛倒竖。</description>
        <baseMoodEffect>-3</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>
  <LichPhylactery.RacialRelationDef>
    <defName>LP_Relation_AarakocraMindFlayer</defName>
    <label>鸟人看夺心魔</label>
    <observer>LP_Aarakocra</observer>
    <target>LP_MindFlayer</target>
    <thought>LP_RacialRelation_AarakocraMindFlayer</thought>
  </LichPhylactery.RacialRelationDef>
</Defs>
