<?xml version="1.0" encoding="utf-8"?>
<!-- 子职业（见 ArtSource/Subclasses-spec.md / Source/ClassSubclass.cs）：野蛮人、游侠、游荡者各 3 个，职业 3 级选一个（选定不能改），能力在职业 3 / 7 / 11 / 15 级获得；
     每个职业另有 2 个通用能力（general，7 / 11 级自动获得）。分支（choices）在子职业窗口里选，到等级才能选。 -->
<Defs>
  <!-- ===================== 子职业 ===================== -->
  <LichPhylactery.LP_SubclassDef>
    <defName>LP_Sub_BarbarianGeneral</defName>
    <label>野蛮人通用</label>
    <description>所有野蛮人都会的两项能力。</description>
    <parent>LP_Class_Barbarian</parent><general>true</general><order>0</order>
    <abilities><li><ability>LP_FeralInstinct</ability><level>7</level></li><li><ability>LP_RecklessCharge</ability><level>11</level></li></abilities>
  </LichPhylactery.LP_SubclassDef>
  <LichPhylactery.LP_SubclassDef>
    <defName>LP_Sub_Berserker</defName>
    <label>狂战士之道</label>
    <description>为杀戮而狂暴：狂暴中出手更快、心志不可动摇，眼神就能吓退敌人，挨打必还手。</description>
    <parent>LP_Class_Barbarian</parent><order>1</order><emblem>LP/Classes/Subclass/Emblem_Berserker</emblem><color>(0.9,0.4,0.32)</color>
    <abilities><li><ability>LP_Frenzy</ability><level>3</level></li><li><ability>LP_MindlessRage</ability><level>7</level></li><li><ability>LP_IntimidatingPresence</ability><level>11</level></li><li><ability>LP_Retaliation</ability><level>15</level></li></abilities>
  </LichPhylactery.LP_SubclassDef>
  <LichPhylactery.LP_SubclassDef>
    <defName>LP_Sub_TotemWarrior</defName>
    <label>图腾勇士之道</label>
    <description>与一种图腾兽的灵魂结盟（熊、鹰、狼选一次，不能改），所有能力都随图腾变化。</description>
    <parent>LP_Class_Barbarian</parent><order>2</order><emblem>LP/Classes/Subclass/Emblem_TotemWarrior</emblem><color>(0.72,0.58,0.4)</color>
    <abilities><li><ability>LP_TotemSpiritRage</ability><level>3</level></li><li><ability>LP_AspectOfBeast</ability><level>7</level></li><li><ability>LP_SpiritWalker</ability><level>11</level></li><li><ability>LP_TotemAttunement</ability><level>15</level></li></abilities>
    <choices><li><key>totem</key><label>图腾</label><level>3</level>
      <options><li>熊</li><li>鹰</li><li>狼</li></options>
      <tips><li>狂暴中除心灵外所有伤害 ×0.5；负重 ×2；灵魂行者召来灰熊；图腾调和嘲讽身边敌人。</li><li>狂暴中远程命中你 ×0.7、移动 ×1.2；远程射程 +3；灵魂行者召来鹰灵（食火鸡形）；图腾调和在狂暴中滑翔。</li><li>狂暴中 5 格内友军近战命中 +15%；移动 ×1.1、追踪逃跑的敌人；灵魂行者召来森林狼；图腾调和让近战命中撞倒目标。</li></tips></li></choices>
  </LichPhylactery.LP_SubclassDef>
  <LichPhylactery.LP_SubclassDef>
    <defName>LP_Sub_StormHerald</defName>
    <label>风暴先驱之道</label>
    <description>狂暴时化身风暴（沙漠之火、海洋之雷、冻原之冰选一次，不能改）：身边的敌人持续受伤，友军得到庇护。</description>
    <parent>LP_Class_Barbarian</parent><order>3</order><emblem>LP/Classes/Subclass/Emblem_StormHerald</emblem><color>(0.55,0.7,0.9)</color>
    <abilities><li><ability>LP_StormAura</ability><level>3</level></li><li><ability>LP_StormSoul</ability><level>7</level></li><li><ability>LP_ShieldingStorm</ability><level>11</level></li><li><ability>LP_RagingStorm</ability><level>15</level></li></abilities>
    <choices><li><key>element</key><label>风暴</label><level>3</level>
      <options><li>沙漠（火）</li><li>海洋（雷）</li><li>冻原（冰）</li></options>
      <tips><li>光环灼烧；火焰伤害 ×0.5，舒适温度上限 +40℃；狂暴风暴可能点燃敌人。</li><li>光环电击（机械体 EMP）；闪电伤害 ×0.5，舒适温度两头各 ±20℃；狂暴风暴可能击晕敌人。</li><li>光环冰霜；冰霜伤害 ×0.5，舒适温度下限 −40℃；狂暴风暴可能让敌人减速。</li></tips></li></choices>
  </LichPhylactery.LP_SubclassDef>

  <LichPhylactery.LP_SubclassDef>
    <defName>LP_Sub_RogueGeneral</defName>
    <label>游荡者通用</label>
    <description>所有游荡者都会的两项能力。</description>
    <parent>LP_Class_Rogue</parent><general>true</general><order>0</order>
    <abilities><li><ability>LP_RogueEvasion</ability><level>7</level></li><li><ability>LP_SteadyTarget</ability><level>11</level></li></abilities>
  </LichPhylactery.LP_SubclassDef>
  <LichPhylactery.LP_SubclassDef>
    <defName>LP_Sub_Assassin</defName>
    <label>刺客</label>
    <description>一击致命的专家：没进入战斗的敌人挨一下就是重击，倒下、被控住的目标更是死路一条。</description>
    <parent>LP_Class_Rogue</parent><order>1</order><emblem>LP/Classes/Subclass/Emblem_Assassin</emblem><color>(0.7,0.4,0.45)</color>
    <abilities><li><ability>LP_AssassinsOpening</ability><level>3</level></li><li><ability>LP_Impostor</ability><level>7</level></li><li><ability>LP_DeadlyStrike</ability><level>11</level></li><li><ability>LP_DeathStrike</ability><level>15</level></li></abilities>
  </LichPhylactery.LP_SubclassDef>
  <LichPhylactery.LP_SubclassDef>
    <defName>LP_Sub_Thief</defName>
    <label>盗贼</label>
    <description>手快、脚快、眼尖：顺手牵羊、翻墙越脊、找得到宝藏，开打的头几秒快得惊人。</description>
    <parent>LP_Class_Rogue</parent><order>2</order><emblem>LP/Classes/Subclass/Emblem_Thief</emblem><color>(0.62,0.66,0.5)</color>
    <abilities><li><ability>LP_FastHands</ability><level>3</level></li><li><ability>LP_SecondStoryWork</ability><level>7</level></li><li><ability>LP_TreasureSense</ability><level>11</level></li><li><ability>LP_ThiefReflexes</ability><level>15</level></li></abilities>
  </LichPhylactery.LP_SubclassDef>
  <LichPhylactery.LP_SubclassDef>
    <defName>LP_Sub_ArcaneTrickster</defName>
    <label>诡术师</label>
    <description>学了点奥术的游荡者：有自己的法力（规则同法师），会法师之手、魔能飞弹、隐形术、睡眠术，还能偷走敌人的法术。</description>
    <parent>LP_Class_Rogue</parent><order>3</order><emblem>LP/Classes/Subclass/Emblem_ArcaneTrickster</emblem><color>(0.62,0.5,0.9)</color>
    <abilities><li><ability>LP_MageHand</ability><level>3</level></li><li><ability>LP_ATMagicMissile</ability><level>3</level></li><li><ability>LP_ATInvisibility</ability><level>3</level></li><li><ability>LP_ATSleep</ability><level>3</level></li>
      <li><ability>LP_MagicalAmbush</ability><level>7</level></li><li><ability>LP_VersatileTrickster</ability><level>11</level></li><li><ability>LP_SpellThief</ability><level>15</level></li></abilities>
  </LichPhylactery.LP_SubclassDef>

  <LichPhylactery.LP_SubclassDef>
    <defName>LP_Sub_RangerGeneral</defName>
    <label>游侠通用</label>
    <description>所有游侠都会的两项能力。</description>
    <parent>LP_Class_Ranger</parent><general>true</general><order>0</order>
    <abilities><li><ability>LP_FieldEye</ability><level>7</level></li><li><ability>LP_ThornTrap</ability><level>11</level></li></abilities>
  </LichPhylactery.LP_SubclassDef>
  <LichPhylactery.LP_SubclassDef>
    <defName>LP_Sub_Hunter</defName>
    <label>猎人</label>
    <description>专门对付威胁的猎手：选一种猎杀之道（3 级）和一种防御战术（7 级），能同时攻击身边所有敌人。</description>
    <parent>LP_Class_Ranger</parent><order>1</order><emblem>LP/Classes/Subclass/Emblem_Hunter</emblem><color>(0.6,0.72,0.42)</color>
    <abilities><li><ability>LP_HuntersPrey</ability><level>3</level></li><li><ability>LP_DefensiveTactics</ability><level>7</level></li><li><ability>LP_MultiAttack</ability><level>11</level></li><li><ability>LP_SuperiorDefense</ability><level>15</level></li></abilities>
    <choices>
      <li><key>prey</key><label>猎手之选</label><level>3</level>
        <options><li>巨像杀手</li><li>群敌杀手</li></options>
        <tips><li>对已经受伤的目标伤害 ×1.25。</li><li>身边贴着 3 个以上敌人时，近战命中后对另一个相邻敌人再打一次（每秒一次）。</li></tips></li>
      <li><key>defense</key><label>防御战术</label><level>7</level>
        <options><li>多重攻击防御</li><li>逃脱之术</li></options>
        <tips><li>同一个敌人 3 秒内第二次起打中你，伤害 ×0.5。</li><li>爆炸、火焰这类躲得开的伤害 ×0.5。</li></tips></li>
    </choices>
  </LichPhylactery.LP_SubclassDef>
  <LichPhylactery.LP_SubclassDef>
    <defName>LP_Sub_BeastMaster</defName>
    <label>兽王</label>
    <description>与一只动物结成游侠伙伴：它跟着你成长（野性等级跟到你的冒险者等级），学会特技，攻击翻倍，还能分享你的增益。</description>
    <parent>LP_Class_Ranger</parent><order>2</order><emblem>LP/Classes/Subclass/Emblem_BeastMaster</emblem><color>(0.72,0.6,0.4)</color>
    <abilities><li><ability>LP_RangerCompanion</ability><level>3</level></li><li><ability>LP_ExceptionalTraining</ability><level>7</level></li><li><ability>LP_BestialFury</ability><level>11</level></li><li><ability>LP_ShareSpells</ability><level>15</level></li></abilities>
  </LichPhylactery.LP_SubclassDef>
  <LichPhylactery.LP_SubclassDef>
    <defName>LP_Sub_GloomStalker</defName>
    <label>幽域追踪者</label>
    <description>在黑暗里狩猎的游侠：每场战斗的第一击最致命，暗处难以命中，意志如钢，落空了马上补刀。</description>
    <parent>LP_Class_Ranger</parent><order>3</order><emblem>LP/Classes/Subclass/Emblem_GloomStalker</emblem><color>(0.5,0.5,0.66)</color>
    <abilities><li><ability>LP_DreadAmbusher</ability><level>3</level></li><li><ability>LP_IronMind</ability><level>7</level></li><li><ability>LP_StalkersFlurry</ability><level>11</level></li><li><ability>LP_ShadowyDodge</ability><level>15</level></li></abilities>
  </LichPhylactery.LP_SubclassDef>

  <!-- ===================== 状态 ===================== -->
  <HediffDef Name="LP_SubclassPassiveBase" Abstract="True">
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <everCurableByItem>false</everCurableByItem>
    <scenarioCanAdd>false</scenarioCanAdd>
    <initialSeverity>1</initialSeverity>
    <maxSeverity>5</maxSeverity>
    <defaultLabelColor>(0.85,0.75,0.5)</defaultLabelColor>
  </HediffDef>
  <HediffDef ParentName="LP_ClassBuffBase">
    <defName>LP_FrenzyFatigue</defName>
    <label>狂乱疲惫</label>
    <description>狂乱过后筋疲力尽：移动 ×0.8，近战冷却 ×1.2。</description>
    <isBad>true</isBad>
    <defaultLabelColor>(0.75,0.55,0.5)</defaultLabelColor>
    <stages><li><statFactors><MoveSpeed>0.8</MoveSpeed><MeleeCooldownFactor>1.2</MeleeCooldownFactor></statFactors></li></stages>
  </HediffDef>
  <HediffDef ParentName="LP_ClassBuffBase">
    <defName>LP_TotemEagleRage</defName>
    <label>鹰之灵</label>
    <description>狂暴中鹰灵附体：移动 ×1.2，远程攻击更难命中你（×0.7）。</description>
    <defaultLabelColor>(0.72,0.58,0.4)</defaultLabelColor>
    <stages><li><statFactors><MoveSpeed>1.2</MoveSpeed></statFactors></li></stages>
  </HediffDef>
  <HediffDef ParentName="LP_ClassBuffBase">
    <defName>LP_WolfPackBuff</defName>
    <label>狼群之灵</label>
    <description>身边有狂暴的狼之图腾勇士：近战命中 +15%。</description>
    <defaultLabelColor>(0.72,0.58,0.4)</defaultLabelColor>
    <stages><li><statOffsets><MeleeHitChance>0.15</MeleeHitChance></statOffsets></li></stages>
  </HediffDef>
  <HediffDef ParentName="LP_SubclassPassiveBase">
    <defName>LP_TotemAspect</defName>
    <label>兽之面相</label>
    <description>图腾兽的面相：熊 负重 ×2；鹰 远程武器射程 +3、射击精度略升；狼 移动 ×1.1，能追踪逃跑的敌人。</description>
    <stages>
      <li><label>熊</label><statFactors><CarryingCapacity>2</CarryingCapacity></statFactors></li>
      <li><minSeverity>1.5</minSeverity><label>鹰</label><statOffsets><ShootingAccuracyPawn>0.02</ShootingAccuracyPawn></statOffsets></li>
      <li><minSeverity>2.5</minSeverity><label>狼</label><statFactors><MoveSpeed>1.1</MoveSpeed></statFactors></li>
    </stages>
  </HediffDef>
  <HediffDef ParentName="LP_ClassBuffBase">
    <defName>LP_Tracked</defName>
    <label>被追踪</label>
    <description>被狼之图腾勇士盯上了脚印：移动 ×0.8。</description>
    <isBad>true</isBad>
    <defaultLabelColor>(0.9,0.6,0.5)</defaultLabelColor>
    <stages><li><statFactors><MoveSpeed>0.8</MoveSpeed></statFactors></li></stages>
  </HediffDef>
  <HediffDef ParentName="LP_ClassBuffBase">
    <defName>LP_Taunted</defName>
    <label>被嘲讽</label>
    <description>被熊之图腾勇士吸引了注意，只想打他。</description>
    <isBad>true</isBad>
    <defaultLabelColor>(0.9,0.6,0.5)</defaultLabelColor>
  </HediffDef>
  <HediffDef ParentName="LP_ClassBuffBase">
    <defName>LP_WolfPounce</defName>
    <label>狼之扑倒</label>
    <description>近战命中把体型不超过 2 的目标撞倒 2 秒。</description>
    <defaultLabelColor>(0.72,0.58,0.4)</defaultLabelColor>
  </HediffDef>
  <HediffDef ParentName="LP_SubclassPassiveBase">
    <defName>LP_StormSoulBuff</defName>
    <label>风暴之魂</label>
    <description>风暴的力量护着身体：对应元素的伤害 ×0.5，舒适温度放宽。</description>
    <stages>
      <li><label>沙漠</label><statOffsets><ComfyTemperatureMax>40</ComfyTemperatureMax></statOffsets></li>
      <li><minSeverity>1.5</minSeverity><label>海洋</label><statOffsets><ComfyTemperatureMin>-20</ComfyTemperatureMin><ComfyTemperatureMax>20</ComfyTemperatureMax></statOffsets></li>
      <li><minSeverity>2.5</minSeverity><label>冻原</label><statOffsets><ComfyTemperatureMin>-40</ComfyTemperatureMin></statOffsets></li>
    </stages>
  </HediffDef>
  <HediffDef ParentName="LP_ClassBuffBase">
    <defName>LP_StormShelter</defName>
    <label>庇护风暴</label>
    <description>身处风暴先驱的光环里：对应元素的伤害 ×0.75，舒适温度放宽一半。</description>
    <defaultLabelColor>(0.55,0.7,0.9)</defaultLabelColor>
    <stages>
      <li><label>沙漠</label><statOffsets><ComfyTemperatureMax>20</ComfyTemperatureMax></statOffsets></li>
      <li><minSeverity>1.5</minSeverity><label>海洋</label><statOffsets><ComfyTemperatureMin>-10</ComfyTemperatureMin><ComfyTemperatureMax>10</ComfyTemperatureMax></statOffsets></li>
      <li><minSeverity>2.5</minSeverity><label>冻原</label><statOffsets><ComfyTemperatureMin>-20</ComfyTemperatureMin></statOffsets></li>
    </stages>
  </HediffDef>
  <HediffDef ParentName="LP_ClassBuffBase">
    <defName>LP_FeralInstinctBuff</defName>
    <label>野性直觉</label>
    <description>察觉到袭击，抢先出手：移动 ×1.3，瞄准时间 ×0.5，近战冷却 ×0.8。</description>
    <defaultLabelColor>(0.9,0.45,0.35)</defaultLabelColor>
    <stages><li><statFactors><MoveSpeed>1.3</MoveSpeed><AimingDelayFactor>0.5</AimingDelayFactor><MeleeCooldownFactor>0.8</MeleeCooldownFactor></statFactors></li></stages>
  </HediffDef>
  <HediffDef ParentName="LP_ClassBuffBase">
    <defName>LP_RogueSteady</defName>
    <label>稳固目标</label>
    <description>瞄准好了：下一次攻击必定命中，并且满足偷袭条件。</description>
    <defaultLabelColor>(0.62,0.62,0.78)</defaultLabelColor>
  </HediffDef>
  <HediffDef ParentName="LP_ClassBuffBase">
    <defName>LP_DeathStrikeFx</defName>
    <hediffClass>LichPhylactery.Hediff_StrikeFactor</hediffClass>
    <label>死亡之击</label>
    <description>死亡之击这一下的近战伤害倍率。</description>
    <everCurableByItem>false</everCurableByItem>
  </HediffDef>
  <HediffDef ParentName="LP_SubclassPassiveBase">
    <defName>LP_SecondStoryBuff</defName>
    <label>飞檐走壁</label>
    <description>身手轻巧：移动 ×1.15，地形、积雪和植物都拖不慢你。</description>
    <stages><li><statFactors><MoveSpeed>1.15</MoveSpeed></statFactors></li></stages>
  </HediffDef>
  <HediffDef ParentName="LP_ClassBuffBase">
    <defName>LP_ThiefReflexBuff</defName>
    <label>盗贼反射</label>
    <description>战斗刚开始，手比谁都快：近战冷却、射击冷却 ×0.5。</description>
    <defaultLabelColor>(0.62,0.62,0.78)</defaultLabelColor>
    <stages><li><statFactors><MeleeCooldownFactor>0.5</MeleeCooldownFactor><RangedCooldownFactor>0.5</RangedCooldownFactor></statFactors></li></stages>
  </HediffDef>
  <HediffDef ParentName="LP_ClassBuffBase">
    <defName>LP_ATInvisible</defName>
    <label>隐形术</label>
    <description>诡术师的隐形术：隐形，攻击后现形（隐形时出手算偷袭）。</description>
    <defaultLabelColor>(0.62,0.5,0.9)</defaultLabelColor>
    <comps><li Class="HediffCompProperties_Invisibility"><visibleToPlayer>true</visibleToPlayer><affectedByDisruptor>true</affectedByDisruptor></li></comps>
  </HediffDef>
  <HediffDef ParentName="LP_ClassBuffBase">
    <defName>LP_Distracted</defName>
    <hediffClass>LichPhylactery.Hediff_ClassMark</hediffClass>
    <label>被法师之手干扰</label>
    <description>一只看不见的手在扯它的衣角：算作偷袭目标。</description>
    <isBad>true</isBad>
    <defaultLabelColor>(0.62,0.5,0.9)</defaultLabelColor>
  </HediffDef>
  <HediffDef ParentName="LP_ClassBuffBase">
    <defName>LP_Spotted</defName>
    <label>被发现</label>
    <description>游侠的原野之眼看见了它。</description>
    <isBad>true</isBad>
    <defaultLabelColor>(0.55,0.75,0.45)</defaultLabelColor>
  </HediffDef>
  <HediffDef ParentName="LP_ClassBuffBase">
    <defName>LP_CompanionGuard</defName>
    <hediffClass>LichPhylactery.Hediff_ClassMark</hediffClass>
    <label>伙伴守护</label>
    <description>游侠伙伴守在身边：伙伴在 3 格内时受到的伤害 ×0.75。</description>
    <defaultLabelColor>(0.55,0.75,0.45)</defaultLabelColor>
  </HediffDef>
  <HediffDef ParentName="LP_ClassBuffBase">
    <defName>LP_BeastFuryBuff</defName>
    <label>野兽之怒</label>
    <description>兽王的伙伴：近战冷却 ×0.5（每次出手攻击两次）。</description>
    <defaultLabelColor>(0.55,0.75,0.45)</defaultLabelColor>
    <stages><li><statFactors><MeleeCooldownFactor>0.5</MeleeCooldownFactor></statFactors></li></stages>
  </HediffDef>
  <HediffDef ParentName="LP_SubclassPassiveBase">
    <defName>LP_IronMindBuff</defName>
    <label>钢铁意志</label>
    <description>幽域追踪者的意志：不会恐惧，心智抗性 +10%。</description>
    <stages><li><statOffsets><LP_MindResist>0.1</LP_MindResist></statOffsets></li></stages>
  </HediffDef>

  <!-- ===================== 荆棘陷阱 ===================== -->
  <ThingDef ParentName="BuildingBase">
