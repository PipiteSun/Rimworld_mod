<?xml version="1.0" encoding="utf-8"?>
<!-- 1.18.0 吉斯洋基：可遗传的灵能剑士种族。银剑、星界跳跃、巫妖女王的信徒、夺心魔的宿敌。 -->
<Defs>
  <XenotypeDef>
    <defName>LP_Githyanki</defName>
    <label>吉斯洋基</label>
    <description>曾被夺心魔奴役的种族的后裔，血脉会遗传给子女。吉斯洋基瘦削、尖耳，皮肤是病态的灰黄绿色；天生心灵敏感，是出色的剑士，能在短距离内穿过星界瞬移。他们世代与夺心魔为敌，对夺心魔下手格外狠，蝌蚪也很难在他们脑中扎根。吉斯洋基崇拜不死的巫妖女王，见到巫妖会心生敬意，被巫妖劝降也更容易动摇。每个吉斯洋基战士都梦想着一把只回应同族之手的银剑。他们傲慢好斗，不擅交际。</description>
    <descriptionShort>可遗传的灵能剑士种族。心灵敏感、近战强、能星界跳跃、专精银剑；夺心魔的宿敌，崇敬巫妖；好斗、不擅交际。</descriptionShort>
    <iconPath>MinotaurGith/Xenotypes/Githyanki</iconPath>
    <inheritable>true</inheritable>
    <combatPowerFactor>1.2</combatPowerFactor>
    <factionlessGenerationWeight>0</factionlessGenerationWeight>
    <genes>
      <li>LP_GithSilverSword</li>
      <li>LP_GithAstralStep</li>
      <li>LP_GithLichDevotee</li>
      <li>LP_GithNemesis</li>
      <li>LP_GithSkin</li>
      <li>PsychicAbility_Enhanced</li>
      <li>AptitudeStrong_Melee</li>
      <li>Body_Thin</li>
      <li>Ears_Pointed</li>
      <li>Beard_NoBeardOnly</li>
      <li>AptitudePoor_Social</li>
      <li>Aggression_Aggressive</li>
    </genes>
  </XenotypeDef>

  <GeneDef ParentName="GeneSkinColorOverride">
    <defName>LP_GithSkin</defName>
    <label>吉斯肤色</label>
    <labelShortAdj>灰黄</labelShortAdj>
    <description>吉斯血脉特有的灰黄绿色皮肤，像久不见日光的羊皮纸。</description>
    <skinColorOverride>(176, 176, 116)</skinColorOverride>
    <randomBrightnessFactor>0.08</randomBrightnessFactor>
    <selectionWeight>0</selectionWeight>
    <displayOrderInCategory>1</displayOrderInCategory>
  </GeneDef>

  <!-- ==================== 银剑传承 ==================== -->
  <GeneDef>
    <defName>LP_GithSilverSword</defName>
    <label>银剑传承</label>
    <description>吉斯洋基战士与银剑之间的古老联结。持银剑的吉斯洋基每次挥砍命中，都会附带一段灵能冲击（约8点，受目标心灵敏感度影响，对心灵失聪者无效，对夺心魔×2）。只有带这个基因的人能在符文铁砧上锻造银剑；别人拿着银剑只是一把普通钢剑，还会觉得剑在排斥自己。</description>
    <iconPath>MinotaurGith/Genes/SilverSword</iconPath>
    <displayCategory>Violence</displayCategory>
    <selectionWeight>0</selectionWeight>
    <biostatCpx>2</biostatCpx>
    <biostatMet>-1</biostatMet>
    <exclusionTags>
      <li>DND_GithLineage</li>
    </exclusionTags>
    <descriptionHyperlinks>
      <ThingDef>LP_SilverSword</ThingDef>
    </descriptionHyperlinks>
    <customEffectDescriptions>
      <li>持银剑近战命中：附加约8×目标心灵敏感度点灵能伤害；目标是夺心魔时×2。</li>
      <li>只有该基因持有者能锻造银剑（符文铁砧，需要研究异族利刃）。</li>
      <li>其他人装备银剑：与普通钢长剑相同，心情-2“银剑拒绝了你”。</li>
    </customEffectDescriptions>
  </GeneDef>
  <ThingDef ParentName="BaseMeleeWeapon_Sharp_Quality">
    <defName>LP_SilverSword</defName>
    <label>银剑</label>
    <description>吉斯洋基的传承之剑，银灰色的剑身上流淌着浅紫色的灵能纹路。在吉斯洋基手中，每一次命中都会把灵能直接灌进对方的心智，对夺心魔尤其致命；在别人手里，它只是一把冷冰冰、不肯配合的钢剑。\n\n商人从不出售银剑：只能从吉斯洋基手中缴获，或由吉斯洋基亲手锻造。</description>
    <possessionCount>1</possessionCount>
    <graphicData>
      <texPath>MinotaurGith/Weapons/SilverSword</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <techLevel>Medieval</techLevel>
    <tradeability>Sellable</tradeability>
    <smeltable>true</smeltable>
    <relicChance>0</relicChance>
    <equippedAngleOffset>-65</equippedAngleOffset>
    <statBases>
      <WorkToMake>24000</WorkToMake>
      <Mass>2</Mass>
      <MarketValue>900</MarketValue>
    </statBases>
    <costList>
      <Plasteel>40</Plasteel>
      <Silver>120</Silver>
    </costList>
    <tools>
      <li>
        <label>剑柄</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>9</power>
        <cooldownTime>2</cooldownTime>
      </li>
      <li>
        <label>剑尖</label>
        <capacities>
          <li>Stab</li>
        </capacities>
        <power>23</power>
        <cooldownTime>2.6</cooldownTime>
      </li>
      <li>
        <label>剑刃</label>
        <capacities>
          <li>Cut</li>
        </capacities>
        <power>23</power>
        <cooldownTime>2.6</cooldownTime>
      </li>
    </tools>
    <recipeMaker>
      <recipeUsers Inherit="False"><li>LP_RuneAnvil</li></recipeUsers>
      <researchPrerequisite>LP_RacialBlades</researchPrerequisite>
      <skillRequirements>
        <Crafting>8</Crafting>
      </skillRequirements>
      <displayPriority>425</displayPriority>
      <defaultIngredientFilter Inherit="False">
        <categories>
          <li>Root</li>
        </categories>
      </defaultIngredientFilter>
    </recipeMaker>
  </ThingDef>
  <DamageDef>
    <defName>LP_SilverPsychic</defName>
    <label>银剑灵能</label>
    <workerClass>DamageWorker_AddInjury</workerClass>
    <externalViolence>true</externalViolence>
    <makesBlood>false</makesBlood>
    <deathMessage>{0}被银剑的灵能冲击撕碎了心智。</deathMessage>
    <hediff>LP_PsychicWound</hediff>
    <impactSoundType>Slice</impactSoundType>
  </DamageDef>
  <HediffDef ParentName="InjuryBase">
    <defName>LP_PsychicWound</defName>
    <label>灵能灼伤</label>
    <labelNoun>灵能灼伤</labelNoun>
    <description>银剑的灵能冲击留下的伤，伤口周围的神经像被烫过一样。</description>
    <displayWound>false</displayWound>
    <comps>
      <li Class="HediffCompProperties_TendDuration">
        <labelTendedWell>已包扎</labelTendedWell>
        <labelTendedWellInner>已处理</labelTendedWellInner>
        <labelSolidTendedWell>已处理</labelSolidTendedWell>
      </li>
      <li Class="HediffCompProperties_GetsPermanent">
        <permanentLabel>灵能疤痕</permanentLabel>
      </li>
    </comps>
    <injuryProps>
      <painPerSeverity>0.0175</painPerSeverity>
      <averagePainPerSeverityPermanent>0.00625</averagePainPerSeverityPermanent>
      <canMerge>false</canMerge>
      <destroyedLabel>被灵能摧毁</destroyedLabel>
    </injuryProps>
  </HediffDef>
  <ThoughtDef>
    <defName>LP_SilverSwordRejects</defName>
    <workerClass>LichPhylactery.ThoughtWorker_SilverSwordRejects</workerClass>
    <stages>
      <li>
        <label>银剑拒绝了你</label>
        <description>这把银剑握在手里冷冰冰的，好像在排斥我。它不属于我。</description>
        <baseMoodEffect>-2</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <!-- ==================== 星界跳跃 ==================== -->
  <GeneDef>
    <defName>LP_GithAstralStep</defName>
    <label>星界跳跃</label>
    <description>吉斯洋基能短暂踏入星界，从8格内的另一处走出来。有心灵链接的吉斯洋基每次消耗5%精神力；没有心灵链接时只受冷却限制。冷却12小时。</description>
    <iconPath>MinotaurGith/Genes/AstralStep</iconPath>
    <displayCategory>Psychic</displayCategory>
    <selectionWeight>0</selectionWeight>
    <biostatCpx>2</biostatCpx>
    <biostatMet>-1</biostatMet>
    <abilities>
      <li>LP_AstralStep</li>
    </abilities>
    <descriptionHyperlinks>
      <AbilityDef>LP_AstralStep</AbilityDef>
    </descriptionHyperlinks>
  </GeneDef>
  <AbilityDef ParentName="LP_MinotaurGithAbilityBase">
    <defName>LP_AstralStep</defName>
    <label>星界跳跃</label>
    <description>穿过星界，瞬间出现在8格内一处可以站立的空地上（不需要视线，但不能落在未探索的地方）。有心灵链接时消耗5%精神力。冷却12小时。</description>
    <iconPath>MinotaurGith/Abilities/AstralStep</iconPath>
    <cooldownTicksRange>30000</cooldownTicksRange>
    <hostile>false</hostile>
    <casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <range>8</range>
      <warmupTime>0.5</warmupTime>
      <violent>false</violent>
      <requireLineOfSight>false</requireLineOfSight>
      <targetParams>
        <canTargetLocations>true</canTargetLocations>
        <canTargetPawns>false</canTargetPawns>
        <canTargetBuildings>false</canTargetBuildings>
        <canTargetSelf>false</canTargetSelf>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="LichPhylactery.CompProperties_MinotaurGithAbility">
        <effect>astral</effect>
        <psyfocusCost>0.05</psyfocusCost>
      </li>
    </comps>
  </AbilityDef>

  <!-- ==================== 巫妖女王的信徒 ==================== -->
  <GeneDef>
    <defName>LP_GithLichDevotee</defName>
    <label>巫妖女王的信徒</label>
    <description>吉斯洋基世代侍奉不死的巫妖女王。殖民地里有巫妖时，吉斯洋基心情+3；巫妖亲自劝降吉斯洋基俘虏时，每次谈话降低的抵抗多30%。</description>
    <iconPath>MinotaurGith/Genes/LichDevotee</iconPath>
    <displayCategory>Miscellaneous</displayCategory>
    <selectionWeight>0</selectionWeight>
    <biostatCpx>1</biostatCpx>
    <biostatMet>0</biostatMet>
    <customEffectDescriptions>
      <li>同一地图上有本殖民地的巫妖：心情+3。</li>
      <li>巫妖作为狱卒劝降：每次谈话降低的抵抗×130%。</li>
    </customEffectDescriptions>
  </GeneDef>
  <ThoughtDef>
    <defName>LP_GithSeesLich</defName>
    <workerClass>LichPhylactery.ThoughtWorker_GithSeesLich</workerClass>
    <stages>
      <li>
        <label>巫妖的荣光</label>
        <description>殖民地里有一位不死的巫妖，就像巫妖女王的影子在注视着我们。</description>
        <baseMoodEffect>3</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <!-- ==================== 宿敌 ==================== -->
  <GeneDef>
    <defName>LP_GithNemesis</defName>
    <label>宿敌</label>
    <description>吉斯洋基的祖先曾是夺心魔的奴隶，这份仇恨刻在血脉里。对夺心魔造成的伤害+25%，近战命中率+10%；心智抗性+30%，脑中的夺心魔蝌蚪化形速度减半。</description>
    <iconPath>MinotaurGith/Genes/Nemesis</iconPath>
    <displayCategory>Violence</displayCategory>
    <selectionWeight>0</selectionWeight>
    <biostatCpx>1</biostatCpx>
    <biostatMet>0</biostatMet>
    <statOffsets>
      <LP_MindResist>0.3</LP_MindResist>
    </statOffsets>
    <customEffectDescriptions>
      <li>对夺心魔：伤害×125%，近战命中率+10%。</li>
      <li>夺心魔蝌蚪化形速度×50%（与心智抗性的减速相乘）。</li>
    </customEffectDescriptions>
    <modExtensions>
      <li Class="LichPhylactery.TadpoleProgressExtension">
        <progressFactor>0.5</progressFactor>
      </li>
    </modExtensions>
  </GeneDef>

  <!-- ==================== 种族关系 ==================== -->
  <ThoughtDef>
    <defName>LP_RacialRelation_GithMindFlayer</defName>
    <workerClass>LichPhylactery.ThoughtWorker_DNDRacialRelation</workerClass>
    <stages>
      <li>
        <label>与夺心魔同住</label>
        <description>夺心魔奴役过我的祖先。和那种东西住在一起，我每晚都想拔剑。</description>
        <baseMoodEffect>-8</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>
  <LichPhylactery.RacialRelationDef>
    <defName>LP_Relation_GithMindFlayer</defName>
    <label>吉斯洋基看夺心魔</label>
    <observer>LP_Githyanki</observer>
    <target>LP_MindFlayer</target>
    <thought>LP_RacialRelation_GithMindFlayer</thought>
  </LichPhylactery.RacialRelationDef>
  <ThoughtDef>
    <defName>LP_RacialRelation_MindFlayerGith</defName>
    <workerClass>LichPhylactery.ThoughtWorker_DNDRacialRelation</workerClass>
    <stages>
      <li>
        <label>与吉斯洋基同住</label>
        <description>那些逃走的奴隶的后代，手里总握着银剑。群脑不喜欢他们。</description>
        <baseMoodEffect>-6</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>
  <LichPhylactery.RacialRelationDef>
    <defName>LP_Relation_MindFlayerGith</defName>
    <label>夺心魔看吉斯洋基</label>
    <observer>LP_MindFlayer</observer>
    <target>LP_Githyanki</target>
    <thought>LP_RacialRelation_MindFlayerGith</thought>
  </LichPhylactery.RacialRelationDef>
</Defs>
