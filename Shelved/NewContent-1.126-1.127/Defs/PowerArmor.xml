<!-- 1.124.0 奥能动力甲：奥术核心驱动的秘铸骑士装甲（侏儒奇械师 + 耐瑟瑞尔奥术科技）。代码在 Source/PowerArmor.cs，贴图由 ArtSource/RaceArt/draw_power_armor_124.py 生成。
     三档：奥械侍从甲（≈原版海军装甲）、秘铸骑士动力甲（略高于原版重甲）、誓约堡垒重甲（最高档，体型 1 以上才能穿）；三个职业变体：圣誓型、秘法炮手型、奇械型。
     双色：CutoutComplex + _m 遮罩（红=甲色，绿=纹章色；纹章色由 HeraldryExtension 给出）。研究在「DND边缘大陆」页 (4,3.5) (5,3.5) (6,3.5)。 -->
<Defs>
  <!-- ==================== 研究 ==================== -->
  <ResearchProjectDef>
    <defName>LP_Research_ArcanePowerArmor</defName>
    <label>奥能动力学</label>
    <description>把奥术核心装进骑士板甲：奥能驱动的伺服关节和推进器。解锁奥械锻炉、奥能充能座、奥能电池，以及第一档奥能动力甲「奥械侍从甲」和配套头盔。</description>
    <baseCost>2000</baseCost>
    <techLevel>Spacer</techLevel>
    <prerequisites>
      <li>LP_Research_KnightForging</li>
      <li>MicroelectronicsBasics</li>
    </prerequisites>
    <tab>LP_FireGiantTech</tab>
    <researchViewX>4</researchViewX>
    <researchViewY>3.5</researchViewY>
  </ResearchProjectDef>
  <ResearchProjectDef>
    <defName>LP_Research_ArcaneKnightArmor</defName>
    <label>秘铸骑士甲</label>
    <description>用秘银和精金秘铸的全身动力甲，核心带力场发生器。解锁「秘铸骑士动力甲」、骑士盔和三种职业变体：圣誓型（圣武士）、秘法炮手型（法师）、奇械型（器械师）。</description>
    <baseCost>3000</baseCost>
    <techLevel>Spacer</techLevel>
    <prerequisites>
      <li>LP_Research_ArcanePowerArmor</li>
      <li>LP_Research_LegendaryArmor</li>
    </prerequisites>
    <tab>LP_FireGiantTech</tab>
    <researchViewX>5</researchViewX>
    <researchViewY>3.5</researchViewY>
  </ResearchProjectDef>
  <ResearchProjectDef>
    <defName>LP_Research_OathBastion</defName>
    <label>誓约堡垒</label>
    <description>骑士团最后的堡垒：一身会走路的城墙，核心能过载放出冲击。解锁「誓约堡垒重甲」和堡垒巨盔（体型 1 以上才能穿）。</description>
    <baseCost>4500</baseCost>
    <techLevel>Spacer</techLevel>
    <prerequisites>
      <li>LP_Research_ArcaneKnightArmor</li>
    </prerequisites>
    <tab>LP_FireGiantTech</tab>
    <researchViewX>6</researchViewX>
    <researchViewY>3.5</researchViewY>
  </ResearchProjectDef>

  <!-- ==================== 状态 ==================== -->
  <HediffDef>
    <defName>LP_PA_Husk</defName>
    <label>铁壳</label>
    <description>奥能动力甲的核心耗尽了：伺服关节失去动力，整身甲变成沉重的铁壳。移动 -35%、操作 -25%，装甲能力不能用。充能或脱下后恢复。</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.62,0.64,0.68)</defaultLabelColor>
    <isBad>true</isBad>
    <everCurableByItem>false</everCurableByItem>
    <scenarioCanAdd>false</scenarioCanAdd>
    <stages><li><capMods><li><capacity>Moving</capacity><offset>-0.35</offset></li><li><capacity>Manipulation</capacity><offset>-0.25</offset></li></capMods></li></stages>
  </HediffDef>
  <HediffDef>
    <defName>LP_PA_Field</defName>
    <label>奥能力场</label>
    <description>贴身的奥能力场：所有伤害都被挡下，每挡一点伤害消耗核心的奥能；奥能耗尽时力场崩溃。</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.45,0.85,1)</defaultLabelColor>
    <isBad>false</isBad>
    <everCurableByItem>false</everCurableByItem>
    <scenarioCanAdd>false</scenarioCanAdd>
    <comps><li Class="HediffCompProperties_Disappears"><disappearsAfterTicks>600</disappearsAfterTicks><showRemainingTime>true</showRemainingTime></li></comps>
  </HediffDef>

