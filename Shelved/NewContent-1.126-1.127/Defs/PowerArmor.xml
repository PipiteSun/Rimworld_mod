  <!-- ==================== 第一档：奥械侍从甲 ==================== -->
  <ThingDef ParentName="LP_PowerArmorBase">
    <defName>LP_PA_SquireArmor</defName>
    <label>奥械侍从甲</label>
    <description>侏儒奇械师给骑士团侍从造的入门动力甲：分节肩甲、颈上一条旧围巾、呼吸软管通到胸前滤罐，胸口一颗黄铜框的蓝色奥能核心，背后两支短推进管。护甲和移速惩罚约同原版海军装甲。\n\n奥能核心 100：受到伤害时每点伤害 -0.25，征召时每小时 -10；耗尽变成铁壳（移动 -35%、操作 -25%）。在通电的奥能充能座充能，或换上奥能电池（+60）。戴任意奥能头盔时核心上限 +20%。\n\n装甲能力：推进跃击（20 奥能，跃到 2～12 格外，落地 1.9 格内的敌人受 10 点钝击，成功率 60% 被震倒）。</description>
    <graphicData><texPath>LP/PowerArmor/SquireArmor/SquireArmor_Icon</texPath><color>(0.46,0.49,0.42)</color></graphicData>
    <costList><Plasteel>80</Plasteel><Steel>40</Steel><LP_Mithral>25</LP_Mithral><ComponentSpacer>3</ComponentSpacer></costList>
    <statBases>
      <WorkToMake>58000</WorkToMake><MaxHitPoints>340</MaxHitPoints><Mass>12</Mass><Flammability>0.4</Flammability>
      <ArmorRating_Sharp>1.04</ArmorRating_Sharp><ArmorRating_Blunt>0.46</ArmorRating_Blunt><ArmorRating_Heat>0.52</ArmorRating_Heat>
      <Insulation_Cold>66</Insulation_Cold><Insulation_Heat>10</Insulation_Heat><EquipDelay>14</EquipDelay>
    </statBases>
    <equippedStatOffsets><MoveSpeed>-0.25</MoveSpeed><VacuumResistance MayRequire="Ludeon.RimWorld.Odyssey">0.3</VacuumResistance></equippedStatOffsets>
    <recipeMaker><researchPrerequisite>LP_Research_ArcanePowerArmor</researchPrerequisite><skillRequirements><Crafting>7</Crafting></skillRequirements><displayPriority>471</displayPriority></recipeMaker>
    <apparel><wornGraphicPath>LP/PowerArmor/SquireArmor/SquireArmor</wornGraphicPath></apparel>
    <comps><li Class="LichPhylactery.CompProperties_ArcaneCore"><capacity>100</capacity><leap>true</leap></li></comps>
  </ThingDef>
  <ThingDef ParentName="LP_PowerHelmBase">
    <defName>LP_PA_SquireHelm</defName>
    <label>奥械侍从盔</label>
    <description>盔顶一排凸节的全盔，深色斜面罩上一道淡蓝 V 形目缝，下面是前凸的呼吸口罩和两根软管。头部护甲约同原版海军头盔。和任意奥能动力甲一起穿时，盔甲的核心上限 +20%。</description>
    <graphicData><texPath>LP/PowerArmor/SquireHelm/SquireHelm_Icon</texPath><color>(0.46,0.49,0.42)</color></graphicData>
    <costList><Plasteel>30</Plasteel><LP_Mithral>8</LP_Mithral><ComponentSpacer>1</ComponentSpacer></costList>
    <statBases>
      <WorkToMake>20000</WorkToMake><MaxHitPoints>120</MaxHitPoints><Mass>1.5</Mass><Flammability>0.4</Flammability>
      <ArmorRating_Sharp>1.04</ArmorRating_Sharp><ArmorRating_Blunt>0.46</ArmorRating_Blunt><ArmorRating_Heat>0.52</ArmorRating_Heat>
      <Insulation_Cold>4</Insulation_Cold><Insulation_Heat>2</Insulation_Heat><EquipDelay>2</EquipDelay>
    </statBases>
    <recipeMaker><researchPrerequisite>LP_Research_ArcanePowerArmor</researchPrerequisite><skillRequirements><Crafting>6</Crafting></skillRequirements><displayPriority>472</displayPriority></recipeMaker>
    <apparel><wornGraphicPath>LP/PowerArmor/SquireHelm/SquireHelm</wornGraphicPath></apparel>
