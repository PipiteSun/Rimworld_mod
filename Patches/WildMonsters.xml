<?xml version="1.0" encoding="utf-8"?>
<!-- DND 怪物第二批的野外刷新：比 1.25.0 的野兽更稀有（0.01～0.03），偶尔能撞见。
     设置里关掉“野外刷新 DND 怪物”时，代码把这些权重当成 0（见 Source/WildMonsters.cs），不用改这里。 -->
<Patch>
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/BiomeDef[defName="TemperateForest"]/wildAnimals</xpath>
    <value>
      <LP_RustMonster>0.02</LP_RustMonster>
      <LP_Manticore>0.01</LP_Manticore>
      <LP_Bulette>0.01</LP_Bulette>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/BiomeDef[defName="BorealForest"]/wildAnimals</xpath>
    <value>
      <LP_RustMonster>0.02</LP_RustMonster>
      <LP_Bulette>0.01</LP_Bulette>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/BiomeDef[defName="Tundra"]/wildAnimals</xpath>
