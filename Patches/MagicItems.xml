    <value>
      <li Class="StockGenerator_SingleDef"><thingDef>LP_ScrollRemoveCurse</thingDef><countRange>1~3</countRange></li>
      <li Class="StockGenerator_SingleDef"><thingDef>LP_WardingBondCase</thingDef><countRange>-2~1</countRange></li>
