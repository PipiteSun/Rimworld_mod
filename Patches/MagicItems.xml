    <xpath>/Defs/TraderKindDef[defName="LP_Caravan_FaerunGoods"]/stockGenerators</xpath>
    <value>
      <li Class="StockGenerator_SingleDef"><thingDef>LP_RingProtection</thingDef><countRange>-1~1</countRange></li>
      <li Class="StockGenerator_SingleDef"><thingDef>LP_NecklaceAdaptation</thingDef><countRange>-2~1</countRange></li>
