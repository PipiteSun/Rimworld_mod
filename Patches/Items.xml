<?xml version="1.0" encoding="utf-8"?>
<!-- 1.22.0 物品与炼金：往本模组各派系商队的货单里加入新物品（Isekai 启用时原版奇物商人另见 Bridges/Isekai）。 -->
<Patch>
  <!-- 余烬氏族：熔岩结晶、精金、龙鳞蜕 -->
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/TraderKindDef[defName="LP_Caravan_GiantSmith"]/stockGenerators</xpath>
    <value>
      <li Class="StockGenerator_SingleDef"><thingDef>LP_LavaCrystal</thingDef><countRange>10~25</countRange></li>
      <li Class="StockGenerator_SingleDef"><thingDef>LP_Adamantine</thingDef><countRange>-10~8</countRange></li>
      <li Class="StockGenerator_BuySingleDef"><thingDef>LP_DragonShed</thingDef></li>
    </value>
  </Operation>
  <!-- 费伦拓荒同盟：少量秘银、寒铁 -->
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/TraderKindDef[defName="LP_Caravan_DwarfSmith"]/stockGenerators</xpath>
    <value>
      <li Class="StockGenerator_SingleDef"><thingDef>LP_Mithral</thingDef><countRange>-5~15</countRange></li>
      <li Class="StockGenerator_SingleDef"><thingDef>LP_ColdIron</thingDef><countRange>10~30</countRange></li>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/TraderKindDef[defName="LP_Caravan_FaerunGoods"]/stockGenerators</xpath>
    <value>
      <li Class="StockGenerator_SingleDef"><thingDef>LP_Mithral</thingDef><countRange>-8~10</countRange></li>
    </value>
  </Operation>
  <!-- 黑网：精金（少量） -->
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/TraderKindDef[defName="LP_Caravan_BlackNetwork"]/stockGenerators</xpath>
    <value>
      <li Class="StockGenerator_SingleDef"><thingDef>LP_Adamantine</thingDef><countRange>-6~6</countRange><price>Expensive</price></li>
    </value>
  </Operation>

  <!-- ===== 成品：种族装备（每件至少一个派系商队）、药水、卷轴、奇物、投掷物 ===== -->
  <!-- 矮人铁匠：投掷锤、符文盾、雷鸣石 -->
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/TraderKindDef[defName="LP_Caravan_DwarfSmith"]/stockGenerators</xpath>
    <value>
      <li Class="StockGenerator_SingleDef"><thingDef>LP_DwarvenThrowingHammer</thingDef><countRange>-1~1</countRange></li>
      <li Class="StockGenerator_SingleDef"><thingDef>LP_DwarvenRuneShield</thingDef><countRange>-1~1</countRange></li>
      <li Class="StockGenerator_SingleDef"><thingDef>LP_Thunderstone</thingDef><countRange>1~4</countRange></li>
    </value>
  </Operation>
  <!-- 精灵草药商：长弓、锁子甲、精灵斗篷与靴、治疗药水 -->
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/TraderKindDef[defName="LP_Caravan_ElfHerbalist"]/stockGenerators</xpath>
    <value>
      <li Class="StockGenerator_SingleDef"><thingDef>LP_ElvenLongbow</thingDef><countRange>-1~1</countRange></li>
      <li Class="StockGenerator_SingleDef"><thingDef>LP_ElvenChain</thingDef><countRange>-2~1</countRange></li>
      <li Class="StockGenerator_SingleDef"><thingDef>LP_CloakElvenkind</thingDef><countRange>-2~1</countRange></li>
      <li Class="StockGenerator_SingleDef"><thingDef>LP_BootsElvenkind</thingDef><countRange>-2~1</countRange></li>
      <li Class="StockGenerator_SingleDef"><thingDef>LP_PotionHealing</thingDef><countRange>2~5</countRange></li>
    </value>
  </Operation>
  <!-- 教会牧师：治疗药水、圣水、防护邪恶与识破卷轴、健康护符；复生卷轴极少（约3000银） -->
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/TraderKindDef[defName="LP_Caravan_ChurchPriest"]/stockGenerators</xpath>
    <value>
      <li Class="StockGenerator_SingleDef"><thingDef>LP_PotionHealing</thingDef><countRange>3~6</countRange></li>
      <li Class="StockGenerator_SingleDef"><thingDef>LP_PotionGreaterHealing</thingDef><countRange>0~2</countRange></li>
      <li Class="StockGenerator_SingleDef"><thingDef>LP_HolyWater</thingDef><countRange>3~6</countRange></li>
      <li Class="StockGenerator_SingleDef"><thingDef>LP_ScrollProtectionEvil</thingDef><countRange>0~2</countRange></li>
      <li Class="StockGenerator_SingleDef"><thingDef>LP_ScrollTrueSeeing</thingDef><countRange>0~1</countRange></li>
      <li Class="StockGenerator_SingleDef"><thingDef>LP_ScrollRevivify</thingDef><countRange>-3~1</countRange></li>
      <li Class="StockGenerator_SingleDef"><thingDef>LP_AmuletHealth</thingDef><countRange>-2~1</countRange></li>
    </value>
  </Operation>
  <!-- 同盟商队：治疗药水、传送卷轴、次元袋 -->
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/TraderKindDef[defName="LP_Caravan_FaerunGoods"]/stockGenerators</xpath>
    <value>
      <li Class="StockGenerator_SingleDef"><thingDef>LP_PotionHealing</thingDef><countRange>1~3</countRange></li>
      <li Class="StockGenerator_SingleDef"><thingDef>LP_ScrollTeleport</thingDef><countRange>0~1</countRange></li>
      <li Class="StockGenerator_SingleDef"><thingDef>LP_BagOfHolding</thingDef><countRange>-2~1</countRange></li>
    </value>
  </Operation>
  <!-- 红袍商人（塞伊）：巨斧、牛头人角盔、骨质护符、各类卷轴与奇物、驱散粉尘 -->
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/TraderKindDef[defName="LP_Caravan_RedRobe"]/stockGenerators</xpath>
    <value>
      <li Class="StockGenerator_SingleDef"><thingDef>LP_OrcishGreataxe</thingDef><countRange>-1~1</countRange></li>
      <li Class="StockGenerator_SingleDef"><thingDef>LP_MinotaurHornHelm</thingDef><countRange>-1~1</countRange></li>
      <li Class="StockGenerator_SingleDef"><thingDef>LP_BoneTalisman</thingDef><countRange>-2~1</countRange></li>
      <li Class="StockGenerator_SingleDef"><thingDef>LP_DispelDust</thingDef><countRange>1~3</countRange></li>
      <li Class="StockGenerator_Tag"><tradeTag>LP_Scroll</tradeTag><thingDefCountRange>2~3</thingDefCountRange><countRange>1~2</countRange></li>
      <li Class="StockGenerator_Tag"><tradeTag>LP_Wondrous</tradeTag><thingDefCountRange>1~2</thingDefCountRange><countRange>1~1</countRange></li>
    </value>
  </Operation>
  <!-- 火巨人铁匠：蜕鳞甲 -->
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/TraderKindDef[defName="LP_Caravan_GiantSmith"]/stockGenerators</xpath>
    <value>
      <li Class="StockGenerator_SingleDef"><thingDef>LP_DragonShedArmor</thingDef><countRange>-1~1</countRange></li>
    </value>
  </Operation>
  <!-- 黑网：隐形药水（只此一家）、星界战甲、触须披风、雷鸣石、驱散粉尘、奇物 -->
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/TraderKindDef[defName="LP_Caravan_BlackNetwork"]/stockGenerators</xpath>
    <value>
      <li Class="StockGenerator_SingleDef"><thingDef>LP_PotionInvisibility</thingDef><countRange>1~3</countRange><price>Expensive</price></li>
      <li Class="StockGenerator_SingleDef"><thingDef>LP_GithAstralArmor</thingDef><countRange>-1~1</countRange><price>Expensive</price></li>
      <li Class="StockGenerator_SingleDef"><thingDef>LP_IllithidTendrilCloak</thingDef><countRange>-1~1</countRange><price>Expensive</price></li>
      <li Class="StockGenerator_SingleDef"><thingDef>LP_Thunderstone</thingDef><countRange>1~3</countRange><price>Expensive</price></li>
      <li Class="StockGenerator_SingleDef"><thingDef>LP_DispelDust</thingDef><countRange>1~3</countRange><price>Expensive</price></li>
      <li Class="StockGenerator_Tag"><tradeTag>LP_Wondrous</tradeTag><thingDefCountRange>1~2</thingDefCountRange><countRange>1~1</countRange><price>Expensive</price></li>
    </value>
  </Operation>
</Patch>
